(* KHANARY / CFPC grammar package — proposed syntax contract v0.1. *)
(* EBNF conventions: { X } repetition, [ X ] optional, | alternation. *)
(* Quoted XML tags are literal terminals. Character data is parsed by the XML host. *)
relation = "<relation/ >" ;
relation_ref = "<relation-ref/ >" ;
fact = "<fact>", { evidence | provenance | scope }, "</fact>" ;
event = "<event>", { evidence | provenance | scope }, "</event>" ;
evidence = "<evidence/ >" ;
provenance = "<provenance/ >" ;
scope = "<scope/ >" ;
(* Relation declaration precedes typed fact use. *)
(* FactIndex is a graph projection; EventLog is append-only. *)
(* Event occurrence never implies automatic state-transition acceptance. *)
