(* KHANARY / CFPC grammar package — proposed syntax contract v0.1. *)
(* EBNF conventions: { X } repetition, [ X ] optional, | alternation. *)
(* Quoted XML tags are literal terminals. Character data is parsed by the XML host. *)
result = "<result>", { finding | hypothesis | contradiction | gap | query | proposal | objection | evidence }, "</result>" ;
finding = "<finding>", text_value, "</finding>" ;
hypothesis = "<hypothesis>", text_value, "</hypothesis>" ;
policy = "<policy/ >" ;
evaluate = "<evaluate/ >" ;
(* Xul returns typed results to parent; root Xul ends document execution. *)
(* Unselected != false, invalid or rejected by evidence. *)
