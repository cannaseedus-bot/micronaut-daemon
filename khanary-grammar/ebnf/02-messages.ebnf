(* KHANARY / CFPC grammar package — proposed syntax contract v0.1. *)
(* EBNF conventions: { X } repetition, [ X ] optional, | alternation. *)
(* Quoted XML tags are literal terminals. Character data is parsed by the XML host. *)
user_message = "<user>", { content | observation | task }, "</user>" ;
assistant_message = "<assistant>", { content | observation | semantic_node }, "</assistant>" ;
instruction_message = "<instruct>", { content | policy }, "</instruct>" ;
content = "<content>", text_value, "</content>" ;
text_value = ? XML character data ? ;
(* The host assigns instruction authority; XML text cannot self-elevate trust. *)
