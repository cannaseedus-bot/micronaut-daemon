(* KHANARY / CFPC grammar package — proposed syntax contract v0.1. *)
(* EBNF conventions: { X } repetition, [ X ] optional, | alternation. *)
(* Quoted XML tags are literal terminals. Character data is parsed by the XML host. *)
promote = "<promote>", { candidate | verification | policy | result }, "</promote>" ;
candidate = "<candidate/ >" ;
verification = "<verification/ >" ;
(* Xul closure always returns; selection is optional; promotion is separate. *)
(* L_i is a deterministic binary permission gate at selected operation boundary. *)
(* Model verifier may return soft rejection bias, never override L_i. *)
(* no_automatic_fact_promotion = true. *)
