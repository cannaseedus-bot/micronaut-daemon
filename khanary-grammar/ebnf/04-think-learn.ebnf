(* KHANARY / CFPC grammar package — proposed syntax contract v0.1. *)
(* EBNF conventions: { X } repetition, [ X ] optional, | alternation. *)
(* Quoted XML tags are literal terminals. Character data is parsed by the XML host. *)
think = "<think>", { pattern | wildcard | context | explore | function | function_ref | invoke | evidence | evaluate | policy | result }, "</think>" ;
learn = "<learn>", { pattern | template | example | evidence | proposal | gap | policy | result }, "</learn>" ;
explore = "<explore>", { relation_ref | query | evidence }, "</explore>" ;
proposal = "<proposal/ >" ;
example = "<example>", text_value, "</example>" ;
(* Learn produces proposals only; route_weight target is parse-rejected until Stage 3. *)
(* Gaps may be returned as findings while candidate updates remain shadow. *)
