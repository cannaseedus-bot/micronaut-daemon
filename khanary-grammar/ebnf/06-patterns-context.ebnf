(* KHANARY / CFPC grammar package — proposed syntax contract v0.1. *)
(* EBNF conventions: { X } repetition, [ X ] optional, | alternation. *)
(* Quoted XML tags are literal terminals. Character data is parsed by the XML host. *)
pattern = "<pattern>", text_value, "</pattern>" ;
wildcard = "<wildcard/ >" ;
context = "<context>", { source | query | evidence | gap }, "</context>" ;
source = "<source/ >" ;
query = "<query>", text_value, "</query>" ;
gap = "<gap/ >" ;
(* N-gram keys may form neighborhood field graphs; lookup, resolution and WCR remain distinct. *)
