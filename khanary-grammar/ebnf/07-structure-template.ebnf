(* KHANARY / CFPC grammar package — proposed syntax contract v0.1. *)
(* EBNF conventions: { X } repetition, [ X ] optional, | alternation. *)
(* Quoted XML tags are literal terminals. Character data is parsed by the XML host. *)
structure = "<structure>", { section | field | dependency | policy }, "</structure>" ;
template = "<template>", { field | section | content }, "</template>" ;
section = "<section>", { field | section | content }, "</section>" ;
field = "<field/ >" ;
dependency = "<dependency/ >" ;
(* structure: semantic organization; template: realization; function: callable behavior. *)
(* article.v1 and code.*.v1 are structural profiles, not separate engines. *)
