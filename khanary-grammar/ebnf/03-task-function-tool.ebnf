(* KHANARY / CFPC grammar package — proposed syntax contract v0.1. *)
(* EBNF conventions: { X } repetition, [ X ] optional, | alternation. *)
(* Quoted XML tags are literal terminals. Character data is parsed by the XML host. *)
task = "<task>", { pattern | wildcard | context | function_ref | tool_ref | result }, "</task>" ;
function = "<function>", { governs | capability | binding | invoke | result }, "</function>" ;
function_ref = "<function-ref/ >" ; (* schematic: real XML uses <function ref="..."/> *)
tool = "<tool>", { capability | binding | provider | policy | result }, "</tool>" ;
tool_ref = "<tool-ref/ >" ; (* schematic: real XML uses <tool ref="..."/> *)
invoke = "<invoke/ >" ;
provider = "<provider/ >" ;
governs = "<governs/ >" ;
capability = "<capability/ >" ;
binding = "<binding/ >" ;
(* ThinkExecutor -> FunctionExecutor -> InvocationExecutor -> provider. *)
(* A bare invoke inside think is wrapped in a temporary local FunctionDef. *)
