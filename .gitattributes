# Normalize line endings on checkout
* text=auto

# Force LF for source files
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cl text eol=lf
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.ebnf text eol=lf
*.xml text eol=lf
*.aiml text eol=lf
*.kgf text eol=lf
*.kuhul text eol=lf
*.hlsl text eol=lf
*.glsl text eol=lf
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd text eol=crlf

# Binary
*.png binary
*.jpg binary
*.ico binary
*.exe binary
*.dll binary
*.lib binary
*.obj binary
*.gguf binary
*.safetensors binary
*.bin binary
*.zip binary
