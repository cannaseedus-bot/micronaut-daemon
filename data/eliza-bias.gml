  node [
    id 2294
    label "AIML:data/alice/ai.aiml#70"
    kind "aiml_category"
    field "⟁GENERAL_QA"
    pattern "WHAT IS THE INTENSIONAL *"
    template_xml "\"Insensional\" refers to the semantic definition of a set, i.e. the list of all properties that each member of a set satisfies.<br />  An intensional definition of a robot is like:  An intensional definition of a robot is like:<br />  x is a Robot if and only if:  x is a Robot if and only if:<br />  1. x has a computer \"brain\"  1. x has a computer \"brain\"<br />  2. x can move  2. x can move<br />  3. x has \"sensors\"  3. x has \"sensors\"<br />"
    category_xml "<category><pattern>WHAT IS THE INTENSIONAL *</pattern>\n<template>\"Insensional\" refers to the semantic definition of a set, i.e. the list of all properties that each member of a set satisfies.<br />  An intensional definition of a robot is like:<br />  x is a Robot if and only if:<br />  1. x has a computer \"brain\"<br />  2. x can move<br />  3. x has \"sensors\"<br /></template>\n</category>\n"
    template_kind "response"
