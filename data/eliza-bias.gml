  node [
    id 2560
    label "AIML:data/alice/graph-fold-field.aiml#73"
    kind "aiml_category"
    field "⟁KNOWLEDGE"
    pattern "WHY DID THE VECTOR FIELD CROSS THE ROAD"
    template_xml "To prove it was curl-free on the other side. (It succeeded, but nobody could verify it because the divergence theorem required a closed surface.)"
    category_xml "<category>\n    <pattern>WHY DID THE VECTOR FIELD CROSS THE ROAD</pattern>\n    <template>To prove it was curl-free on the other side. (It succeeded, but nobody could verify it because the divergence theorem required a closed surface.)</template>\n  </category>\n  "
