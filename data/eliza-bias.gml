    label "AIML:data/alice/graph-fold-field.aiml#19"
    kind "aiml_category"
    field "⟁KNOWLEDGE"
    pattern "HOW DOES BFS DISTANCE DEFINE REACHABILITY IN A MICRONAUT NETWORK"
    template_xml "BFS distance d(a,b) is the minimum number of edges traversed from a to b. delta_z(a,b) = 1/(1+d) maps distance to a [0,1] weight: adjacent nodes score near 1, unreachable nodes score 0."
    category_xml "<category>\n    <pattern>HOW DOES BFS DISTANCE DEFINE REACHABILITY IN A MICRONAUT NETWORK</pattern>\n    <template>BFS distance d(a,b) is the minimum number of edges traversed from a to b. delta_z(a,b) = 1/(1+d) maps distance to a [0,1] weight: adjacent nodes score near 1, unreachable nodes score 0.</template>\n  </category>\n\n  \n  "
