  node [
    id 2531
    label "AIML:data/alice/graph-fold-field.aiml#44"
    kind "aiml_category"
    field "⟁KNOWLEDGE"
    pattern "HOW DOES DELTA Z MEASURE TOPOLOGICAL CHANGE IN THE SEMANTIC FOLD SURFACE"
    template_xml "ΔZ = clamp01(W_µ · C_µ) after each scoring cycle. It captures the combined weight-confidence mass of the selected micronaut as a proxy for how much topology changed. High ΔZ means a confident, strongly-connected choice was made; near-zero means marginal selection."
    category_xml "<category>\n    <pattern>HOW DOES DELTA Z MEASURE TOPOLOGICAL CHANGE IN THE SEMANTIC FOLD SURFACE</pattern>\n    <template>ΔZ = clamp01(W_µ · C_µ) after each scoring cycle. It captures the combined weight-confidence mass of the selected micronaut as a proxy for how much topology changed. High ΔZ means a confident, strongly-connected choice was made; near-zero means marginal selection.</template>\n  </category>\n\n  \n  "
    template_kind "response"
    source "data/alice/graph-fold-field.aiml"
