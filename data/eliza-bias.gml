  node [
    id 2528
    label "AIML:data/alice/graph-fold-field.aiml#41"
    kind "aiml_category"
    field "⟁KNOWLEDGE"
    pattern "WHAT IS THE DIFFERENCE BETWEEN A FOLD AND A RELATION"
    template_xml "A fold is a phase-indexed operation on the topology — it changes what the system knows. A relation is a typed edge in G_semantic between two micronauts — it records a structural fact. Folds produce change; relations record it."
    category_xml "<category>\n    <pattern>WHAT IS THE DIFFERENCE BETWEEN A FOLD AND A RELATION</pattern>\n    <template>A fold is a phase-indexed operation on the topology — it changes what the system knows. A relation is a typed edge in G_semantic between two micronauts — it records a structural fact. Folds produce change; relations record it.</template>\n  </category>\n\n  \n  "
    template_kind "response"
    source "data/alice/graph-fold-field.aiml"
