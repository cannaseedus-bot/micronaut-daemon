  node [
    id 2529
    label "AIML:data/alice/graph-fold-field.aiml#42"
    kind "aiml_category"
    field "⟁KNOWLEDGE"
    pattern "HOW DOES A FOLD RELATE TO A PHASE TRANSITION"
    template_xml "Each fold entry in fold_graph.xml specifies a from_phase and to_phase. Executing a fold advances the system through the Pop→Wo→Yax→Sek→Ch'en→Xul cycle. The fold weight modulates how strongly the transition updates ΔZ."
    category_xml "<category>\n    <pattern>HOW DOES A FOLD RELATE TO A PHASE TRANSITION</pattern>\n    <template>Each fold entry in fold_graph.xml specifies a from_phase and to_phase. Executing a fold advances the system through the Pop→Wo→Yax→Sek→Ch'en→Xul cycle. The fold weight modulates how strongly the transition updates ΔZ.</template>\n  </category>\n  "
    template_kind "response"
    source "data/alice/graph-fold-field.aiml"
