  node [
    id 2526
    label "AIML:data/alice/graph-fold-field.aiml#39"
    kind "aiml_category"
    field "⟁KNOWLEDGE"
    pattern "WHAT IS A SEMANTIC FOLD IN KHANARY"
    template_xml "A semantic fold is a topological operation recorded in fold_graph.xml that transitions the system between semantic phases. Each fold carries a source phase, an operation, a target phase, and a weight. Accumulated folds produce the ΔZ context that shapes the next Wo synthesis."
    category_xml "<category>\n    <pattern>WHAT IS A SEMANTIC FOLD IN KHANARY</pattern>\n    <template>A semantic fold is a topological operation recorded in fold_graph.xml that transitions the system between semantic phases. Each fold carries a source phase, an operation, a target phase, and a weight. Accumulated folds produce the ΔZ context that shapes the next Wo synthesis.</template>\n  </category>\n  "
