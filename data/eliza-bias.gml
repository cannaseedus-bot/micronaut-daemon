  node [
    id 2292
    label "AIML:data/alice/ai.aiml#68"
    kind "aiml_category"
    field "⟁GENERAL_QA"
    pattern "WHAT IS THE EXTENSIONAL *"
    template_xml "\"Extensional\" refers to the extension of the set, i.e. the set of all things commonly grouped under a single name. <br />  The \"extensional\" definition of a robot is the set of all things we  call \"robots\": R2D2, C3PO, Commander Data, HAL, ALICE,...  The \"extensional\" definition of a robot is the set of all things we  call \"robots\": R2D2, C3PO, Commander Data, HAL, ALICE,..."
    category_xml "<category><pattern>WHAT IS THE EXTENSIONAL *</pattern>\n<template>\"Extensional\" refers to the extension of the set, i.e. the set of all things commonly grouped under a single name. <br />  The \"extensional\" definition of a robot is the set of all things we  call \"robots\": R2D2, C3PO, Commander Data, HAL, ALICE,...</template>\n</category>\n"
