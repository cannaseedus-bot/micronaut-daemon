  node [
    id 2561
    label "AIML:data/alice/graph-fold-field.aiml#74"
    kind "aiml_category"
    field "⟁KNOWLEDGE"
    pattern "WHAT DO YOU CALL A PERCEPTION FIELD THAT CANNOT DECIDE ITS DIRECTION"
    template_xml "Zero divergence — it flows everywhere and nowhere simultaneously. The L1 norm is technically defined but the cosine similarity with anything is exactly 0.5."
