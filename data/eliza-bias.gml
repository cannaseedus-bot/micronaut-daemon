    label "AIML:data/alice/word-problem.aiml#1"
    kind "aiml_category"
    field "⟁REASONING"
    pattern "IF * GOING * AND * GOING *"
    template_xml "<mx2lm>\n<think><set name=\"wtype\">rate-distance-time</set></think>\nLet me parse that step by step.\nKnowns: object A rate = <star index=\"2\" />, object B rate = <star index=\"4\" />.\nRule: rate × time = distance; meeting when distances sum to initial gap.\nSolving under K'UHUL Yax admission — computing relative rate gap …\n<srai>WORD PROBLEM RATE DISTANCE <star index=\"1\" /> <star index=\"2\" /> <star index=\"3\" /> <star index=\"4\" /></srai>\n</mx2lm>"
    category_xml "<category>\n<pattern>IF * GOING * AND * GOING *</pattern>\n<template>\n<mx2lm>\n<think><set name=\"wtype\">rate-distance-time</set></think>\nLet me parse that step by step.\nKnowns: object A rate = <star index=\"2\" />, object B rate = <star index=\"4\" />.\nRule: rate × time = distance; meeting when distances sum to initial gap.\nSolving under K'UHUL Yax admission — computing relative rate gap …\n<srai>WORD PROBLEM RATE DISTANCE <star index=\"1\" /> <star index=\"2\" /> <star index=\"3\" /> <star index=\"4\" /></srai>\n</mx2lm>\n</template>\n</category>\n\n"
