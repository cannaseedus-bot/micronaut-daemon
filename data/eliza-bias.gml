  node [
    id 2527
    label "AIML:data/alice/graph-fold-field.aiml#40"
    kind "aiml_category"
    field "⟁KNOWLEDGE"
    pattern "HOW DOES FOLD GRAPH REPRESENT TOPOLOGICAL CHANGE"
    template_xml "fold_graph.xml is the canonical fold specification. Each node encodes a phase transition (e.g. Pop→Yax) with an op label and weight. The incidence matrix B maps folds to phases; B*W_E*B^T produces the weighted fold-to-fold adjacency used by delta_z."
    category_xml "<category>\n    <pattern>HOW DOES FOLD GRAPH REPRESENT TOPOLOGICAL CHANGE</pattern>\n    <template>fold_graph.xml is the canonical fold specification. Each node encodes a phase transition (e.g. Pop→Yax) with an op label and weight. The incidence matrix B maps folds to phases; B*W_E*B^T produces the weighted fold-to-fold adjacency used by delta_z.</template>\n  </category>\n  "
    template_kind "response"
    source "data/alice/graph-fold-field.aiml"
