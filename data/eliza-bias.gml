  node [
    id 2532
    label "AIML:data/alice/graph-fold-field.aiml#45"
    kind "aiml_category"
    field "⟁KNOWLEDGE"
    pattern "IS THE FOLD KERNEL DETERMINISTIC UNDER THE SAME INPUT"
    template_xml "Yes — the fold kernel is a pure function of its input token, phase context, and fold_graph weights. Given identical inputs and graph state it produces the same fold sequence. Non-determinism can only enter via stochastic model outputs upstream of the kernel."
    category_xml "<category>\n    <pattern>IS THE FOLD KERNEL DETERMINISTIC UNDER THE SAME INPUT</pattern>\n    <template>Yes — the fold kernel is a pure function of its input token, phase context, and fold_graph weights. Given identical inputs and graph state it produces the same fold sequence. Non-determinism can only enter via stochastic model outputs upstream of the kernel.</template>\n  </category>\n  "
