  "patterns": [
    {
      "id": "eliza.reasoning.why.need.dependency",
      "pattern": "WHY DOES * NEED *",
      "phase": "Pop",
      "reasoning": {
        "operator": "DEPENDENCY",
        "program": "REASON-µ.DEPENDENCY",
        "sraiTemplate": "REASON DEPENDENCY SUBJECT {1} OBJECT {2}",
        "terminalPatternId": "eliza.reasoning.program.dependency",
        "slots": [
          "subject",
          "object"
        ],
        "piRoute": "PI_TRIANGLE"
      },
      "template": [
        {
          "tag": "srai",
          "children": [
            {
              "tag": "text",
              "value": "REASON DEPENDENCY SUBJECT "
            },
            {
              "tag": "star",
              "index": 1
            },
            {
              "tag": "text",
              "value": " OBJECT "
            },
            {
              "tag": "star",
              "index": 2
            }
          ]
        }
      ]
