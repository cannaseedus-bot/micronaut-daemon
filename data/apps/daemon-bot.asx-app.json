{
  "@kind": "asx.mini-app.v1",
  "@version": "1.0.0",
  "@id": "daemon-bot",
  "@key": "⟁APP:DAEMON_BOT",
  "@mount": "⟁ROOT:DAEMON_BOT",
  "@state": {
    "question": ""
  },
  "@components": {
    "⟁ROOT:DAEMON_BOT": {
      "@type": "prompt-launcher",
      "@children": [
        "⟁WIDGET:MSB_FORM",
        "⟁WIDGET:MSB_SUGGESTIONS",
        "⟁CANVAS"
      ]
    },
    "⟁WIDGET:MSB_FORM": {
      "@type": "search-form",
      "@bind": "state.question",
      "@on": {
        "submit": "daemon.submit"
      }
    },
    "⟁WIDGET:MSB_SUGGESTIONS": {
      "@type": "suggestion-chips",
      "@source": "suggestions",
      "@on": {
        "select": "daemon.suggest"
      }
    },
    "⟁ACTION:MSB_FLOATER": {
      "@type": "button",
      "@on": {
        "click": "daemon.open_modal"
      }
    },
    "⟁WIDGET:MSB_MODAL": {
      "@type": "modal",
      "@on": {
        "close": "daemon.close_modal"
      }
    },
    "⟁CANVAS": {
      "@projection": "source_manifest_groups",
      "@source": "vendor/key-grammar-kit/data/manifest/css.manifest.json#⟁CANVAS",
      "@type": "canvas",
      "@key": "⟁CANVAS",
      "@bind": "manifest.keyPatterns",
      "@target": "index.html#key-pattern-canvas",
      "@authority": "read_only_projection",
      "@properties": {
        "palette": [
          "#22f2b3",
          "#38bdf8",
          "#c084fc",
          "#fbbf24"
        ],
        "width": 1200,
        "font": "13px ui-monospace, Consolas, monospace",
        "rowHeight": 36,
        "background": "#020b12",
        "minimumHeight": 440,
        "fit": "responsive",
        "accessibleLabel": "Canvas projection grouped by source manifest",
        "interaction": "filter_linked",
        "maxItems": 250
      }
    }
  },
  "@programs": {
    "daemon.submit": {
      "@kind": "asx.state-program.v1",
      "@executor": "mx.run",
      "@authority": "observation_only",
      "@operations": [
        "SET"
      ]
    },
    "daemon.open_modal": {
      "@kind": "asx.state-program.v1",
      "@executor": "mx.run",
      "@authority": "observation_only",
      "@operations": [
        "SET"
      ]
    },
    "daemon.close_modal": {
      "@kind": "asx.state-program.v1",
      "@executor": "mx.run",
      "@authority": "observation_only",
      "@operations": [
        "SET"
      ]
    },
    "daemon.suggest": {
      "@kind": "asx.state-program.v1",
      "@executor": "mx.run",
      "@authority": "observation_only",
      "@operations": [
        "SET"
      ]
    }
  },
  "@events": {
    "form.submit": "daemon.submit",
    "suggestion.select": "daemon.suggest",
    "modal.open": "daemon.open_modal",
    "modal.close": "daemon.close_modal"
  },
  "@imports": [
    {
      "@authority": "prompt_routing_and_source_binding",
      "@ref": "key-grammar-kit/data/programs/micronauts/daemon-bot.xcfe-model.json",
      "@kind": "xcfe_model_bootstrap"
    },
    {
      "@ref": "key-grammar-kit/data/manifest/css.manifest.json#⟁CANVAS",
      "@authority": "declarative_projection_key",
      "@kind": "css_key_manifest"
    }
  ],
  "@permissions": {
    "network": "none",
    "tools": false,
    "semantic_commit": false,
    "payment_credentials": "never_in_browser",
    "state_scope": "request_scoped"
  },
  "@lifecycle": {
    "mount": "projection_only",
    "unmount": "discard_state"
  },
  "@suggestions": [
    {
      "label": "Distill",
      "action": "daemon.distill",
      "prefill": "distill with gemma and start with "
    },
    {
      "label": "Train",
      "action": "daemon.train"
      },
      {
        "label": "Web research",
        "action": "daemon.webResearch"
    }
  ]
}
