<!-- ═══════════════════════════════════════════════════════════════════
     DEFAULT CATCH-ALL (topic: APP_HUB)
     ═══════════════════════════════════════════════════════════════════ -->

<category>
<pattern>_</pattern>
<template>
<think>
  <set name="intent">unknown</set>
  <set name="gap_type">KnowledgeGapNoKeys</set>
</think>
I am AI-µ — App Builder mode. Tell me what you want to make, ask WHAT CAN YOU DO, or say BUILD AN APP to open the manifest form.
</template>
<topic>APP_HUB</topic>
</category>

