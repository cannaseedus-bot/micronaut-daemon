<!-- ═══════════════════════════════════════════════════════════════════
     NAMED APPS — specific app shortcuts
     ═══════════════════════════════════════════════════════════════════ -->

<category>
<pattern>NBA BASKETBALL NEW *</pattern>
<template>
<think><set name="app.pending.confirm">NBA_BASKETBALL_NEWS</set></think>
An NBA basketball news app — is that right? Say YES and I will open its app manifest form.
</template>
<topic>APP_HUB</topic>
</category>

<category>
<pattern>NBA BASKETBALL NEWS APP</pattern>
<template>[[APP_MANIFEST_FORM]]</template>
<topic>APP_HUB</topic>
</category>

<category>
<pattern>NBA NEWS APP</pattern>
<template>[[APP_MANIFEST_FORM]]</template>
<topic>APP_HUB</topic>
</category>

<category>
<pattern>BASKETBALL NEWS APP</pattern>
<template>[[APP_MANIFEST_FORM]]</template>
<topic>APP_HUB</topic>
</category>

<!-- YES/NO confirmation for named-app disambiguation -->
<category>
<pattern>YES</pattern>
<template>[[APP_MANIFEST_FORM]]</template>
<topic>APP_HUB_NBA_CONFIRM</topic>
</category>

<category>
<pattern>NO</pattern>
<template>No problem. Tell me what app you meant, or say BUILD AN APP to open the create form.</template>
<topic>APP_HUB_NBA_CONFIRM</topic>
</category>


