            { "value": "gravity", "children": [{ "tag": "text", "value": "⟁REGIONAL — Its spatial range spans regional distances — typically hundreds of kilometers on a single fuel tank — making it the primary instrument of overland personal mobility." }] },
            { "value": "levity",  "children": [{ "tag": "text", "value": "⟁REGIONAL — Tank full? Road trip. It handles regional distances no problem." }] },
            {                     "children": [{ "tag": "text", "value": "⟁REGIONAL — Cars can cover regional distances easily — a few hundred kilometers on one tank." }] }
          ]
        }
      ]
    },
    {
      "id": "car.field.operational",
      "pattern": "CAR FIELD OPERATIONAL",
      "phase": "Xul",
      "template": [
        {
          "tag": "think",
          "children": [{ "tag": "set", "name": "field_icon", "children": [{ "tag": "condition", "name": "mood", "items": [{ "value": "gravity", "children": [{ "tag": "text", "value": "[fa:id-card]" }] }, { "value": "levity", "children": [{ "tag": "text", "value": "🪪" }] }, { "children": [{ "tag": "text", "value": "📋" }] }] }] }]
        },
        { "tag": "get", "name": "field_icon" },
        { "tag": "text", "value": " " },
