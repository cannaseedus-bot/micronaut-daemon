{
  "@kind": "semantic.think.v1",
  "@id": "joke_delivery_trace",
  "@owner": "JOKE-µ",
  "@mode": "delivery_trace",
  "@subject": "joke_frame",
  "@context": "cfpc.field",
  "@functions": [
    {
      "@kind": "semantic.function.v1",
      "@id": "identify_frame",
      "@owner": "JOKE-µ",
      "@governs": ["joke", "intent:joke", "frame:joke_setup", "wind-up", "pitch"],
      "@capabilities": ["pattern_discovery"],
      "@bindings": {
        "setup": {"type": "text", "required": true, "wildcard": "{setup}"}
      },
      "@backend": {
        "type": "micronaut",
        "capability": "pattern_discovery"
      },
      "@policy": {
        "max_depth": 2,
        "cycle_detection": true,
        "allow_dynamic_resolution": false
      },
      "@result": {
        "retain_provenance": true,
        "retain_gaps": true,
        "allow_pattern_candidates": false
      }
    },
    {
      "@kind": "semantic.function.v1",
      "@id": "resolve_collapse",
      "@owner": "JOKE-µ",
      "@governs": ["frame:collapse", "frame:subverted", "joke:pun_bridge", "joke:answer_surface", "swing"],
      "@capabilities": ["pattern_discovery"],
      "@bindings": {
        "punchline": {"type": "text", "required": false, "wildcard": "{punchline}"}
      },
      "@backend": {
        "type": "micronaut",
        "capability": "pattern_discovery"
      },
      "@policy": {
        "max_depth": 2,
        "cycle_detection": true,
        "allow_dynamic_resolution": false
      },
      "@result": {
        "retain_provenance": false,
        "retain_gaps": false,
        "allow_pattern_candidates": false
      }
    }
  ],
  "@policy": {
    "max_depth": 3,
    "max_operations": 6,
    "cycle_detection": true
  }
}
