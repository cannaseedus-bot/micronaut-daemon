(* K'UHUL Intent / Field / Wildcard Question Graph.
   Proposal-only topology; graph membership is not execution authority.

   Typed edge contract, validated by micronaut/intent_graph.py:
     field_member          container -> semantic_key
     unfolds_to_bigram     container -> bigram_candidate
     bigram_target         semantic_key -> bigram_candidate
     instantiates_question bigram_candidate -> wildcard_pattern

   A container is a node with kind "semantic_field". A key that also owns its own
   bigram unfoldings keeps kind "semantic_key" and declares `also_field 1`, so it
   stays a member and a bigram endpoint while it can also be traversed as a field.
   ⟁GASOLINE and ⟁ELECTRIC are members of ⟁CAR and fields in their own right. *)
graph [
  directed 1
  label "K'UHUL Intent / Field / Wildcard Question Graph"
  schema "kgf.intent-graph/1"
  authority "data_only"
  admission "xcfe_required"
  cycle_policy "active_path_detection"
  max_depth 4

  node [ id 1 label "⟁CAR" kind "semantic_field" phase "Wo" authority "data_only" ]
  node [ id 2 label "⟁CARRIAGE" kind "semantic_key" authority "data_only" ]
  node [ id 3 label "⟁AUTOMOBILE" kind "semantic_key" authority "data_only" ]
  node [ id 4 label "⟁GASOLINE" kind "semantic_key" also_field 1 authority "data_only" ]
  node [ id 5 label "⟁ELECTRIC" kind "semantic_key" also_field 1 authority "data_only" ]
  node [ id 6 label "⟁COMBUSTION" kind "semantic_field" phase "Wo" authority "data_only" ]
  node [ id 7 label "⟁ROCKET" kind "semantic_key" authority "data_only" ]
  node [ id 8 label "⟁GUNPOWDER" kind "semantic_key" authority "data_only" ]
  node [ id 9 label "⟁ENGINE" kind "semantic_key" authority "data_only" ]
