  node [ id 33 label "phase:XUL_CLOSE" kind "closure_gate" phase "Xul" authority "host_gated" ]
  node [ id 34 label "output:RELATION_CANDIDATE" kind "proposal" phase "Yax" authority "proposal_only" ]
  node [ id 35 label "output:QUESTION_CANDIDATE" kind "proposal" phase "Yax" authority "proposal_only" ]
  node [ id 36 label "output:VERIFIED_RELATION" kind "verified_result" phase "Ch'en" authority "host_gated" ]
  node [ id 37 label "store:GRAMSTORE" kind "persistence_target" phase "Xul" authority "host_gated" ]
  node [ id 54 label "example:how to grow tomatoes" kind "ngram_example" phase "Yax" authority "example_only" ]
  node [ id 55 label "example:how to grow peppers" kind "ngram_example" phase "Yax" authority "example_only" ]
  node [ id 56 label "⟁KUHUL" kind "semantic_field" phase "Pop" authority "data_only" definition_ref "../../../kuhul-field.json#⟁KUHUL" ]
