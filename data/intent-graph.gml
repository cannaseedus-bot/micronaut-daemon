  node [ id 11 label "⟁ECONOMY" kind "semantic_key" authority "data_only" ]
  node [ id 12 label "⟁VOLTAGE" kind "semantic_key" authority "data_only" ]
  node [ id 13 label "⟁BATTERY" kind "semantic_key" authority "data_only" ]
  node [ id 14 label "⟁UTILITY" kind "semantic_key" authority "data_only" ]
  node [ id 15 label "intent:RELATIONSHIP_QUERY" kind "intent" phase "Pop" authority "host_gated" ]
  node [ id 16 label "cfpc:INTENT_GAP" kind "cfpc_gap" phase "Wo" authority "host_gated" ]
  node [ id 17 label "cfpc:QUERY_GAP" kind "cfpc_gap" phase "Wo" authority "host_gated" ]
  node [ id 18 label "cfpc:KNOWLEDGE_GAP" kind "cfpc_gap" phase "Wo" authority "host_gated" ]
  node [ id 19 label "pattern:HOW_IS_*_RELATED_TO_*" kind "wildcard_pattern" phase "Yax" authority "proposal_only" ]
  node [ id 20 label "pattern:HOW_TO_*" kind "wildcard_pattern" phase "Yax" authority "proposal_only" ]
  node [ id 21 label "gram:RELATED_YAX" kind "trigram_pattern" phase "Yax" authority "proposal_only" ]
  node [ id 22 label "gram:AFFECT_YAX" kind "trigram_pattern" phase "Yax" authority "proposal_only" ]
  node [ id 23 label "gram:DIFFERENCE_SEK" kind "trigram_pattern" phase "Sek" authority "proposal_only" ]
  node [ id 24 label "fold:RELATED" kind "fold" phase "Yax" authority "host_gated" ]
  node [ id 25 label "fold:AFFECT" kind "fold" phase "Yax" authority "host_gated" ]
  node [ id 26 label "fold:DIFFERENCE" kind "fold" phase "Sek" authority "host_gated" ]
  node [ id 27 label "micro:WILDCARD_ENTITY" kind "micronaut" phase "Yax" authority "host_gated" ]
  node [ id 28 label "micro:RELATIONSHIP" kind "micronaut" phase "Yax" authority "host_gated" ]
  node [ id 29 label "track:WILDCARD_RELATIONS" kind "track" phase "Wo" authority "host_gated" ]
  node [ id 30 label "xcfe:BINDING_ADMISSION" kind "execution_gate" phase "Sek" authority "host_gated" ]
  node [ id 31 label "xcfe:WILDCARD_POLICY" kind "policy" phase "Sek" authority "host_gated" ]
