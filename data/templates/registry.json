{
  "schema": "khanary.template-registry.v1",
  "description": "ASX design kit registry. source_type:html kits are filled by CSS-var injection + title swap. source_type:vite kits are multi-file scaffolds.",
  "house_tokens": {
    "brand_accent":    "#16f2aa",
    "brand_secondary": "#38bdf8",
    "brand_bg":        "#020617",
    "brand_surface":   "#0f172a",
    "brand_text":      "#e2e8f0"
  },
  "slot_definitions": {
    "app_name":       { "type": "app_name",    "phase": "Pop",   "edge_kind": "@provides",   "unit": "identity_token",   "css_vars": [],                                                                      "description": "Application display name — sets <title> and first h1/h2" },
    "brand_accent":   { "type": "css_color",   "phase": "Xul",   "edge_kind": "@configures", "unit": "brand_token",      "css_vars": ["--accent","--asx-primary","--atomic-border","--kuhul-color"],          "description": "Primary accent color (hex)" },
    "brand_secondary":{ "type": "css_color",   "phase": "Xul",   "edge_kind": "@configures", "unit": "brand_token",      "css_vars": ["--asx-secondary","--accent-blue"],                                     "description": "Secondary accent color (hex)" },
    "brand_bg":       { "type": "css_color",   "phase": "Xul",   "edge_kind": "@configures", "unit": "brand_token",      "css_vars": ["--bg","--bg-primary","--asx-bg","--dark-pool"],                        "description": "Page background color (hex)" },
    "brand_surface":  { "type": "css_color",   "phase": "Xul",   "edge_kind": "@configures", "unit": "brand_token",      "css_vars": ["--asx-surface"],                                                        "description": "Card / panel surface color (hex)" },
    "brand_text":     { "type": "css_color",   "phase": "Xul",   "edge_kind": "@configures", "unit": "brand_token",      "css_vars": ["--asx-color"],                                                          "description": "Body text color (hex)" },
    "logo_url":       { "type": "url",         "phase": "Pop",   "edge_kind": "@provides",   "unit": "identity_token",   "css_vars": [],                                                                      "description": "Logo image URL injected at top-left" },
    "description":    { "type": "string",      "phase": "Yax",   "edge_kind": "@provides",   "unit": "content_token",    "css_vars": [],                                                                      "description": "Short app description for meta/README" },
    "rpc_port":       { "type": "port",        "phase": "Sek",   "edge_kind": "@configures", "unit": "connection_token", "css_vars": [],                                                                      "description": "KHANARY JSON-RPC port (default 8787)" },
    "features":       { "type": "feature_list","phase": "Yax",   "edge_kind": "@configures", "unit": "feature_token",    "css_vars": [],                                                                      "description": "Extra feature labels driving scaffold content" },
    "template":       { "type": "template_ref","phase": "Yax",   "edge_kind": "@requires",   "unit": "content_token",    "css_vars": [],                                                                      "description": "Kit id to switch to (template switcher value)" }
  },
  "kits": [
