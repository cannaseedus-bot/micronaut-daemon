{
  "@kind": "semantic.declarative-realization-templates.v1",
  "@no-eval": true,
  "@version": "1.0.0",
  "mood": "declarative",

  "authority_boundary": {
    "semantic_authority": false,
    "commit_authorized": false,
    "mutation": "none",
    "emits": "statement",
    "note": "A declarative template renders one existing relation edge as one sentence. It creates no edge, proves nothing, and commits nothing."
  },

  "contract": "data/grammar/document.contracts.json",

  "templates": [
    {
      "id": "stmt.is_a",
      "realizes_relation": "@is_a",
      "patterns": ["*:entity is a *:entity"],
      "captures": [
        { "index": 1, "name": "subject", "type": "entity", "on_unresolved": "defer", "on_resolved": "bind" },
        { "index": 2, "name": "object", "type": "entity", "on_unresolved": "defer", "on_resolved": "bind" }
      ],
      "render": "{subject} is a {object}.",
      "phases": ["Wo", "Yax", "Sek"],
      "phase_floor": "Wo",
      "admission": { "mode": "rank_if_verified", "capabilities": ["render.statement"], "min_score": 0.25 },
      "emits": "statement"
    },
