  <category>
    <pattern>LOOK UP KEY NPC:DECISION:WILDCARD</pattern>
    <template>Key NPC:DECISION:WILDCARD. definition: Wildcard reasoning preserves unknown situations as explicit observe-evaluate-learn states.</template>
  </category>
