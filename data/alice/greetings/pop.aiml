<!-- ═══════════════════════════════════════════════════════════════════
     PART II — CODE_REQUEST (pos_hint_trigger: code_token)
     code_signal detected → route to Wo-phase for CODE-µ escalation.
     ═══════════════════════════════════════════════════════════════════ -->

<!-- Intent templates from greeting.micronaut.json -->
<category>
<pattern>CAN YOU WRITE * IN *</pattern>
<template>
<mx2lm>
<think>
  <set name="intent">CODE_REQUEST</set>
  <set name="gap_type">IntentGap</set>
  <set name="code_target"><star/></set>
  <set name="code_lang"><star index="2"/></set>
</think>
intent=CODE_REQUEST target=<star/> lang=<star index="2"/>.
<srai>GREETING WO CODE_REQUEST CAN YOU WRITE <star/> IN <star index="2"/></srai>
</mx2lm>
</template>
</category>

<category>
<pattern>FIX THIS * CODE</pattern>
<template>
<mx2lm>
<think>
  <set name="intent">CODE_REQUEST</set>
  <set name="gap_type">IntentGap</set>
  <set name="code_target"><star/></set>
</think>
intent=CODE_REQUEST fix_target=<star/>.
<srai>GREETING WO CODE_REQUEST FIX <star/></srai>
</mx2lm>
</template>
</category>

<category>
<pattern>WHAT IS WRONG WITH THIS *</pattern>
<template>
<mx2lm>
<think>
  <set name="intent">CODE_REQUEST</set>
  <set name="gap_type">IntentGap</set>
  <set name="code_target"><star/></set>
</think>
intent=CODE_REQUEST debug_target=<star/>.
<srai>GREETING WO CODE_REQUEST DEBUG <star/></srai>
</mx2lm>
</template>
</category>

<!-- Keyword-driven code signal patterns -->
<category>
<pattern>_ FUNCTION *</pattern>
<template>
<mx2lm>
<think><set name="intent">CODE_REQUEST</set><set name="gap_type">IntentGap</set></think>
intent=CODE_REQUEST code_signal=function.
<srai>GREETING WO CODE_REQUEST <star/> FUNCTION <star index="2"/></srai>
</mx2lm>
</template>
</category>

<category>
<pattern>_ CLASS *</pattern>
<template>
<mx2lm>
<think><set name="intent">CODE_REQUEST</set><set name="gap_type">IntentGap</set></think>
intent=CODE_REQUEST code_signal=class.
<srai>GREETING WO CODE_REQUEST <star/> CLASS <star index="2"/></srai>
</mx2lm>
</template>
</category>

<category>
<pattern>DEBUG *</pattern>
<template>
<mx2lm>
<think><set name="intent">CODE_REQUEST</set><set name="gap_type">IntentGap</set></think>
intent=CODE_REQUEST code_signal=debug target=<star/>.
<srai>GREETING WO CODE_REQUEST DEBUG <star/></srai>
</mx2lm>
</template>
</category>

<category>
<pattern>REFACTOR *</pattern>
<template>
<mx2lm>
<think><set name="intent">CODE_REQUEST</set><set name="gap_type">IntentGap</set></think>
intent=CODE_REQUEST code_signal=refactor target=<star/>.
<srai>GREETING WO CODE_REQUEST REFACTOR <star/></srai>
</mx2lm>
</template>
</category>

<category>
<pattern>IMPLEMENT *</pattern>
<template>
<mx2lm>
<think><set name="intent">CODE_REQUEST</set><set name="gap_type">IntentGap</set></think>
intent=CODE_REQUEST code_signal=implement target=<star/>.
<srai>GREETING WO CODE_REQUEST IMPLEMENT <star/></srai>
</mx2lm>
</template>
</category>


