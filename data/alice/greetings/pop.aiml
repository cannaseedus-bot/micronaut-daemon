<?xml version="1.0" encoding="UTF-8"?>
<aiml version="1.0">

<!-- Pop phase bank: greeting intake and intent formation for GREETING-µ.
     K'UHUL Pop ops: greeting.decompose, greeting.bank, greeting.intent.
     Responsibility split:
       - GREETING_ONLY intents resolve here via greeting.bank (no escalation).
       - All other intents emit <srai> to Wo-phase for deeper intent traversal.
     Authority: data_only at Pop; routing proposals require XCFE Ch'en admission.
     Pattern.Log.dll: appends decompose entry on every match. -->


<!-- ═══════════════════════════════════════════════════════════════════
     PART I — GREETING_ONLY
     Canonical surface forms → greeting.bank (gap_type = Resolved;
     routing.primary_target = ELIZA-µ; no escalation).
     ═══════════════════════════════════════════════════════════════════ -->

<category>
<pattern>HI</pattern>
<template>
<mx2lm>
<think>
  <set name="intent">GREETING_ONLY</set>
  <set name="gap_type">Resolved</set>
  <set name="greeting"><input/></set>
</think>
<srai>GREETING POP HI</srai>
</mx2lm>
</template>
</category>

<category>
<pattern>HELLO</pattern>
<template>
<mx2lm>
<think>
  <set name="intent">GREETING_ONLY</set>
  <set name="gap_type">Resolved</set>
  <set name="greeting"><input/></set>
</think>
<srai>GREETING POP HELLO</srai>
</mx2lm>
</template>
</category>

