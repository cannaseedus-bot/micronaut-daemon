<!-- ═══════════════════════════════════════════════════════════════════
     PART VII — RELATIONSHIP_QUERY
     → REASON-µ → ELIZA-µ escalation via Wo.
     ═══════════════════════════════════════════════════════════════════ -->

<category>
<pattern>HOW IS * RELATED TO *</pattern>
<template>
<mx2lm>
<think>
  <set name="intent">RELATIONSHIP_QUERY</set>
  <set name="gap_type">QueryGap</set>
</think>
intent=RELATIONSHIP_QUERY a=<star/> b=<star index="2"/>.
<srai>GREETING WO RELATIONSHIP_QUERY <star/> AND <star index="2"/></srai>
</mx2lm>
</template>
</category>

<category>
<pattern>WHAT IS THE CONNECTION BETWEEN * AND *</pattern>
<template>
<mx2lm>
<think>
  <set name="intent">RELATIONSHIP_QUERY</set>
  <set name="gap_type">QueryGap</set>
</think>
intent=RELATIONSHIP_QUERY a=<star/> b=<star index="2"/>.
<srai>GREETING WO RELATIONSHIP_QUERY <star/> AND <star index="2"/></srai>
</mx2lm>
</template>
</category>


<!-- ═══════════════════════════════════════════════════════════════════
     PART VIII — DIAGNOSTICS
     greeting.health — Pop-phase status report; data_only.
     ═══════════════════════════════════════════════════════════════════ -->

<category>
<pattern>GREETING HEALTH</pattern>
<template>
<mx2lm>
greeting.health — Pop-phase diagnostics.
intent_graph: data/intent-graph.gml.
greeting_bank: data/greeting-bank.json (8 phases: Pop Wo Yax Sek Ch'en Xul reactive_mirror synthesized).
gyro_abi: data/gyro_abi_v1.json.
pattern_log: Pattern.Log.dll (append-only).
word_key_field_schema: data/schema/kuhul.word-key-field.v1.json.
cfpc_track: data/tracks/CFPC-u.semantic-tracks.v1.json.
authority: data_only.
</mx2lm>
</template>
</category>

<category>
<pattern>GREETING HEALTH *</pattern>
<template>
<mx2lm>
greeting.health subsystem=<star/>.
<srai>GREETING HEALTH</srai>
</mx2lm>
</template>
</category>

<!-- ═══════════════════════════════════════════════════════════════════
     PART IX — DEFAULT INTAKE
     Catch-all: run greeting.decompose on the raw input, emit
     WordKeyField, let Wo-phase intent traversal continue.
     gap_type = KnowledgeGapNoKeys until Wo resolves it.
     ═══════════════════════════════════════════════════════════════════ -->

<category>
<pattern>_</pattern>
<template>
<mx2lm>
<think>
  <set name="intent">unknown</set>
  <set name="gap_type">KnowledgeGapNoKeys</set>
</think>
greeting.decompose input=<input/>.
Tokenize and produce kuhul.word-key-field.v1.
<srai>GREETING WO <input/></srai>
</mx2lm>
</template>
</category>

</aiml>
