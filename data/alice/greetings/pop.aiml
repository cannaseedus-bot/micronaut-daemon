<!-- Greeting + name or cue: mirror-and-absorb lingo path -->
<category>
<pattern>HI *</pattern>
<template>
<mx2lm>
<think>
  <set name="intent">GREETING_ONLY</set>
  <set name="gap_type">Resolved</set>
  <set name="greeting">HI</set>
  <set name="cue"><star/></set>
</think>
<srai>GREETING POP REACTIVE_MIRROR <star/></srai>
</mx2lm>
</template>
</category>

<category>
<pattern>HEY *</pattern>
