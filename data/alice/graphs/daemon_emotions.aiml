  <!--Graph lookup export from daemon_emotions.gml. Metadata is not execution authority.-->
  <category>
    <pattern>DESCRIBE GRAPH DAEMONEMOTIONPRESENTATIONCANDIDATES</pattern>
    <template>source daemon_emotions.gml; label DaemonEmotionPresentationCandidates; identity kuhul.daemon-emotions.v1; authority data_only; semantic_authority 0; purpose emotion cues suggest presentation modes; no diagnosis or admission; directed 1; nodes 16; edges 10. Data-only graph export.</template>
