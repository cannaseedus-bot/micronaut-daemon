<?xml version='1.0' encoding='UTF-8'?>
<aiml version="1.0">
  <!--Graph lookup export from wildcard.gml. Metadata is not execution authority.-->
  <category>
    <pattern>DESCRIBE GRAPH WILDCARDPATTERNGRAPH</pattern>
    <template>source wildcard.gml; label WildcardPatternGraph; identity 1701; directed 1; nodes 4; edges 3. Data-only graph export.</template>
  </category>
  <category>
    <pattern>GRAPH WILDCARDPATTERNGRAPH NODE 1</pattern>
    <template>Graph WildcardPatternGraph; node 1; arity: variable; id: 1; kind: wildcard_pattern; label: HOW TO *; order: 3. Data-only graph record.</template>
  </category>
