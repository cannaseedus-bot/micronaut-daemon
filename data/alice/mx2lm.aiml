    <template><mx2lm>tool_key rpc_cycle_identity surface rpc method cycle_identity key_value k_rpc_cycle_identity</mx2lm></template>
  </category>
  <category>
    <pattern>TOOL KEY RPC FOLD GRAPH PARSE</pattern>
    <template><mx2lm>tool_key rpc_fold_graph_parse surface rpc method fold_graph_parse key_value k_rpc_fold_graph_parse</mx2lm></template>
  </category>
  <category>
    <pattern>TOOL KEY RPC KEY ENCODE</pattern>
    <template><mx2lm>tool_key rpc_key_encode surface rpc method key_encode key_value k_rpc_key_encode</mx2lm></template>
  </category>
  <category>
    <pattern>TOOL KEY RPC KEY DECODE</pattern>
    <template><mx2lm>tool_key rpc_key_decode surface rpc method key_decode key_value k_rpc_key_decode</mx2lm></template>
