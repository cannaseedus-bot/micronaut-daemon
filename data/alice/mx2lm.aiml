<aiml version="1.0.1">
  <category>
    <pattern>MX2LM *</pattern>
    <template><mx2lm><star/></mx2lm></template>
  </category>
  <category>
    <pattern>@MX2LM *</pattern>
    <template><mx2lm><star/></mx2lm></template>
  </category>
  <category>
    <pattern>MX2LM NGRAMS *</pattern>
    <template><mx2lm><star/></mx2lm></template>
  </category>
  <category>
    <pattern>SYNONYMIZE *</pattern>
    <template><mx2lm>synonymize: <star/></mx2lm></template>
  </category>
  <category>
    <pattern>SYNONYM *</pattern>
    <template><mx2lm>synonym: <star/></mx2lm></template>
  </category>
  <category>
    <pattern>@SYN *</pattern>
    <template><mx2lm>@syn <star/></mx2lm></template>
  </category>
  <category>
    <pattern>WORD SIMILARITY *</pattern>
    <template><mx2lm>synonym: <star/></mx2lm></template>
  </category>
  <category>
    <pattern>REWRITE WITH SYNONYMS *</pattern>
    <template><mx2lm>synonymize: <star/></mx2lm></template>
  </category>
  <category>
    <pattern>LEXICON *</pattern>
    <template><mx2lm>lexicon dictionary lemma definition similarity <star/></mx2lm></template>
  </category>
  <category>
    <pattern>LEX *</pattern>
    <template><mx2lm>lexicon dictionary lemma definition similarity <star/></mx2lm></template>
  </category>
  <category>
    <pattern>LEMMA *</pattern>
    <template><mx2lm>lexicon lemma canonical definition <star/></mx2lm></template>
  </category>
  <category>
    <pattern>UNIGRAM *</pattern>
    <template><mx2lm>lexicon unigram word entry <star/></mx2lm></template>
  </category>
  <category>
    <pattern>GRAPH *</pattern>
    <template><mx2lm>graph cognition <star/></mx2lm></template>
  </category>
  <category>
    <pattern>BRAIN GRAPH *</pattern>
    <template><mx2lm>brain graph thinking patterns <star/></mx2lm></template>
  </category>
  <category>
    <pattern>INCIDENCE MATRIX *</pattern>
    <template><mx2lm>incidence matrix participation topology <star/></mx2lm></template>
  </category>
  <category>
    <pattern>HYPERCUBE GRAPH *</pattern>
    <template><mx2lm>hypercube graph cognition folding dimensions <star/></mx2lm></template>
  </category>
  <category>
    <pattern>DISTRIBUTIONAL SEMANTICS *</pattern>
    <template><mx2lm>distributional semantics context similarity <star/></mx2lm></template>
  </category>
  <category>
    <pattern>SEMANTIC FOLDING *</pattern>
    <template><mx2lm>semantic folding sparse distributed representation book unfold <star/></mx2lm></template>
  </category>
  <category>
    <pattern>SEMANTIC FINGERPRINT *</pattern>
    <template><mx2lm>semantic fingerprint context overlap hamming jaccard cosine <star/></mx2lm></template>
  </category>
  <category>
    <pattern>FGP *</pattern>
    <template><mx2lm>fold graph parse atoms relations books candidates provenance <star/></mx2lm></template>
  </category>
  <category>
    <pattern>@FGP *</pattern>
    <template><mx2lm>fold graph parse atoms relations books candidates provenance <star/></mx2lm></template>
  </category>
  <category>
    <pattern>FOLD GRAPH PARSE *</pattern>
    <template><mx2lm>fold graph parse atoms relations books candidates provenance <star/></mx2lm></template>
  </category>
  <category>
    <pattern>PARSE FOLD GRAPH *</pattern>
    <template><mx2lm>fold graph parse atoms relations books candidates provenance <star/></mx2lm></template>
  </category>

  <!-- Tool key/value map for AIML-side tool reasoning -->
  <category>
    <pattern>TOOL KEYS</pattern>
    <template><mx2lm>tool keys rpc_key_query rpc_resolve_manifest rpc_fold_query rpc_micronaut_dispatch rpc_list_keys rpc_record_key rpc_infer rpc_cycle_identity rpc_fold_graph_parse rpc_key_encode rpc_key_decode rpc_keyspace_status mcp_kuhul_forge mcp_manifest_resolve mcp_fold_execute mcp_micronaut_run mcp_grammar_check mcp_phase_query mcp_gram_read mcp_gram_write mcp_confidence_get mcp_jrom_replay mcp_sandbox_query mcp_sandbox_list mcp_sandbox_violations mcp_world_state mcp_field_dag mcp_field_dag_svg mcp_relational_graph mcp_incidence_matrix mcp_semantic_fold mcp_code_parse</mx2lm></template>
  </category>

  <!-- RPC keys -->
  <category>
    <pattern>TOOL KEY RPC KEY QUERY</pattern>
    <template><mx2lm>tool_key rpc_key_query surface rpc method key_query key_value k_rpc_key_query</mx2lm></template>
  </category>
  <category>
    <pattern>TOOL KEY RPC RESOLVE MANIFEST</pattern>
    <template><mx2lm>tool_key rpc_resolve_manifest surface rpc method resolve_manifest key_value k_rpc_resolve_manifest</mx2lm></template>
  </category>
  <category>
    <pattern>TOOL KEY RPC FOLD QUERY</pattern>
    <template><mx2lm>tool_key rpc_fold_query surface rpc method fold_query key_value k_rpc_fold_query</mx2lm></template>
  </category>
  <category>
    <pattern>TOOL KEY RPC MICRONAUT DISPATCH</pattern>
    <template><mx2lm>tool_key rpc_micronaut_dispatch surface rpc method micronaut_dispatch key_value k_rpc_micronaut_dispatch</mx2lm></template>
  </category>
  <category>
    <pattern>TOOL KEY RPC LIST KEYS</pattern>
    <template><mx2lm>tool_key rpc_list_keys surface rpc method list_keys key_value k_rpc_list_keys</mx2lm></template>
  </category>
