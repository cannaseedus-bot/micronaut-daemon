<?xml version="1.0" encoding="UTF-8"?>
<aiml version="1.0.1"
      xmlns="http://alicebot.org/2001/AIML-1.0.1"
      xmlns:aiml="http://alicebot.org/2001/AIML-1.0.1">
<!-- Generated by tools/gemma-distill.py — K'UHUL daemon discussion patterns -->

  <category>
    <pattern>I CAN LOOK THAT UP</pattern>
    <template>I can look that up in the K'UHUL fold system.</template>
  </category>

  <category>
    <pattern>KUHUL</pattern>
    <template>I can look that up in the K'UHUL fold.</template>
  </category>

  <category>
    <pattern>SEK</pattern>
    <template>I can look that up.</template>
  </category>

  <category>
    <pattern>BOOK</pattern>
    <template>I can look that up for you.</template>
  </category>

  <category>
    <pattern>I CAN CHECK THE DETAILS</pattern>
    <template>I can check the details to verify accuracy.</template>
  </category>

  <category>
    <pattern>I CAN CONFIRM THE FACTS</pattern>
    <template>I can confirm the facts to verify reliability.</template>
  </category>

  <!-- ═══════════════════════════════════════════════════════════════════════
       SRAI Operator Dispatch Surface
       Each top-level pattern redirects via <srai> to the XCFE-prefixed handler.
       The XCFE handler template is a typed dispatch frame; the C++ aiml_engine
       intercepts "XCFE <OP> *" patterns and routes to xcfe_executor.cpp.
       TRAIN is guarded: it must not run without a verified outcome reference.
       ═══════════════════════════════════════════════════════════════════════ -->

  <!-- SCORE ── evaluate WCR + vector + metric evidence for a candidate set -->
  <category>
    <pattern>SCORE *</pattern>
    <template><srai>XCFE SCORE <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE SCORE *</pattern>
    <template>[XCFE:SCORE operator="SCORE" executor="metric" phase="Sek" input_roles="candidate_set,query_vector,context" output_role="scored_candidates" effects="read,measure"] <star/></template>
  </category>

  <!-- RANK ── order admitted scored_candidates -->
  <category>
    <pattern>RANK *</pattern>
    <template><srai>XCFE RANK <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE RANK *</pattern>
    <template>[XCFE:RANK operator="RANK" executor="metric" phase="Sek" input_roles="scored_candidates,context" output_role="ranked_candidates" effects="read,order"] <star/></template>
  </category>

  <!-- TRAIN ── apply verified learning feedback; blocked without verified_outcome -->
  <category>
    <pattern>TRAIN *</pattern>
    <template><srai>XCFE TRAIN GUARD <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE TRAIN GUARD *</pattern>
    <template><srai>XCFE TRAIN <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE TRAIN *</pattern>
    <template>[XCFE:TRAIN operator="TRAIN" executor="learning" phase="Xul" requires="verified_outcome" input_roles="ranked_candidates,verified_feedback" output_role="weight_delta" effects="propose_delta" commit_requires="Ch_en_verification,Xul_authorization" W_target="W_learned" W_invariant="W_effective=W_corpus*W_learned"] <star/></template>
  </category>
  <!-- TRAIN without verified outcome is blocked -->
  <category>
    <pattern>TRAIN WITHOUT VERIFICATION</pattern>
    <template>TRAIN requires a verified outcome from Ch'en before weight updates can be proposed. Raw ranking alone does not authorize learning commits.</template>
  </category>
  <category>
    <pattern>XCFE TRAIN UNVERIFIED *</pattern>
    <template>BLOCKED: TRAIN requires verified_outcome. Route through Ch'en verification first, then Xul authorization before committing W_learned delta.</template>
  </category>

  <!-- COMPARE ── structured comparison of two candidates or evidence sets -->
  <category>
    <pattern>COMPARE *</pattern>
    <template><srai>XCFE COMPARE <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE COMPARE *</pattern>
    <template>[XCFE:COMPARE operator="COMPARE" executor="eliza" phase="Ch_en" input_roles="candidate_a,candidate_b,evidence_refs" output_role="comparison_report" effects="read,analyze"] <star/></template>
  </category>

  <!-- VERIFY ── Ch'en verification gate -->
  <category>
    <pattern>VERIFY *</pattern>
    <template><srai>XCFE VERIFY <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE VERIFY *</pattern>
    <template>[XCFE:VERIFY operator="VERIFY" executor="ch_en_gate" phase="Ch_en" input_roles="candidate,evidence_refs,comparison_report" output_role="verified_outcome" effects="read,gate" authority_phase="Ch_en"] <star/></template>
  </category>

  <!-- RECALL ── GramStore + vector evidence retrieval -->
  <category>
    <pattern>RECALL *</pattern>
    <template><srai>XCFE RECALL <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE RECALL *</pattern>
    <template>[XCFE:RECALL operator="RECALL" executor="gram_store" phase="Pop" input_roles="query,phase,context" output_role="gram_evidence" effects="read"] <star/></template>
  </category>

  <!-- PROJECT ── VectorMuMicronaut geodesic projection -->
  <category>
    <pattern>PROJECT *</pattern>
    <template><srai>XCFE PROJECT <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE PROJECT *</pattern>
    <template>[XCFE:PROJECT operator="PROJECT" executor="vector_mu" phase="Yax" input_roles="source_substrate,context,trajectory_id" output_role="result_substrate" effects="read,project" mutation="none"] <star/></template>
  </category>

  <!-- QUESTION ── question selector; drives clarification and gap-filling -->
  <category>
    <pattern>QUESTION *</pattern>
    <template><srai>XCFE QUESTION <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE QUESTION *</pattern>
    <template>[XCFE:QUESTION operator="QUESTION" executor="question_selector" phase="Yax" input_roles="intent_gap,context,question_history" output_role="question_record" effects="read,emit"] <star/></template>
  </category>

  <!-- COLLAPSE ── Jyggalag entropy-collapse; total-order reduction of candidate set -->
  <category>
    <pattern>COLLAPSE *</pattern>
    <template><srai>XCFE COLLAPSE <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE COLLAPSE *</pattern>
    <template>[XCFE:COLLAPSE operator="COLLAPSE" executor="jyggalag" phase="Ch_en" input_roles="ranked_candidates,critic_reports" output_role="collapsed_candidate" effects="read,collapse" T="0.0" note="Greymarch_record_only;_Xul_commit_requires_full_authority_path"] <star/></template>
  </category>

  <!-- ── Pipeline convenience patterns ─────────────────────────────────── -->

  <!-- SCORE then RANK -->
  <category>
    <pattern>SCORE AND RANK *</pattern>
    <template><srai>RANK <srai>SCORE <star/></srai></srai></template>
  </category>

  <!-- Full pipeline: SCORE → RANK → COLLAPSE (without premature TRAIN) -->
  <category>
    <pattern>PIPELINE SCORE RANK COLLAPSE *</pattern>
    <template><srai>COLLAPSE <srai>RANK <srai>SCORE <star/></srai></srai></srai></template>
  </category>

  <!-- VERIFY then TRAIN (the only safe TRAIN path) -->
  <category>
    <pattern>VERIFY AND TRAIN *</pattern>
    <template><srai>TRAIN <srai>VERIFY <star/></srai></srai></template>
  </category>

  <!-- ── Operator routing summary (help pattern) ───────────────────────── -->
  <category>
    <pattern>XCFE OPERATORS</pattern>
    <template>SRAI operator dispatch: SCORE (metric/Sek), RANK (metric/Sek), TRAIN (learning/Xul, verified only), COMPARE (eliza/Ch_en), VERIFY (ch_en_gate/Ch_en), RECALL (gram_store/Pop), PROJECT (vector_mu/Yax), QUESTION (question_selector/Yax), COLLAPSE (jyggalag/Ch_en). App tool commands: GET APP, LIST APPS, POST APP, PATCH APP, DELETE APP (see APP COMMANDS). Pipeline: SCORE → RANK → COLLAPSE → VERIFY → TRAIN → Xul commit.</template>
  </category>

  <!-- ═══════════════════════════════════════════════════════════════════════
       App Tool Commands — GET / LIST / POST / PATCH / DELETE
       Natural language aliases → <srai> → XCFE APP <VERB> dispatch frames.
       The C++ aiml_engine intercepts [XCFE:APP_*] frames and routes to the
       manifest_store handlers in xcfe_executor → app_host.
       Read ops (GET/LIST) run at Pop; write ops (POST/PATCH/DELETE) are
       Xul-gated. DELETE uses a GUARD step mirroring TRAIN's guard pattern.
       All app ops carry semantic_authority=false, topology_mutation=false.
       ═══════════════════════════════════════════════════════════════════════ -->

  <!-- GET APP ── read a published manifest (public or owner-scoped) -->
  <category>
    <pattern>GET APP *</pattern>
    <template><srai>XCFE APP GET <star/></srai></template>
  </category>
  <category>
    <pattern>OPEN APP *</pattern>
    <template><srai>XCFE APP GET <star/></srai></template>
  </category>
  <category>
    <pattern>SHOW APP *</pattern>
    <template><srai>XCFE APP GET <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE APP GET *</pattern>
    <template>[XCFE:APP_GET operator="GET" executor="manifest_store" phase="Pop" input_roles="app_id,session_opt" output_role="manifest_doc" effects="read" semantic_authority="false" topology_mutation="false" commit_authorized="false"] <star/></template>
  </category>

  <!-- LIST APPS ── enumerate the caller's published projects -->
  <category>
    <pattern>LIST APPS</pattern>
    <template><srai>XCFE APP LIST</srai></template>
  </category>
  <category>
    <pattern>MY APPS</pattern>
    <template><srai>XCFE APP LIST</srai></template>
  </category>
  <category>
    <pattern>MY PROJECTS</pattern>
    <template><srai>XCFE APP LIST</srai></template>
  </category>
  <category>
    <pattern>XCFE APP LIST</pattern>
    <template>[XCFE:APP_LIST operator="LIST" executor="manifest_store" phase="Pop" input_roles="session_required" output_role="project_index" effects="read" semantic_authority="false" topology_mutation="false" commit_authorized="false"]</template>
  </category>

  <!-- POST APP ── publish a new manifest (Xul-gated write) -->
  <category>
    <pattern>POST APP *</pattern>
    <template><srai>XCFE APP POST <star/></srai></template>
  </category>
  <category>
    <pattern>PUBLISH APP *</pattern>
    <template><srai>XCFE APP POST <star/></srai></template>
  </category>
  <category>
    <pattern>CREATE APP *</pattern>
    <template><srai>XCFE APP POST <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE APP POST *</pattern>
    <template>[XCFE:APP_POST operator="POST" executor="manifest_store" phase="Xul" input_roles="manifest,session_required" output_role="project_doc" effects="write" semantic_authority="false" topology_mutation="false" commit_authorized="false" commit_requires="session_required,manifest_valid,kind_asx_mini_app_v1,id_format_valid,Xul_authorization" next_gate="Ch_en/XCFE/Xul"] <star/></template>
  </category>

  <!-- PATCH APP ── merge-patch manifest fields (RFC 7396, Xul-gated, owner-only) -->
  <category>
    <pattern>PATCH APP *</pattern>
    <template><srai>XCFE APP PATCH <star/></srai></template>
  </category>
  <category>
    <pattern>UPDATE APP *</pattern>
    <template><srai>XCFE APP PATCH <star/></srai></template>
  </category>
  <category>
    <pattern>EDIT APP *</pattern>
    <template><srai>XCFE APP PATCH <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE APP PATCH *</pattern>
    <template>[XCFE:APP_PATCH operator="PATCH" executor="manifest_store" phase="Xul" input_roles="app_id,patch_body,session_required" output_role="updated_doc" effects="write" merge_strategy="RFC7396" semantic_authority="false" topology_mutation="false" commit_authorized="false" commit_requires="session_required,owner_only,Xul_authorization"] <star/></template>
  </category>

  <!-- DELETE APP ── remove a project (guarded; owner + Ch'en gate required) -->
  <category>
    <pattern>DELETE APP *</pattern>
    <template><srai>XCFE APP DELETE GUARD <star/></srai></template>
  </category>
  <category>
    <pattern>REMOVE APP *</pattern>
    <template><srai>XCFE APP DELETE GUARD <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE APP DELETE GUARD *</pattern>
    <template><srai>XCFE APP DELETE <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE APP DELETE *</pattern>
    <template>[XCFE:APP_DELETE operator="DELETE" executor="manifest_store" phase="Xul" input_roles="app_id,session_required" output_role="deletion_receipt" effects="delete" semantic_authority="false" topology_mutation="false" commit_authorized="false" commit_requires="session_required,owner_only,Ch_en_verification,Xul_authorization"] <star/></template>
  </category>
  <category>
    <pattern>DELETE APP WITHOUT AUTH</pattern>
    <template>DELETE APP requires an owner session and Ch'en verification before the Xul commit path opens. A guest cannot delete a project; the session gate runs first.</template>
  </category>

  <!-- ── App tool pipeline conveniences ── -->
  <category>
    <pattern>GET AND PATCH APP *</pattern>
    <template><srai>PATCH APP <srai>GET APP <star/></srai></srai></template>
  </category>
  <category>
    <pattern>PUBLISH AND OPEN APP *</pattern>
    <template><srai>GET APP <srai>POST APP <star/></srai></srai></template>
  </category>

  <!-- ── App tool help ── -->
  <category>
    <pattern>APP COMMANDS</pattern>
    <template>App tool commands: GET APP * (read manifest, Pop/read, public or owner-scoped), LIST APPS (enumerate projects, Pop/read, session required), POST APP * (publish manifest, Xul/write, session + valid manifest), PATCH APP * (merge-patch fields RFC 7396, Xul/write, owner only), DELETE APP * (remove project, Xul/delete, owner + Ch'en gate). Natural aliases: OPEN/SHOW APP → GET; CREATE/PUBLISH APP → POST; UPDATE/EDIT APP → PATCH; REMOVE APP → DELETE. Pipelines: GET AND PATCH APP *, PUBLISH AND OPEN APP *.</template>
  </category>
  <category>
    <pattern>APP TOOLS</pattern>
    <template><srai>APP COMMANDS</srai></template>
  </category>
  <category>
    <pattern>WHAT APP COMMANDS ARE AVAILABLE</pattern>
    <template><srai>APP COMMANDS</srai></template>
  </category>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Domain fact patterns — Q-Prime gap question targets
       These give the n-gram engine direct answers to the domain-specific
       questions that VerbEngine generates for EXPLAIN intents about XCFE
       operators and K'UHUL fold phases.
       ═══════════════════════════════════════════════════════════════════════ -->

  <!-- XCFE operator facts -->
  <category>
    <pattern>WHAT DO XCFE OPERATORS DO</pattern>
    <template>XCFE operators are the policy evaluator control vocabulary. The ten declarative operators are: if (tests a condition at Wo), then (executes a consequence at Ch en), else (branches on failure), for (iterates over a set), from (selects a source), as (binds a result), cause (asserts a causal link), direct (routes without branching), op (dispatches a named operation), fn (calls a registered function). XCFE owns phase-gate enforcement across all operators.</template>
  </category>

  <category>
    <pattern>WHICH XCFE OPERATOR NAMES ARE PRESENT</pattern>
    <template>The nine SRAI operators are SCORE, RANK, COLLAPSE, VERIFY, TRAIN, COMPARE, RECALL, PROJECT, and QUESTION. The ten declarative XCFE operators are if, then, else, for, from, as, cause, direct, op, and fn. SCORE, RANK, COLLAPSE run at Sek; VERIFY and COMPARE at Ch en; TRAIN at Xul (verified_outcome required); RECALL at Pop; PROJECT and QUESTION at Yax.</template>
  </category>

  <category>
    <pattern>WHICH XCFE OPERATOR NAMES *</pattern>
    <template><srai>WHICH XCFE OPERATOR NAMES ARE PRESENT</srai></template>
  </category>

  <category>
    <pattern>FOR EACH OPERATOR WHAT TYPED INPUT DOES IT CONSUME AND WHAT OUTPUT DOES IT PRODUCE</pattern>
    <template>SCORE consumes candidate_set and query_vector, produces scored_candidates. RANK consumes scored_candidates, produces ranked_list. COLLAPSE consumes ranked_list, produces single_candidate. VERIFY consumes candidate and evidence, produces verified_outcome. TRAIN consumes verified_outcome, produces learned_weight update. COMPARE consumes two responses, produces ranked_pair. RECALL consumes a key, produces a gram_store entry. PROJECT consumes a fold handle, produces a vector projection. QUESTION consumes a gap description, produces a ranked question.</template>
  </category>

  <category>
    <pattern>FOR EACH OPERATOR WHAT TYPED INPUT *</pattern>
    <template><srai>FOR EACH OPERATOR WHAT TYPED INPUT DOES IT CONSUME AND WHAT OUTPUT DOES IT PRODUCE</srai></template>
  </category>

  <category>
    <pattern>WHICH PHASE EFFECTS AND ADMISSION CHECKS GOVERN EACH OPERATOR</pattern>
    <template>SCORE and RANK run at Sek phase with effects read and measure; admission requires a candidate set. COLLAPSE runs at Ch en with effect select; requires ranked_list. VERIFY runs at Ch en with effect proof; requires evidence present. TRAIN runs at Xul with effect write; requires verified_outcome and is guarded: TRAIN without VERIFY is rejected. RECALL runs at Pop with effect read; no admission guard. PROJECT runs at Yax with effect map; requires a valid fold handle. QUESTION runs at Yax with effect map; requires an unresolved gap.</template>
  </category>

  <!-- K'UHUL fold / phase facts -->
  <!-- K UHUL (two tokens) aliases — K'UHUL normalizes to K + UHUL -->
  <category>
    <pattern>WHAT IS K UHUL FOLD</pattern>
    <template><srai>WHAT IS KUHUL FOLD</srai></template>
  </category>

  <category>
    <pattern>WHAT IS K UHUL</pattern>
    <template>K'UHUL is KHANARY's semantic execution layer: phases Pop, Wo, Yax, Sek, Ch'en, Xul define runtime operations over folds, while XCFE authorizes control-flow transitions and commits. See docs/KHANARY-CPP-SPEC.md. [epistemic:SUPPORTED via utility-runtime]</template>
  </category>

  <category>
    <pattern>WHAT DOES EACH PHASE * CONTRIBUTE TO A K UHUL FOLD</pattern>
    <template><srai>WHAT DOES EACH PHASE CONTRIBUTE TO A KUHUL FOLD</srai></template>
  </category>

  <category>
    <pattern>WHAT DOES EACH PHASE CONTRIBUTE TO A KUHUL FOLD</pattern>
    <template>Pop introduces the fold seed and archives the prompt. Wo binds state: CONDITION, ROUTING, CAUSAL, and STRUCTURE nodes are governed here. Yax expands candidates and derives the Active Fold Graph from the query gate. Sek dispatches and transforms: EXECUTION, CAPABILITY, and TRANSFORM nodes execute here. Ch'en observes and proves: VERIFICATION and CONSEQUENCE nodes verify evidence; the ParsedGraph becomes a VerifiedGraph. Xul collapses to a terminal result and is the only phase that may commit a topology delta.</template>
  </category>

  <category>
    <pattern>HOW DO CANDIDATE STATE AND EVIDENCE MOVE THROUGH THOSE SIX PHASES IN K UHUL</pattern>
    <template><srai>HOW DO CANDIDATE STATE AND EVIDENCE MOVE THROUGH THOSE SIX PHASES</srai></template>
  </category>

  <category>
    <pattern>IS THE QUESTION ABOUT THE SIX PHASE K UHUL CYCLE OR A FUNCTIONAL FOLD *</pattern>
    <template><srai>IS THE QUESTION ABOUT THE SIX PHASE KUHUL CYCLE OR A FUNCTIONAL FOLD ANSWER</srai></template>
  </category>

  <category>
    <pattern>IS THE QUESTION ABOUT THE SIX PHASE KUHUL CYCLE OR A FUNCTIONAL FOLD ANSWER</pattern>
    <template>These are two distinct things. The six-phase K'UHUL cycle Pop-Wo-Yax-Sek-Ch'en-Xul is the execution geometry: a discrete C6 connection with arc_weight = cos(delta_theta). A functional fold is the catamorphism algebra alpha : F(B) to B applied to the bounded neighborhood at a given phase. The semantic fold uses the functional fold as its algebra; the phase cycle positions that algebra in the execution geometry. Fold is structure plus interpretation; the phase cycle is where that interpretation sits.</template>
  </category>

  <category>
    <pattern>WHAT IS KUHUL FOLD</pattern>
    <template>A K'UHUL fold is a bounded semantic context around a handle h: Fold(contexts, relations, nodes) → h. The semantic fold applies an interpretation algebra α : F(B) → B to that neighborhood at a given phase θ in the C6 cycle Pop→Wo→Yax→Sek→Ch'en→Xul. Unfold reveals the neighborhood; Xul is the only commit phase.</template>
  </category>

  <category>
    <pattern>WHAT DOES EACH PHASE * CONTRIBUTE TO A KUHUL FOLD</pattern>
    <template>Pop introduces the fold seed and archives the prompt. Wo binds state: CONDITION, ROUTING, CAUSAL, and STRUCTURE nodes are governed here. Yax expands candidates and derives the Active Fold Graph from the query gate. Sek dispatches and transforms: EXECUTION, CAPABILITY, and TRANSFORM nodes execute here. Ch'en observes and proves: VERIFICATION and CONSEQUENCE nodes verify evidence; the ParsedGraph becomes a VerifiedGraph. Xul collapses to a terminal result and is the only phase that may commit a topology delta.</template>
  </category>

  <category>
    <pattern>HOW DO CANDIDATE STATE AND EVIDENCE MOVE THROUGH THOSE SIX PHASES</pattern>
    <template>Pop seeds the candidate from the prompt and logs a gram-event. Wo allocates and binds the candidate to a track via W·C·R scoring. Yax expands the neighborhood and scores competing candidates. Sek dispatches the selected candidate to an executor micronaut. Ch'en verifies the result against evidence; a failed proof routes to MISS. Xul commits the verified result to gram_store and closes the fold — a MISS at Ch'en stays unresolved rather than collapsing to a guess.</template>
  </category>

  <category>
    <pattern>IS THE QUESTION ABOUT THE SIX PHASE KUHUL CYCLE OR A FUNCTIONAL FOLD *</pattern>
    <template>These are two distinct things. The six-phase K'UHUL cycle Pop→Wo→Yax→Sek→Ch'en→Xul is the execution geometry: a discrete C6 connection with arc_weight = cos(Δθ). A functional fold is the catamorphism algebra α : F(B) → B applied to the bounded neighborhood at a given phase. The semantic fold uses the functional fold as its algebra; the phase cycle positions that algebra in the execution geometry. Fold is structure plus interpretation; the phase cycle is where that interpretation sits.</template>
  </category>

  <!-- Verify prefix — Ch'en verification pass from the critic node -->
  <category>
    <pattern>VERIFY KUHUL *</pattern>
    <template>K'UHUL phases are defined at src/config.h: Pop=0, Wo=π/3, Yax=2π/3, Sek=π, Ch'en=4π/3, Xul=5π/3. arc_weight=cos(Δθ). This is confirmed by the phase_engine and fold_engine source. [epistemic:SUPPORTED via REASON-u]</template>
  </category>

  <category>
    <pattern>VERIFY XCFE *</pattern>
    <template>XCFE is the policy evaluator that owns @if/@then/@else/@for/@from/@as/@cause/@direct/@op/@fn operator execution and phase-gate enforcement. Source: src/kuhul/xcfe_executor.cpp. [epistemic:SUPPORTED via REASON-u]</template>
  </category>
</aiml>
