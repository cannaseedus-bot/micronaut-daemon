<aiml version="1.0.1">
  <!-- GENERATED by tools/grammar/mini_transpilers.py greeting-bank-compile
       from data/grammar/greeting-bank.json — do not edit by hand;
       re-run the transpiler after changing the bank. -->
  <category>
    <pattern>GREETING BANK</pattern>
    <template><mx2lm>greeting bank phases Pop Wo Yax Sek Ch'en Xul kinds canonical learned associative status confirmatory recall reactionary synthesized</mx2lm></template>
  </category>
  <category>
    <pattern>GREETING CH EN *</pattern>
    <template><mx2lm>greeting phase=Ch'en kind=confirmatory bank=greeting_bank <star/></mx2lm></template>
  </category>
  <category>
    <pattern>GREETING POP REACTIVE_MIRROR *</pattern>
    <template><mx2lm>greeting phase=Pop.reactive_mirror kind=reactionary bank=greeting_bank <star/></mx2lm></template>
  </category>
  <category>
    <pattern>GREETING YAX SYNTHESIZED_GREETING *</pattern>
    <template><mx2lm>greeting phase=Yax.synthesized_greeting kind=synthesized bank=greeting_bank <star/></mx2lm></template>
  </category>
  <category>
    <pattern>GREETING POP *</pattern>
    <template><mx2lm>greeting phase=Pop kind=canonical bank=greeting_bank <star/></mx2lm></template>
  </category>
  <category>
    <pattern>GREETING WO *</pattern>
    <template><mx2lm>greeting phase=Wo kind=learned bank=greeting_bank <star/></mx2lm></template>
  </category>
  <category>
    <pattern>GREETING YAX *</pattern>
    <template><mx2lm>greeting phase=Yax kind=associative bank=greeting_bank <star/></mx2lm></template>
  </category>
  <category>
    <pattern>GREETING SEK *</pattern>
    <template><mx2lm>greeting phase=Sek kind=status bank=greeting_bank <star/></mx2lm></template>
  </category>
  <category>
    <pattern>GREETING XUL *</pattern>
    <template><mx2lm>greeting phase=Xul kind=recall bank=greeting_bank <star/></mx2lm></template>
  </category>
  <category>
    <pattern>GREETING *</pattern>
    <template><mx2lm>greeting bank=greeting_bank hint GREETING BANK for phases <star/></mx2lm></template>
  </category>
</aiml>
