<?xml version="1.0" encoding="UTF-8"?>
<aiml version="1.0">

<!-- Xul phase bank: word-problem terminal emission.
     K'UHUL Xul ops: compare_and_commit, emit_answer.
     This is the terminal fold: emit the phase trace and commit the answer.
     Matches any WORD PROBLEM * not resolved by a more specific Sek pattern —
     the catch-all that annotates with the full phase pipeline. -->

<category>
<pattern>WORD PROBLEM *</pattern>
<template>
<mx2lm>
Applying K'UHUL phase pipeline:
  Pop  — parsed problem tokens
  Wo   — bound variables to knowns
  Yax  — admitted candidate solution paths
  Sek  — computed via governing equation
  Ch'en — verified units and reasonableness
  Xul  — committing answer
Problem: <star/>
</mx2lm>
</template>
</category>

</aiml>
