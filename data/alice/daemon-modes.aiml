  <!-- Mode IDs resolve through daemon-behavior-modes.v1.json. Bias values are illustrative priors, not gradients or learned weights. -->
  <category>
    <pattern>USE THERAPY MODE</pattern>
    <template><xaiml:behavior mode="therapy" role="response_style" priority="primary"/><xaiml:bias empathy="0.9" reasoning="0.55" initiative="0.55" skepticism="0.15" creativity="0.35" source="mode_prior"/></template>
