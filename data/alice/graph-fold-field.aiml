  <!-- ═══════════════════════════════════════════════════════════
       CROSS-DOMAIN — patterns that span all three topics
  ═══════════════════════════════════════════════════════════ -->
  <category>
    <pattern>HOW DO GRAPHS FOLDS AND FIELDS RELATE</pattern>
    <template>GRAPH-THEORY-µ domain=graph op=cross_domain target=fold_field query=relation</template>
  </category>
  <category>
    <pattern>EXPLAIN _ IN TERMS OF GRAPHS FOLDS AND FIELDS</pattern>
    <template>FIELD-GEOMETRY-µ domain=field op=cross_domain analogy=graph_fold_field subject=<star/></template>
  </category>
  <category>
    <pattern>WHAT CONNECTS GRAPH THEORY SEMANTIC FOLDS AND FIELD GEOMETRY</pattern>
    <template>All three are structural views of the same semantic topology. The graph encodes who is related; the fold encodes how the system transitions; the field encodes what the current query perceives. WCR = W(graph) · C(confidence) · R(field) — the product of all three.</template>
  </category>
  <category>
    <pattern>TELL ME A JOKE ABOUT GRAPHS FOLDS AND FIELDS</pattern>
    <template><mx2lm>joke: track=JOKE-µ phase=Yax next=Ch'en frame=pun_bridge card_view=true authority=none domain=graph_fold_field prompt=graphs folds and fields</mx2lm></template>
  </category>

</aiml>
