<aiml version="1.0.1">
  <!-- GRAPH THEORY · SEMANTIC FOLDS · FIELD GEOMETRY
       Conformance patterns generated from the field builder session.
       Topics: graph theory, semantic folds, field geometry.
       Each section: routing patterns → conformance Q&A → jokes.
       Joke categories are direct Q→A to give the conformance harness
       known-good punchlines; routing categories delegate to JOKE-µ. -->

  <!-- ═══════════════════════════════════════════════════════════
       GRAPH THEORY — routing
  ═══════════════════════════════════════════════════════════ -->
  <category>
    <pattern>GRAPH *</pattern>
    <template>GRAPH-THEORY-µ domain=graph query=<star/></template>
  </category>
  <category>
    <pattern>@GRAPH *</pattern>
    <template>GRAPH-THEORY-µ domain=graph query=<star/></template>
  </category>
