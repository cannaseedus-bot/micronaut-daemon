    <template><mx2lm>joke: track=JOKE-µ phase=Yax next=Ch'en frame=humor_frame card_view=true authority=none domain=graph_theory prompt=graphs</mx2lm></template>
  </category>
  <category>
    <pattern>TELL ME A JOKE ABOUT GRAPH THEORY</pattern>
    <template><mx2lm>joke: track=JOKE-µ phase=Yax next=Ch'en frame=pun_bridge card_view=true authority=none domain=graph_theory prompt=graph theory</mx2lm></template>
  </category>
