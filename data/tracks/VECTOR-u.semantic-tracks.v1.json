{
  "@no-eval": true,
  "id": "VECTOR-µ",

  "schemes": ["vector"],
  "description": "VECTOR-µ — representation-learning sidekick for Mx2LM. It learns and emits derived geometry over verified semantic containers, GML/FoldGraph topology, RelationISA edges, Fold neighborhoods, mesh/STB evidence, and EpisodeJournal deltas. Beyond flat embeddings, it may learn a semantic-manifold projection M_mu over authoritative topology B, local tangent charts N(k)->T_k(M_mu), phase/relation-conditioned metrics g(F,theta,r), and graph-geodesic distance estimates, without becoming semantic authority.",
  "phase": "Wo",
  "category": "geometry",
  "confidence": 1.0,
  "projection_micronaut": true,
  "semantic_authority": false,
  "governs": [
