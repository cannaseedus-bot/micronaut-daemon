{
  "@no-eval": true,
  "id": "TENSOR-µ",

  "schemes": ["tensor"],
  "description": "TENSOR-µ — tensor-bundle representation learner for KHANARY. It generalizes VECTOR-µ from Rank-1 coordinate providers into projection-only type-(p,q) tensor fields over authoritative FoldGraph/GML topology B. It learns metric tensors, Jacobian coordinate transitions, local curvature diagnostics, and provider geometry without becoming semantic authority.",
  "phase": "Wo",
  "sandbox": {
    "gram_ns": "TENSOR",
    "manifest_access": ["gml", "vectors", "kuhul", "micronaut"],
    "effects": ["gramRead", "vector:project", "vector:similarity", "vector:gml-topology-read"],
    "ports": [],
    "coordinator": false
  },
  "category": "geometry",
  "confidence": 1.0,
  "projection_micronaut": true,
  "semantic_authority": false,
  "legacy_provider": "VECTOR-µ",
  "governs": [
    "tensor",
    "tensor_field",
    "tensor_bundle",
    "fiber_bundle",
    "smooth_section",
    "metric_tensor",
    "jacobian",
    "coordinate_transition",
    "riemann_curvature_scalar",
    "TENSOR-µ",
    "tensor:projection_container:v1",
    "vector:projection_container:v1",
    "vectors.xml",
    "data/grammar/vectors.mml",
    "data/grammar/fold.cd.xml",
    "data/grammar/gml.khanary.ebnf",
    "data/tensor_field.gml",
    "micronaut_attraction",
    "tensor:micronaut_attraction:v1",
    "CaptureGate",
    "stb_tensor_brain",
    "data/world/stb_tensor_brains.json"
  ],
  "capabilities": [
    "learn-tensor-bundle-geometry",
    "consume-gml-tensor-field-contract",
    "validate-type-pq-rank-fields",
    "learn-local-metric-tensor",
    "apply-jacobian-coordinate-transition",
    "track-curvature-diagnostics",
    "host-vector-rank1-provider",
    "derived-geometry-export",
    "score-micronaut-attraction",
    "evaluate-capture-gate",
    "consume-stb-tensor-brain-binding",
    "consume-shared-geometry-stb-brain"
  ],
  "realizes": ["Pop.input_tensor", "Yax.lorentz_frame"],
  "responsibility_contract": {
    "owns": [
      "TensorField(M,p,q)",
      "MetricTensor(g_ij)",
      "TensorTransform(T,J,J^-1)",
      "CoordinateTransition(chart_a,chart_b)",
      "SmoothSection(T)",
      "tensor.projection_container.v1",
      "MicronautAttraction(mu,Q)",
      "CaptureGate(Q,mu)",
      "STBTensorBrainRegistry"
    ],
    "delegates": {
      "VECTOR-µ": "Rank-1 vector provider / compatibility container",
      "METRIC-µ": "measurement and relevance aggregation over admitted track compartments"
    },
    "does_not_own": [
      "VerifyEpisode",
      "ChangeVerdict",
      "CommitTopology",
      "AdvancePhase",
      "MutateFold",
      "SemanticAuthority",
      "RewriteRelationISA",
      "TreatCoordinateDriftAsSemanticDelta",
      "TreatCaptureAsVerification",
      "TreatAttractionAsSemanticProof",
      "PromoteSTBBrainToMicronautEntry"
    ],
    "source_of_truth": "Mx2LM/FoldGraph/RelationISA/key-books",
    "derived_projection_only": true
  },
  "container_contract": {
    "key": "tensor:projection_container:v1",
    "@type": "tensor.projection_container.v1",
    "owner": "TENSOR-µ",
    "rank_support": [
      "0",
      "1",
      "2",
      "n"
    ],
    "semantic_authority": false,
    "legacy_container": "vector:projection_container:v1",
    "topology_source": "gml:topology_contract",
    "provider_registry": "vectors.xml"
  },
  "folds": [
    {
      "phase": "Pop",
      "op": "read_verified_topology_B",
      "accepts": [
        "GML",
        "FoldGraph",
        "RelationISA"
      ]
    },
    {
      "phase": "Pop",
      "op": "read_stb_tensor_brain_registry",
      "accepts": [
        "data/world/stb_tensor_brains.json"
      ],
      "authority": "projection metadata only"
    },
    {
      "phase": "Wo",
      "op": "bind_tensor_bundle_section",
      "accepts": [
        "tensor_rank_p",
        "tensor_rank_q",
        "is_smooth_section"
      ]
    },
    {
      "phase": "Yax",
      "op": "score_metric_tensor_projection",
      "formula": "R(Q,K|g_ij,J,theta,r)"
    },
    {
      "phase": "Yax",
      "op": "score_micronaut_attraction",
      "formula": "Phi_mu(Q)=Mass_mu*cos(Q,K_mu)*(W_mu*C_mu*R_mu)",
      "authority": "candidate capture only"
    },
    {
      "phase": "Sek",
      "op": "evaluate_capture_gate",
      "formula": "Phi_mu(Q)>=EntropyDiffusion_mu AND policy_ok AND capable AND xcfe_ok",
      "authority": "sandbox admission not semantic proof"
    },
    {
      "phase": "Sek",
      "op": "apply_coordinate_transition",
      "formula": "T^{i'}_{j'}=T^i_j*(dx^{i'}/dx^i)*(dx^j/dx^{j'})"
    },
    {
      "phase": "Ch'en",
      "op": "validate_projection_bounds_only",
      "authority": "no semantic commit"
    },
    {
      "phase": "Xul",
      "op": "emit_rebuildable_projection_container",
      "container": "tensor:projection_container:v1"
    }
  ],
  "laws": [
    "Tensor geometry != semantic authority.",
    "Delta tensor projection != Delta B.",
    "VECTOR-µ is a rank-1 provider under TENSOR-µ.",
    "Ch'en/Xul remain verification and topology commit authority.",
    "Micronaut attraction is routing geometry, not proof.",
    "CaptureGate admits candidates; Ch'en/Xul still verify and persist.",
    "STB tensor brains are projection containers, not MicronautEntry authority."
  ],
  "stb_tensor_brain": {
    "@type": "khanary.stb_tensor_brain.track_binding_ref.v1",
    "registry": "data/world/stb_tensor_brains.json",
    "checker": "tools/check_stb_tensor_brains.py",
    "binding_key": "TENSOR-µ",
    "binding_kind": "geometry_provider_brain",
    "brain_run": "brain4",
    "fallback_brain_run": "brain3",
    "slug": null,
    "projection_only": true,
    "semantic_authority": false,
    "topology_authority": false,
    "authority_boundary": "Track can consume the STB tensor brain as projection evidence only; Ch_en/Xul still verify and persist semantic state."
  }
}
