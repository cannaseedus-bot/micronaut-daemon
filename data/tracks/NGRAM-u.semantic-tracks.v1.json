{
  "@no-eval": true,
  "id": "NGRAM-µ",

  "schemes": ["ngram"],
  "description": "Parent ngram-pipeline micronaut — owns the full lifecycle from text ingest through field construction to gram store persistence. Orchestrates child micronauts anchored to the ngram system: AC key admission (NGRAM-KEY-µ), user session ngrams (USER-µ), geometric projection (VECTOR-µ), numeric scoring (MATH-µ), gram store persistence (MEMORY-µ), field inference (INFER-µ), and key recording (FACTORY-µ). Contributes C_Ngram to the semantic field at phase Wo. All three parent micronauts (CHAT-µ, CODEGEN-µ, ADVISOR-µ) consume NGRAM-µ output; NGRAM-µ does not route responses — it routes field addresses.",
  "phase": "Wo",
  "category": "structural",
  "confidence": 1.0,
  "governs": [
    "ngram",
    "ngrams",
    "n-gram",
    "n-grams",
    "ngram pipeline",
    "ngram field",
    "ngram store",
    "gram store",
    "gramWrite",
    "gramRead",
    "build_learning_ngrams",
    "learning ngrams",
    "ngram ingest",
    "ngram build",
    "ngram lifecycle",
    "ngram address",
    "ngram context",
    "ngram evidence",
    "ngram routing",
    "ngram key recording",
    "key grammar pipeline",
    "ngram window",
    "bigram",
    "trigram",
    "unigram",
    "ngram candidate",
    "ngram score",
    "ngram replay",
    "evolve_candidate",
    "replay_candidate",
    "ngram:*",
    "@ngram"
  ],
  "sub_micronauts": [
    "NGRAM-KEY-µ",
    "USER-µ",
    "VECTOR-µ",
    "MATH-µ",
    "MEMORY-µ",
    "INFER-µ",
    "FACTORY-µ"
  ],
  "capabilities": [
    "ngram-ingest",
    "ngram-field-build",
    "ngram-window-slide",
    "ngram-route-to-child",
    "ngram-score-rank",
    "ngram-gram-store-persist",
    "ngram-replay-evolve",
    "ngram-user-session-bind",
    "ngram-vector-project",
    "ngram-math-score",
    "ngram-memory-persist",
    "ngram-infer-field",
    "ngram-factory-record",
    "⟁Wo",
    "⟁Sek"
  ],
  "pattern_registry": {
    "insert_key": "NGRAM:",
    "invoke_node": "@ngram",
    "wrapper": "<mx2lm>ngram-u op={op} window={window} phase={phase} track={track}</mx2lm>",
    "fallback": "<mx2lm>ngram-u {input}</mx2lm>"
  },
  "ngram_pipeline": {
    "ingest_fn":     "build_learning_ngrams",
    "admit_fn":      "NGRAM-KEY-µ / ac_admit_keys",
    "persist_fn":    "gramWrite",
    "record_fn":     "factory.record_key",
    "replay_fn":     "replay_candidate",
    "evolve_fn":     "evolve_candidate",
    "max_window":    24,
    "phase_chat":    "Pop",
    "phase_codegen": "Wo",
    "phase_advisor": "Yax"
  },
  "relations": [
    { "target": "NGRAM-KEY-µ", "verb": "@delegates_to", "directed": true  },
    { "target": "MEMORY-µ",    "verb": "@delegates_to", "directed": true  },
    { "target": "VECTOR-µ",    "verb": "@delegates_to", "directed": true  },
    { "target": "USER-µ",      "verb": "@delegates_to", "directed": true  },
    { "target": "MATH-µ",      "verb": "@delegates_to", "directed": true  },
    { "target": "INFER-µ",     "verb": "@delegates_to", "directed": true  },
    { "target": "FACTORY-µ",   "verb": "@delegates_to", "directed": true  },
    { "target": "CHAT-µ",      "verb": "@supports",     "directed": true  },
    { "target": "CODEGEN-µ",   "verb": "@supports",     "directed": true  },
    { "target": "ADVISOR-µ",   "verb": "@supports",     "directed": true  },
    { "target": "FOLDGRAPH-µ", "verb": "@related_to",   "directed": false }
  ],
  "folds": [
    { "phase": "Pop",   "op": "gramRead",              "key": "ngram:context:current",
      "note": "read prior ngram field state for the current session" },
    { "phase": "Wo",    "op": "build_learning_ngrams", "window": 24,
      "note": "slide window over prompt+response text, emit candidate ngrams" },
    { "phase": "Wo",    "op": "ac_admit_keys",         "delegate": "NGRAM-KEY-µ",
      "note": "AC bag-of-keys admission; filters to grammar-registered keys only" },
    { "phase": "Yax",   "op": "route_to_child_track",
      "note": "bind ngrams to USER-µ/VECTOR-µ/MATH-µ/MEMORY-µ/INFER-µ/FACTORY-µ per category" },
    { "phase": "Sek",   "op": "score_ngram_candidates","delegate": "MATH-µ",
      "note": "WCR ranking over admitted ngrams; prune below threshold" },
    { "phase": "Ch'en", "op": "verify_ngram_boundary",
      "note": "ngram keys must not collide with xcfe.* or fold.* namespaces" },
    { "phase": "Xul",   "op": "gramWrite",             "scope": "local",
      "note": "persist ranked ngrams to gram store; call factory.record_key per key" }
  ],
  "memory_patterns": [
    "ngram:context:current",
    "ngram:field:last",
    "ngram:candidate:session",
    "ngram:score:history"
  ],
  "sandbox": {
    "gram_ns": "NGRAM",
    "manifest_access": ["words", "micronaut", "kuhul", "fold_graph", "gram"],
    "effects": [
      "gramRead",
      "gramWrite",
      "ngram:ingest",
      "ngram:admit",
      "ngram:route",
      "ngram:record",
      "ngram:replay",
      "ngram:evolve"
    ],
    "key_prefix_allow": ["ngram:"],
    "key_prefix_deny":  ["xcfe.", "fold.", "ctrl:"],
    "ports": [],
    "coordinator": false
  }
}
