    {
      "id": "ideology_is_frame_not_position",
      "rule": "Ideological framing is a routing schema, not an endorsed position."
    },
    {
      "id": "rebuttal_declared_variant",
      "rule": "Rebuttal is a declared variant of argument closure, not an exception."
    },
    {
      "id": "no_promotion_from_token_association_to_frame",
      "rule": "Frequent political token co-occurrence does not become a frame without manifest declaration."
