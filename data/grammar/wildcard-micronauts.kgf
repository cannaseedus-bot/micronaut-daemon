keygraph "wildcard-micronauts" version "2.0";
namespace relation:core domain custom;
namespace fold:core domain fold;
namespace gram:core domain gram;
namespace track:core domain track;
namespace micro:core domain micro;
namespace xcfe:core domain xcfe;
key relation:AFFECTS kind relation;
key relation:RELATED_TO kind relation;
key relation:DIFFERS_FROM kind relation;
key micro:WILDCARD_ENTITY kind program;
key micro:RELATIONSHIP kind program;
key xcfe:BINDING_ADMISSION kind contract;
template fold:AFFECT domain fold { operator RELATE; input cause; input target; output candidate_edges; };
template fold:RELATED domain fold { operator RELATE; input source; input target; output candidate_edges; };
template fold:DIFFERENCE domain fold { operator COMPARE; input left; input right; output distinctions; };
trigram gram:AFFECT_YAX ("affect",*,*) phase Yax fold fold:AFFECT bindings [cause:capture,target:capture];
trigram gram:RELATED_YAX ("related",*,*) phase Yax fold fold:RELATED bindings [source:capture,target:capture];
trigram gram:DIFFERENCE_SEK ("differ",*,*) phase Sek fold fold:DIFFERENCE bindings [left:capture,right:capture];
track track:WILDCARD_RELATIONS { include micro:WILDCARD_ENTITY; include micro:RELATIONSHIP; include gram:AFFECT_YAX; include gram:RELATED_YAX; include gram:DIFFERENCE_SEK; };
policy xcfe:WILDCARD_POLICY { score wcr_vector; admission xcfe:BINDING_ADMISSION; max_depth 4; allow_cycle false; commit_phase Xul; };
resolver micro:ENTITY_LOOKUP domain micro mode lookup policy xcfe:WILDCARD_POLICY;
resolver micro:RELATION_EXEC domain micro mode execute policy xcfe:WILDCARD_POLICY;
vector2 micro:WILDCARD_ENTITY (0.9,0.2);
vector2 micro:RELATIONSHIP (0.8,0.6);
micronaut micro:WILDCARD_ENTITY track track:WILDCARD_RELATIONS resolver micro:ENTITY_LOOKUP vector micro:WILDCARD_ENTITY;
micronaut micro:RELATIONSHIP track track:WILDCARD_RELATIONS resolver micro:RELATION_EXEC vector micro:RELATIONSHIP;
edge micro:RELATIONSHIP -> micro:WILDCARD_ENTITY type requires order 1;
edge micro:RELATIONSHIP -> fold:AFFECT type calls;
edge micro:RELATIONSHIP -> fold:RELATED type calls;
edge micro:RELATIONSHIP -> fold:DIFFERENCE type calls;
program relation:AFFECTS track track:WILDCARD_RELATIONS entry fold:AFFECT phase Yax micronaut micro:RELATIONSHIP;
program relation:RELATED_TO track track:WILDCARD_RELATIONS entry fold:RELATED phase Yax micronaut micro:RELATIONSHIP;
program relation:DIFFERS_FROM track track:WILDCARD_RELATIONS entry fold:DIFFERENCE phase Sek micronaut micro:RELATIONSHIP;
