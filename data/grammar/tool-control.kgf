keygraph "tool-control" version "2.0";
namespace tool:core domain custom;
namespace fold:core domain fold;
namespace gram:core domain gram;
namespace track:core domain track;
namespace micro:core domain micro;
namespace xcfe:core domain xcfe;
key micro:TOOL kind program;
key xcfe:TOOL_ADMISSION kind contract;
key xcfe:ALERT_EVENT kind contract;
key tool:GET kind program;
key tool:POST kind program;
key tool:READ kind program;
key tool:WRITE kind program;
key tool:PATCH kind program;
key tool:LIST kind program;
key tool:INSPECT kind program;
key tool:RUN kind program;
key tool:COMPILE kind program;
key tool:CALL kind program;
key tool:HEALTH kind program;
key tool:SEARCH kind program;
key tool:ALERT kind program;
template fold:GET domain fold { operator GET; input resource; output observation; };
template fold:POST domain fold { operator POST; input resource; input payload; output candidate; };
template fold:READ domain fold { operator READ; input path; output observation; };
template fold:WRITE domain fold { operator WRITE; input path; input payload; output candidate; };
template fold:PATCH domain fold { operator PATCH; input path; input delta; output candidate; };
template fold:LIST domain fold { operator LIST; input resource; output observation; };
template fold:INSPECT domain fold { operator INSPECT; input resource; output observation; };
template fold:RUN domain fold { operator RUN; input program; output candidate; };
template fold:COMPILE domain fold { operator COMPILE; input source; output artifact; };
template fold:CALL domain fold { operator CALL; input program; input arguments; output candidate; };
template fold:HEALTH domain fold { operator HEALTH; input service; output observation; };
template fold:SEARCH domain fold { operator SEARCH; input query; output evidence; };
template fold:ALERT domain fold { operator ALERT; input key; input threshold; output event; };
trigram gram:GET_POP ("get",*,*) phase Pop fold fold:GET bindings [resource:capture];
trigram gram:POST_SEK ("post",*,*) phase Sek fold fold:POST bindings [resource:capture,payload:capture];
trigram gram:READ_POP ("read",*,*) phase Pop fold fold:READ bindings [path:capture];
trigram gram:WRITE_SEK ("write",*,*) phase Sek fold fold:WRITE bindings [path:capture,payload:capture];
trigram gram:PATCH_SEK ("patch",*,*) phase Sek fold fold:PATCH bindings [path:capture,delta:capture];
trigram gram:LIST_POP ("list",*,*) phase Pop fold fold:LIST bindings [resource:capture];
trigram gram:INSPECT_WO ("inspect",*,*) phase Wo fold fold:INSPECT bindings [resource:capture];
trigram gram:RUN_SEK ("run",*,*) phase Sek fold fold:RUN bindings [program:capture];
trigram gram:COMPILE_SEK ("compile",*,*) phase Sek fold fold:COMPILE bindings [source:capture];
trigram gram:CALL_SEK ("call",*,*) phase Sek fold fold:CALL bindings [program:capture,arguments:capture];
trigram gram:HEALTH_POP ("health",*,*) phase Pop fold fold:HEALTH bindings [service:capture];
trigram gram:SEARCH_YAX ("search",*,*) phase Yax fold fold:SEARCH bindings [query:capture];
trigram gram:ALERT_XUL ("alert",*,*) phase Xul fold fold:ALERT bindings [key:capture,threshold:capture];
track track:TOOL_CONTROL { include micro:TOOL; include gram:GET_POP; include gram:POST_SEK; include gram:READ_POP; include gram:WRITE_SEK; include gram:PATCH_SEK; include gram:LIST_POP; include gram:INSPECT_WO; include gram:RUN_SEK; include gram:COMPILE_SEK; include gram:CALL_SEK; include gram:HEALTH_POP; include gram:SEARCH_YAX; include gram:ALERT_XUL; };
policy xcfe:TOOL_POLICY { score wcr; admission xcfe:TOOL_ADMISSION; max_depth 3; allow_cycle false; commit_phase Xul; };
resolver micro:TOOL_EXEC domain micro mode execute policy xcfe:TOOL_POLICY;
vector2 micro:TOOL (0.9,0.5);
micronaut micro:TOOL track track:TOOL_CONTROL resolver micro:TOOL_EXEC vector micro:TOOL;
program tool:GET track track:TOOL_CONTROL entry fold:GET phase Pop micronaut micro:TOOL;
program tool:POST track track:TOOL_CONTROL entry fold:POST phase Sek micronaut micro:TOOL;
program tool:READ track track:TOOL_CONTROL entry fold:READ phase Pop micronaut micro:TOOL;
program tool:WRITE track track:TOOL_CONTROL entry fold:WRITE phase Sek micronaut micro:TOOL;
program tool:PATCH track track:TOOL_CONTROL entry fold:PATCH phase Sek micronaut micro:TOOL;
program tool:LIST track track:TOOL_CONTROL entry fold:LIST phase Pop micronaut micro:TOOL;
program tool:INSPECT track track:TOOL_CONTROL entry fold:INSPECT phase Wo micronaut micro:TOOL;
program tool:RUN track track:TOOL_CONTROL entry fold:RUN phase Sek micronaut micro:TOOL;
program tool:COMPILE track track:TOOL_CONTROL entry fold:COMPILE phase Sek micronaut micro:TOOL;
program tool:CALL track track:TOOL_CONTROL entry fold:CALL phase Sek micronaut micro:TOOL;
program tool:HEALTH track track:TOOL_CONTROL entry fold:HEALTH phase Pop micronaut micro:TOOL;
program tool:SEARCH track track:TOOL_CONTROL entry fold:SEARCH phase Yax micronaut micro:TOOL;
program tool:ALERT track track:TOOL_CONTROL entry fold:ALERT phase Xul micronaut micro:TOOL;
