keygraph "program-bias-buffer" version "2.0";
namespace tensor:core domain custom;
namespace micro:core domain micro;
namespace fold:core domain fold;
namespace gram:core domain gram;
namespace track:core domain track;
namespace xcfe:core domain xcfe;
key micro:REASON kind program;
key xcfe:VERIFY kind contract;
template fold:COMPARE domain fold { operator COMPARE; input left; input right; output observation; };
trigram gram:COMPARE_SEK ("compare",*,*) phase Sek fold fold:COMPARE bindings [left:capture,right:capture];
track track:RESEARCH { include micro:REASON; include gram:COMPARE_SEK; };
vector2 micro:REASON (0.8,0.4);
edge micro:REASON -> fold:COMPARE type calls weight 0.75;
bias tensor:reason_bias target micro:REASON corpus 0.8 learned 1.0 update xul_commit;
buffer tensor:metric dtype f32 shape (2,2) residency cpu init external;
buffer tensor:jacobian dtype f32 shape (2,2) residency cpu init identity;
buffer tensor:input dtype f32 shape (2,1) residency cpu init external;
buffer tensor:output dtype f32 shape (2,1) residency cpu init zero;
provider tensor:TENSOR-mu projection tensor_field rank (1,1) phase Yax authority false metric tensor:metric jacobian tensor:jacobian;
kernel tensor:project provider tensor:TENSOR-mu op matvec2 reads [tensor:metric,tensor:input] writes [tensor:output];
program micro:REASON track track:RESEARCH entry fold:COMPARE phase Sek;
policy xcfe:admit { score wcr_vector; admission xcfe:VERIFY; max_depth 8; commit_phase Xul; };
dispatch tensor:reason_dispatch program micro:REASON kernel tensor:project policy xcfe:admit;
