    "note": "Membership, association, and exclusion declarations are kept distinct. No embedding-generated candidate is promoted to membership."
  },
  "pi_radius_contract": {
    "meaning": "derived radial coordinate from a declared word depth within a domain",
    "unit": "radians",
    "max_depth": 10,
    "formula": "(depth / max_depth) * pi",
    "domain_center_depth": 0,
    "member_default_depth": 1,
    "associated_depth_source": "associated.level",
    "depth_prior_formula": "1 - (depth / max_depth)",
    "depth_prior_is_calibrated_confidence": false,
    "domain_depth_source": "tree_hop_count_from_root",
    "inferred_associated_depth_source": "parent_domain_tree_hop_plus_1"
  },
