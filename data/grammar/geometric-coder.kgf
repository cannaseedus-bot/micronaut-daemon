keygraph "geometric-coder" version "2.0";
namespace coder:core domain custom;
namespace tensor:core domain custom;
namespace fold:core domain fold;
namespace gram:core domain gram;
namespace track:core domain track;
namespace micro:core domain micro;
namespace xcfe:core domain xcfe;
key coder:ANALYZE kind program;
key coder:GENERATE kind program;
key micro:CODER kind program;
key xcfe:CODE_ADMISSION kind contract;
template fold:ANALYZE_CODE domain fold { operator ANALYZE; input source; output structure; };
template fold:GENERATE_CODE domain fold { operator GENERATE; input structure; output candidate; };
trigram gram:ANALYZE_SEK ("analyze",*,*) phase Sek fold fold:ANALYZE_CODE bindings [source:capture];
trigram gram:GENERATE_YAX ("generate",*,*) phase Yax fold fold:GENERATE_CODE bindings [structure:capture];
track track:GEOMETRIC_CODER { include micro:CODER; include gram:ANALYZE_SEK; include gram:GENERATE_YAX; };
policy xcfe:CODE_POLICY { score wcr_vector; admission xcfe:CODE_ADMISSION; max_depth 8; allow_cycle false; commit_phase Xul; };
resolver micro:CODE_EXEC domain micro mode execute policy xcfe:CODE_POLICY;
vector2 micro:CODER (0.95,0.3);
micronaut micro:CODER track track:GEOMETRIC_CODER resolver micro:CODE_EXEC vector micro:CODER;
program coder:ANALYZE track track:GEOMETRIC_CODER entry fold:ANALYZE_CODE phase Sek micronaut micro:CODER;
program coder:GENERATE track track:GEOMETRIC_CODER entry fold:GENERATE_CODE phase Yax micronaut micro:CODER;
bias tensor:analyze_bias target coder:ANALYZE corpus 0.9 learned 1.0 update read_only;
bias tensor:generate_bias target coder:GENERATE corpus 0.8 learned 1.0 update xul_commit;
buffer tensor:metric dtype f32 shape (2,2) residency cpu init external;
buffer tensor:jacobian dtype f32 shape (2,2) residency cpu init identity;
buffer tensor:input dtype f32 shape (2,1) residency cpu init external;
buffer tensor:output dtype f32 shape (2,1) residency cpu init zero;
provider tensor:CODER_FIELD projection tensor_field rank (1,1) phase Yax authority false metric tensor:metric jacobian tensor:jacobian;
kernel tensor:project provider tensor:CODER_FIELD op matvec2 reads [tensor:metric,tensor:input] writes [tensor:output];
dispatch tensor:analyze_dispatch program coder:ANALYZE kernel tensor:project policy xcfe:CODE_POLICY;
dispatch tensor:generate_dispatch program coder:GENERATE kernel tensor:project policy xcfe:CODE_POLICY;
