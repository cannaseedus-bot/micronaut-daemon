  "tool_families": {
    "tool:rpc": {
      "verbs": ["resolve_manifest", "key_query", "fold_graph_parse", "infer", "list_keys", "key_encode", "key_decode", "keyspace_status"],
      "phase": "Pop/Wo",
      "authority": "data_only"
    },
    "tool:file": {
      "verbs": ["sandbox_query", "sandbox_list", "sandbox_violations"],
      "phase": "Ch'en",
      "authority": "data_only"
    },
    "tool:graph": {
      "verbs": ["world_state", "field_dag", "field_dag_svg", "relational_graph"],
      "phase": "Pop",
      "authority": "data_only"
    },
    "tool:xcfe": {
      "verbs": ["xcfe_eval", "kuhul_forge", "fold_execute", "op:if", "op:then", "op:else", "op:for", "op:from", "op:as", "op:cause", "op:direct"],
      "phase": "Pop→Xul",
      "authority": "XCFE_required"
    },
    "tool:dispatch": {
      "verbs": ["micronaut_dispatch"],
      "phase": "Wo/Sek",
      "authority": "proposal_only"
    },
    "tool:math": {
      "verbs": ["math:normalize_number_words", "mathml:parse_compile_evaluate"],
      "phase": "Pop/Wo/Yax/Sek/Ch'en",
      "authority": "data_only",
      "implementation": "lib/mathml-eval.cjs"
    },
    "tool:app": {
      "verbs": ["app:inspect", "app:build_candidate", "app:validate_candidate", "app:edit_spec_and_rebuild"],
      "phase": "Pop→Xul",
      "authority": "proposal_only",
      "route": "worker.py"
    }
  },

  "intent_to_verb": {
    "intent:tool_retrieve": "verb:GET",
    "intent:tool_invoke":   "verb:POST",
    "intent:tool_file_read": "verb:READ",
    "intent:tool_file_write": "verb:WRITE",
    "intent:tool_file_patch": "verb:PATCH",
    "intent:tool_code": "verb:COMPILE",
    "intent:tool_research": "verb:SEARCH",
    "intent:tool_program": "verb:RUN"
  },

  "admission_rule": "Both intent_key (from words.manifest.json) AND registered_verb (from tool.manifest.json) are required for admission. Neither alone is sufficient. InvocationValidationBoundary must be satisfied before any verb is promoted from candidate to dispatch.",
  "execution_boundary": "candidate_only:true on all tool intents — no tool call here grants XCFE execution authority. Execution requires Ch'en verification and Xul commit."
}
