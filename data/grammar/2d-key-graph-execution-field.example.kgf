keygraph "2d-key-graph-execution-field" version "1.0";
namespace CSS:CORE domain css;
namespace TRACK:CORE domain track;
namespace MICRO:CORE domain micro;
namespace FOLD:CORE domain fold;
namespace XCFE:CORE domain xcfe;
namespace GRAM:CORE domain gram;
key CSS:BGPANEL kind primitive value "background:#020b12";
key CSS:BORDER kind primitive value "border:1px solid #334155";
key CSS:PANEL kind composite;
key CSS:CARD kind composite;
edge CSS:PANEL -> CSS:BGPANEL type requires order 1;
edge CSS:PANEL -> CSS:BORDER type requires order 2;
edge CSS:CARD -> CSS:PANEL type requires order 1;
template FOLD:COMPARE domain fold { operator COMPARE; input left; input right; output observation; };
trigram GRAM:COMPARE_SEK ("compare",*,*) phase Sek fold FOLD:COMPARE bindings [left:capture,right:capture];
key MICRO:REASON kind program;
key XCFE:VERIFY kind contract;
edge MICRO:REASON -> FOLD:COMPARE type calls;
edge MICRO:REASON -> XCFE:VERIFY type references;
vector2 MICRO:REASON (0.8,0.6);
track TRACK:RESEARCH { include MICRO:REASON; include GRAM:COMPARE_SEK; };
context TRACK:ACTIVE track TRACK:RESEARCH { query "compare these concepts"; };
policy XCFE:ADMISSION { score wcr_vector; admission XCFE:VERIFY; max_depth 12; commit_phase Xul; };
resolver CSS:EXPAND domain css mode expand;
resolver MICRO:EXEC domain micro mode execute policy XCFE:ADMISSION;
micronaut MICRO:REASON track TRACK:RESEARCH resolver MICRO:EXEC vector MICRO:REASON;
