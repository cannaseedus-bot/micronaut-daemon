{
  "@type": "khanary.xcfe_policy_contracts.v1",
  "version": "1.0.0",
  "authority": "xcfe_control_policy_not_execution",
  "semantic_authority": false,
  "policy_is_data": true,
  "evaluator": "XCFE",
  "law": {
    "control_function": "Pi(Evidence, State, Event) -> (State, Route)",
    "policy_boundary": "Policy != Control != Execution",
    "execution_boundary": "XCFE evaluates policy; backend executors do not.",
    "state_boundary": "Policy does not store Fold Kernel state; it computes the next state and route."
  },
  "policy_ref": {
    "pattern": "^xcfe://[A-Za-z0-9._:-]+/[A-Za-z0-9._:-]+(@[A-Za-z0-9._:+-]+)?$",
    "example": "xcfe://autonomy/default@1.0.0"
  },
  "evidence_fields": [
    "observations",
    "support",
    "exceptions",
    "validated",
    "failures"
  ],
  "weight_fields": [
    "alpha",
    "beta",
    "gamma",
    "delta",
    "epsilon"
  ],
  "route_targets": [
    "local",
    "local-test",
    "fallback"
  ],
  "states": [
    "unbound",
    "observed",
    "learned",
    "bound",
    "validated",
    "autonomous"
  ],
  "events": [
    "authorize",
    "uncertainty",
    "contract_failed"
  ],
  "functions": [
    "clamp",
    "min",
    "max",
    "sqrt",
    "log",
    "exp"
  ],
  "default_derive": "clamp(alpha * support / (observations + epsilon) + beta * validated / (validated + failures + epsilon) - gamma * exceptions / (observations + epsilon) - delta * failures / (validated + epsilon), 0, 1)",
  "total_arithmetic": {
    "zero_over_zero": 0,
    "nonzero_over_zero": "infinity_until_clamped",
    "log_zero": 0,
    "sqrt_negative": 0,
    "nan_policy": "clamp_or_zero"
  },
  "invariants": {
    "W1": "alpha + beta + gamma + delta = 1",
    "W2": "epsilon > 0",
    "W3": "fallback <= autonomy",
    "W4": "hysteresis <= autonomy - fallback",
    "W5": "alpha >= 0 and beta >= 0 and gamma >= 0 and delta >= 0",
    "W6": "failure_limit >= 0",
    "W7": "routes covers {autonomous, validated, default}",
    "W8": "inputs subset_of {observations, support, exceptions, validated, failures}",
    "W9": "evidence_vars(derive) subset_of inputs",
    "W10": "vars(guards) subset_of inputs union {confidence}"
  },
  "transition": {
    "validated_to_autonomous": {
      "from_state": "validated",
      "condition": "confidence >= thresholds.autonomy and failures <= thresholds.failure_limit",
      "to_state": "autonomous",
      "route": "@routes.@autonomous"
    },
    "autonomous_stays_autonomous": {
      "from_state": "autonomous",
      "condition": "confidence >= thresholds.fallback and failures <= thresholds.failure_limit",
      "to_state": "autonomous",
      "route": "@routes.@autonomous"
    },
    "autonomous_to_bound_low_confidence": {
      "from_state": "autonomous",
      "condition": "confidence < thresholds.fallback",
      "to_state": "bound",
      "route": "@routes.@default"
    },
    "autonomous_to_bound_failure_limit": {
      "from_state": "autonomous",
      "condition": "failures > thresholds.failure_limit",
      "to_state": "bound",
      "route": "@routes.@default"
    },
    "contract_failed_to_learned": {
      "event": "contract_failed",
      "to_state": "learned",
      "route": "@routes.@default"
    },
    "validated_default": {
      "from_state": "validated",
      "condition": "confidence >= thresholds.fallback",
      "to_state": "validated",
      "route": "@routes.@validated"
    },
    "otherwise": {
      "to_state": "same",
      "route": "@routes.@default"
    }
  }
}
