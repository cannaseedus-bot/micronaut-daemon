(* ================================================================
   K'UHUL π — CANONICAL EBNF
   Version: π-1.2.0 + tensor-bundle-grounding/v8

   Semantic algebra:
       <Φ, F, G, γ, θ, Π, S>

   Tensor bundle grounding:
       M  = SVG-3D base manifold / FoldGraph projection manifold
       θ  = discrete connection on C6, with arc_weight=cos(Δθ)
       γ  = geodesic selected under that connection, not the connection itself
       G  = rank-p gram basis, V^tensor_p
       Π  = projection/interior-product-shaped observation, not exterior d

   Closed phase cycle:
       Pop -> Wo -> Yax -> Sek -> Ch'en -> Xul -> Pop'

   Fundamental laws:

       Fold != Xul
       K'UHULSemanticFold != KLSLFold
       K'UHULSemanticFold != KXCFold
       K'UHULSemanticFold != KHLCFold
       Phase != Opcode
       Reachability != Authority
       Representation != Authority
       Vocabulary != Authority
       Usage != Confidence
       Proposal != Commit
       Verified != Authorized
       Relation-shaped data != Topological relation

       ΔB != 0
           => Xul
           AND XCFE-authorized
           AND transaction-bound CommitAuthority

   XCFE owns control.
   K'UHUL owns semantic execution.
   KLSL/KXC/KHLC folds are backend/compiler lowering folds unless they
   explicitly preserve the K'UHUL semantic fold contract:
       N(k) --[alpha, theta]--> B --Xul--> k'
   Ch'en verifies.
   Xul is the only topology commit boundary.

   Implementation layer covered by sections 24-29:
       XCFE Node ISA (14 classes), KLSL glyphs, Gram store protocol,
       NGram pipeline detail, WCR scoring / B_tau projection,
       Bracket programs (KuhulVM).
   ================================================================ *)


(* ================================================================
   1. PROGRAM
   ================================================================ *)

program
    ::= pi_open
        declaration*
        manifold_definition*
        bundle_definition*
        event_definition*
        cso_definition*
        fold_binding_definition*
        fold_definition*
        micronaut_definition*
        semantic_cycle
        pi_close
    ;

pi_open
    ::= "pi-open"
    ;

pi_close
    ::= "pi-close"
    ;


(* ================================================================
   2. CLOSED SEMANTIC CYCLE
   ================================================================ *)

semantic_cycle
    ::= pop_phase
        wo_phase
        yax_phase
        sek_phase
        chen_phase
        xul_phase
    ;

phase
    ::= pop_phase
      | wo_phase
      | yax_phase
      | sek_phase
      | chen_phase
      | xul_phase
    ;

pop_phase  ::= "Pop"   phase_body ;
wo_phase   ::= "Wo"    phase_body ;
yax_phase  ::= "Yax"   phase_body ;
sek_phase  ::= "Sek"   phase_body ;
chen_phase ::= "Ch'en" phase_body ;
xul_phase  ::= "Xul"   xul_body  ;

phase_body ::= "{" phase_statement* "}" ;
xul_body   ::= "{" xul_statement*   "}" ;


(* ================================================================
   3. PHASE GEOMETRY
   C6 cyclic group. Index i carries angle i*(pi/3).
   arc_weight(from,to) = cos(angle_to - angle_from).
   θ is the connection / parallel-transport prescription.
   The geodesic propagator computes paths under that connection.
   SC-1c: Connection != geodesic.
   SC-1: only four arc weights are possible.
   ================================================================ *)

phase_angle
    ::= "0"
      | "pi/3"
      | "2pi/3"
      | "pi"
      | "4pi/3"
      | "5pi/3"
    ;

phase_ref
    ::= "Pop" | "Wo" | "Yax" | "Sek" | "Ch'en" | "Xul"
    ;

phase_transition     ::= phase_ref "->"  phase_ref ;

(* horizontal_transition: same phase, delta_theta=0, weight=+1.0.
   SC-2: always authorized. *)
horizontal_transition ::= track_ref "<->" track_ref ;


(* ================================================================
   4A. TENSOR BUNDLE GROUNDING

   K'UHUL tensor geometry is projection-only unless a later Ch'en/Xul
   authority path commits topology. These productions make the bundle
   calculus addressable without letting grammar manufacture truth.
   ================================================================ *)

manifold_definition
    ::= "manifold" identifier ":" manifold_type [ "(" integer ")" ] [ manifold_body ]
    ;

manifold_body ::= "{" manifold_statement* "}" ;

manifold_statement
    ::= invariant_assertion
      | "metric" ":" metric_kind
      | "dimension" ":" integer
    ;

manifold_type
    ::= "euclidean"
      | "riemannian"
      | "minkowski"
      | "pi_harmonic"
      | "geodesic"
      | "spherical"
      | "smooth"
    ;

metric_kind
    ::= "flat"
      | "conformal"
      | "riemannian"
      | "pseudo_riemannian"
      | "discrete"
    ;

bundle_definition
    ::= "bundle" identifier "over" identifier "{"
            bundle_section*
        "}"
    ;

bundle_section
    ::= fiber_section
      | connection_section
      | geodesic_section
      | tensor_section
    ;

fiber_section
    ::= "fiber" "{"
            "rank" ":" tensor_rank ","
            "dimension" ":" integer ","
            "stride" ":" integer
        "}"
    ;

connection_section
    ::= "connection" "{"
            "type" ":" connection_type ","
            "arc_weight" ":" expression ","
            "holonomy" ":" holonomy_type
        "}"
    ;

geodesic_section
    ::= "geodesic" "{"
            "propagator" ":" identifier ","
            "minimizes" ":" minimization_target
            [ "," "raychaudhuri" ":" raychaudhuri_metric ]
        "}"
    ;

tensor_section
    ::= "tensor" "{"
            "rank" ":" tensor_rank ","
            "authority" ":" projection_authority
        "}"
    ;

tensor_rank ::= "(" integer "," integer ")" ;

connection_type
    ::= "riemannian"
      | "levi_civita"
      | "discrete"
      | "discrete_circle"
    ;

holonomy_type ::= "path_ordered" | "abelian" ;

minimization_target ::= "entropy" | "action" | "length" ;

projection_authority ::= "projection_only" | "semantic_authority_false" ;

raychaudhuri_metric
    ::= "{"
            "focusing" ":" expression ","
            "expansion" ":" expression
        "}"
    ;

bundle_ref ::= identifier ;
connection_ref ::= identifier "." "connection" ;
geodesic_ref ::= identifier ;
parallel_transport ::= "parallel_transport" "(" expression "," geodesic_ref "," connection_ref ")" ;
tensor_product ::= expression "⊗" expression ;
einstein_contraction ::= expression "⊓" expression ;
interior_product ::= "ι" "(" expression "," expression ")" ;

(* ================================================================
   4B. HYPERBOLIC EVENT AND HARDWARE KERNEL SURFACES

   Events are key-grammar memory/routing projections on a Minkowski
   future sheet. CSO declarations bind hash-identified compiled shader
   artifacts to CDATA kernel source envelopes. Both are projection and
   execution surfaces; neither can manufacture semantic authority.
   ================================================================ *)

event_definition
    ::= "event" identifier "at" minkowski_four_vector "{"
            "track" ":" string ","
            "rapidity" ":" expression ","
            "direction" ":" list ","
            "interval" ":" interval_signature
            [ "," "holographic_boundary" ":" mesh_inequality ]
        "}"
    ;

event_decl ::= event_definition ;

minkowski_four_vector
    ::= "[" expression "," expression "," expression "," expression "]"
    ;

interval_signature
    ::= "timelike" | "spacelike" | "lightlike"
    ;

mesh_inequality
    ::= "{"
            "circumradius_R" ":" expression ","
            "inradius_r" ":" expression
        "}"
    ;

cso_definition
    ::= "cso" identifier [ "id" ":" cso_hash_id ] "{"
            "manifest" ":" object ","
            "kernel" ":" cdata_block
        "}"
    ;

cso_decl ::= cso_definition ;

cdata_block
    ::= "<![CDATA[" hlsl_kernel_source "]]>"
    ;

cso_hash_id
    ::= string
    ;

hlsl_kernel_source
    ::= ? raw unescaped HLSL/DirectCompute shader source code text ?
    ;


(* ================================================================
   4C. FOLD BINDING CONTRACTS

   Fold Binding = (alpha, theta, backend, entrypoint, contract).
   K'UHUL owns alpha and theta. The backend owns the entrypoint.
   The binding is a contract-carrying link, not an identity:

       Fold -> Phase Binding -> Backend Binding -> Executor
       K'UHUL Fold -> Fold Binding -> KXC -> HLSL -> GPU

   Bind_backend(alpha_theta) = K_theta^backend.
   Valid iff K_theta^backend models Contract(alpha_theta).
   ================================================================ *)

fold_binding_definition
    ::= "bind" "fold" identifier "phase" phase_ref
        "to" backend_target "entry" identifier
        "{"
            fold_binding_section*
        "}"
    ;

fold_binding_decl ::= fold_binding_definition ;

fold_binding_section
    ::= semantic_binding_section
      | dispatch_binding_section
      | backend_contract_section
    ;

semantic_binding_section
    ::= "semantic" ":" string
    ;

dispatch_binding_section
    ::= "dispatch" ":" dispatch_shape
    ;

backend_contract_section
    ::= "contract" ":" hoare_contract
    ;

backend_target
    ::= "hlsl"
      | "cuda"
      | "cpp"
      | "scxq2"
      | "wgsl"
      | "cpu"
      | "kxc"
      | "khlc"
    ;

dispatch_shape
    ::= "[" integer "," integer "," integer "]"
    ;

hoare_contract
    ::= "{"
            "pre" ":" contract_predicate ","
            "post" ":" contract_predicate
        "}"
    ;

contract_predicate
    ::= string | identifier
    ;

(* vertical_transition: adjacent phase step, delta_theta=pi/3, weight=+0.5.
   SC-3: dist MUST equal 1; requires XCFE authorization. *)
vertical_transition  ::= phase_ref "=>"  phase_ref ;


(* ================================================================
   4. FOLD / UNFOLD

   State: Omega = (phi, T, s)
     phi = phase
     T   = active semantic track
     s   = 0 folded | 1 unfolded

   Legal primitive:
       Handle -> Unfold -> Neighborhood
              -> Attention -> Fold -> Handle'

   Fold does NOT mutate B.
   Fold/unfold may occur repeatedly at one phase without advancing phi.
   ================================================================ *)

fold_definition
    ::= "fold" identifier
        "{"
            fold_member*
        "}"
    ;

fold_member
    ::= node_definition
      | relation_definition
      | field_definition
      | invariant_definition
    ;

fold_operation
    ::= unfold_operation
      | fold_operation_close
      | fold_entry_binding
    ;

unfold_operation   ::= "unfold" "(" track_ref [ "," handle_ref ] ")" ;
fold_operation_close ::= "fold" "(" track_ref [ "," field_ref ] ")" ;

(* FoldEntry: per-node fold hook binding. *)
fold_entry_binding
    ::= "fold_entry"
        "("
            phase_ref ","
            fold_hook ","
            fold_monitor_expr ","
            fold_action
        ")"
    ;

fold_hook        ::= "on_read" | "on_write" | "on_gc" ;
fold_monitor_expr ::= string ;
fold_action      ::= "warn_clip" | "promote_checkpoint" ;

fold_state ::= "folded" | "unfolded" ;
fold_bit   ::= "0" | "1" ;
handle_ref ::= identifier ;


(* ================================================================
   5. SEMANTIC FIELD

   Unfold(T) -> F_Q   (working field, not topology)
   Fold(T)   -> C_T   (collapsed back)

   F_Q is a composite structure. Its full composition:

       F_Q = { N, E, V, K, W, C, Sym, ... }

         N   = nodes (semantic objects from gram store / topology)
         E   = relations between nodes
         V   = semantic vectors (value payloads addressed by K)
         K   = key vectors (capability/profile vectors per micronaut)
         W   = learned weights (per micronaut)
         C   = evidence confidence (per micronaut)
         Sym = symbolic projections (MathML / math-mu)

   The field is NOT a vector. It can CONTAIN vectors as part of
   its semantic state.

   Unfold(T) exposes T's semantic neighborhood AND its associated
   vector representations (Q, K, V) into F_Q.

   For WCR attention operating over the field:
       Q  = vec(current task / field state)
       K_mu = vec(Micronaut capability / semantic profile)
       R_mu = cos(Q, K_mu)
   If V_mu exists: K_mu -> V_mu (semantic payload addressed by key).
   "Q/K locate relevance; W/C qualify relevance; Key addresses V; Yax admits V."

   F_Q is not topology B. Accumulating vectors/nodes/relations into
   F_Q is observation; only an authorized Xul commit mutates B.
   SC-4: field_accumulation must not call topology_mutation directly.
   ================================================================ *)

field_definition
    ::= "field" identifier ":" field_type
    ;

field_type
    ::= "query"           (* field anchored on a query vector Q         *)
      | "semantic"        (* general semantic neighborhood field         *)
      | "vector_bearing"  (* field carrying Q, K, V vector components   *)
      | "candidate"       (* set of candidate micronaut contributions    *)
      | "observation"     (* read-only observation over gram store       *)
      | "evidence"        (* Ch'en evidence accumulation field           *)
      | "projection"      (* symbolic / MathML projection field          *)
      | "bounded"         (* field with explicit fold boundary           *)
    ;

field_ref ::= identifier ;

field_accumulation ::= field_ref "<-" contribution ;

contribution
    ::= node_ref
      | relation_ref
      | semantic_vector
      | key_vector_binding
      | value_payload
      | projection
      | evidence
    ;

(* Semantic vector: a float vector associated with a named semantic entity. *)
semantic_vector
    ::= "vec" "(" identifier ")"
    ;

(* Query vector Q = vec(current task / field state): *)
query_vector
    ::= "Q" "=" "vec" "(" field_ref ")"
    ;

(* Key vector K_mu = vec(Micronaut capability / semantic profile): *)
key_vector_binding
    ::= "K" "(" micronaut_id ")" "=" "vec" "(" identifier ")"
    ;

(* Value payload V_mu: semantic content addressed by key K_mu.
   K_mu -> V_mu is addressing; V_mu is what Yax admits. *)
value_payload
    ::= "V" "(" micronaut_id ")" "=" identifier
    ;

(* Key addressing: K -> V (not a mutation of B). *)
key_addresses_value
    ::= "K" "(" micronaut_id ")" "->" "V" "(" micronaut_id ")"
    ;

(* ── Vector-bearing field — concrete scored form ──────────────────────
   F_Q as a set of SemanticRecord_i indexed by gram candidates.
   The field is NOT a vector; vectors are components inside each record.

   Central semantic path:
       F_Q -> SemanticRecord_i -> W_i*C_i*R_i -> Geometry_i
           -> Legal_i -> YaxAdmission_i

   SemanticRecord is the concrete unit that carries all five field
   coordinates needed by the GPU admission kernel. *)
semantic_field
    ::= "field" field_id "{"
            semantic_record_entry*
        "}"
    ;

field_id ::= identifier ;

semantic_record_entry
    ::= "record" gram_ref "{"
            vector_component
            weight_component
            confidence_component
            relevance_component
            geometry_component*
            legality_component*
        "}"
    ;

gram_ref ::= identifier ;

vector_component
    ::= "vector" ":" "[" number { "," number } "]"
    ;

weight_component      ::= "W" ":" number ;
confidence_component  ::= "C" ":" number ;
relevance_component   ::= "R" ":" number ;

(* Geometry derived from the gram's semantic/geodesic vector v=(x,y,z):
   fold_weight     = ||v||                      (geodesic reach)
   relation_weight = sqrt(x^2+y^2) / ||v||     (equatorial component)
   phase_weight    = 0.5 + 0.5*(z / ||v||)     (vertical component) *)
geometry_component
    ::= "fold_weight"     ":" number
      | "relation_weight" ":" number
      | "phase_weight"    ":" number
    ;

(* Legality gate — hard binary before scoring.
   policy_ok, capable, xcfe_ok each >= 0.5 to be legal.
   HIGH SCORE CANNOT MANUFACTURE LEGALITY.  (SC-27) *)
legality_component
    ::= "policy_ok" ":" boolean
      | "capable"   ":" boolean
      | "xcfe_ok"   ":" boolean
    ;


(* ================================================================
   6. TOPOLOGY B

   B = (V, E, A, W, S)
     V = nodes    E = relations
     A = attributes  W = weights  S = persistent semantic state

   Reading B is not mutation.
   Describing deltaB is not mutation.
   Only authorized Xul commit may mutate B.
   SC-5: every topology_mutation must be wrapped in a proposal
         and verified before it can appear in xul_statement.
   ================================================================ *)

topology_read
    ::= "read" "B" topology_selector
    ;

topology_selector
    ::= node_ref
      | relation_ref
      | neighborhood
    ;

neighborhood
    ::= "N" "(" handle_ref "," relation_type ")"
    ;

topology_delta
    ::= "deltaB" "{"
            topology_mutation*
        "}"
    ;

topology_mutation
    ::= node_proposal
      | relation_proposal
      | attribute_proposal
      | weight_proposal
      | state_proposal
    ;


(* ================================================================
   7. NODES
   ================================================================ *)

node_definition
    ::= "node" node_id
        "{"
            node_property*
        "}"
    ;

node_property
    ::= "type"   ":" identifier
      | "value"  ":" value
      | "symbol" ":" symbol
      | "weight" ":" number
      | "state"  ":" value
    ;

node_ref ::= node_id ;
node_id  ::= identifier ;


(* ================================================================
   8. RELATIONS

   RelationISA defines vocabulary.
   A valid RelationVerb does NOT itself create E(B).
   TypedRelation != CommittedRelation  (SC-6)
   ================================================================ *)

relation_definition
    ::= "relation" node_ref relation_verb node_ref
    ;

relation_proposal
    ::= "propose_relation" "(" node_ref "," relation_verb "," node_ref ")"
    ;

relation_ref  ::= identifier ;
relation_type ::= identifier ;

relation_verb ::= canonical_relation_verb ;

canonical_relation_verb
    ::= "@is_a"
      | "@part_of"
      | "@supports"
      | "@requires"
      | "@governs"
      | "@delegates_to"
      | "@related_to"
      | "@causes"
      | "@enables"
      | "@contradicts"
      | "@co_occurs_with"
      | relation_isa_extension
    ;

relation_isa_extension ::= identifier ;

(* SC-7: relation_isa_extension must be a registered alias.
   Unknown verbs produce MISS_relation; never resolve to @related_to. *)


(* ================================================================
   9. MICRONAUTS / TRACKS

   Track participation != governing-track ownership.
   Multiple tracks may unfold/fold horizontally at one phase.
   ================================================================ *)

micronaut_definition
    ::= "micronaut" micronaut_id
        "{"
            capability_declaration*
            track_binding*
        "}"
    ;

micronaut_id ::= identifier ;
track_ref    ::= identifier ;

track_binding         ::= "track" ":" track_ref ;
capability_declaration ::= "requests" capability_set ;
capability_set        ::= "[" [ capability { "," capability } ] "]" ;
capability            ::= identifier ;


(* ================================================================
   10. CAPABILITY LIFECYCLE

   C_granted subset_of C_verified subset_of C_requested
   A requested capability has no execution authority.
   ================================================================ *)

capability_proposal    ::= "capability_request"  capability_set ;
capability_verification ::= "capability_verified" capability_set ;
capability_grant       ::= "capability_granted"  capability_set ;


(* ================================================================
   11. YAX ATTENTION / WCR

   Canonical selection formula:
       S_mu(Q) = W_mu * C_mu * R_mu(Q)
       R_mu(Q) = cos(Q, K_mu)

   - W_mu = learned/reinforced weight of the micronaut/track
   - C_mu = confidence (evidence-based; SC-8: never usage frequency)
   - R_mu = query-conditioned relevance via cosine similarity
   - S_mu = Yax admission/selection score

   Q = vec(current task / field state)       -- from Unfold(T) -> F_Q
   K_mu = vec(Micronaut capability / profile) -- from key_vector_binding
   V_mu = semantic payload addressed by K_mu  -- what Yax admits

   Q/K locate relevance. W/C qualify relevance. Key addresses V. Yax admits V.

   Q and K are inside R_mu:
       Q * K_mu  ->  R_mu
   then:
       (W_mu, C_mu, R_mu)  ->  S_mu

   NOT transformer QKV: Q and K are semantic/capability vectors;
   W and C qualify from outside relevance. V is the payload, not a
   value projection matrix.

   WCR is NOT extended by usage. Usage has its own path (section 12).

   Full Yax pipeline:
       Requirements -> Eligibility -> WCR -> Ranking -> Omega -> Yax

   1. eligibility  -- capability/phase gate (binary, before scoring)
   2. wcr          -- S_i = W_i * C_i * R_i  (soft score per eligible mu)
   3. normalize    -- p_i = S_i / sum_j(S_j)
   4. entropy      -- H = -sum_i(p_i * log2(p_i))
                      H_hat = H / log2(|Eligible|)
   5. admit        -- S_i >= admission_threshold (0.35)
                      B_tau[h,*] fold neighborhood shapes the candidate set

   Admission threshold: 0.35.
   ================================================================ *)

attention  ::= "attend"  "(" query_ref "," track_ref ")" ;
selection  ::= "select"  "(" candidate_set ")" ;

candidate_set ::= "[" [ candidate { "," candidate } ] "]" ;
candidate     ::= identifier ;
query_ref     ::= identifier ;

(* Eligibility: hard binary gate applied before WCR scoring. *)
eligibility
    ::= "eligible" "(" micronaut_id "," operation_ref ")" "->" boolean
    ;

operation_ref ::= identifier ;

(* WCR score for one eligible micronaut: *)
wcr_expression ::= weight "*" confidence "*" relevance ;
weight         ::= number ;
confidence     ::= number ;

(* relevance R_mu = cos(Q, K_mu).
   Q = vec(field/task); K_mu = vec(micronaut capability profile). *)
relevance
    ::= "cos" "(" vec_expr "," vec_expr ")"
    ;

vec_expr
    ::= query_vector        (* Q = vec(field_ref)         *)
      | key_vector_binding  (* K(mu) = vec(identifier)    *)
      | semantic_vector     (* vec(identifier) — any named vector *)
      | key_ref             (* bare identifier for inline use *)
    ;

key_ref ::= identifier ;

(* Normalize across eligible set to get selection distribution: *)
normalized_score
    ::= "normalize" "(" wcr_expression "," candidate_set ")"
    ;

(* Routing entropy over the normalized distribution:
   H     = -sum_i(p_i * log2(p_i))
   H_hat = H / log2(|Eligible|)
   Low H_hat = confident routing; high H_hat = routing uncertainty. *)
routing_entropy
    ::= "entropy" "(" candidate_set ")"
    ;


(* ================================================================
   12. USAGE != CONFIDENCE

   Three distinct quantities -- never collapse them:

   U(k) = usage / retrieval frequency
   C(k) = evidence confidence  (SC-8: only from Ch'en verification)
   V(k) = epistemic verdict

   Roles:
     U(k) -> RetrievalStrength(k)
             influences which candidates enter F_Q (pre-admission)
     S = W * C * R
             determines admission inside F_Q (post-retrieval)

   Usage is useful for surfacing associations cheaply.
   It does NOT enter the WCR formula.
   Adding usage to the score (WUCR) is rejected -- it conflates
   retrieval strength with epistemic confidence.

   Lookup may change U. Lookup MUST NOT change C.
   SC-8: confidence_update is ONLY triggered by evidence_score
         from Ch'en verification, never from lookup alone.
   ================================================================ *)

usage              ::= "usage"            "(" key_ref ")" ;
confidence_state   ::= "confidence"       "(" key_ref ")" ;
verdict            ::= "UNKNOWN" | "GOOD" | "BAD" ;
verdict_statement  ::= "verdict"          "(" key_ref ")" "=" verdict ;
lookup             ::= "lookup"           "(" key_ref ")" ;
usage_update       ::= "usage"            "(" key_ref ")" "<-" number ;
retrieval_strength ::= "retrieval_strength" "(" key_ref ")" ;
retrieval_strength_update
                   ::= "retrieval_strength" "(" key_ref ")" "<-" number ;
confidence_update  ::= "confidence"       "(" key_ref ")" "<-" evidence_score ;
evidence_score     ::= number ;


(* ================================================================
   13. MATH-mu / MATHML SEMANTIC PROJECTION

   Math-mu is activated by symbolic semantic relevance,
   not merely by a "math question."

   Activation flow:
       Words -> Nodes -> SemanticGraph -> Math-mu -> MathML
                                                   -> symbolic reasoning

   MathML does NOT mutate B.
   Math-mu participation does not require Math-mu to govern Q.
   SC-9: mathml_projection produces representation only;
         no side-effect on topology B or gram store.
   ================================================================ *)

math_projection
    ::= "math" "{"
            math_statement*
        "}"
    ;

math_statement
    ::= symbolic_binding
      | symbolic_relation
      | symbolic_constraint
      | symbolic_function
      | mathml_projection
    ;

symbolic_binding  ::= math_symbol ":=" node_ref ;
math_symbol       ::= identifier ;
symbolic_relation ::= math_expression relation_operator math_expression ;
symbolic_constraint ::= math_expression constraint_operator math_expression ;

symbolic_function
    ::= math_symbol "=" function_expression
    ;

function_expression
    ::= identifier "(" [ math_expression_list ] ")"
    ;

math_expression_list ::= math_expression { "," math_expression } ;

math_expression
    ::= math_symbol
      | number
      | function_expression
      | "(" math_expression ")"
    ;

relation_operator
    ::= "=" | "!=" | "<" | ">" | "<=" | ">=" | "=>" | "<=>"
    ;

constraint_operator ::= relation_operator ;

mathml_projection
    ::= "MathML" "(" semantic_expression ")"
    ;

semantic_expression
    ::= symbolic_relation
      | symbolic_constraint
      | symbolic_function
    ;


(* ================================================================
   14. PROPOSAL / VERIFICATION
   ================================================================ *)

proposal
    ::= topology_delta
      | candidate_proposal
      | capability_proposal
    ;

candidate_proposal
    ::= "candidate" "{"
            proposal_member*
        "}"
    ;

proposal_member
    ::= node_proposal
      | relation_proposal
      | attribute_proposal
      | weight_proposal
      | state_proposal
      | capability_proposal
    ;

node_proposal
    ::= "propose_node" node_definition
    ;

attribute_proposal
    ::= "propose_attribute" "(" node_ref "," identifier "," value ")"
    ;

weight_proposal
    ::= "propose_weight" "(" relation_ref "," number ")"
    ;

state_proposal
    ::= "propose_state" "(" node_ref "," value ")"
    ;

verification
    ::= "verify" "(" proposal_ref ")" "->" verification_result
    ;

proposal_ref        ::= identifier ;
verification_result ::= "PASS" | "FAIL" | "UNKNOWN" ;


(* ================================================================
   15. XCFE AUTHORIZATION

   XCFE owns control algebra.
   K'UHUL syntax may reference authorization results but MUST NOT
   manufacture control authority.
   ================================================================ *)

xcfe_authorization ::= "xcfe_authorized" "(" proposal_ref ")" ;
authorization_result ::= "ALLOW" | "DENY" ;

(* XCFE eval dispatch (first key present wins):
     @if -> conditional branch     @for  -> iteration
     @from -> origin extraction    @as   -> alias/cast
     @cause -> causal link         @direct -> op dispatch
   See XCFE Node ISA in section 24 for the 14-class closed set. *)

xcfe_eval_node
    ::= xcfe_if_node
      | xcfe_for_node
      | xcfe_from_node
      | xcfe_as_node
      | xcfe_cause_node
      | xcfe_direct_node
      | xcfe_fn_node
      | xcfe_node_ref
      | xcfe_literal
    ;

xcfe_if_node
    ::= "{" "\"@if\""     ":" string ","
            "\"@then\""   ":" xcfe_eval_node
        [ "," "\"@else\"" ":" xcfe_eval_node ] "}"
    ;

xcfe_for_node
    ::= "{" "\"@for\""  ":" string
        [ "," "\"@as\"" ":" string ]
        [ "," "\"@index\"" ":" string ]
        [ "," "\"@do\"" ":" xcfe_eval_node ] "}"
    ;

xcfe_from_node
    ::= "{" "\"@from\"" ":" string
        [ "," "\"@as\"" ":" string ]
        [ "," "\"@do\"" ":" xcfe_eval_node ] "}"
    ;

xcfe_as_node
    ::= "{" "\"@as\"" ":" string
        [ "," "\"@value\"" ":" xcfe_eval_node ]
        [ "," "\"@cast\""  ":" cast_type ]
        [ "," "\"@do\""    ":" xcfe_eval_node ] "}"
    ;

cast_type ::= "string" | "upper" | "lower" | "key" | "number" | "bool" ;

xcfe_cause_node
    ::= "{" "\"@cause\"" ":" string
        [ "," "\"@because\"" ":" string ] "}"
    ;

xcfe_direct_node
    ::= "{" "\"@direct\"" ":" string "}"
    ;

xcfe_fn_node
    ::= "{" "\"@fn\"" ":" string "," "\"@args\"" ":" xcfe_string_args "}"
    ;

xcfe_string_args  ::= "{" [ xcfe_string_field { "," xcfe_string_field } ] "}" ;
xcfe_string_field ::= string ":" string ;   (* SC-10: values are strings only *)

xcfe_node_ref ::= "{" "\"@node\"" ":" string "}" ;
xcfe_literal  ::= string | number | boolean | "null" ;


(* ================================================================
   16. XUL COMMIT

   CommitAuthority is a runtime capability.
   It is NOT expressible in K'UHUL source syntax.
   No production of this grammar manufactures a CommitAuthority.

   Informative identity (runtime):
       A_commit = Authority(scope, proposal_identity)

   Required by XulGate::authorize_commit:
       phase == Xul
       proposal_verified
       mutation_authorized
       scope_permitted
       bound authorizer grants
       proposal identity matches

   Authority is transaction-bound, move-only, single-use.

   SC-11: xul_statement may REFERENCE a verified_proposal_ref but
          cannot construct or copy a CommitAuthority value.
   ================================================================ *)

xul_statement
    ::= commit_statement
      | projection
      | invariant_assertion
    ;

commit_statement ::= "commit" "(" verified_proposal_ref ")" ;
verified_proposal_ref ::= identifier ;


(* ================================================================
   17. INVARIANTS
   ================================================================ *)

invariant_definition  ::= "invariant" identifier ":" invariant_expression ;
invariant_assertion   ::= "assert" invariant_expression ;
invariant_expression  ::= expression ;

canonical_invariant
    ::= "collapse_only"
      | "topology_preserving_before_xul"
      | "proposal_not_commit"
      | "usage_not_confidence"
      | "reachability_not_authority"
      | "representation_not_authority"
    ;


(* ================================================================
   18. PHASE STATEMENTS
   ================================================================ *)

phase_statement
    ::= declaration
      | bundle_definition
      | manifold_definition
      | event_definition
      | cso_definition
      | fold_binding_definition
      | topology_read
      | fold_operation
      | field_accumulation
      | attention
      | selection
      | lookup
      | usage_update
      | verdict_statement
      | math_projection
      | proposal
      | verification
      | xcfe_authorization
      | xcfe_eval_node
      | projection
      | invariant_assertion
    ;


(* ================================================================
   19. DECLARATIONS
   ================================================================ *)

declaration
    ::= immutable_declaration
      | invariant_definition
      | field_definition
      | manifold_definition
      | bundle_definition
      | event_definition
      | cso_definition
      | fold_binding_definition
    ;

immutable_declaration ::= "Wo" identifier "=" value ;


(* ================================================================
   20. PROJECTION

   Projection is representation, never topology authority.
   ================================================================ *)

projection ::= "project"  "(" expression ")" ;
evidence   ::= "evidence" "(" expression ")" ;


(* ================================================================
   21. EXPRESSIONS / DATA
   ================================================================ *)

expression
    ::= value
      | identifier
      | node_ref
      | relation_ref
      | field_ref
      | bundle_ref
      | connection_ref
      | geodesic_ref
      | parallel_transport
      | tensor_product
      | einstein_contraction
      | interior_product
      | math_expression
      | "(" expression ")"
    ;

value   ::= string | number | boolean | null | list | object ;
list    ::= "[" [ value { "," value } ] "]" ;
object  ::= "{" [ object_member { "," object_member } ] "}" ;
object_member ::= string ":" value ;
boolean ::= "true" | "false" ;
null    ::= "null" ;


(* ================================================================
   22. LEXICAL
   ================================================================ *)

identifier
    ::= identifier_start { identifier_continue }
    ;

identifier_start
    ::= letter | "_" | "@" | "mu-char"
    ;

identifier_continue
    ::= identifier_start | digit | "-" | "." | "'"
    ;

symbol    ::= identifier ;
string    ::= ? JSON string ? ;
number    ::= [ "-" ] digit { digit } [ "." digit { digit } ] ;
letter    ::= "A".."Z" | "a".."z" ;
digit     ::= "0".."9" ;


(* ================================================================
   23. CLOSED-LAW SUMMARY

   1.  Pop is semantic entry.
   2.  Phase order is closed:
           Pop -> Wo -> Yax -> Sek -> Ch'en -> Xul -> Pop'

   3.  Horizontal semantic composition:
           unfold(T) -> work -> fold(T)
       may occur repeatedly without advancing phi.

   4.  Fold/unfold never commits topology.

   5.  MathML is a symbolic projection over semantic nodes.
       Math-mu participation does not require Math-mu to govern Q.

   6.  RelationVerb validity does not create a relation in B.

   7.  Usage/retrieval frequency does not constitute confidence.

   8.  Sek may propose deltaB.
       Ch'en may verify deltaB.
       XCFE may authorize deltaB.
       Only Xul may commit authorized deltaB.

   9.  CommitAuthority is external runtime authority:
           scope + proposal_identity
       transaction-bound, non-copyable, single-use.

   10. No syntax in this grammar may manufacture CommitAuthority.

   11. For every non-Xul semantic phase:
           B_out = B_in

   12. Therefore:
           B(t+1) != B(t)
               => Xul
               AND Authorized(deltaB)
               AND IdentityBound(deltaB)

   13. XCFE remains the control algebra.
       K'UHUL pi remains the semantic/execution algebra.
   ================================================================ *)


(* ================================================================
   24. XCFE NODE ISA — IMPLEMENTATION LAYER
   14-class closed set. CanonicalPhase is total (SC-12).
   ================================================================ *)

xcfe_node_class
    ::= "CONDITION"       (* -> Wo    *)
      | "ROUTING"         (* -> Wo    *)
      | "CAUSAL"          (* -> Wo    *)
      | "STRUCTURE"       (* -> Wo    *)
      | "SELECTION"       (* -> Yax   *)
      | "EXECUTION"       (* -> Sek   *)
      | "CAPABILITY"      (* -> Sek   *)
      | "TRANSFORM"       (* -> Sek   *)
      | "VERIFICATION"    (* -> Ch'en *)
      | "CONSEQUENCE"     (* -> Ch'en *)
      | "COMMIT"          (* -> Xul   *)
      | "MEMORY"          (* -> Pop   *)
      | "NEGATION"        (* -> Pop   *)
      | "KUHUL_RUNTIME"   (* -> Pop   *)
    ;

xcfe_operator_name
    ::= "DEPENDENCY" | "CONSTRAINT"             (* -> CONDITION  *)
      | "ROUTING"                                (* -> ROUTING    *)
      | "CAUSE"                                  (* -> CAUSAL     *)
      | "BOUNDARY" | "RELATION"                  (* -> STRUCTURE  *)
      | "ALTERNATIVE"                            (* -> SELECTION  *)
      | "DIRECT"                                 (* -> EXECUTION  *)
      | "CAPABILITY"                             (* -> CAPABILITY *)
      | "SUBSTITUTE"                             (* -> TRANSFORM  *)
      | "EVIDENCE" | "TEST" | "VERIFY"           (* -> VERIFICATION *)
      | "SEQUENCE"                               (* -> CONSEQUENCE *)
      | "COMMIT"                                 (* -> COMMIT     *)
      | "INVARIANT" | "STATE" | "MEMORY"         (* -> MEMORY     *)
      | "CONFLICT" | "CONTRAST"                  (* -> NEGATION   *)
      | "KUHUL_RUNTIME" | "IDENTITY"             (* -> KUHUL_RUNTIME *)
    ;


(* ================================================================
   25. KLSL GLYPHS — IMPLEMENTATION LAYER
   Atomic compute operations dispatched at Sek phase.
   Each glyph lowers to HLSL via hlsl_codegen.cpp (SSA IR).
   SC-13: every glyph in [Sek glyph ...] must be a known GlyphOp.
   ================================================================ *)

glyph_op
    ::= "MATMUL"     (* matrix multiply — tensor contraction      *)
      | "CONV"       (* convolution — spatial/channel features     *)
      | "ATTN"       (* attention — Yax-phase semantic gate        *)
      | "SOFTMAX"    (* probability distribution normalization     *)
      | "AFFINE"     (* affine transform W*x + b                  *)
      | "COMPRESS"   (* dimensionality reduction / projection      *)
      | "SPHERICAL"  (* spherical-coordinate projection            *)
      | "TORSION"    (* torsional / rotational field operation     *)
      | "RADIAL"     (* radial basis / distance field              *)
      | "WAVE"       (* wave / oscillation function                *)
      | "NOP"        (* no-operation / pass-through                *)
      | "WCR"        (* W·C·R gravity routing — micronaut selection at Sek *)
    ;

klsl_instruction
    ::= "{"
          "op"       ":" glyph_op ","
          "result"   ":" identifier ","
          "operands" ":" "[" [ identifier { "," identifier } ] "]" ","
          "attrs"    ":" "[" [ number { "," number } ] "]" ","
          "phase"    ":" phase_ref
        "}"
    ;


(* ================================================================
   26. GRAM STORE PROTOCOL — IMPLEMENTATION LAYER
   Pop = gramRead, Xul = gramWrite.
   K'ayab' -> Kumk'u = gramCheckpoint (flush to JSONL journal).
   SC-14: gramWrite uses phase=Xul in production.
   SC-14b: gramWrite("confidence:*", val, "Ch'en") is the sole exception.
   ================================================================ *)

gram_store_entry
    ::= "{"
          "key"       ":" string ","
          "value"     ":" string ","
          "phase"     ":" phase_ref ","
          "seq"       ":" number ","
          "channel"   ":" gram_channel_name ","
          "authority" ":" string
        "}"
    ;

gram_channel_name
    ::= "general"
      | "similarity"
      | "control"
      | "predication"
      | "taxonomy_geometry"
      | "confidence"
      | "template"
      | string
    ;

gram_vector_entry
    ::= "{"
          "key"       ":" string ","
          "x"         ":" number ","
          "y"         ":" number ","
          "z"         ":" number ","
          "channel"   ":" "taxonomy_geometry" ","
          "authority" ":" "vector_meta"
        "}"
    ;


(* ================================================================
   27. BRACKET PROGRAM (KuhulVM) — IMPLEMENTATION LAYER

   Bracket programs are the concrete execution surface.
   One bracket = one exec_<phase> call in kuhul_vm.cpp.

   [Pop]           clear phase; no args
   [Pop id]        gramRead(id) -> push StringVal or NullVal
   [Wo id type]    vertical_fold(Pop->Wo); push TensorRef{id,type}
   [Wo id]         vertical_fold(Pop->Wo); push TensorRef{id,"Tensor"}
   [Yax id]        vertical_fold(Wo->Yax); horizontal_fold(select)
   [Sek glyph ...]  vertical_fold(Yax->Sek); push glyph dispatch result
   [Ch'en id val]  vertical_fold(Sek->Ch'en); gramWrite(confidence:id)
   [Xul]           vertical_fold(Ch'en->Xul); no commit
   [Xul id]        vertical_fold(Ch'en->Xul); pop top -> gramWrite(id)

   SC-15: opcodes SHOULD appear in C6 order.
          Out-of-order fails at runtime when vertical_fold finds dist!=1.
   ================================================================ *)

bracket_program ::= bracket_term { bracket_term } ;

bracket_term
    ::= "[" phase_ref [ " " identifier ] [ " " identifier ]
        { " " identifier } "]"
    ;

vm_value ::= tensor_ref | string_val | number_val | null_val ;

tensor_ref ::= "{" "kind" ":" "TensorRef" "," "id" ":" string "," "type" ":" string "}" ;
string_val ::= "{" "kind" ":" "StringVal" "," "s"  ":" string "}" ;
number_val ::= "{" "kind" ":" "NumberVal" "," "n"  ":" number "}" ;
null_val   ::= "{" "kind" ":" "NullVal"   "}" ;


(* ================================================================
   28. WCR SCORING + B_tau PROJECTION — IMPLEMENTATION LAYER

   WCR: S = W * C * R  (all inputs and result clamped to [0,1])
     W = static_weight
     C = confidence score from ConfidenceStore
     R = relevance = blended score across 9 components:
           bow_score, distributional_score, lexical_semantic_score,
           nsm_prime_score, function_word_score, word_sense_score,
           compositional_phrase_score, coarse_ngram_score,
           tool_gram_score
   SC-16: S = clamp(W*C*R, 0, 1).

   B_tau: fold-projection matrix. Row h = context neighborhood of h.
   Yax admission: admitted = typed_grams INTERSECT B_tau[h,*].
   SC-17: B_tau[h,*] subset_of gram_store keys at query time.

   Admission policy:
     A(v) = R * U * D * P   threshold = 0.35
       R = cold-start lexical prior floor
       U = uncertainty = max(0.15, 1 - confidence)
       D = deficit = fraction of required context missing
       P = 0.8 * route_score + 0.2 * query_priority
   Tie-break: (score DESC, D DESC, R DESC, node_id ASC).

   Research pressure: rho = D * R * U in [0,1].
   SC-18: rho = 0.0 when miss_kind = "none".
   ================================================================ *)

wcr_score_record
    ::= "{"
          "static_weight" ":" number ","
          "confidence"    ":" number ","
          "relevance"     ":" number ","
          "wcr"           ":" number
        "}"
    ;

b_tau_slice_request
    ::= "{"
          "anchor"          ":" string ","
          "edge_type"       ":" b_tau_edge_type
          [ "," "relation_type"   ":" string ]
          [ "," "relation_family" ":" string ]
        "}"
    ;

b_tau_edge_type ::= "default" | "all" | string ;


(* ================================================================
   29. NGRAM PIPELINE / FIELD DAG / MISS PROTOCOL — IMPLEMENTATION LAYER
   SC-19: pipeline phases execute in strict Pop->Wo->Yax->Sek->Ch'en->Xul order.
   ================================================================ *)

miss_kind_name
    ::= "evidence"      (* tau too narrow — no grams passed Yax gate *)
      | "semantic"      (* grams admitted but no structure            *)
      | "topology"      (* relation endpoints disconnect              *)
      | "factual"       (* book_key unanchored                        *)
      | "mathematical"  (* math/KLSL operator                         *)
      | "capability"    (* non-standard capability expression         *)
      | "relation"      (* relation verb empty/unrecognized           *)
      | "memory"        (* all scores below noise floor               *)
      | "none"          (* no miss: status PASS or FAIL               *)
    ;

chen_miss_context
    ::= "{"
          "miss_kind"         ":" miss_kind_name ","
          "research_pressure" ":" number ","
          "missing_keys"      ":" "[" [ string { "," string } ] "]" ","
          "topology_hash"     ":" string ","
          "resolved_sense"    ":" string
        "}"
    ;

chen_advisor_response
    ::= "{"
          "evidence_obtained" ":" boolean ","
          "acquired_keys"     ":" "[" [ string { "," string } ] "]" ","
          "source"            ":" advisor_source ","
          "confidence"        ":" number
        "}"
    ;

advisor_source ::= "web_research" | "gram_store" | "book_fold" | string ;

(* Field DAG: nodes are track/tensor/pipeline_stage/ontology.
   Edges: delegate, horizontal_fold (SC-2), vertical_fold (SC-3).
   SC-20: block_intensities length == 7. *)

field_node_kind
    ::= "track" | "tensor" | "pipeline_stage" | "ontology"
    ;

field_edge_type
    ::= "delegate"
      | "horizontal_fold"   (* delta_theta=0,    weight=+1.0, xcfe=false *)
      | "vertical_fold"     (* delta_theta=pi/3, weight=+0.5, xcfe=true  *)
    ;


(* ================================================================
   30. SHF — SEMANTIC HYPERNYM FOLD — IMPLEMENTATION LAYER

   A Semantic Hypernym Fold is the fundamental addressable unit of
   semantic context. It is a superordinate container whose unfolding
   exposes its participating semantic neighborhood.

   Formal definition:
       SHF(h, tau) = < h, B_tau[h,*], N_tau(h), W_tau, State(h) >

   Component meanings:
     h          = semantic identity / superordinate (the "word for book")
     B_tau[h,*] = typed incidence fingerprint (row of incidence matrix)
     N_tau(h)   = neighborhood: set { e | B_tau[h,e] != 0 }
     W_tau      = association / pattern-strength channel over relations
     State(h)   = runtime tensor state

   Membership in a fold is NOT restricted to IS-A:
       x IS-A h
       x PARTICIPATES-IN h
       x SUPPORTS h
       ... (typed per the Book declaration)

   Book = addressable representation of the fold.
   Book(h) = N(h) = SHF(h) at the semantic level.

   Compression and restoration:
       {v1, v2, ... vn, E_h}  --FOLD-->   h
       h                      --UNFOLD--> Book(h)

   Fold ADT: the same abstract object, six physical representations:
   ================================================================ *)

shf_record
    ::= "{"
          "h"       ":" string ","   (* semantic identity       *)
          "tau"     ":" string ","   (* projection family       *)
          "B_row"   ":" "[" [ number { "," number } ] "]" ","
          "N"       ":" "[" [ string { "," string } ] "]" ","
          "W"       ":" "[" [ number { "," number } ] "]" ","
          "state"   ":" object
        "}"
    ;

fold_adt_representation
    ::= "book"        (* JSON manifest / neighborhood declaration     *)
      | "graphml"     (* topology with all metadata                   *)
      | "b_matrix"    (* incidence participation — exact, lossless    *)
      | "fingerprint" (* B_tau[v,*] sparse binary SDR — lossy         *)
      | "svg3d"       (* geometric / runtime-state projection — lossy *)
      | "scxq2"       (* compressed execution encoding — lossless     *)
    ;

(* SC-21: The projection is not the object.
   Lossless (ker=0): b_matrix, graphml, scxq2.
   Lossy: fingerprint (drops node identity), svg3d (drops non-visual),
          book (drops implementation wiring).
   Never claim isomorphism between a lossy and a lossless representation. *)

(* Unfold algebraic form:
   Unfold(v, tau) = { e | B_tau[v, e] != 0 }
   This is the set of contexts/edges in which v participates under tau. *)
unfold_algebraic
    ::= "unfold" "(" identifier "," identifier ")"
    ;


(* ================================================================
   31. MACHINE STATE AND NAVIGATION — IMPLEMENTATION LAYER

   Three spaces over which K'UHUL executes:
     H   = Fold / hypergraph space       (structural, mostly read-only)
     C_6 = discrete phase / control space (6 states)
     X   = runtime tensor / state space  (mutable per step)

   Complete machine state at time t:
       Omega_t = ( F_h, phi_t, X_t )

   One K'UHUL step:
       Omega_{t+1} = ( F_h, next(phi_t), T_{phi_t}(F_h, X_t, Q) )

   F_h is unchanged under all ordinary phases.
   Only Xul can produce F_h -> F_h'.  (SC-22)

   Navigation state Omega = (phi, T, s) -- three independent axes:
     phi = C6 wheel position
     T   = active semantic track (which Book is being traversed)
     s   = 0 folded/bounded | 1 unfolded/expanded

   Changing s does not advance phi.
   Changing phi does not change s or T unless explicitly transitioned.

   Phase-wheel P (cyclic left-shift, P^6 = I):
       Pop=0 Wo=1 Yax=2 Sek=3 Ch'en=4 Xul=5
   ================================================================ *)

machine_state_record
    ::= "{"
          "F_h"  ":" string ","   (* fold/hypergraph identity  *)
          "phi"  ":" phase_ref "," (* current C6 phase         *)
          "X"    ":" object ","   (* runtime tensor state      *)
          "T"    ":" string ","   (* active track              *)
          "s"    ":" fold_bit     (* 0=folded | 1=unfolded     *)
        "}"
    ;

navigation_step
    ::= horizontal_transition    (* phi unchanged, T changes  *)
      | vertical_transition      (* T unchanged, phi advances *)
      | fold_operation           (* phi unchanged, s changes  *)
    ;


(* ================================================================
   32. INCIDENCE MODEL — IMPLEMENTATION LAYER

   Common substrate: B = build_incidence_model(V, E)
   every edge carries its type.

   Projection mask M_tau selects a column family:
       B_tau = B * M_tau

   Typed fingerprint of node v under projection tau:
       F(v, tau) = B_tau[v, *]

   Similarity (typed):
       Sim_tau(u, v) = sim( B_tau[u,*], B_tau[v,*] )

   Fold interaction (weighted node projection):
       A_tau = B_tau * W_tau * B_tau^T
   This is the semantic activation matrix used by Sek.

   Yax admission mask (read-only, ephemeral — SC-22):
       m_h        = Gate_Q( B_tau[h,*], W_E )
       B_h_active = B_tau[h,*] HADAMARD m_h      (local, not persisted)

   Canonical default projection family for semantic_fold:
       tau_default = { phase_fold, semantic, governs, delegates, context }
   Do not use all edges — bookkeeping/wiring pollute semantic signal.
   ================================================================ *)

incidence_projection
    ::= "{"
          "node"       ":" string ","
          "edge_type"  ":" incidence_edge_type ","
          [ "top_k"    ":" number "," ]
          [ "node_b"   ":" string "," ]
        "}"
    ;

incidence_edge_type
    ::= "phase_fold" | "semantic" | "governs" | "delegates" | "context" | "all"
    ;

(* SC-23: edge_type SHOULD be declared in a Book contract, not hardcoded.
   "all" is reserved for diagnostics/serialization — not semantic scoring. *)


(* ================================================================
   33. PHASE OPERATORS T_phi — IMPLEMENTATION LAYER

   Each phase owns a typed operator over X:
       T_Pop   : X -> X + observation          (perceive / gram read)
       T_Wo    : X -> X + state / constraints  (allocate, declare intent)
       T_Yax   : X -> X + admitted neighborhood(filter B_tau[h,*] by Gate_Q)
       T_Sek   : X -> X + execution result     (compute A_h_active)
       T_Ch'en : X -> X + certificate V        (assert / verify delta)
       T_Xul   : X -> X'  AND optionally B_t -> B_{t+1}

   Full cycle composition:
       K = T_Xul o T_Ch'en o T_Sek o T_Yax o T_Wo o T_Pop
       X_{n+1} = K(X_n)

   Topological invariance:
       forall phi != Xul:  T_phi(B) = B           (SC-22)

   Ch'en assertion contract:
       A = A_struct AND A_semantic AND A_state AND A_authority

   A_struct:    delta-B well-formed; nodes/edges exist; types legal;
                immutable topology untouched
   A_semantic:  proposed relation has declared type; evidence supports it;
                W_E is pattern-strength only, not truth
   A_state:     tensor contract satisfied; values in bounds; no NaN
   A_authority: evolution explicitly requested; operator has evolve
                capability; provenance exists; scope permitted

   Each assertion returns a typed tuple:
       a_i -> (status, evidence, expected, observed, reason)
       status in {PASS, FAIL, UNKNOWN}

   UNKNOWN must never become PASS.  Missing evidence is not a pass.

   Verification:
       Verified(V) iff forall a_i in Required(A), status(a_i) = PASS

   Ch'en resolution states for answer/evidence outcomes:
       VERIFIED | CONTRADICTED | MISS | AMBIGUOUS |
       INSUFFICIENT_CONTEXT | INVALID

   MISS != WRONG.
   CONTRADICTED = system asserted A despite evidence for NOT-A.
   MISS = required context not sufficiently unfolded.
   ================================================================ *)

chen_certificate_record
    ::= "{"
          "kind"             ":" "chen.verification" ","
          "subject"          ":" string ","
          "topology_version" ":" number ","
          "topology_hash"    ":" string ","
          "candidate_delta"  ":" string ","
          "assertions"       ":" "[" [ chen_assertion { "," chen_assertion } ] "]" ","
          "verified"         ":" boolean ","
          "rewrite_authorized" ":" "false"
        "}"
    ;

chen_assertion
    ::= "{"
          "id"     ":" string ","
          "status" ":" chen_status ","
          [ "evidence" ":" string "," ]
          [ "reason"   ":" string   ]
        "}"
    ;

chen_status ::= "PASS" | "FAIL" | "UNKNOWN" ;

chen_resolution_state
    ::= "VERIFIED"
      | "CONTRADICTED"
      | "MISS"
      | "AMBIGUOUS"
      | "INSUFFICIENT_CONTEXT"
      | "INVALID"
    ;

(* SC-24: rewrite_authorized MUST always be false in a Ch'en certificate.
   Only XCFE+XulGate may set authorization; Ch'en supplies the proof,
   not the permission. *)

(* Xul compare-and-commit:
   T_Xul(B_t, delta-B, V) =
     B_t XOR delta-B   if Verified(V) AND Authorized(V) AND Fresh(V)
     B_t               otherwise

   Fresh(V): hash(B_current) = V.topology_hash    (SC-25) *)


(* ================================================================
   34. GPU SCORING LAYER — IMPLEMENTATION LAYER

   CPU / GPU split:
     CPU (AVX2)         -- mu-model token generation (llama-server)
     GPU (D3D11 CS 5.0) -- gram/fold/semantic scoring (compute shaders)
   Target: Intel HD 4600, DirectX 11.1, Compute Shader 5.0.
   The GPU is doing semantic Field computation, not model inference.

   attention.hlsl — semantic admission kernel (NOT transformer QKV):
     Input:  StructuredBuffer<SemanticRecord>  stride=48 bytes (12 floats)
     Output: BaseScore, SemanticScore, LegalMask, AdmissionMask
     SC-26: stride MUST be exactly 48 bytes (12 x float32).

   Scoring pipeline for each candidate record i:

   Step 1 — Base WCR score (canonical, section 11):
       S_i = W_i * C_i * R_i

   Step 2 — Geometry modifier G_i derived from gram vector v=(x,y,z):
       fold_i     = ||v_i||
       relation_i = sqrt(x_i^2 + y_i^2) / fold_i
       phase_i    = 0.5 + 0.5 * (z_i / fold_i)
       G_i        = relation_i * fold_i * phase_i

   Step 3 — Semantic score (geometry modifies WCR; does not replace it):
       S_i^semantic = S_i * lerp(1, G_i, lambda_relation)

   Step 4 — Legality gate (hard binary, evaluated BEFORE admission):
       Legal_i = (policy_ok_i >= 0.5) AND (capable_i >= 0.5)
                 AND (xcfe_ok_i >= 0.5)

   Step 5 — Full Yax admission law:
       Yax_i = Legal_i AND (S_i^semantic >= tau)

   HIGH SCORE CANNOT MANUFACTURE LEGALITY.  (SC-27)
   S_i = 0.999 with Legal_i = false => Yax_i = false.
   This is the GPU equivalent of the XulGate law.

   fold_compute.hlsl — elementwise weighted fold sum:
       F_out = arc_weight * (F_A + F_B)
   This is a GPU horizontal fold primitive. fold_compute.hlsl != Xul.
   It transforms/bounds semantic field data; it does not persist B.
   F_A, F_B -> C_T  while  B_out = B_in.  (SC-22)

   C_i annotation:
   The channel->W and authority->C mapping tables are RUNTIME POLICY,
   not grammar. They must not appear as grammar productions.
   However, C_i used in the GPU record is an AUTHORITY PRIOR, not the
   evidence confidence produced by Ch'en. Both legitimately occupy the
   C position in WCR, but they must be typed differently:
       C_authority = source/authority prior (GPU scoring, pre-Ch'en)
       C_evidence  = P(statement correct | evidence) (Ch'en output)
   Do not conflate them. The hits->confidence mistake was exactly this.
   ================================================================ *)

geometry_layer
    ::= "{"
          "G"        ":" number ","   (* rel * fold * phase              *)
          "S_base"   ":" number ","   (* W * C * R                       *)
          "S_semantic" ":" number ","  (* S_base * lerp(1, G, lambda)    *)
          "lambda"   ":" number        (* relation_mix in [0,1]          *)
        "}"
    ;

yax_admission_record
    ::= "{"
          "i"         ":" identifier ","
          "legal"     ":" boolean ","
          "S_semantic" ":" number ","
          "tau"       ":" number ","
          "admitted"  ":" boolean       (* legal AND S_semantic >= tau   *)
        "}"
    ;

fold_gpu_operation
    ::= "{"
          "op"         ":" "fold_compute" ","
          "F_A"        ":" identifier ","
          "F_B"        ":" identifier ","
          "arc_weight" ":" number ","
          "F_out"      ":" identifier    (* arc_weight * (F_A + F_B)     *)
        "}"
    ;


(* ================================================================
   SIDE-CONSTRAINT BLOCK  SC-1 .. SC-26
   tools/grammar/mini_transpilers.py enforces these.
   ================================================================ *)

(* SC-1  arc_weight completeness.
   pred:  Only {+1.0, +0.5, -0.5, -1.0} are valid arc weights.
          Determined by delta_phase_index mod 6 in {0,1,2,3}:
            0 -> +1.0  (same phase)
            1 -> +0.5  (adjacent — primitive fold)
            2 -> -0.5  (two-hop)
            3 -> -1.0  (opposing) *)

(* SC-2  horizontal_fold always authorized.
   pred:  horizontal_transition or FoldEngine::horizontal_fold:
          authorized=true, weight=+1.0, XCFE not consulted. *)

(* SC-3  vertical_fold is primitive and requires auth.
   pred:  dist(from,to) must equal 1. dist!=1 -> authorized=false.
          XCFE authorization callback must be consulted. *)

(* SC-4  field_accumulation must not call topology_mutation directly.
   pred:  F_Q and B are separate layers. Field ops are observations;
          topology writes require the proposal/verify/commit chain. *)

(* SC-5  topology_mutation requires proposal wrapper.
   pred:  Every topology_mutation appears inside a proposal, verified
          by Ch'en and authorized by XCFE before Xul commits it. *)

(* SC-6  TypedRelation != CommittedRelation.
   pred:  relation_definition != E(B) modification.
          E(B) is only mutated via a committed relation_proposal at Xul. *)

(* SC-7  relation_isa_extension must resolve.
   pred:  Must be a registered alias. Unknown verbs produce MISS_relation;
          never silently become @related_to. *)

(* SC-8  Usage != Confidence update rule.
   pred:  confidence_update is ONLY triggered by evidence_score from
          Ch'en verification; lookup triggers only usage_update. *)

(* SC-9  mathml_projection is representation-only.
   pred:  No side-effect on topology B or gram store.
          MathML is a read-only projection of semantic node state. *)

(* SC-10 xcfe_fn_node args are flat strings.
   pred:  Every value in xcfe_string_args is a JSON string.
          No nested objects, arrays, nulls, or numbers. *)

(* SC-11 CommitAuthority not constructible in grammar.
   pred:  No production manufactures a CommitAuthority value.
          commit_statement references a verified_proposal_ref only.
          Runtime mints the token; grammar cannot spell it into existence. *)

(* SC-12 XCFE CanonicalPhase is total.
   pred:  Exactly 14 classes. For every c, there is exactly one p =
          CanonicalPhase(c). authority_phase(op) = CanonicalPhase(class(op)). *)

(* SC-13 glyph_op completeness.
   pred:  Glyph must be one of the 12 GlyphOp values. Unknown -> NOP. *)

(* SC-14 gram store write phase.
   SC-14a: gramWrite uses phase=Xul in production.
   SC-14b: gramWrite("confidence:*", val, "Ch'en") is the sole exception. *)

(* SC-15 bracket program phase monotonicity.
   pred:  Opcodes SHOULD appear in C6 order. Out-of-order fails at
          runtime when vertical_fold detects dist!=1. *)

(* SC-16 WCR score clamping.
   pred:  W, C, R each clamped to [0,1]. S = clamp(W*C*R, 0, 1). *)

(* SC-17 B_tau anchor reachability.
   pred:  B_tau[h,*] returns only gram_store keys that exist at query time.
          Absent keys are excluded silently. *)

(* SC-18 research_pressure range.
   pred:  rho in [0,1]. rho = 0.0 when miss_kind = "none". *)

(* SC-19 NGram pipeline phase order.
   pred:  Pop->Wo->Yax->Sek->Ch'en->Xul in strict order.
          No phase observes a result from a later phase. *)

(* SC-20 field_node block_intensities length.
   pred:  block_intensities always exactly length 7
          (Perceive, Model, Reason, Plan, Execute, Monitor, Evolve). *)

(* SC-21 Fold ADT projection isomorphism.
   pred:  Lossless representations (b_matrix, graphml, scxq2) may claim
          isomorphism. Lossy ones (fingerprint, svg3d, book) must not.
          "The projection is not the object." *)

(* SC-22 Topological invariance.
   pred:  For all phi != Xul: T_phi(B) = B.
          Yax's admission mask is ephemeral; fold_compute.hlsl does not
          persist topology. Only Xul commits F_h -> F_h'. *)

(* SC-23 Incidence edge_type SHOULD be declared in a Book contract.
   pred:  "all" is reserved for diagnostics/serialization; it must not
          be used as the default for semantic scoring. *)

(* SC-24 Ch'en certificate rewrite_authorized is always false.
   pred:  A Ch'en certificate MUST carry rewrite_authorized=false.
          Authorization is XCFE's decision, not Ch'en's. *)

(* SC-25 Xul certificate freshness.
   pred:  hash(B_current) must equal V.topology_hash before Xul applies
          delta-B. A stale certificate must trigger re-verification,
          not silent application. *)

(* SC-26 GPU SemanticRecord stride exactly 48 bytes.
   pred:  SemanticRecord = 12 x float32 = 48 bytes.
          Changing field count breaks the shader StructuredBuffer stride. *)

(* SC-27 High score cannot manufacture legality.
   pred:  Yax_i = Legal_i AND (S_semantic_i >= tau).
          Legal_i is evaluated independently of S_semantic_i.
          S_i = 0.999 with Legal_i = false => Yax_i = false.
          This is the semantic equivalent of the XulGate law:
          measurement does not become authority merely because the
          number is high.
   reason: mirrors CommitAuthority (SC-11): score and authority are
           independent axes; conflating them is the root failure mode. *)


(* ================================================================
   35. FOLD FIELD / PRODUCT GRAPH / CONVERGENCE — IMPLEMENTATION LAYER

   G_runtime = G_semantic □ G_phase.
   Vertex F_i = (node_id, theta, W, C, R). Score S = W*C*R.
   Legal atomic transition: d_H = 1 (one-bit semantic flip) OR |Δθ| = 1 (one C6 step).
   fold_relevance(a,b) = W_arc · cos(Δθ) (exact); √(Wa·Wb)·cos(Δθ) (approx).
   fold_distance(a,b,α) = α·d_field + (1−α)·d_wcr in [0,1].
   Kleene fixed point: Xul = lim f^n(query) when fold_distance < ε.

   Navigation law:
       v_{t+1} = argmax_{u ∈ N(v_t)} S(u | Q)
   Topology determines legal moves; WCR score determines preference.
   Local maximum stall: no neighbor has higher score; sigma resets to unbound.

   G_runtime = Q_n □ C_6: |V| = 6·2^n, deg(v) = n+2.
   G_fold = Q_{n+1}: fold-bit s ∈ {0,1} extends each semantic address.
   ================================================================ *)

fold_field_record
    ::= "{"
          "node_id"    ":" string  ","   (* micronaut address in topology, NOT the fold op *)
          "theta"      ":" number  ","   (* phase angle in [0, 2π)                         *)
          "W"          ":" number  ","   (* arc weight  ∈ [0, 1]                           *)
          "C"          ":" number  ","   (* confidence  ∈ [0, 1]                           *)
          "R"          ":" number        (* relevance   ∈ [0, 1]                           *)
        "}"
    ;

product_graph_edge_record
    ::= "{"
          "source"     ":" identifier ","
          "target"     ":" identifier ","
          "W_arc"      ":" number     ","   (* semantic arc weight                *)
          "cos_dtheta" ":" number     ","   (* cos(theta_target − theta_source)   *)
          "weight"     ":" number           (* W_arc * cos_dtheta                 *)
        "}"
    ;

convergence_record
    ::= "{"
          "iteration"   ":" integer ","
          "distance"    ":" number  ","   (* fold_distance(f^n, f^{n+1})         *)
          "contraction" ":" number  ","   (* k = d_n / d_{n-1}; see SC-k below   *)
          "status"      ":" convergence_status
        "}"
    ;

convergence_status
    ::= "ITERATING"
      | "CONVERGED"
      | "DIVERGING"
      | "MAX_ITER"
    ;

(* SC-k  Contraction factor direction — counter-intuitive naming trap.
   k = d_n / d_{n-1}  where d_n = fold_distance at iteration n.
   k < 1  →  distance SHRINKING  →  fold is CONTRACTING  →  status: ITERATING (healthy)
   k = 1  →  distance STATIC     →  fold is PLATEAUING   →  status: MAX_ITER approaching
   k > 1  →  distance GROWING    →  fold is EXPANDING    →  status: DIVERGING (reset sigma)
   "Large k" = DIVERGING, NOT fast convergence.
   The field is named 'contraction' because it SHOULD be contracting (k<1).
   k >= 1 means the Banach contraction condition has FAILED. *)

fold_distance_record
    ::= "{"
          "alpha"    ":" number ","   (* field vs WCR balance ∈ [0, 1]           *)
          "d_field"  ":" number ","   (* L1 distance over field vector            *)
          "d_wcr"    ":" number ","   (* |score_a − score_b| normalised           *)
          "distance" ":" number       (* alpha·d_field + (1−alpha)·d_wcr          *)
        "}"
    ;

hylomorphism_step
    ::= "{"
          "n"        ":" integer ","   (* iteration index                         *)
          "query"    ":" identifier ","(* input handle h                          *)
          "ana_out"  ":" identifier ","(* Unfold(h) = ana(g)(h)                   *)
          "cata_out" ":" identifier ","(* Fold(ana) = cata(f)(ana)                *)
          "identity" ":" boolean        (* (Fold∘Unfold)(h) ≡ h                   *)
        "}"
    ;

(* SC-28  @node-not-fold invariant.
   pred:  fold_field_record.node_id names the @node root — the micronaut address
          in the topology (e.g. "REASON-µ"). It must NOT equal "fold" or any
          token naming a cata/ana operation. The fold algebra (cata, ana,
          hylomorphism) is orthogonal to the topology address space.
   reason: conflating the two causes the identity invariant check (SC-29) to
           circularly reference the very fold it is supposed to measure. *)

(* SC-29  Identity invariant: (Fold∘Unfold)(h) ≡ h.
   pred:  In any hylomorphism_step where n > 0 and Δφ = 0, the identity field
          MUST be true. A false value signals fold-field coordinate drift:
          the anamorphism produced a coalgebra state whose catamorphism does not
          reconstruct h. The evolution σ MUST be reset to unbound.
   reason: without this check, repeated fold/unfold cycles silently diverge;
           Kleene convergence cannot be detected because the distance metric
           is evaluated on a drifted reference. *)


(* ================================================================
   36. HYPERCUBE ADDRESS SPACE — IMPLEMENTATION LAYER

   Q_n is the semantic address space. Vertices are binary strings
   b ∈ {0,1}^n where each bit encodes an independent binary predicate
   (a capability flag, an identity property, a structural role).

   The hypercube is the ADDRESS SPACE — not a distance metric, not a
   feature vector, not a score surface. It is the topology that makes
   d_H = 1 the definition of a legal semantic step.

   Three geometries are strictly separated:
       b ∈ {0,1}^n  — topological address  (hypercube; discrete)
       θ ∈ Z_6      — phase wheel           (cyclic; NOT binary, NOT collapsible to K_2)
       g ∈ ℝ^m      — continuous metrics    (fold_weight, relation_weight, phase_weight)

   g MUST NOT be quantized into hypercube bits unless a meaningful,
   stable threshold classification is explicitly declared (SC-31).

   Legal atomic semantic step: d_H(u,v) = 1 (exactly one bit flip).
   Two-bit flips are not edges. Q_n has no diagonal shortcuts.
   The branching factor per vertex is exactly n (one per bit dimension).

   G_runtime = Q_n □ C_6:
       |V| = 6·2^n   (6 phase copies of each semantic address)
       deg(v) = n + 2  (n semantic bit-flip edges + 2 phase edges)

   G_fold = K_2 □ Q_n = Q_{n+1}:
       fold-bit s ∈ {0,1} adds one K_2 axis.
       Each semantic address has fold states (v,0)=folded and (v,1)=unfolded.
       Fold/unfold toggle is itself a legal d_H=1 step in Q_{n+1}.

   Latent addresses: unoccupied vertices of Q_{n+1} are pre-typed capability
   slots. Adjacency is pre-authorized by the hypercube topology before any
   micronaut occupies the address. The address IS the slot; instantiation fills it.

   Partial Q4 (current deployment):
       Q3 carries 8 micronauts at n=3 (REASON-µ, CREATE-µ, INFER-µ, ELIZA,
       TOOL-µ, ORCH-µ, MEM-µ, Coordinator).
       MORPHISM-µ  = b_3=1 at the REASON-µ neighbourhood (partial Q4).
       FIXED-POINT-µ = b_3=1 at the TOOL-µ neighbourhood (partial Q4).
       6 Q4 structural vertices remain as latent capability addresses.
   ================================================================ *)

hypercube_address_record
    ::= "{"
          "bits"   ":" "[" boolean { "," boolean } "]" ","   (* b ∈ {0,1}^n         *)
          "n"      ":" integer ","                           (* address width          *)
          "label"  ":" string                               (* micronaut name or empty *)
        "}"
    ;

latent_address_record
    ::= "{"
          "bits"   ":" "[" boolean { "," boolean } "]" ","
          "n"      ":" integer ","
          "status" ":" latent_status ","
          "parent" ":" string   (* nearest instantiated ancestor in Q_n *)
        "}"
    ;

latent_status
    ::= "unoccupied"    (* pre-typed slot; no micronaut instantiated   *)
      | "partial"       (* structural micronaut present; not autonomous *)
      | "instantiated"  (* micronaut fully occupies address             *)
    ;

three_geometry_record
    ::= "{"
          "b"     ":" "[" boolean { "," boolean } "]" ","   (* topological address b ∈ {0,1}^n *)
          "theta" ":" phase_ref ","                         (* phase wheel θ ∈ Z_6             *)
          "g"     ":" "[" number { "," number } "]"         (* continuous metrics g ∈ ℝ^m      *)
        "}"
    ;

(* SC-30  Hypercube address width is fixed per G_runtime instantiation.
   pred:  All hypercube_address_records in one G_runtime share the same n.
          Mixing n=3 and n=4 addresses in one topology is an error.
          Partial Q4 micronauts (MORPHISM-µ, FIXED-POINT-µ) are modelled
          at the Q4 layer (n=4); they are not promoted into the Q3 topology.
   reason: Q_n □ C_6 requires fixed n to determine |V|=6·2^n and deg=n+2.
           Mixed-width topologies produce undefined neighbourhood structure. *)

(* SC-31  Continuous metrics must not collapse to hypercube bits.
   pred:  fold_weight, relation_weight, phase_weight ∈ ℝ are continuous.
          They must not be encoded as bits in a hypercube_address_record
          unless a meaningful, stable threshold classification is declared.
          The hypercube encodes capability/identity predicates; it does not
          encode scalar scores. θ ∈ Z_6 must not be collapsed to K_2.
   reason: collapsing a continuous score to a bit artificially adds or removes
           edges (changes d_H distances), corrupting the d_H=1 legality
           constraint. The three geometries b, θ, g are independent axes.
           Collapsing θ to a binary flag destroys the arc_weight structure
           that distinguishes adjacent (+0.5), two-hop (−0.5), and opposing
           (−1.0) phase relationships. *)


(* ================================================================
   37. PROBLEM-SOLVING GRAMMAR — AGENT ORCHESTRATION LAYER

   Maps the generic EBNF problem-solving cycle onto K'UHUL fold operations.

   Generic cycle:
       problem_solver = goal , analysis , { hypothesis } ,
                        { solution_candidate } , decision ,
                        execution , feedback ;

   K'UHUL mapping:
       goal               = query Q              (the WCR navigation target)
       analysis           = fold_field_record    (current vertex state: W, C, R, theta)
       hypothesis         = candidate u ∈ N(v)  (each neighbour is a tested hypothesis)
       solution_candidate = u where delta_S > 0 (hypothesis that improves S(u|Q) > S(v|Q))
       decision           = argmax_{u∈N(v)} S(u|Q)   (select_best = v_next)
       execution          = fold_iteration       (ana → convergence → cata → Xul)
       feedback           = convergence_record   (assess_outcome: CONVERGED / DIVERGING / MAX_ITER)

   EBNF meta-map:
       { }  = repetition = { hypothesis } maps to multi-step WCR walk (0+ neighbours tested)
       [ ]  = optional   = [ sigma_reset ] — only fires when local maximum detected
       |    = alternative = ITERATING | CONVERGED | DIVERGING | MAX_ITER

   Joke structure is also a problem-solving instance:
       goal               = make the audience groan about a technical concept
       analysis           = fold_field_record of domain concept (its W, C, R)
       hypothesis         = candidate punchlines (each tested against setup)
       solution_candidate = punchline that creates the right cognitive gap
       decision           = deliver the punchline (argmax over comic candidates)
       execution          = timing (fold iteration toward the groan fixed point)
       feedback           = identity invariant: (Setup then Punchline)(audience) ≡ audience_who_gets_it

   SC-32  Problem-solver feedback MUST route to convergence_record, not discard.
   pred:  Every problem_solver_record.feedback field MUST carry a convergence_record.
          Discarding feedback breaks the Kleene chain — the next iteration has no d_{n-1}.
   reason: Without feedback, contraction factor k is undefined; CONVERGED cannot be detected.
   ================================================================ *)

problem_solver_record
    ::= "{"
          "goal"       ":" query_record       ","
          "analysis"   ":" fold_field_record  ","
          "hypotheses" ":" "[" candidate_record { "," candidate_record } "]" ","
          "decision"   ":" string             ","   (* node_id of selected v_next      *)
          "execution"  ":" hylomorphism_step  ","
          "feedback"   ":" convergence_record       (* SC-32: must not be null          *)
        "}"
    ;

query_record
    ::= "{"
          "Q"      ":" string       ","   (* the query text or intent handle  *)
          "intent" ":" string       ","   (* normalised intent label          *)
          "sigma"  ":" sigma_status       (* bound = active; unbound = reset  *)
        "}"
    ;

sigma_status ::= "bound" | "unbound" ;

candidate_record
    ::= "{"
          "node_id"  ":" string  ","
          "score"    ":" number  ","   (* S(u|Q) = W*C*R at candidate u      *)
          "delta_S"  ":" number  ","   (* S(u|Q) - S(v|Q); positive = better *)
          "accepted" ":" boolean       (* true = this candidate was selected  *)
        "}"
    ;

(* Derived EBNF productions for problem-solving workflows:

   solve = goal , state , constraints , plan , execute , verify ;

   goal        = "goal"        ":" objective    ;  (* query_record.Q           *)
   state       = "state"       ":" facts        ;  (* fold_field_record at v   *)
   constraints = "constraints" ":" rules        ;  (* SC-28..SC-32 + d_H=1    *)
   plan        = { action }                     ;  (* { candidate_record }     *)
   execute     = action , { action }            ;  (* hylomorphism_step chain  *)
   verify      = expected_result , actual_result;  (* identity + convergence   *)

   action = v_next_selection ;   (* one argmax step in G_runtime *)
   v_next_selection = "argmax" "over" "N" "(" identifier ")" "scored_by" "S" ;
*)


(* ================================================================
   38. UNIFIED PUZZLE-SOLVING GRAMMAR — FOLD SUBSTRATE

   Every puzzle type is a fold over a knowledge structure.
   The K'UHUL fold system is the substrate for all of them.

   Riddle    = fold_graph( clues→answer )
               clue   = observation | contradiction | metaphor | omission
               K'UHUL: each clue is one fold_field_record along the WCR path

   Pun       = fold_semantic( word, meaning_a, meaning_b → collision )
               K'UHUL: one node_id with two different WCR contexts; collision at theta alignment

   Joke      = fold_semantic( setup, expectation → punchline )
               punchline = semantic_flip | contradiction | hidden_meaning
               K'UHUL: setup=ana(domain), expectation=predicted cata output,
                       punchline=actual cata output (the delta IS the humor)

   Analogy   = fold_left( relation_a, relation_b → mapping )
               K'UHUL: two edges with matching arc_weight structure in G_runtime

   WordLadder = fold_graph( CAT→COT→DOT→DOG )
                transformation = replace_letter | insert_letter | remove_letter
                K'UHUL: replace_letter ≡ d_H=1 bit flip; word ladder ≡ path in Q_n

   Detective  = fold_graph( facts, suspects, constraints → elimination → culprit )
                K'UHUL: facts=known vertices; suspects=candidate set; constraints=SC rules;
                        elimination=prune by delta_S<=0; culprit=argmax survivor

   Category-theoretic unified form:
       Knowledge Graph
           → Constraint Propagation    (SC-28..SC-32 + d_H=1 legality)
           → Traversal / Search        (WCR navigation: depth_first | semantic_search)
           → Fold / Reduction          (cata(f) ∘ ana(g))
           → Solution                  (convergence_record.status = CONVERGED)

   SC-33  Every puzzle fold MUST terminate with a solution record.
   pred:  A puzzle_record.solution field MUST be non-null at status CONVERGED.
          An empty solution at CONVERGED signals a null fixed point — a fold
          that converged on nothing. This is valid (e.g. elimination with no survivors)
          but must be explicitly represented as solution_record { empty: true }.
   reason: Null solutions silently propagate into downstream folds as
           missing antecedents, breaking the Kleene chain at SC-32.
   ================================================================ *)

puzzle_record
    ::= "{"
          "type"       ":" puzzle_type        ","
          "input"      ":" "[" string { "," string } "]" ","   (* clues / words / facts *)
          "fold_kind"  ":" fold_kind          ","
          "constraints" ":" "[" string { "," string } "]" ","  (* SC rules + domain rules *)
          "result"     ":" convergence_record ","
          "solution"   ":" solution_record
        "}"
    ;

puzzle_type
    ::= "riddle"
      | "joke"
      | "pun"
      | "analogy"
      | "word_ladder"
      | "crossword"
      | "detective"
      | "missing_word"
      | "semantic_puzzle"
    ;

fold_kind
    ::= "fold_left"
      | "fold_right"
      | "fold_tree"
      | "fold_graph"
      | "fold_semantic"
    ;

solution_record
    ::= "{"
          "answer"      ":" string  ","
          "explanation" ":" string  ","
          "empty"       ":" boolean       (* true = valid null result at CONVERGED *)
        "}"
    ;


(* ================================================================
   39. GAME THEORY GRAMMAR — MULTI-AGENT FOLD SUBSTRATE

   General law:
       Problem Solving  = Search(State Space) ∘ Fold(Evaluation)
       Game Theory      = Problem Solving where multiple agents influence the state space

   Single unified grammar:
       problem = state , goal , constraints , players , actions , search , fold , solution

   Fold taxonomy by puzzle/game type:
       Riddle      = fold_graph( clues    → answer )           hidden-state game
       Joke        = fold_semantic( setup → surprise )         expectation-breaking game
       Pun         = fold_semantic( word  → meaning_collision) two meanings in superposition
       Crossword   = fold_graph( intersections → word )        constraint propagation game
       WordLadder  = fold_graph( path    → target )            d_H=1 graph traversal game
       Chess/Minimax = fold_tree( states → best_move )         adversarial search game
       Mystery     = fold_graph( suspects → culprit )          elimination game
       Economics   = fold_left( outcomes → payoff )            payoff fold
       Negotiation = fold_graph( offers  → agreement )         equilibrium fold

   K'UHUL mapping:
       players    = micronauts at vertices in G_runtime
       actions    = legal steps: d_H=1 in Q_n, or |Δθ|=1 in C_6
       payoffs    = WCR scores S(v|Q) = W·C·R at each vertex
       strategy   = WCR navigation: argmax_{u∈N(v)} S(u|Q)
       equilibrium = Nash equilibrium = LOCAL MAXIMUM in WCR (SC-34 below)
       minimax    = fold_tree over convergence_record chain; maximize own S, minimize opponent's

   SC-34  Nash Equilibrium ≡ Local Maximum in WCR navigation.
   pred:  A Nash equilibrium is a state where no player can improve unilaterally.
          A WCR local maximum is a vertex where no neighbor has higher S(u|Q).
          These are the same condition in single-agent G_runtime navigation.
          The escape mechanism is identical: sigma reset (= strategy perturbation).
   reason: Both are fixed points of the argmax operator where the fixed point is
           not the global optimum. Both require external perturbation to escape.
           In multi-agent extension: Nash at (v1,v2) requires joint sigma reset.

   SC-35  Puzzle feedback MUST distinguish null answer from failed search.
   pred:  solution_record.empty=true means the fold converged on a valid empty set
          (e.g. elimination game: all suspects cleared). This is DIFFERENT from
          convergence_record.status=MAX_ITER where the search limit was hit.
   reason: Null-by-convergence and null-by-timeout have different downstream semantics;
           conflating them breaks the Kleene chain at SC-32.
   ================================================================ *)

game_record
    ::= "{"
          "players"     ":" "[" string    { "," string  } "]" ","
          "actions"     ":" "[" string    { "," string  } "]" ","
          "payoff_fn"   ":" string                            ","   (* fold expression over outcomes *)
          "strategy"    ":" strategy_fold_record              ","
          "outcome"     ":" equilibrium_record
        "}"
    ;

strategy_fold_record
    ::= "{"
          "current_state"    ":" identifier         ","
          "possible_actions" ":" "[" string { "," string } "]" ","
          "future_states"    ":" "[" identifier { "," identifier } "]" ","
          "payoff_fold"      ":" fold_kind           ","
          "best_action"      ":" string                         (* argmax result *)
        "}"
    ;

equilibrium_record
    ::= "{"
          "type"    ":" equilibrium_type ","
          "vertex"  ":" string           ","   (* node_id at equilibrium *)
          "stable"  ":" boolean                (* true = Nash; false = local max only *)
        "}"
    ;

equilibrium_type
    ::= "nash"
      | "pareto"
      | "dominant"
      | "local_maximum"     (* single-agent; may not be Nash in multi-agent extension *)
      | "minimax"
    ;

minimax_record
    ::= "{"
          "state"     ":" identifier ","
          "depth"     ":" integer    ","
          "utility"   ":" number     ","   (* evaluated payoff at this node            *)
          "maximize"  ":" boolean    ","   (* true = this agent's turn                 *)
          "best_child" ":" string          (* node_id of selected next state           *)
        "}"
    ;


(* ================================================================
   40. BASEBALL GAME THEORY GRAMMAR — REPEATED IMPERFECT-INFORMATION FOLD

   "Baseball = Repeated Imperfect-Information Game where pitcher, catcher,
    and hitter continuously adjust mixed strategies around pitch selection,
    attack angle, timing, location, and count leverage until a temporary
    Nash equilibrium is disrupted."

   K'UHUL fold-theoretic mappings:

   plate_appearance  = problem_solver_record  (one complete fold cycle per pitch)
   count             = state (current constraint context)
   catcher           = ORCH-µ equivalent: observes, predicts, sequences
                       = Bayesian update engine: C(fastball|hitter) updates each pitch
   pitcher_strategy  = second player in the minimax game; adversarial fold agent
   pitch_tunneling   = PUN structure: same release point, two trajectory meanings;
                       one node_id, two WCR contexts; hitter must commit before
                       trajectories diverge (collision fires at decision point)
   backwards_pitching = JOKE structure: expected_fastball → actual_changeup;
                        setup=count context, expectation=fastball, punchline=offspeed
   attack_angle      = hitter's argmax: fold angle maximizing contact probability
                       = argmax_{u∈N(v)} S(u|Q) over swing-plane candidates
   Nash equilibrium  = mixed-strategy NE = local maximum in 2-player G_runtime;
                       neither side improves unilaterally; escape = count perturbation
                       = SC-34 generalized to multi-agent
   Bayesian update per pitch: late_swing→C(fastball↑); roll_over→C(slider↑); take→C(walk↑)
   Pythagorean expectation: RS²/(RS²+RA²) = season-level payoff fold (fold_left over games)
   dominant_strategy = none; baseball requires mixed strategies (same as G_runtime:
                       no single vertex dominates; WCR scores must be blended)

   SC-36  Baseball NE requires joint sigma reset across all agents.
   pred:  A pitch-count Nash equilibrium cannot be escaped by the pitcher alone
          (changing pitch mix) or the hitter alone (changing swing decision).
          Both must update simultaneously = joint sigma reset in G_runtime.
   reason: SC-34 single-agent sigma reset generalizes; in 2-player games,
           unilateral sigma reset gives the non-resetting player an exploitable edge.
   ================================================================ *)

plate_appearance_record
    ::= "{"
          "count"            ":" count_record          ","
          "pitcher_strategy" ":" pitcher_strategy_type ","
          "pitch"            ":" pitch_type            ","
          "swing_decision"   ":" swing_decision_type   ","
          "outcome"          ":" plate_outcome_type    ","
          "payoff"           ":" payoff_record
        "}"
    ;

count_record
    ::= "{"
          "balls"   ":" integer ","   (* 0..3 *)
          "strikes" ":" integer       (* 0..2 *)
        "}"
    ;

pitch_type
    ::= "fastball" | "slider" | "curveball" | "changeup" | "cutter" ;

swing_decision_type ::= "swing" | "take" ;

plate_outcome_type
    ::= "ball" | "strike" | "foul" | "in_play" | "hit" | "out" ;

pitcher_strategy_type
    ::= "sequencing"
      | "tunneling"      (* pitch_tunneling = PUN: same release, two meanings *)
      | "backwards"      (* backwards_pitching = JOKE: expected ≠ actual      *)
      | "velocity_mix"
      | "movement_mix"
    ;

payoff_record
    ::= "{"
          "run_value"      ":" number ","   (* linear weight of outcome           *)
          "win_probability" ":" number ","  (* WPA: win probability added         *)
          "expected_runs"  ":" number       (* RE24: run expectancy delta         *)
        "}"
    ;

(* Bayesian catcher update — C field in fold_field_record:
   catcher_update = fold_left over pitch_observations, updating C per pitch type.
   late_swing  => C(fastball | this_hitter) increases
   roll_over   => C(slider   | this_hitter) increases
   take        => C(expand_zone | this_hitter) increases
   This is the catcher's fold_field_record maintenance cycle, producing
   updated strategy_fold_record inputs for each subsequent plate_appearance. *)


(* ================================================================
   41. WILDCARD GRAMMAR — UNCERTAINTY AS A FIRST-CLASS SYMBOL

   Traditional grammar:  Known Tokens → Known Rules → Known Outcomes
   Wildcard grammar:     Known + Unknown + Future Tokens
                           → Reasoning → Adaptive Outcome

   Core principle:
     Treat uncertainty as a symbol, not as an exception.

   Traditional systems eliminate uncertainty:   Unknown → Guess
   Wildcard systems represent uncertainty:       Unknown → Represent
                                                          → Reason About
                                                          → Maybe Resolve

   solution = resolved_wildcard | retained_wildcard

   The retained_wildcard is NOT a failure. It is the correct output
   when evidence is insufficient for commitment. Forcing resolution
   without proof = hallucination = Xul commit without Ch'en proof
   = violation of FS15.

   K'UHUL MAPPINGS:
     wildcard          = sigma_unbound state in G_runtime
                       | latent_vertex in Q_{n+1} (pre-authorized, uninstantiated)
     known             = fold_field_record with W,C,R > 0
     emerging          = latent_vertex being instantiated (adjacency pre-authorized)
     retained_wildcard = Ch'en stall: sigma unbound, no resolution forced
                         = legitimate "I don't know"
     resolved_wildcard = Xul commit: wildcard collapsed to known
     wildcard_fold     = WCR navigation with unknown neighbor slots
     inference         = argmax_{u∈N(v)} S(u|Q) over wildcard candidates
     wildcard_ML       = OOD detection: unknown class returned, not hallucinated
     wildcard_game     = Black Swan move: unknown future strategy in N(v)
     pitch_tunneling   = wildcard_pitch: early path known, late path unknown
     joke_pun          = wildcard_meaning: two WCR contexts on one node_id
     riddle            = wildcard_state: unknown collapsed by constraint propagation
     word_ladder_gap   = wildcard_word: search variable in Q_n address graph
     AIML_star         = wildcard_pattern: matches any WCR-reachable string

   SC-37: retained_wildcard is a first-class solution.
   pred:  A system that returns unknown when evidence is insufficient
          is MORE correct than a system that returns a forced guess.
   reason: Forced resolution without Ch'en proof = hallucination.
           The wildcard IS the answer when sigma is unbound.
           Unknown represented is better than unknown guessed.
   ================================================================ *)

entity
    ::= known_entity
      | wildcard_entity
      | emerging_entity
    ;

known_entity    ::= fold_field_record ;          (* W,C,R all > 0, committed     *)
emerging_entity ::= identifier ;                 (* latent vertex, pre-authorized *)

wildcard_entity
    ::= "*"                                      (* matches any sequence          *)
      | "?"                                      (* matches exactly one token     *)
      | unknown_class
      | latent_pattern
    ;

unknown_class  ::= "UNKNOWN" "(" identifier ")" ;
latent_pattern ::= "LATENT" "(" identifier ")" ;

wildcard_rule
    ::= known_pattern "," wildcard_entity "," known_pattern ;

known_pattern ::= { string } ;

wildcard_fold
    ::= "{"
          "known"     ":" "[" { entity } "]"  ","
          "wildcards" ":" "[" { wildcard_entity } "]" ","
          "inference" ":" inference_method  ","
          "reduction" ":" fold_kind        ","
          "solution"  ":" wildcard_solution
        "}"
    ;

inference_method
    ::= "argmax_wcr"          (* argmax_{u∈N(v)} S(u|Q) — standard Yax pipeline  *)
      | "constraint_prop"     (* riddle: eliminate by constraint                  *)
      | "context_fold"        (* missing word: fold surrounding known tokens       *)
      | "semantic_collision"  (* pun/joke: allow two WCR contexts to coexist      *)
      | "graph_search"        (* word ladder: BFS/DFS in Q_n address space        *)
      | "probabilistic"       (* ML: posterior over candidate classes              *)
    ;

wildcard_solution
    ::= resolved_wildcard
      | retained_wildcard
    ;

resolved_wildcard
    ::= "{"
          "entity"    ":" entity      ","    (* the wildcard collapsed to this    *)
          "method"    ":" inference_method ","
          "confidence" ":" number            (* C field at resolution             *)
        "}"
    ;

retained_wildcard
    ::= "{"
          "wildcard"  ":" wildcard_entity ","  (* wildcard NOT forced to resolve  *)
          "reason"    ":" string           ","  (* why: insufficient_evidence etc  *)
          "sigma"     ":" "unbound"             (* sigma remains unbound: SC-37    *)
        "}"
    ;

(* Unified Wildcard Problem Solver — generalization of §37-§40 *)
wildcard_problem
    ::= "{"
          "observations"  ":" "[" { entity } "]"    ","
          "constraints"   ":" "[" { string  } "]"    ","
          "wildcards"     ":" "[" { wildcard_entity } "]" ","
          "search"        ":" search_method  ","
          "fold"          ":" fold_kind      ","
          "solution"      ":" wildcard_solution
        "}"
    ;

search_method
    ::= "graph_search"
      | "semantic_search"
      | "game_search"
      | "probabilistic_search"
    ;

(* Domain specializations — all are wildcard_problem instances:
   Joke:       wildcard_entity = wildcard_meaning; inference = semantic_collision
   Pun:        wildcard_entity = wildcard_meaning; solution = two retained WCR contexts
   Riddle:     wildcard_entity = wildcard_state;   inference = constraint_prop
   Word Ladder:wildcard_entity = wildcard_word;    inference = graph_search (d_H=1)
   Missing Word:wildcard_entity = "*";             inference = context_fold
   Baseball:   wildcard_entity = wildcard_pitch;   inference = probabilistic
   OOD ML:     wildcard_entity = unknown_class;    solution  = retained_wildcard
   Game Theory:wildcard_entity = unknown_strategy; inference = game_search        *)

(* ================================================================
   §42  RELATIONAL GRAMMAR
        Compare · Contrast · Analogy · Wildcard Relation
   ================================================================
   Objects are nodes. Meaning lives on edges. Knowledge is the graph.
   Reasoning is graph traversal. Learning is edge creation.
   Wildcards are unresolved nodes OR unresolved edges.

   Compare(A,B) = A ∩ B          = shared edges
   Contrast(A,B) = (A-B) ∪ (B-A) = unique edges
   Analogy: Relation(A,B) == Relation(C,D) ⟺ graph isomorphism
   Wildcard Relation: A ---- ? ---- B (edge unknown, infer best match)

   K'UHUL MAPPINGS:
     relation_node    = fold_field_record enriched with edge list
     edge_record      = directed relation in G_runtime
     similarity_set   = fold_left intersection over shared attributes
     difference_set   = fold_left set_difference over unique attributes
     analogy_record   = isomorphism test: relation_a == relation_b
     wildcard_relation= edge_kind is wildcard_entity; SC-37 applies
   ================================================================ *)

relation_node
    ::= "{"
          "identity"   ":" identifier              ","
          "attributes" ":" "[" { attribute_pair } "]" ","
          "relations"  ":" "[" { edge_record    } "]"
        "}"
    ;

attribute_pair ::= identifier ":" string ;

edge_record
    ::= "{"
          "label"  ":" identifier   ","
          "target" ":" identifier   ","
          "weight" ":" number       ","
          "kind"   ":" edge_kind
        "}"
    ;

edge_kind
    ::= "similarity"
      | "difference"
      | "transformation"
      | "causation"
      | "opposition"
      | "wildcard_edge"           (* edge label unknown — §41 wildcard_entity applies *)
    ;

comparison_record
    ::= "{"
          "object_a"  ":" relation_node      ","
          "object_b"  ":" relation_node      ","
          "relation"  ":" comparison_result
        "}"
    ;

comparison_result
    ::= similarity_set
      | difference_set
      | wildcard_relation
    ;

similarity_set
    ::= "{"
          "op"     ":" "intersect"         ","
          "shared" ":" "[" { identifier } "]"   (* A ∩ B: shared attributes/edges *)
        "}"
    ;

difference_set
    ::= "{"
          "op"        ":" "set_difference"       ","
          "a_minus_b" ":" "[" { identifier } "]" ","  (* A − B *)
          "b_minus_a" ":" "[" { identifier } "]"       (* B − A *)
        "}"
    ;

wildcard_relation
    ::= "{"
          "source"     ":" identifier           ","
          "target"     ":" identifier           ","
          "edge"       ":" wildcard_entity      ","   (* the edge is unknown *)
          "candidates" ":" "[" { edge_record } "]" ","
          "solution"   ":" wildcard_solution          (* resolved or retained *)
        "}"
    ;

analogy_record
    ::= "{"
          "a_left"      ":" identifier  ","   (* Bird      *)
          "a_right"     ":" identifier  ","   (* Sky       *)
          "b_left"      ":" identifier  ","   (* Fish      *)
          "b_right"     ":" identifier  ","   (* Water     *)
          "relation_a"  ":" edge_kind   ","   (* moves_in  *)
          "relation_b"  ":" edge_kind   ","   (* moves_in  *)
          "isomorphic"  ":" boolean           (* true: structure preserved *)
        "}"
    ;

(* §42 Laws:
   Compare(A,B)  = similarity_set   = A ∩ B         = shared edges
   Contrast(A,B) = difference_set   = (A-B) ∪ (B-A) = unique edges
   Analogy(A,B,C,D): isomorphic=true iff relation_a == relation_b
   Wildcard(A,?,B): wildcard_relation; solve with §41 inference_method   *)


(* ================================================================
   §43  UNIFIED ANALYSIS GRAMMAR
        A = G + C + W + I + F
   ================================================================
   G = Graph        (relation_nodes + edge_records)
   C = Constraints  (prune candidate space)
   W = Wildcards    (unknown nodes or edges, named not suppressed)
   I = Inference    (traversal_method selects search strategy)
   F = Fold         (C6 phase reduction to solution)

   EBNF defines structure.
   Graphs define relationships.
   MathML defines formal transformations.
   AIML defines pattern capture.
   Wildcards represent unknowns.
   Graph ML predicts missing nodes and edges (link prediction).
   Folds reduce possibility space.
   Analysis = graph traversal + wildcard resolution.

   Wildcard GNN: Known Node → Known Node → [Unknown Node] → Known Node
   Message passing: neighbor signals → wildcard embedding update →
   predicted meaning. Mechanism is identical for: fill-in-the-blank,
   missing word, riddle, knowledge completion, OOD detection.
   ================================================================ *)

analysis_record
    ::= "{"
          "graph"        ":" "[" { relation_node  } "]"  ","
          "observations" ":" "[" { entity         } "]"  ","
          "constraints"  ":" "[" { string         } "]"  ","
          "wildcards"    ":" "[" { wildcard_entity } "]" ","
          "traversal"    ":" traversal_method            ","
          "fold"         ":" analysis_fold_kind          ","
          "result"       ":" analysis_result
        "}"
    ;

traversal_method
    ::= "bfs"               (* breadth-first over relation_nodes          *)
      | "dfs"               (* depth-first; good for chain reasoning       *)
      | "semantic_search"   (* WCR-weighted traversal (standard Yax path)  *)
      | "graph_ml"          (* message-passing GNN over known+wildcard     *)
    ;

analysis_fold_kind
    ::= "compare_fold"      (* fold_left A ∩ B: shared edge extraction    *)
      | "contrast_fold"     (* fold_left (A-B)∪(B-A): unique edges        *)
      | "analogy_fold"      (* isomorphism test on edge_kind pairs         *)
      | "game_fold"         (* §40: repeated imperfect-info fold game      *)
      | "wildcard_fold"     (* §41: WCR navigation with unknown slots      *)
    ;

analysis_result
    ::= explanation_result
      | prediction_result
      | classification_result
      | equilibrium_result
      | discovered_relation_result
    ;

explanation_result
    ::= "{"
          "kind" ":" "explanation" ","
          "text" ":" string
        "}"
    ;

prediction_result
    ::= "{"
          "kind"       ":" "prediction"  ","
          "entity"     ":" entity        ","
          "confidence" ":" number
        "}"
    ;

classification_result
    ::= "{"
          "kind"       ":" "classification" ","
          "class"      ":" identifier       ","
          "confidence" ":" number
        "}"
    ;

equilibrium_result
    ::= "{"
          "kind"       ":" "equilibrium"         ","
          "strategies" ":" "[" { identifier } "]"
        "}"
    ;

discovered_relation_result
    ::= "{"
          "kind"       ":" "discovered_relation" ","
          "source"     ":" identifier            ","
          "target"     ":" identifier            ","
          "relation"   ":" edge_kind             ","
          "confidence" ":" number
        "}"
    ;

(* §43 Universal Analysis Equation:
   A = G + C + W + I + F

   All analysis tasks are special cases of analysis_record:
     Compare:    compare_fold,  traversal=semantic_search, result=explanation
     Contrast:   contrast_fold, traversal=semantic_search, result=explanation
     Analogy:    analogy_fold,  traversal=bfs,             result=explanation
     Riddle:     wildcard_fold, inference=constraint_prop, result=explanation
     Baseball:   game_fold,     traversal=graph_ml,        result=prediction
     OOD ML:     wildcard_fold, traversal=graph_ml,        result=classification
     KG Compl.:  wildcard_fold, traversal=graph_ml,        result=discovered_relation
     Agent Plan: wildcard_fold, traversal=dfs,             result=prediction
     Game Theory:game_fold,     traversal=dfs,             result=equilibrium         *)


(* ================================================================
   §44  NPC THEORY GRAMMAR
        Perceive → Interpret → Decide → Act → Observe → Update
   ================================================================
   NPC behavior is a formal behavior grammar, NOT a general ML system.
   The NPC loop is deterministic, auditable, and personality-filtered.

   Core loop:
     npc_cycle = perception, decision, action, feedback

   K'UHUL MAPPINGS:
     npc_cycle         = C6 phase loop:
                           perception  = Wo  (environment unfolds, state read)
                           decision    = Yax (interpret) + Sek (propose tactic)
                           action      = Xul (commit to move/attack/talk)
                           feedback    = Pop (reset, carry observation delta)
     wildcard_behavior = §41 wildcard_fold:
                           observe+evaluate = Ch'en hold (insufficient info)
                           learn            = emerging_entity creation in G_runtime
                           "I don't know yet" = retained_wildcard = Investigate
     utility_ai        = argmax_wcr: maximize action_score = argmax S(u|Q)
                         over candidate actions; S(a) = W(a)*C(a)*R(a)
                         The action with highest WCR score wins
     personality       = W field modifier: each personality_type shifts the
                         weight W before Yax admission pass (aggressive boosts
                         attack W; cautious boosts observe W; etc.)
     relationship_graph= §42 relation_node applied to NPC-to-NPC/NPC-to-world
                         edges (friend, enemy, merchant, ally, rival)
     illusion_of_intelligence = believable ≠ optimal; SC-37 analog:
                         retained_wildcard (Investigate) is more convincing
                         than a hallucinated wrong action.
                         Players evaluate consistency+responsiveness+variation,
                         NOT optimal play.
     fsm               = discrete contracting fold: each transition is a
                         Pop→state reset; SC-k < 1 per transition = converging
     behavior_tree     = selector = argmax_first_success (first Yax pass);
                         sequence = fold_all (every node must succeed)
   ================================================================ *)

npc_record
    ::= "{"
          "identity"    ":" npc_identity    ","
          "personality" ":" personality_type ","
          "goals"       ":" "[" { objective } "]" ","
          "perception"  ":" npc_perception  ","
          "memory"      ":" "[" { known_fact } "]" ","
          "decision"    ":" npc_decision    ","
          "action"      ":" npc_action      ","
          "feedback"    ":" npc_feedback
        "}"
    ;

npc_identity
    ::= "{"
          "role"     ":" identifier ","
          "faction"  ":" identifier
        "}"
    ;

personality_type
    ::= "aggressive"  (* W boost: attack, flank; WCR shifts toward confrontation   *)
      | "cautious"    (* W boost: observe, retreat; holds at Ch'en longer           *)
      | "curious"     (* W boost: investigate, patrol; wildcard_behavior preferred  *)
      | "friendly"    (* W boost: talk, trade; opens dialog before action           *)
      | "cowardly"    (* W boost: flee, idle; Xul fires escape at low threat        *)
    ;

objective ::= identifier ;
known_fact ::= identifier ;

npc_perception
    ::= "{"
          "vision"   ":" "[" { identifier } "]" ","   (* visible objects/agents    *)
          "hearing"  ":" "[" { identifier } "]" ","   (* audible events            *)
          "memory"   ":" "[" { known_fact } "]"        (* recalled facts            *)
        "}"
    ;

npc_decision
    ::= fsm_decision
      | behavior_tree_decision
      | utility_decision
      | planner_decision
      | wildcard_decision
    ;

(* FSM: discrete state machine — each trigger fires a Pop→reset transition *)
fsm_decision
    ::= "{"
          "kind"    ":" "fsm"          ","
          "state"   ":" fsm_state      ","
          "trigger" ":" identifier     ","
          "next"    ":" fsm_state
        "}"
    ;

fsm_state
    ::= "patrol" | "alert" | "investigate" | "attack" | "retreat" ;

(* Behavior Tree: selector = argmax_first_success; sequence = fold_all *)
behavior_tree_decision
    ::= "{"
          "kind" ":" "behavior_tree"        ","
          "root" ":" bt_node
        "}"
    ;

bt_node
    ::= bt_selector
      | bt_sequence
      | bt_condition
      | bt_action_leaf
    ;

bt_selector  ::= "selector"  "(" { bt_node } ")" ;  (* first success wins     *)
bt_sequence  ::= "sequence"  "(" { bt_node } ")" ;  (* all must succeed       *)
bt_condition ::= "condition" "(" identifier   ")" ;
bt_action_leaf ::= "action"  "(" npc_action   ")" ;

(* Utility AI: argmax_wcr over action_score set — highest S(a) wins *)
utility_decision
    ::= "{"
          "kind"    ":" "utility_ai"             ","
          "scores"  ":" "[" { action_score } "]" ","
          "chosen"  ":" npc_action                     (* argmax S(a)           *)
        "}"
    ;

action_score
    ::= "{"
          "action"  ":" npc_action ","
          "utility" ":" number           (* S(a) = W(a)*C(a)*R(a), 0.0–1.0     *)
        "}"
    ;

(* Planner: sequence of actions toward a goal state *)
planner_decision
    ::= "{"
          "kind"  ":" "planner"                ","
          "goal"  ":" identifier               ","
          "plan"  ":" "[" { npc_action } "]"
        "}"
    ;

(* Wildcard decision: §41 — NPC encounters unknown situation *)
wildcard_decision
    ::= "{"
          "kind"      ":" "wildcard_reasoning" ","
          "trigger"   ":" wildcard_entity      ","   (* unknown situation       *)
          "observe"   ":" npc_perception       ","   (* gather more signal      *)
          "evaluate"  ":" inference_method     ","   (* Ch'en: hold + assess    *)
          "solution"  ":" wildcard_solution          (* resolved=act, retained=investigate *)
        "}"
    ;

npc_action
    ::= "patrol"
      | "move"
      | "talk"
      | "trade"
      | "attack"
      | "flee"
      | "idle"
      | "investigate"          (* wildcard_behavior default: Ch'en hold         *)
    ;

npc_feedback
    ::= "{"
          "update_memory"        ":" "[" { known_fact  } "]" ","
          "update_relationships" ":" "[" { edge_record } "]" ","
          "update_goals"         ":" "[" { objective   } "]"
        "}"
    ;                            (* feedback = Pop phase: carries delta forward  *)

(* §44 Relationship graph — §42 relation_node with NPC edge_kinds *)
npc_relation_kind
    ::= "friend" | "enemy" | "merchant" | "ally" | "rival" | "neutral" ;

npc_relationship
    ::= "{"
          "npc"      ":" identifier        ","
          "relation" ":" npc_relation_kind ","
          "target"   ":" identifier
        "}"
    ;

(* illusion_of_intelligence: believable ≠ optimal               *)
(* Players judge: consistency + responsiveness + variation,     *)
(* NOT: optimal play. Investigate > wrong action. SC-37 analog. *)
illusion_of_intelligence
    ::= "{"
          "consistency"    ":" number ","   (* same personality filters every cycle *)
          "responsiveness" ":" number ","   (* Wo→Xul latency; fast = alive         *)
          "variation"      ":" number       (* non-determinism in Sek proposal       *)
        "}"
    ;

(* §44 Invariant — NPC Cycle Law:
   npc_cycle = perception(Wo), decision(Yax+Sek), action(Xul), feedback(Pop)
   Every NPC tick is a full C6 traversal.
   wildcard_decision.solution = retained_wildcard → action = "investigate"
   personality_type shifts W field before Yax admission pass
   utility_ai.chosen = argmax S(a) = argmax W(a)*C(a)*R(a) = standard WCR    *)


(* ================================================================
   §45  UNIVERSAL SCRIPT GRAMMAR
        String → Pattern → Wildcard → Regex → Grammar →
        State Machine → Behavior → Agent
   ================================================================
   The lowest-level substrate beneath all higher-order grammars.
   Every agent system is a pattern engine operating at different levels
   of structure. The deepest loop is:

     perceive → search → match → transition

   This loop is identical across: string search, regex, wildcard
   matching, FSMs, behavior trees, NPC cycles, game theory, riddles,
   and statistical ML. The layers differ in what counts as a "pattern"
   and what counts as a "match" — not in the loop itself.

   LAYER STACK:
     String        → character sequence (raw substrate)
     Pattern       → literal | wildcard | regex (structured query)
     Wildcard      → §41 wildcard_entity: ? = single token, * = any seq
     Regex         = compact grammar language (atom + operators)
     Grammar       = structured pattern engine (EBNF rules)
     State Machine = state pattern engine (FSM transitions)
     Behavior      = hierarchical pattern engine (behavior tree)
     Agent         = reactive pattern engine (NPC cycle §44)

   PATTERN ENGINE TAXONOMY:
     Regex        = Symbol Pattern Engine
     Wildcard     = Unknown Pattern Engine  (§41)
     Grammar      = Structured Pattern Engine
     FSM          = State Pattern Engine    (§44 fsm_decision)
     BehaviorTree = Hierarchical Pattern Engine (§44 bt_node)
     NPC          = Reactive Pattern Engine (§44 npc_cycle)
     Game Theory  = Strategic Pattern Engine (§39-§40)
     Riddle       = Clue Pattern Engine     (§38 constraint_prop)
     ML           = Statistical Pattern Engine (§43 graph_ml)

   K'UHUL MAPPING of the script micro-cycle:
     perceive   = Wo  (input arrives, environment unfolds)
     search     = Yax (pattern evaluated against input)
     match      = Sek+Ch'en (candidate confirmed or rejected)
     transition = Xul (commit to next state or response)
   ================================================================ *)

(* §45a — Base String and Pattern Layer *)

string_token  ::= identifier | string ;
string_input  ::= "[" { string_token } "]" ;

pattern_atom
    ::= literal_pattern
      | wildcard_pattern_45
      | regex_pattern
    ;

literal_pattern   ::= string ;          (* exact match required              *)
wildcard_pattern_45
    ::= "?"                             (* any single token — §41 ?          *)
      | "*"                             (* any sequence, 0+ tokens — §41 *   *)
    ;

regex_pattern
    ::= regex_atom { regex_operator } ;

regex_atom
    ::= string                          (* literal atom                      *)
      | "."                             (* any single character              *)
      | "[" string "]"                  (* character class                   *)
    ;

regex_operator
    ::= "*"                             (* zero or more (Kleene star)        *)
      | "+"                             (* one or more                       *)
      | "?"                             (* zero or one (optional)            *)
      | "|"                             (* alternation: cat|dog              *)
      | "(" regex_pattern ")"          (* grouping                          *)
    ;

(* §45b — Search and Match Records *)

search_record
    ::= "{"
          "pattern"  ":" pattern_atom  ","
          "input"    ":" string_input  ","
          "engine"   ":" search_engine ","
          "result"   ":" match_result
        "}"
    ;

search_engine
    ::= "literal_scan"         (* O(n) character-by-character              *)
      | "wildcard_search"      (* ? = skip 1, * = skip any; §41            *)
      | "regex_engine"         (* NFA/DFA backtracking over regex_pattern   *)
      | "grammar_parse"        (* EBNF rule application                    *)
      | "state_machine"        (* FSM: current state + input → next state  *)
      | "semantic_search"      (* WCR-weighted match over fold graph        *)
    ;

match_result
    ::= "{"
          "matched"    ":" boolean     ","
          "captures"   ":" "[" { string_token } "]" ","  (* wildcard/group captures *)
          "confidence" ":" number                          (* 1.0 for exact, <1 for semantic *)
        "}"
    ;

(* §45c — Universal Script Record *)

script_record
    ::= "{"
          "input"    ":" script_input   ","
          "pattern"  ":" pattern_atom   ","
          "wildcard" ":" "[" { wildcard_entity } "]" ","
          "search"   ":" search_engine  ","
          "match"    ":" match_result   ","
          "response" ":" script_response
        "}"
    ;

script_input
    ::= text_input
      | game_state_input
      | graph_input
      | clue_input
      | observation_input
    ;

text_input        ::= string_input ;
game_state_input  ::= "[" { identifier } "]" ;
graph_input       ::= "[" { relation_node } "]" ;
clue_input        ::= "[" { string } "]" ;
observation_input ::= "[" { entity   } "]" ;

script_response
    ::= action_response
      | answer_response
      | classification_response
      | transition_response
    ;

action_response         ::= npc_action ;             (* §44 *)
answer_response         ::= string ;
classification_response ::= identifier ;
transition_response     ::= fsm_state ;              (* §44 *)

(* §45d — Universal Agent Loop *)

agent_record
    ::= "{"
          "perceive"   ":" script_input  ","   (* Wo: input arrives            *)
          "search"     ":" search_engine ","   (* Yax: evaluate pattern        *)
          "match"      ":" match_result  ","   (* Sek+Ch'en: confirm/reject    *)
          "decide"     ":" npc_decision  ","   (* Sek→Ch'en: select response   *)
          "act"        ":" script_response     (* Xul: commit                  *)
        "}"
    ;

(* ================================================================
   §46  REGEX–FSM DUALITY
        Regex answers WHAT. FSM answers WHERE + HOW.
        Same language, different representation.
        Compilation: Regex → NFA → DFA (Thompson construction)
   ================================================================
   Regex = declarative pattern specification (symbol grammar)
   FSM   = procedural execution graph (behavior grammar)

   Regex describes a language.  FSM recognizes it.
   Every regular expression compiles to a finite automaton.
   Every FSM accepts a language describable by a regex.

   K'UHUL MAPPINGS:
     regex pattern  = Wo layer: declare what to match (unfold spec)
     FSM execution  = Xul layer: commit state transitions
     NFA state      = emerging_entity: multiple simultaneous candidates
     DFA state      = known_entity: one deterministic state per input
     ε-transition   = Pop reset: move without consuming input
     accept_state   = Xul commit: pattern confirmed, transition fires
     regex * (star) = C6 loop: { } repetition = Pop→cycle
     regex ? (opt)  = §41 wildcard_entity: zero_or_one = optional
     regex | (alt)  = Sek candidates: multiple proposals, Yax selects
     compilation    = Sek→Ch'en: regex proposes structure, Ch'en proves
                      the NFA/DFA accepts the same language

   LAYER STACK clarification from §45:
     String → Regex (declarative) → FSM (compiled execution) →
     Behavior Tree → NPC → Agent

   DUALITY TABLE:
     Regex:  pattern-centric | declarative | compact | text-focused
     FSM:    state-centric   | procedural  | explicit graph | behavior

   SYSTEMS that compile regex → FSM:
     Lexer/scanner (lex, flex)    : token patterns → DFA
     Parser (yacc, bison)         : grammar rules  → LALR automaton
     NPC AI                       : behavior rules → state machine
     Protocol handler             : message specs  → state machine
     Dialogue system              : script patterns → conversation FSM
     Workflow engine              : trigger rules  → process automaton
   ================================================================ *)

(* §46a — NFA and DFA state types *)

nfa_state
    ::= "{"
          "id"          ":" identifier              ","
          "transitions" ":" "[" { nfa_transition } "]" ","
          "accepting"   ":" boolean
        "}"
    ;                   (* NFA: multiple transitions per symbol allowed *)
                        (* maps to emerging_entity in G_runtime         *)

nfa_transition
    ::= "{"
          "symbol" ":" string_token ","   (* or "ε" for epsilon       *)
          "target" ":" identifier         (* next nfa_state id         *)
        "}"
    ;

dfa_state
    ::= "{"
          "id"          ":" identifier              ","
          "transitions" ":" "[" { dfa_transition } "]" ","
          "accepting"   ":" boolean
        "}"
    ;                   (* DFA: exactly one transition per symbol       *)
                        (* maps to known_entity in G_runtime            *)

dfa_transition
    ::= "{"
          "symbol" ":" string_token ","   (* no ε-transitions in DFA   *)
          "target" ":" identifier
        "}"
    ;

(* §46b — Regex and FSM records *)

regex_record
    ::= "{"
          "pattern"    ":" regex_pattern ","   (* §45 regex_pattern    *)
          "input"      ":" string_input  ","
          "result"     ":" match_result        (* declarative: WHAT     *)
        "}"
    ;

fsm_record_46
    ::= "{"
          "states"     ":" "[" { dfa_state } "]"   ","
          "start"      ":" identifier               ","
          "input"      ":" string_input             ","
          "result"     ":" match_result                   (* HOW + WHERE *)
        "}"
    ;

(* §46c — Compilation record: regex → NFA → DFA *)
compilation_record
    ::= "{"
          "source_regex"  ":" regex_pattern        ","
          "nfa"           ":" "[" { nfa_state } "]" ","
          "dfa"           ":" "[" { dfa_state } "]" ","
          "equivalent"    ":" boolean                     (* accepts same language *)
        "}"
    ;

(* §46 Duality Laws:
   (1) For every regex R there exists a DFA D such that L(R) = L(D).
       equivalent = true in compilation_record.

   (2) Regex operators map to K'UHUL structures:
       R*    = { R } in EBNF  = Pop→reset loop in C6
       R?    = §41 wildcard_entity (optional = emerging_entity)
       R|S   = R | S in EBNF  = Sek candidates, Yax selects first match
       (RS)  = R , S in EBNF  = sequential fold (Wo→Xul for R then S)

   (3) NFA state = emerging_entity (σ-unbound over multiple branches).
       DFA state = known_entity (deterministic, one live state).
       Subset construction (NFA→DFA) = Ch'en proof that sigma resolves
       to a single deterministic state set.

   (4) Regex answers WHAT pattern is acceptable.
       FSM answers WHERE the recognizer is and HOW it moves.
       Together: regex = Wo spec, FSM = Xul execution.              *)

(* ================================================================
   §47  DFA–NFA TRADEOFFS
        One Future vs Many Possible Futures
   ================================================================
   DFA: one active state, one next state per symbol, no ε-transitions.
        Fast matching. More memory (all paths precomputed).
        = single outgoing resolution path
        = resolved_wildcard at every step

   NFA: multiple active states, multiple next states per symbol allowed,
        ε-transitions allowed. Compact. More runtime work (paths explored
        during matching, not precomputed).
        = branching possibility graph
        = retained_wildcard over the active state set

   K'UHUL MAPPINGS:
     DFA state   = known_entity: sigma bound, one active state
                 = "one future": Xul already knows the next state
     NFA state   = emerging_entity: sigma unbound, multiple live states
                 = "many futures": Ch'en hold over branching paths
     DFA NPC     = §44 fsm_decision: strict, deterministic,
                   one state active at a time
     NFA NPC     = modern behavior system: multiple conditions evaluated
                   simultaneously; partial activation of several subtrees
     DFA player  = dominant strategy (§39): one legal response per state,
                   predictable, no strategic uncertainty
     NFA player  = mixed strategy (§39 SC-34): multiple responses per
                   state, strategic uncertainty, SC-36 territory
     wildcard *  = NFA-friendly: C*T = compact NFA self-loop
                   DFA equivalent requires explicit expanded states
                   (powerset construction: up to 2^n DFA states from n NFA)
     subset_constr= NFA→DFA compilation = Ch'en proof: the branching
                    NFA possibility space resolves to a single deterministic
                    state set = known_entity = sigma bound
   ================================================================ *)

automaton
    ::= dfa_automaton
      | nfa_automaton
    ;

dfa_automaton
    ::= "{"
          "kind"         ":" "dfa"                   ","
          "states"       ":" "[" { dfa_state } "]"   ","
          "start"        ":" identifier              ","
          "accept"       ":" "[" { identifier } "]"  ","
          "active_state" ":" identifier                    (* exactly one at all times *)
        "}"
    ;

nfa_automaton
    ::= "{"
          "kind"          ":" "nfa"                    ","
          "states"        ":" "[" { nfa_state } "]"    ","
          "start"         ":" identifier               ","
          "accept"        ":" "[" { identifier } "]"   ","
          "active_states" ":" "[" { identifier } "]"        (* set: 1..n live states  *)
        "}"
    ;

tradeoff_record
    ::= "{"
          "automaton_kind" ":" ( "dfa" | "nfa" )    ","
          "active_states"  ":" number                ","   (* DFA=1, NFA≥1            *)
          "memory_cost"    ":" ( "higher" | "lower" ) ","  (* DFA precomputes paths   *)
          "runtime_cost"   ":" ( "lower"  | "higher" ) ","  (* NFA explores at runtime *)
          "epsilon_allowed" ":" boolean              ","   (* NFA only                *)
          "future_kind"    ":" ( "single" | "branching" )   (* DFA=one, NFA=many      *)
        "}"
    ;

(* §47 Laws:
   (1) DFA = one future:  active_states = 1 always.
       Xul always knows the next state before input arrives (precomputed).
       Equivalent to resolved_wildcard at every transition.

   (2) NFA = many futures: active_states ≥ 1.
       Ch'en holds open multiple possibilities until input disambiguates.
       Equivalent to retained_wildcard over the active state set.
       Resolved when exactly one path reaches an accept state.

   (3) Wildcard patterns (C*T) are NFA-natural.
       The * self-loop is one NFA state; the equivalent DFA may have
       exponentially more states (2^n via powerset construction).
       §41 wildcard_entity is NFA-native; forcing to DFA costs memory.

   (4) NPC analogy:
       DFA NPC = strict fsm_decision (§44): one state at a time.
       NFA NPC = modern behavior system: behavior tree with simultaneous
       subtree evaluation; multiple conditions partially active.

   (5) Game theory analogy (§39):
       DFA player = dominant strategy: one legal response per state.
       NFA player = mixed strategy: multiple responses per state.
       SC-34: Nash equilibrium = the state where both players reduce
       their NFA to a single-branch DFA (one best response each).   *)

(* §46 will follow §45 — see below *)

(* §45 Invariants:
   (1) The perceive→search→match→transition loop is substrate-invariant.
       The same loop runs in: string search, regex, AIML, FSM,
       behavior tree, NPC cycle, game theory, riddle, and ML inference.

   (2) Pattern engines differ in what "pattern" means:
       literal_scan:    pattern = exact string
       wildcard_search: pattern includes §41 ?, * symbols
       regex_engine:    pattern = regex_atom + operators
       grammar_parse:   pattern = EBNF rule (recursive structure)
       state_machine:   pattern = (current_state, trigger) pair
       semantic_search: pattern = WCR query Q over fold graph

   (3) match_result.confidence = 1.0 for exact; < 1.0 for wildcard/semantic.
       When confidence < threshold: retained_wildcard (SC-37).
       When confidence ≥ threshold: resolved_wildcard → Xul commit.

   (4) Regex alternation (cat|dog) = grammar alternation (cat | dog)
       = FSM branching = behavior_tree selector = Sek proposal with
       multiple candidates. All are the same Yax admission structure
       expressed at different levels of the stack.                        *)


(* ================================================================
   §48 NFA vs DFA vs Backtracking — Parallel Possibilities vs Sequential Guessing

   The three-way distinction that NFA is often confused with backtracking.

   DFA:          1 active state  →  1 next state.  sigma bound always.
   NFA:          n active states →  n' next states.  All advance simultaneously.
                 NOT sequential. NOT guessing. NOT rewinding.
   Backtracking: 1 active path.  Try → fail → rewind → try next.
                 Sequential exploration of Sek candidates.

   Central law:
     NFA = parallel possibilities (retained_wildcard over active state set,
           all futures alive simultaneously)
     Backtracking = sequential guessing (one path at a time, rewind on fail)
     DFA = resolved_wildcard at every step (precomputed, one future)

   NPC analogies:
     DFA NPC     = Patrol→Alert→Attack (one deterministic path)
     NFA NPC     = {Attack,Flank,Retreat,Investigate} evaluated simultaneously,
                   all futures live until input disambiguates
     Backtracking NPC = try attack; if fail → rewind → try flank;
                        if fail → rewind → try retreat (sequential)

   CA example (matching CAT|CAR|CAN|...):
     DFA after "CA": still in one combined state S2.
     NFA after "CA": active = {T?,R?,N?,P?,D?,B?,M?,L?,S?,K?}
                     10 futures alive simultaneously, not tried one at a time.
   ================================================================ *)

execution_strategy
    ::= dfa_execution
      | nfa_execution
      | backtracking_execution
    ;

dfa_execution
    ::= "{"
          "kind"          ":" "dfa_execution"        ","
          "active_states" ":" "[" identifier "]"     ","   (* exactly 1 *)
          "next_state"    ":" identifier              ","
          "mode"          ":" "resolved_wildcard"
        "}"
    ;

nfa_execution
    ::= "{"
          "kind"          ":" "nfa_execution"              ","
          "active_states" ":" "[" { identifier } "]"       ","  (* 1..n simultaneous *)
          "advance"       ":" "all_active_simultaneously"  ","
          "mode"          ":" "retained_wildcard"
        "}"
    ;

backtracking_execution
    ::= "{"
          "kind"         ":" "backtracking_execution"  ","
          "active_path"  ":" identifier                ","   (* exactly 1 path active *)
          "rewind_stack" ":" "[" { identifier } "]"    ","   (* saved choice points   *)
          "advance"      ":" "sequential_try_rewind"   ","
          "mode"         ":" "sequential_wildcard"
        "}"
    ;

(* §48 Laws:
   (1) NFA ≠ backtracking.
       NFA advances all active_states simultaneously per input symbol.
       Backtracking tries one path, rewinds if it fails, tries the next.

   (2) DFA: active_states = 1 always. resolved_wildcard at every step.

   (3) NFA: advance ALL active states per symbol.
       Active = {S1,S7,S12} → read 'x' → {S2,S8,S14}.
       No rewinding. No guessing. No sequential exploration.
       Equivalent to retained_wildcard over the live set.

   (4) Backtracking: try → fail → rewind (pop choice point) → try next Sek candidate.
       This is sequential exploration of the Sek candidate set,
       not simultaneous parallel activation.

   (5) True NFA simulation:
       for each symbol: next_set = ∪ { transitions(s, sym) | s ∈ active }
       This is O(n·|active|) per symbol — no exponential blowup at runtime,
       unlike backtracking which can exhibit O(2^n) worst-case behavior.   *)


(* ================================================================
   §49 Regex as Set Grammar — Five Universal Primitives

   A regex does not describe a string. It describes a SET of possible strings.
   The four core operations map to set algebra:

     Literal:        "cat"    = singleton set {cat}
     Alternation:    A|B      = A∪B (set union)     → Sek candidates, Yax selects
     Concatenation:  AB       = {xy | x∈L(A), y∈L(B)}  → sequential fold chain
     Repetition:     R*       = ∪_{n≥0} L(R)^n         → C6 loop (Pop→reset)

   Universality:
     Five primitives appear at every substrate level:
       choice(|), sequence(,), optional(?), loop(*,+), wildcard(.)
     These are the same across: regex, EBNF, FSM, behavior_tree,
     NPC decision (§44), dialogue, workflow, agent system (§45).

     Regex is the compact algebra; NFA is the graph form of the possibility space.
   ================================================================ *)

regex_set_record
    ::= "{"
          "pattern"  ":" regex_pattern       ","
          "language" ":" "[" { string } "]"  ","
          "set_op"   ":" set_operation
        "}"
    ;

set_operation
    ::= "union"       (* A|B = A∪B  *)
      | "product"     (* AB   = Cartesian chain *)
      | "star"        (* R*   = infinite union of powers *)
      | "singleton"   (* "x"  = {x} *)
      | "any"         (* .    = {any single token} *)
    ;

regex_primitive
    ::= literal_match
      | alternation_49
      | concatenation_49
      | repetition_family
      | wildcard_match
    ;

literal_match    ::= string ;

alternation_49   ::= regex_primitive "|" regex_primitive ;
                     (* L(A|B) = L(A) ∪ L(B)  = Sek candidates  *)

concatenation_49 ::= regex_primitive regex_primitive ;
                     (* L(AB)  = {xy | x∈L(A), y∈L(B)}  = sequential fold *)

repetition_family
    ::= optional_match
      | zero_or_more
      | one_or_more
      | bounded_rep
    ;

optional_match   ::= regex_primitive "?" ;             (* L(R?) = L(R) ∪ {ε}  = §41 wildcard_entity  *)
zero_or_more     ::= regex_primitive "*" ;             (* L(R*) = ∪_{n≥0} L(R)^n = C6 loop           *)
one_or_more      ::= regex_primitive "+" ;             (* L(R+) = L(R)·L(R*)  = C6 loop, Wo entry    *)
bounded_rep      ::= regex_primitive "{" number "," number "}" ;  (* explicit NFA self-loop expansion *)

wildcard_match   ::= "." ;         (* any single token  = §41 wildcard_entity  *)
wildcard_sequence ::= "." "*" ;   (* any sequence      = retained_wildcard until match *)

universal_primitive
    ::= "choice"    (* | : Sek candidates, Yax admission selects first match *)
      | "sequence"  (* , : sequential fold chain, ordered Wo→Xul arcs *)
      | "optional"  (* ? : §41 wildcard_entity, zero or one = emerging_entity *)
      | "loop"      (* *, + : C6 repetition (Pop→Wo→…→Xul→Pop) *)
      | "wildcard"  (* .   : §41 wildcard_entity, any single token *)
    ;

(* §49 Laws:
   (1) Regex = Set Grammar. L(R) is the set of all strings the regex matches.
       Writing a regex is defining a language (a set), not a string template.

   (2) Alternation = set union = Sek candidates.
       L(A|B) = L(A) ∪ L(B).  gray|grey = {gray,grey}.

   (3) Kleene star = C6 loop = potentially infinite set.
       L(R*) = {ε} ∪ L(R) ∪ L(R)² ∪ L(R)³ ∪ ...
       Still regular (no recursion), representable as an NFA self-loop.

   (4) The five universal primitives (choice, sequence, optional, loop, wildcard)
       are substrate-invariant: they appear in regex, EBNF, FSM, behavior_tree,
       NPC logic, dialogue, workflow, and agent systems.
       §49 Universality Law: regex is the compact notation for this algebra;
       NFA is its graph execution form.

   (5) NFA = possibility graph form of a regex.
       Each regex operator maps to an NFA sub-graph (Thompson construction).
       DFA collapses the NFA possibility space: 1→many (NFA) reduced to
       many→1 (DFA powerset state = known combined possibility subset).   *)

(* ================================================================
   §50 FOLDL / FOLDR — Structural Fold Algebra

   foldl (left fold, catamorphism):
     foldl f z [x1,x2,x3] = f(f(f(z, x1), x2), x3)
     = left-associative accumulation, strict left-to-right
     = C6 cycle applied to a sequence: at each arc,
       (accumulator, input) -> new_accumulator

   foldr (right fold, catamorphism, right-associative):
     foldr f z [x1,x2,x3] = f(x1, f(x2, f(x3, z)))
     = right-associative reduction, evaluates deepest element first
     = grammar parse tree evaluation: leaf rules evaluated first,
       combined upward at each grammar node

   CORRECTION: foldl AND foldr are BOTH catamorphisms (reductions: Many→One).
   The difference is only associativity. Anamorphism is a SEPARATE concept (unfold).

   Recursion scheme family:
     catamorphism (fold)   = reduce structure to value  = Many→One
       foldl: left-associative  ((z⊗x1)⊗x2)⊗x3
       foldr: right-associative  x1⊗(x2⊗(x3⊗z))
     anamorphism (unfold)  = generate structure from seed = One→Many
     hylomorphism          = anamorphism then catamorphism = generate then reduce
     metamorphism          = catamorphism then anamorphism = fold then unfold

   K'UHUL phase mappings:
     foldl accumulator update = Pop carries accumulator forward each cycle
     foldr leaf evaluation   = Wo (deepest element first, input arrives)
     foldr combine step      = Xul (grammar rule fires after children combine)
     anamorphism             = Wo unfold: seed → possibility space (One→Many)
     catamorphism            = C6 cycle: possibility space → Xul output (Many→One)
     hylomorphism            = Wo unfold (ana) + C6 cycle (cata) = full intelligence loop

   Applied:
     NPC feedback   = foldl (cata): (npc_state, event) → new_npc_state each Pop
     NFA advance    = foldl (cata): (active_states, symbol) → next_active_states
     Grammar parse  = foldr (cata): recursive descent evaluates leaves first
     Regex compile  = foldr (cata): Thompson construction builds NFA from regex AST
     Wo expansion   = anamorphism: seed → NFA state set (generate possibilities)
     argmax_wcr     = catamorphism: WCR scores → one Xul commit
     NPC planning   = hylomorphism: goal → behaviors (ana) → best action (cata)
     Game tree      = hylomorphism: position → move tree (ana) → minimax fold (cata)
   ================================================================ *)

fold_algebra_record
    ::= foldl_record
      | foldr_record
      | scanl_record
      | anamorphism_record
      | hylomorphism_record
      | metamorphism_record
    ;

foldl_record
    ::= "{"
          "kind"        ":" "foldl"                   ","
          "f"           ":" accumulate_fn              ","
          "z"           ":" accumulator                ","   (* initial value *)
          "input"       ":" "[" { element } "]"        ","
          "result"      ":" accumulator                ","   (* final value   *)
          "phase_map"   ":" "Pop_carries_accumulator_forward"
        "}"
    ;

foldr_record
    ::= "{"
          "kind"        ":" "foldr"                   ","
          "f"           ":" combine_fn                ","
          "z"           ":" base_case                 ","   (* leaf / terminal *)
          "input"       ":" "[" { element } "]"       ","
          "result"      ":" accumulator               ","
          "phase_map"   ":" "Wo_leaf_Xul_combine"
        "}"
    ;

scanl_record
    ::= "{"
          "kind"       ":" "scanl"                              ","
          "f"          ":" accumulate_fn                        ","
          "z"          ":" accumulator                          ","
          "input"      ":" "[" { element } "]"                  ","
          "history"    ":" "[" { accumulator } "]"              ","  (* all intermediates *)
          "phase_map"  ":" "C6_cycle_with_full_state_history"
        "}"
    ;

anamorphism_record
    ::= "{"
          "kind"       ":" "anamorphism"                ","
          "seed"       ":" identifier                   ","   (* starting value / goal *)
          "generator"  ":" generate_fn                  ","   (* seed → {next_values}  *)
          "structure"  ":" "[" { element } "]"          ","   (* generated possibility space *)
          "phase_map"  ":" "Wo_unfold_One_to_Many"
        "}"
    ;

hylomorphism_record
    ::= "{"
          "kind"       ":" "hylomorphism"      ","
          "unfold"     ":" anamorphism_record   ","   (* ana first: seed → structure *)
          "fold"       ":" foldl_record         ","   (* cata second: structure → value *)
          "phase_map"  ":" "Wo_unfold_C6_refold"
        "}"
    ;

metamorphism_record
    ::= "{"
          "kind"       ":" "metamorphism"       ","
          "fold"       ":" foldl_record         ","   (* cata first: structure → value *)
          "unfold"     ":" anamorphism_record   ","   (* ana second: value → new structure *)
          "phase_map"  ":" "Xul_commit_then_Wo_reexpand"
        "}"
    ;

accumulate_fn ::= "(" accumulator "," element ")"   "->" accumulator ;
combine_fn    ::= "(" element     "," accumulator ")" "->" accumulator ;
generate_fn   ::= "(" identifier ")" "->" ( "stop" | "[" { identifier } "]" ) ;

accumulator ::= identifier ;
element     ::= identifier ;
base_case   ::= identifier ;

(* §50 Laws:
   CORRECTION: foldl AND foldr are BOTH catamorphisms (Many→One reductions).
   Anamorphism is the unfold (One→Many). The full recursion scheme family:
     catamorphism (cata) = fold   = Many→One  [foldl, foldr]
     anamorphism  (ana)  = unfold = One→Many
     hylomorphism (hylo) = ana then cata = generate then reduce
     metamorphism (meta) = cata then ana = fold then unfold

   (1) foldl = catamorphism, left-associative.
       foldl f z [x1,x2,x3] = ((z⊗x1)⊗x2)⊗x3.
       C6 loop: Pop carries accumulator forward each arc.
       NPC feedback = foldl: (npc_state, event) → new_npc_state.
       NFA advance  = foldl: (active_states, sym) → next_active_states.

   (2) foldr = catamorphism, right-associative.
       foldr f z [x1,x2,x3] = x1⊗(x2⊗(x3⊗z)).
       Evaluates deepest element first. Grammar parse tree.
       For non-associative f: foldl ≠ foldr.
         foldl (-) 0 [1,2,3] = ((0-1)-2)-3 = -6
         foldr (-) 0 [1,2,3] = 1-(2-(3-0)) = 2
       Thompson construction = foldr over regex AST.

   (3) anamorphism = unfold = One→Many.
       seed → generator → possibility structure.
       K'UHUL: Wo phase = anamorphism: input seed → NFA state expansion.
       NPC planning: goal → {Patrol, Guard, Investigate, Attack, Retreat}.
       Game tree: position → {Move A, Move B, Move C, Move D}.
       Riddle: clue → {Piano, Keyboard, Map, Car}.

   (4) hylomorphism = intelligence loop = ana ∘ cata.
       intelligence ≈ generate possibilities then reduce possibilities.
       Riddle:      clue → candidates (ana) → apply constraints → answer (cata).
       NPC AI:      goal → behaviors (ana) → argmax_wcr → action (cata).
       Game theory: position → game tree (ana) → minimax fold → best move (cata).
       Regex:       pattern → NFA (ana) → subset construction → DFA (cata).
       Wildcard ML: query → candidates (ana) → WCR selection (cata).

   (5) scanl = catamorphism + full history.
       scanl f z input = [z, f(z,x1), f(f(z,x1),x2), ...]
       = C6 cycle that saves every intermediate accumulator.
       Rolling session context log = scanl of the C6 cycle.

   (6) Compact law:
       catamorphism = Many→One = fold
       anamorphism  = One→Many = unfold
       intelligence ≈ anamorphism ∘ catamorphism
                    = generate possibilities, then reduce possibilities.  *)


(* ================================================================
   §51 FoldGraph as Graph-Native Hylomorphism

   FoldGraph is not foldl/foldr over a list — it is a hylomorphism
   over a graph topology B.

   Type signature:
     Ana_Q  : (B, Q) → F_Q            (Unfold: topology + query → field)
     Cata_Π : F_Q   → C_Q             (Fold: field → canonical projection)
     FoldGraph : (B, Q) → C_Q = Cata_Π ∘ Ana_Q

   With optional attention/constrain step:
     FoldGraph(B,Q) = Cata_Π(Attention(Ana_Q(B,Q)))

   Fundamental hylomorphic identity (from fold_graph.xml law hylomorphism-identity):
     (Fold ∘ Unfold)(h) ≡ h
     Knowledge = Fold(Unfold(Knowledge))
     Every query expands B into F_Q, then folds F_Q back to C_Q.

   NFA / DFA interpretation (§47 connection):
     Ana  = NFA expansion: One→Many (1 query → N candidates)
     Cata = DFA construction: Many→One (N candidates → 1 canonical result)
     FoldGraph = NFA expansion then DFA reduction = hylomorphism over B

   Wildcard support:
     During Ana: node = known | wildcard | candidate (unresolved allowed)
     During Cata: fold_result = resolved | retained_wildcard
     FoldGraph does NOT require complete collapse. SC-37 applies.

   Kleene iteration:
     f = cata ∘ ana (one Micronaut cycle)
     f^n(query) is Kleene iteration converging to Xul = least fixed point
     µf = ⊔{f^n(⊥) | n≥0}
     Convergence requires contraction: k = d(f^(n+1),f^n)/d(f^n,f^(n-1)) < k_max
   ================================================================ *)

fold_graph_record
    ::= "{"
          "query"     ":" identifier         ","   (* Q *)
          "source"    ":" identifier         ","   (* B = base topology *)
          "field"     ":" identifier         ","   (* F_Q = unfolded candidate field *)
          "attention" ":" attention_record   ","   (* constrain/rank F_Q → F*_Q *)
          "canonical" ":" identifier               (* C_Q = canonical projection *)
        "}"
    ;

fold_graph_pipeline
    ::= ana_step
        attention_step
        cata_step
    ;

ana_step
    ::= "{"
          "kind"   ":" "ana"                          ","
          "input"  ":" "(" identifier "," identifier ")"  ","   (* (B, Q) *)
          "output" ":" identifier                           ","   (* F_Q *)
          "expand" ":" ( "graph_expand" | "wildcard_expand" | "hypothesis_expand" )
        "}"
    ;

attention_step
    ::= "{"
          "kind"       ":" "attention"                                    ","
          "input"      ":" identifier                                     ","   (* F_Q *)
          "operations" ":" "[" { ( "ranking" | "confidence" | "wildcard_bounding" | "wcr_score" ) } "]" ","
          "output"     ":" identifier                                           (* F*_Q *)
        "}"
    ;

cata_step
    ::= "{"
          "kind"   ":" "cata"                                   ","
          "input"  ":" identifier                               ","   (* F*_Q *)
          "output" ":" identifier                               ","   (* C_Q *)
          "reduce" ":" ( "graph_reduce" | "semantic_fold" | "equilibrium_fold" | "canonical_projection" ) ","
          "result" ":" ( "resolved" | "retained_wildcard" )           (* SC-37 applies *)
        "}"
    ;

attention_record
    ::= "{"
          "ranking"           ":" boolean   ","
          "confidence_filter" ":" boolean   ","
          "wildcard_bounding" ":" boolean
        "}"
    ;

(* §51 Laws:
   (1) FoldGraph = Cata_Π ∘ Ana_Q.
       Type: (B,Q) → C_Q.
       Ana: (B,Q) → F_Q (unfold: expand neighborhood into candidate field).
       Cata: F_Q → C_Q (fold: canonical projection under preservation contract).

   (2) Hylomorphic identity: (Fold∘Unfold)(h) ≡ h.
       Knowledge = Fold(Unfold(Knowledge)).
       Every query temporarily expands B into F_Q, then folds back to C_Q.
       B is preserved (topology-preservation law from fold_graph.xml).

   (3) Ana behaves like NFA (§47): 1 query → N candidate states (One→Many).
       Cata behaves like DFA construction (§47): N candidates → 1 canonical result.
       FoldGraph is §50 hylomorphism applied to graph topology, not a list.

   (4) Wildcard support (SC-37):
       During Ana: unresolved nodes = retained_wildcard (wildcard_entity §41).
       During Cata: fold_result = resolved | retained_wildcard.
       FoldGraph does not force complete collapse. Returning retained_wildcard
       when evidence is insufficient is correct (SC-37).

   (5) Kleene iteration: f^n(query) → Xul = µf (least fixed point).
       One C6 arc = one iteration. Convergence when contraction k < k_max.
       Divergence (k ≥ k_max) signals retained_wildcard or Ch'en hold.

   (6) Attention as middle step: F_Q → F*_Q.
       Ranks, constrains, confidence-filters the raw unfolded field.
       Does not mutate B — operates only on the temporary field F_Q.   *)

(* ================================================================
   §52 — FoldGraph Typed Specification (Formal Graph Hylomorphism)
   Canonical source: user-provided 2026-10-06.
   This section makes §51 type-precise.
   ================================================================ *)

(* §52 Core Types *)

node_kind    ::= "Known" | "Candidate" | "Wildcard" ;
node_52      ::= "{" "kind" ":" node_kind "," "id" ":" identifier "}" ;
edge_52      ::= "{" "src" ":" identifier "," "dst" ":" identifier ","
                     "rel" ":" identifier "," "weight" ":" number "}" ;
graph_52     ::= "{" "nodes" ":" "[" { node_52 } "]" ","
                     "edges" ":" "[" { edge_52 } "]" "}" ;
query_52     ::= "{" "pattern" ":" identifier ","
                     "constraints" ":" "[" { identifier } "]" "}" ;

score_entry  ::= "{" "node_id" ":" identifier "," "confidence" ":" number "}" ;

candidate_field_52 ::= "{"
    "graph"      ":" graph_52               ","
    "frontier"   ":" "[" { node_52 } "]"   ","
    "unresolved" ":" "[" { node_52 } "]"   ","
    "scores"     ":" "[" { score_entry } "]"
  "}" ;

canonical_view_52 ::= "{"
    "selected"   ":" "[" { node_52 } "]"  ","
    "relations"  ":" "[" { edge_52 } "]"  ","
    "confidence" ":" number
  "}" ;

(* §52 Functor: GraphF A = Empty | Vertex(Node, List A) *)

graph_functor_52  ::= graph_functor_empty_52 | graph_functor_vertex_52 ;
graph_functor_empty_52  ::= "{" "kind" ":" "Empty" "}" ;
graph_functor_vertex_52 ::= "{"
    "kind"     ":" "Vertex"              ","
    "node"     ":" node_52               ","
    "children" ":" "[" { graph_functor_52 } "]"
  "}" ;

(* §52 Coalgebra ψ : (Graph,Query) → GraphF (Graph,Query) *)

coalgebra_psi ::= "{"
    "kind"     ":" "coalgebra_psi"                              ","
    "input"    ":" "(" graph_52 "," query_52 ")"               ","
    "frontier" ":" "[" { node_52 } "]"                         ","
    "output"   ":" graph_functor_52
  "}" ;

(* §52 Attention: CandidateField → CandidateField *)

attention_52 ::= "{"
    "kind"   ":" "attention_52"          ","
    "input"  ":" candidate_field_52      ","
    "output" ":" candidate_field_52
  "}" ;

(* §52 Algebra φ : GraphF CanonicalView → CanonicalView *)

algebra_phi_52 ::= algebra_phi_empty_52 | algebra_phi_vertex_52 ;
algebra_phi_empty_52  ::= "{" "kind" ":" "algebra_phi_empty" ","
                              "output" ":" canonical_view_52 "}" ;
algebra_phi_vertex_52 ::= "{"
    "kind"          ":" "algebra_phi_vertex"              ","
    "node"          ":" node_52                           ","
    "children"      ":" "[" { canonical_view_52 } "]"   ","
    "best_children" ":" "[" { canonical_view_52 } "]"   ","
    "output"        ":" canonical_view_52
  "}" ;

(* §52 Wildcard Coalgebra: expand never fails — emits Wildcard on empty neighborhood *)

wildcard_expand_52 ::= "{"
    "kind"      ":" "wildcard_expand"          ","
    "node"      ":" node_52                    ","
    "neighbors" ":" "[" { node_52 } "]"        ","
    "output"    ":" "[" { node_52 } "]"
  "}" ;

(* §52 Wildcard Algebra: confidence threshold gates Known vs Wildcard *)

wildcard_resolve_52 ::= "{"
    "kind"       ":" "wildcard_resolve"   ","
    "node"       ":" node_52              ","
    "confidence" ":" number               ","
    "threshold"  ":" number               ","
    "output"     ":" node_52
  "}" ;

(* §52 Complete FoldGraph Pipeline Record *)

fold_graph_52 ::= "{"
    "kind"     ":" "fold_graph_52"       ","
    "graph"    ":" graph_52              ","
    "query"    ":" query_52              ","
    "field"    ":" candidate_field_52   ","
    "weighted" ":" candidate_field_52   ","
    "result"   ":" canonical_view_52
  "}" ;

(* §52 Laws:
   (1) Expansion Law: Ana = ψ = 1→N.
       coalgebra ψ : (Graph,Query) → GraphF (Graph,Query)
       Expands current state into Vertex(node,[successor_states]).
       Empty neighborhood → Wildcard(freshId()) — never fails.

   (2) Reduction Law: Cata = φ = N→1.
       algebra φ : GraphF CanonicalView → CanonicalView
       Empty → CanonicalView.empty()
       Vertex(n,children) → rank(children)→merge→aggregate → single CanonicalView.

   (3) FoldGraph Law (typed):
       FoldGraph : Graph → Query → CanonicalView
       FoldGraph(graph,query) = cata_φ(attention(ana_ψ(graph,query)))
       Compressed: FoldGraph(Q,B) = Cata_φ(Attention(Ana_ψ(B,Q)))
       Three steps: Generate → Score → Reduce.

   (4) Wildcard Law: Unknown ≠ Failure.
       expand returns Wildcard(freshId()) rather than empty — coalgebra total.
       resolve: confidence > threshold → Known; else → Wildcard (SC-37 applies).
       Wildcard ∈ CandidateField is valid structure, not an error state.

   (5) Canonicalization Law: CanonicalView = Π(CandidateField).
       Π = resolve ∘ merge ∘ constrain ∘ rank
       Applied by algebra φ across ranked Vertex children.
       Result: selected=Set<Node>, relations=Set<Edge>, confidence=Float.
*)

(* ===================================================================
   §53 — FoldGraph Formal Specification Revision 2.0
   Corrections and extensions to §51-§52.
   Date: 2026-10-06
   =================================================================== *)

(* §53.1 — Topological Substrate *)
(* B = Q_n □ C_6 for Atomic-DOM deployment.
   Q_n = n-dimensional hypercube (binary addresses of length n).
   C_6 = six-phase cyclic manifold (Pop=0, Wo=1, Yax=2, Sek=3, Ch'en=4, Xul=5).
   Neighborhood: N_G(b,θ) = {(b⊕eᵢ,θ)} ∪ {(b,θ±1 mod 6)}
*)
topology     ::= "graph" | "hypercube" | "lattice" | "manifold" ;
atomic_dom_B ::= "Q_n" "□" "C_6" ;
hypercube_addr ::= { "0" | "1" } ;
c6_phase_idx   ::= "0" | "1" | "2" | "3" | "4" | "5" ;
atomic_node    ::= "(" hypercube_addr "," c6_phase_idx ")" ;
neighborhood_53 ::= "N_G" "(" atomic_node ")" "="
    "{" "(" atomic_node "⊕eᵢ" ")" "}" "∪" "{" "(" atomic_node "±1" ")" "}" ;

(* §53.2 — Score Function (formalized) *)
(* S_µ(u|Q) = W_u · C_u · R(Q,K_u)
   W_u = weight (structural importance of node u)
   C_u = confidence (accumulated evidence for node u)
   R(Q,K_u) = query relevance = retrieval_strength of u given query Q vs key K_u
   Usage → R as prior. R is WCR's R field, query-indexed.
*)
score_function_53 ::= "{" "kind" ":" "score_function_53" ","
    "node"       ":" identifier  ","
    "weight"     ":" number      ","
    "confidence" ":" number      ","
    "relevance"  ":" number      ","
    "query"      ":" identifier  ","
    "score"      ":" number      "}" ;
(* score = weight * confidence * relevance *)

(* §53.3 — Wildcard Types (expanded from §52 unknown_node|unknown_edge) *)
wildcard_type_53 ::= "unknown_node"     | "unknown_edge"
                   | "unknown_class"    | "unknown_relation"
                   | "unknown_strategy" ;
(* unknown_strategy: missing game plan, missing search strategy, missing fold path *)

(* Resolution (v2.0 rename: retained_unknown = alias for retained_wildcard; SC-37 canonical) *)
resolution_53 ::= "resolved" | "retained_unknown" ;
(* retained_unknown = retained_wildcard (SC-37 term unchanged). Both are valid. *)

(* §53.4 — Fixed Point Semantics *)
(* T_Q = Cata_φ ∘ Attention_WCR,Q ∘ Ana_ψQ
   B* = T_Q(B*) — stable knowledge state under query Q.
   Kleene: B* = ⊔{T_Q^n(⊥) | n≥0}
   FIXED-POINT-µ governs this stability.
*)
fixed_point_53 ::= "{" "kind" ":" "fixed_point_53" ","
    "operator"   ":" "T_Q"        ","
    "definition" ":" "Cata_φ∘Attention_WCR,Q∘Ana_ψQ"  ","
    "equation"   ":" "B*=T_Q(B*)" ","
    "kleene"     ":" "B*=⊔{T_Q^n(⊥)|n≥0}" ","
    "micronaut"  ":" "FIXED-POINT-µ" "}" ;

(* §53.5 — Problem Solver Runtime (v2.0 unified) *)
problem_solver_53 ::= "{" "kind" ":" "problem_solver_53" ","
    "observe"        ":" "(" topology_ref "," query_52 ")"           ","
    "anamorphism"    ":" "Ana_ψQ" "(" topology_ref "," query_52 ")" ","
    "attention"      ":" "Attention_WCR,Q" "(" candidate_field_52 ")" ","
    "catamorphism"   ":" "Cata_φ" "(" candidate_field_52 ")"         ","
    "solution"       ":" resolution_53 "}" ;
topology_ref ::= identifier ;

(* §53.6 — Automata Correspondence Correction (v2.0 §9)
   CRITICAL: The following were written as analogies in §51-§52.
   They are EXAMPLES, not structural equivalences.

   WRONG (as identities):  Ana ≡ NFA,  Cata ≡ DFA
   CORRECT (as subset):    NFA, DFA ⊂ FoldGraph Applications

   Ana = unfold = One→Many. NFA expansion is one example.
   Cata = fold = Many→One. DFA subset construction is one example (Ch'en proof).
   FoldGraph subsumes NFA, DFA, backtracking, and any recursion scheme
   that unfolds then folds over a topology.
*)
automata_correspondence_53 ::= "{" "kind" ":" "automata_correspondence_53" ","
    "nfa_role"  ":" "example_ana_application"  ","
    "dfa_role"  ":" "example_cata_application" ","
    "law"       ":" "NFA,DFA ⊂ FoldGraph Applications" "}" ;

(* §53.7 — FoldGraph v2.0 Complete Pipeline *)
fold_graph_v2 ::= "{" "kind" ":" "fold_graph_v2" ","
    "topology"       ":" atomic_dom_B                    ","
    "operator"       ":" "T_Q=Cata_φ∘Attention_WCR,Q∘Ana_ψQ" ","
    "score"          ":" score_function_53               ","
    "fixed_point"    ":" fixed_point_53                  ","
    "wildcard_types" ":" "[" { wildcard_type_53 } "]"    ","
    "resolution"     ":" resolution_53                   ","
    "automata"       ":" automata_correspondence_53       ","
    "problem_solver" ":" problem_solver_53                "}" ;

(* §53 Laws:
   (1) Automata Correspondence Law: NFA,DFA ⊂ FoldGraph Applications.
       Ana ≢ NFA. Cata ≢ DFA. They are examples, not definitions.
       § §51 Law 3 and §52 annotations that said "Ana behaves like NFA /
       Cata behaves like DFA construction" were analogies — v2.0 demotes
       these from equivalence claims to example-of relations.

   (2) Topological Locality Law: N_G(b,θ) ⊂ Q_n □ C_6.
       All Ana/Cata traversal is local within the Atomic-DOM geometry.
       No global traversal; each step moves one edge in Q_n or one phase in C_6.

   (3) Score Law: S_µ(u|Q) = W_u · C_u · R(Q,K_u).
       R is query-indexed retrieval_strength. Usage feeds R as prior.
       Applied during Attention step between Ana and Cata.

   (4) Fixed Point Law: B* = T_Q(B*).
       Stable under Kleene iteration. FIXED-POINT-µ governs.
       Convergence: d(T_Q^(n+1)(⊥), T_Q^n(⊥)) → 0.

   (5) Wildcard Completeness Law: wildcard_type_53 covers all unknown categories.
       unknown_strategy extends the set to include missing game plans.
       retained_unknown = retained_wildcard (SC-37 term canonical).
*)

(* ===================================================================
   §54 — FoldGraph Inference Rules and Formal Derivations
   Operational semantics: judgments Gamma |- X where Gamma=(B,Q,psi,phi,WCR).
   Date: 2026-10-06
   =================================================================== *)

(* §54.1 — Normative Operational Semantics
   Every FoldGraph evaluation SHALL satisfy:
     evaluation = topology, anamorphism, attention, catamorphism
   such that (B,Q)->F_Q->F*_Q->C_Q where:
     F_Q   = Ana_psiQ(B)
     F*_Q  = Attention_WCR,Q(F_Q)
     C_Q   = Cata_phi(F*_Q)
   FoldGraph(B,Q) = Cata_phi(Attention_WCR,Q(Ana_psiQ(B)))
*)
evaluation_54 ::= "{" "topology" ":" topology ","
    "anamorphism"  ":" candidate_field_52 ","
    "attention"    ":" candidate_field_52 ","
    "catamorphism" ":" canonical_view_52 "}" ;

(* §54.2 — Anamorphism Rules *)

(* ANA-EXPAND: Reachable nodes are valid expansions.
     u in N_G(v)
   ────────────────  ANA-EXPAND
    Gamma |- v => u
*)
ana_expand_rule ::= "{" "kind" ":" "ANA-EXPAND" ","
    "premise"    ":" "u in N_G(v)" ","
    "conclusion" ":" "Gamma |- v => u" "}" ;

(* ANA-WILDCARD: Empty neighborhood generates wildcard — prevents expansion failure.
     N_G(v) = empty
   ────────────────  ANA-WILDCARD
    Gamma |- v => *
*)
ana_wildcard_rule ::= "{" "kind" ":" "ANA-WILDCARD" ","
    "premise"    ":" "N_G(v)=empty" ","
    "conclusion" ":" "Gamma |- v => *" "}" ;

(* ANA-HYPOTHESIS: A query generates multiple candidate possibilities.
     match(Q,xi)
   ────────────────────────────  ANA-HYPOTHESIS
    Gamma |- Q => {x1,...,xn}
*)
ana_hypothesis_rule ::= "{" "kind" ":" "ANA-HYPOTHESIS" ","
    "premise"    ":" "match(Q,x_i)" ","
    "conclusion" ":" "Gamma |- Q => {x1,...,xn}" "}" ;

(* §54.3 — Attention Rules *)

(* ATT-SCORE: Score each candidate by WCR formula.
     W_u, C_u, R(Q,K_u)
   ────────────────────────  ATT-SCORE
    Gamma |- u : S_mu(u|Q)
   S_mu(u|Q) = W_u * C_u * R(Q,K_u)
*)
att_score_rule ::= "{" "kind" ":" "ATT-SCORE" ","
    "premise"    ":" "W_u, C_u, R(Q,K_u)" ","
    "conclusion" ":" "Gamma |- u : S_mu(u|Q)" "}" ;

(* ATT-RANK: Rank by score descending.
     S(u) > S(v)
   ────────────────────────  ATT-RANK
    Gamma |- rank(u) > rank(v)
*)
att_rank_rule ::= "{" "kind" ":" "ATT-RANK" ","
    "premise"    ":" "S(u)>S(v)" ","
    "conclusion" ":" "Gamma |- rank(u)>rank(v)" "}" ;

(* ATT-THRESHOLD: Discard low-relevance candidates below threshold tau.
     S(u) < tau
   ────────────────────────  ATT-THRESHOLD
    Gamma |- reject(u)
*)
att_threshold_rule ::= "{" "kind" ":" "ATT-THRESHOLD" ","
    "premise"    ":" "S(u)<tau" ","
    "conclusion" ":" "Gamma |- reject(u)" "}" ;

(* §54.4 — Catamorphism Rules *)

(* CATA-SELECT: Select the highest-ranked candidate.
     u = argmax S
   ────────────────────────  CATA-SELECT
    Gamma |- select(u)
*)
cata_select_rule ::= "{" "kind" ":" "CATA-SELECT" ","
    "premise"    ":" "u=argmax S" ","
    "conclusion" ":" "Gamma |- select(u)" "}" ;

(* CATA-MERGE: Selected nodes merge into combined canonical result.
     u,v in Selected
   ────────────────────────  CATA-MERGE
    Gamma |- merge(u,v)
*)
cata_merge_rule ::= "{" "kind" ":" "CATA-MERGE" ","
    "premise"    ":" "u,v in Selected" ","
    "conclusion" ":" "Gamma |- merge(u,v)" "}" ;

(* CATA-PROJECTION: Projection forms the canonical view C_Q.
     Selected
   ────────────────────────  CATA-PROJECTION
    Gamma |- C_Q
*)
cata_projection_rule ::= "{" "kind" ":" "CATA-PROJECTION" ","
    "premise"    ":" "Selected" ","
    "conclusion" ":" "Gamma |- C_Q" "}" ;

(* §54.5 — Wildcard Rules *)

(* WILD-RETAIN: Confidence below threshold -> retain uncertainty (SC-37).
     C(u) < tau
   ────────────────────────  WILD-RETAIN
    Gamma |- u => Wildcard
   Safety invariant: forall u (Wildcard(u) => Representable(u))
*)
wild_retain_rule ::= "{" "kind" ":" "WILD-RETAIN" ","
    "premise"    ":" "C(u)<tau" ","
    "conclusion" ":" "Gamma |- u => Wildcard" ","
    "invariant"  ":" "forall u (Wildcard(u)=>Representable(u))" "}" ;

(* WILD-RESOLVE: Confidence above threshold -> resolve to Known.
     C(u) >= tau
   ────────────────────────  WILD-RESOLVE
    Gamma |- u => Known
*)
wild_resolve_rule ::= "{" "kind" ":" "WILD-RESOLVE" ","
    "premise"    ":" "C(u)>=tau" ","
    "conclusion" ":" "Gamma |- u => Known" "}" ;

(* §54.6 — Fixed Point Rules *)

(* FP-CONVERGENCE: Stable state is a fixed point.
     T_Q(B) = B
   ────────────────────────  FP-CONVERGENCE
    Gamma |- FixedPoint(B)
*)
fp_convergence_rule ::= "{" "kind" ":" "FP-CONVERGENCE" ","
    "premise"    ":" "T_Q(B)=B" ","
    "conclusion" ":" "Gamma |- FixedPoint(B)" "}" ;

(* FP-ITERATE: Otherwise continue iteration.
     T_Q(B) != B
   ────────────────────────  FP-ITERATE
    Gamma |- B -> T_Q(B)
*)
fp_iterate_rule ::= "{" "kind" ":" "FP-ITERATE" ","
    "premise"    ":" "T_Q(B)!=B" ","
    "conclusion" ":" "Gamma |- B -> T_Q(B)" "}" ;

(* §54.7 — FOLDGRAPH Master Rule
   The complete derivation rule:
     Ana_psiQ(B)=F_Q   Attention_WCR,Q(F_Q)=F*_Q   Cata_phi(F*_Q)=C_Q
   ────────────────────────────────────────────────────────────────────  FOLDGRAPH
                        (B,Q) Downarrow C_Q

   Read: If Ana generates F_Q, Attention transforms to F*_Q, Cata reduces to C_Q,
         then (B,Q) evaluates to C_Q.
*)
foldgraph_master_rule ::= "{" "kind" ":" "FOLDGRAPH" ","
    "premise_1"  ":" "Ana_psiQ(B)=F_Q" ","
    "premise_2"  ":" "Attention_WCR,Q(F_Q)=F*_Q" ","
    "premise_3"  ":" "Cata_phi(F*_Q)=C_Q" ","
    "conclusion" ":" "(B,Q)=>C_Q" "}" ;

(* §54.8 — Example Derivations (7 canonical instances)

   Example 1: Regex expansion — H(ae?)ndel / H(a-umlaut)ndel
     Topology: B = regex graph
     Ana: F_Q = {Handel, Haendel, Haendel}
     Att: {Handel=0.92, Haendel=0.88, Haendel-with-umlaut=0.94}
     Cata: C_Q = Haendel-with-umlaut  (argmax=0.94)

   Example 2: Wildcard relation — Pitcher -?- AttackAngle
     Ana: F_Q = {counters, influences, creates, disrupts}
     Att: {counters=0.60, influences=0.75, creates=0.20, disrupts=0.91}
     Cata: C_Q = Pitcher -- disrupts -- AttackAngle

   Example 3: Riddle — has keys, has space, can enter
     Ana: F_Q = {Piano, Keyboard, House, Car}
     Att: {Piano=0.44, Keyboard=0.99, House=0.11, Car=0.08}
     Cata: C_Q = Keyboard

   Example 4: NPC decision — PlayerVisible, Health=95, Distance=5
     Ana: F_Q = {Patrol, Chase, Attack, Retreat}
     Att: {Patrol=0.05, Chase=0.72, Attack=0.95, Retreat=0.01}
     Cata: C_Q = Attack

   Example 5: Game Theory — RunnerOnFirst, Count=2-1
     Ana: F_Q = {Steal, Wait, HitAndRun, Bunt}
     Att: {Steal=0.82, Wait=0.35, HitAndRun=0.74, Bunt=0.18}
     Cata: C_Q = Steal

   Example 6: Hypercube runtime — B=Q_n square C_6, node (b,theta)
     Ana: N_G(b,theta)={(b XOR ei,theta)} union {(b,theta+-1)} -> F_Q={A,B,C,D,E}
     Att: {A=0.91, B=0.63, C=0.42, D=0.81, E=0.12}
     Cata: C_Q = {A,D}  (above threshold)

   Example 7: Wildcard preservation — Person -?- Event (all scores < tau=0.80)
     Ana: F_Q = {attended, organized, created, ?}
     Att: {attended=0.42, organized=0.39, created=0.31}  all < tau
     Cata: WILD-RETAIN fires -> C_Q = Person -?- Event  (retained_wildcard)
     SC-37: Unknown != Failure
*)

(* §54.9 — Derived Interpretation Law
   Every application domain (Regex, NPC, Game Theory, Baseball, Riddles,
   Wildcards, Compare/Contrast, Graph ML, Automata) MUST be interpretable as:
     Generate Possibilities -> Evaluate Possibilities -> Reduce Possibilities
   Formally: Ana -> Attention -> Cata
   This is the canonical execution model of FoldGraph.
*)
derived_interpretation_law ::= "{" "kind" ":" "derived_interpretation_law" ","
    "generate"   ":" "Ana" ","
    "evaluate"   ":" "Attention" ","
    "reduce"     ":" "Cata" ","
    "domains"    ":" "[" "Regex" "," "NPC" "," "GameTheory" "," "Baseball" ","
                        "Riddles" "," "Wildcards" "," "Compare" "," "Automata" "]" "}" ;

(* §54 Laws:
   (ANA)  Expansion always possible: ANA-WILDCARD guarantees Ana never fails.
   (ATT)  Evidence is ordered: ATT-RANK defines total order over candidates.
   (CATA) Projection is deterministic: CATA-SELECT picks argmax S.
   (WILD) Uncertainty is representable: forall u(Wildcard(u) => Representable(u)).
   (FP)   Knowledge converges: B* = T_Q(B*) under Kleene iteration.
   (FOLDGRAPH) Master rule: Ana(B)=F_Q and Att(F_Q)=F*_Q and Cata(F*_Q)=C_Q => (B,Q)=>C_Q.
*)

(* ===================================================================
   §55 — Graph Isomorphism as First-Class FoldGraph Operation
   Date: 2026-10-06
   =================================================================== *)

(* §55.1 — Structural Equivalence Grammar
   Two graphs are isomorphic if there exists a bijection f:V(G)->V(H)
   that preserves adjacency: (u,v) in E(G) <=> (f(u),f(v)) in E(H).
   Structure > Labels: node names are irrelevant, topology is canonical.
*)
node_mapping     ::= "{" "from" ":" node "," "to" ":" node "}" ;
vertex_bijection ::= "{" "kind" ":" "vertex_bijection" ","
                         "mappings" ":" "[" { node_mapping } "]" "}" ;
structural_equivalence ::= isomorphic_rec | non_isomorphic_rec ;
isomorphic_rec   ::= "{" "kind"      ":" "isomorphic" ","
                         "graph_a"   ":" graph_52 ","
                         "graph_b"   ":" graph_52 ","
                         "bijection" ":" vertex_bijection "}" ;
non_isomorphic_rec ::= "{" "kind"    ":" "non_isomorphic" ","
                           "graph_a" ":" graph_52 ","
                           "graph_b" ":" graph_52 "}" ;

(* §55.2 — Graph Canonization
   All isomorphic graphs share the same canonical form.
   Iso(G,H) <=> Canon(G)=Canon(H)
*)
canonical_form   ::= "{" "kind" ":" "canonical_form" ","
                         "graph" ":" graph_52 ","
                         "hash"  ":" string "}" ;
canonical_view_iso ::= "{" "selected"    ":" "[" { node } "]" ","
                           "relations"   ":" "[" { edge } "]" ","
                           "confidence"  ":" number ","
                           "canonical_form" ":" canonical_form "}" ;

(* §55.3 — Topology-Based Compare/Contrast *)
compare_topology ::= "{" "kind"            ":" "topology_compare" ","
                         "graph_a"         ":" graph_52 ","
                         "graph_b"         ":" graph_52 ","
                         "isomorphism"     ":" structural_equivalence ","
                         "shared_topology" ":" "[" { edge } "]" "}" ;
compare_upgraded ::= attribute_compare_52 | compare_topology ;
attribute_compare_52 ::= "{" "kind" ":" "attribute_compare" ","
                              "intersection" ":" "[" { node } "]" "}" ;

(* §55.4 — Extended FoldGraph Pipeline with Iso Step
   (B,Q) ->Ana F_Q ->Att F*_Q ->Iso F_Q_iso ->Cata C_Q
*)
fold_graph_iso ::= "{" "kind"         ":" "fold_graph_iso" ","
                       "graph"        ":" graph_52 ","
                       "query"        ":" query_52 ","
                       "field"        ":" candidate_field_52 ","
                       "weighted"     ":" candidate_field_52 ","
                       "iso_field"    ":" "[" { structural_equivalence } "]" ","
                       "result"       ":" canonical_view_iso "}" ;

(* §55 Inference Rules:
   ISO-MATCH: exists f:V(G)->V(H) preserving edges => Gamma |- G iso H
     If a structure-preserving bijection exists, graphs are isomorphic.

   ISO-WILDCARD: Wildcard(u) and StructureMatch(u,v) => Gamma |- u ~ v
     Unknown nodes may inherit candidate meanings from structurally equivalent nodes.

   CANON: G iso H => Canon(G) = Canon(H)
     Isomorphic graphs share canonical representation.
*)
iso_match_rule   ::= "{" "kind" ":" "ISO-MATCH" ","
    "premise"    ":" "exists f:V(G)->V(H) and PreservesEdges(f)" ","
    "conclusion" ":" "Gamma |- G iso H" "}" ;
iso_wildcard_rule ::= "{" "kind" ":" "ISO-WILDCARD" ","
    "premise"    ":" "Wildcard(u) and StructureMatch(u,v)" ","
    "conclusion" ":" "Gamma |- u ~ v" "}" ;
canon_rule       ::= "{" "kind" ":" "CANON" ","
    "premise"    ":" "G iso H" ","
    "conclusion" ":" "Canon(G)=Canon(H)" "}" ;

(* §55 Law: Iso(G,H) <=> Canon(G)=Canon(H)
   Structural equivalence is equivalent to canonical-form equality.
   FoldGraph now reasons over shape-preserving meaning, not labels.
*)

(* ===================================================================
   §56 — Pattern Matching Layer
   Governs how queries interact with candidate fields.
   Sits between Anamorphism (->F_Q) and Attention (->F*_Q).
   Date: 2026-10-06
   =================================================================== *)

(* §56.1 — Core Grammar *)
scrutinee ::= node | edge | graph_52 | candidate_field_52 | wildcard_type ;
pattern   ::= literal_pattern | compound_pattern | wildcard_pattern
            | predicate_pattern | view_pattern | alternative_pattern
            | guard_pattern ;
literal_pattern      ::= string ;
wildcard_pattern     ::= "_" ;
compound_pattern     ::= pattern "," relation_id "," pattern ;
alternative_pattern  ::= pattern "|" pattern ;
guard_pattern        ::= pattern "when" condition ;
predicate_pattern    ::= identifier "(" pattern ")" ;
view_pattern         ::= identifier "(" pattern ")" ;
relation_id          ::= identifier ;
condition            ::= identifier "(" identifier ")" ">" number ;
binding              ::= "{" "var" ":" identifier "," "value" ":" value_kind "}" ;
value_kind           ::= string | number | node | edge ;
match_record         ::= "{" "kind"         ":" "match" ","
                             "scrutinee"    ":" scrutinee ","
                             "pattern"      ":" pattern ","
                             "bindings"     ":" "[" { binding } "]" ","
                             "continuation" ":" continuation "}" ;
continuation ::= "action" | "substitution" | "fold" | "graph_transform" ;

(* §56.2 — Pattern Matching Step in Pipeline
   Extended pipeline:
   (B,Q) -> F_Q -> PatternMatch -> F'_Q -> Attention_WCR -> F*_Q -> Cata_phi -> C_Q
*)
pattern_match_step ::= "{" "kind"      ":" "pattern_match" ","
                           "field"     ":" candidate_field_52 ","
                           "pattern"   ":" pattern ","
                           "bindings"  ":" "[" { binding } "]" ","
                           "result"    ":" candidate_field_52 "}" ;
fold_graph_full ::= "{" "kind"         ":" "fold_graph_full" ","
                        "topology"     ":" topology ","
                        "query"        ":" query_52 ","
                        "anamorphism"  ":" candidate_field_52 ","
                        "pattern_match" ":" pattern_match_step ","
                        "attention"    ":" candidate_field_52 ","
                        "catamorphism" ":" canonical_view_52 "}" ;

(* §56 Inference Rules:
   MATCH-BIND:     S=v            => Gamma |- x => v            (variable binds value)
   MATCH-WILDCARD: (no premise)   => Gamma |- S match _          (wildcard matches anything)
   MATCH-LITERAL:  S=L            => Gamma |- S match L          (literal equality)
   MATCH-COMPOUND: S1 match P1, S2 match P2 => (S1,S2) match (P1,P2)  (deconstruct)
   MATCH-OR-L:     S match P1     => S match (P1|P2)             (alt left)
   MATCH-OR-R:     S match P2     => S match (P1|P2)             (alt right)
   MATCH-GUARD:    S match P, Guard(S)=true => S match (P when Guard)
   MATCH-PRED:     P(S)=true      => S match P                   (predicate)
   MATCH-VIEW:     f(S) match P   => S match View(f,P)           (transform before match)
   MATCH-CONT:     S match P, Bindings=B => Gamma[B] |- Continuation
*)
match_rule ::= "{" "kind" ":" match_rule_kind ","
                   "premise"    ":" string ","
                   "conclusion" ":" string "}" ;
match_rule_kind ::= "MATCH-BIND" | "MATCH-WILDCARD" | "MATCH-LITERAL"
                  | "MATCH-COMPOUND" | "MATCH-OR-L" | "MATCH-OR-R"
                  | "MATCH-GUARD" | "MATCH-PRED" | "MATCH-VIEW" | "MATCH-CONT" ;

(* §56 Law: Gamma |- Scrutinee match Pattern => Bindings => Continuation
   Every match extracts structure (bindings) and drives continuation.
   Aligns: Regex, FSM, NFA/DFA, Wildcard Learning, Graph Isomorphism, NPC BT, FoldGraph.
   Core semantic primitive: Match -> Bind -> Guard -> Continue -> Fold.
*)

(* ===================================================================
   §57 — BitField Extension
   Binary substrate for state, attention, matching, graph traversal.
   Dual representation: Symbolic Layer (nodes/edges) + Binary Layer (bits).
   Date: 2026-10-06
   =================================================================== *)

(* §57.1 — BitField Grammar *)
bit    ::= "0" | "1" ;
bitfield ::= { bit } ;
flag   ::= bit ;

node_flags ::= "{" "known"      ":" bit ","
                   "candidate"  ":" bit ","
                   "wildcard"   ":" bit ","
                   "selected"   ":" bit ","
                   "resolved"   ":" bit ","
                   "active"     ":" bit ","
                   "frontier"   ":" bit ","
                   "ranked"     ":" bit "}" ;
pattern_mask ::= bitfield ;

(* §57.2 — Node as Structure + BitField *)
node_with_bits ::= "{" "kind"   ":" node_kind ","
                       "id"     ":" identifier ","
                       "flags"  ":" node_flags "}" ;
(* Node = Structure + BitField. Match = StructureMatch OR BitMaskMatch.
   Wildcard bit = bit 2 = 1: WildcardBit=1 != Failure (maps to SC-37)
*)

(* §57.3 — BitField Pattern Matching
   Pattern mask: a bitfield where 1 = required bit.
   Match: (node AND mask) = mask <=> all required bits present.
*)
bit_match ::= "{" "kind" ":" "bit_match" ","
                  "node"    ":" bitfield ","
                  "mask"    ":" pattern_mask ","
                  "result"  ":" boolean "}" ;

(* §57.4 — Graph Traversal Visited Map *)
visited_map ::= bitfield ;
(* Visited(v) <=> Bit(v)=1. More compact than Set<NodeId> for dense graphs. *)

(* §57.5 — Execution Register *)
execution_flags ::= "{" "expanded"     ":" bit ","
                        "matched"      ":" bit ","
                        "guarded"      ":" bit ","
                        "ranked"       ":" bit ","
                        "folded"       ":" bit ","
                        "canonicalized" ":" bit ","
                        "fixed_point"  ":" bit "}" ;

(* §57.6 — Hypercube Bit Coordinate *)
(* Q_n node (b,theta): b is an n-bit binary address. b XOR e_i = flip bit i = one hypercube edge.
   Hypercube adjacency is literally bit-flip adjacency.
   Example: 1011 XOR bit2 -> 1001 (legal neighbor).
*)
hypercube_coord ::= "{" "address" ":" bitfield "," "phase" ":" c6_phase_idx "}" ;
hypercube_neighbor ::= "{" "kind"   ":" "hypercube_neighbor" ","
                           "from"   ":" hypercube_coord ","
                           "to"     ":" hypercube_coord ","
                           "op"     ":" "bit_flip" ","
                           "bit"    ":" number "}" ;

(* §57.7 — Attention with BitField Filter *)
bit_filtered_attention ::= "{" "kind"      ":" "bit_filtered_attention" ","
                                "mask"     ":" pattern_mask ","
                                "field"    ":" candidate_field_52 ","
                                "filtered" ":" candidate_field_52 "}" ;
(* Only nodes with matching bit flags participate in WCR scoring.
   Flags: Candidate+Frontier+Relevant+Visible = 00011001 example.
*)

(* §57.8 — Extended FoldGraph Runtime (with BitField) *)
(* (B,Q) -> Ana -> Candidate BitField F_Q
         -> Pattern Match / Mask
         -> Attention_WCR
         -> Weighted BitField F*_Q
         -> Cata_phi
         -> Canonical BitField C_Q
*)

(* §57 Inference Rules:
   BIT-SET:     (no premise) => Gamma |- SetBit(x,i)           (set bit i)
   BIT-CLEAR:   (no premise) => Gamma |- ClearBit(x,i)         (clear bit i)
   BIT-MATCH:   (x AND m)=m  => Gamma |- x match m             (mask match)
   BIT-WILDCARD: WildcardBit(x)=1 => Gamma |- Wildcard(x)      (bit encodes wildcard)
*)
bit_rule ::= "{" "kind" ":" bit_rule_kind ","
                 "premise"    ":" string ","
                 "conclusion" ":" string "}" ;
bit_rule_kind ::= "BIT-SET" | "BIT-CLEAR" | "BIT-MATCH" | "BIT-WILDCARD" ;

(* §57 Laws:
   (1) Node=Structure+BitField: every node has both a symbolic identity and a bit-flag register.
   (2) Match=StructureMatch OR BitMaskMatch: two equivalent execution surfaces.
   (3) WildcardBit=1 != Failure: maps SC-37 to the binary layer.
   (4) Hypercube adjacency = bit-flip adjacency: Q_n neighbor = XOR one bit.
   (5) Attention filter = bitfield mask: only flagged nodes enter WCR scoring.
*)

(* ===================================================================
   §58 — Two-Dimensional Pattern Matching
   Generalization: 1D Scrutinee/Pattern -> 2D Matrix/Submatrix match.
   Unified hierarchy: Literal -> Regex -> Tree -> Graph -> BitField -> 2D -> Topological.
   Date: 2026-10-06
   =================================================================== *)

(* §58.1 — 2D Grammar Extensions *)
matrix_cell    ::= literal | wildcard_char ;
wildcard_char  ::= "*" ;
matrix_row     ::= matrix_cell { matrix_cell } ;
pattern_matrix ::= matrix_row { matrix_row } ;
picture_matrix ::= matrix_row { matrix_row } ;

two_dimensional_pattern ::= "{" "kind" ":" "two_dimensional_pattern" ","
                                 "pattern" ":" pattern_matrix ","
                                 "picture" ":" picture_matrix "}" ;

(* §58.2 — Scrutinee Generalization (extends §56) *)
scrutinee_58 ::= node | edge | graph_52 | candidate_field_52
               | bitfield | pattern_matrix ;
(* scrutinee now includes matrix: any 2D surface is a valid scrutinee *)

(* §58.3 — Pattern Generalization (unified hierarchy) *)
pattern_58 ::= literal_pattern | wildcard_pattern | compound_pattern
             | alternative_pattern | predicate_pattern | view_pattern
             | graph_pattern_58 | matrix_pattern | bitfield_pattern ;
graph_pattern_58 ::= "{" "kind" ":" "graph_pattern" "," "nodes" ":" "[" { node } "]" "}" ;
matrix_pattern   ::= "{" "kind" ":" "matrix_pattern" "," "matrix" ":" pattern_matrix "}" ;
bitfield_pattern ::= "{" "kind" ":" "bitfield_pattern" "," "mask" ":" bitfield "}" ;

(* §58.4 — 2D Match Record *)
two_dimensional_match ::= "{" "kind"         ":" "two_dimensional_match" ","
                              "pattern"      ":" pattern_matrix ","
                              "scrutinee"    ":" picture_matrix ","
                              "row"          ":" number ","
                              "col"          ":" number ","
                              "bindings"     ":" "[" { binding } "]" ","
                              "continuation" ":" continuation "}" ;

(* §58.5 — Matrix Isomorphism (extends §55) *)
matrix_cell_mapping  ::= "{" "from_row" ":" number "," "from_col" ":" number ","
                              "to_row"   ":" number "," "to_col"   ":" number "}" ;
matrix_isomorphism   ::= "{" "kind"         ":" "matrix_isomorphism" ","
                              "pattern"     ":" pattern_matrix ","
                              "submatrix"   ":" picture_matrix ","
                              "mapping"     ":" "[" { matrix_cell_mapping } "]" "}" ;

(* §58.6 — Extended FoldGraph 2D Pipeline
   (B,Q) -> Ana (all windows) -> PatternMatch (2D) -> Attention (score) -> Cata (argmax(row,col))
*)
fold_graph_2d ::= "{" "kind"           ":" "fold_graph_2d" ","
                      "picture"        ":" picture_matrix ","
                      "pattern"        ":" pattern_matrix ","
                      "windows"        ":" "[" { two_dimensional_match } "]" ","
                      "attention"      ":" "[" { score_function_53 } "]" ","
                      "canonical_match" ":" two_dimensional_match "}" ;

(* §58.7 — Attention with Partial Matching Score
   score_window: wildcard cell = 0.5, matching cell = 1.0, mismatch = 0.0
   Enables approximate matching: returns ranked list rather than boolean.
*)
window_score ::= "{" "kind"      ":" "window_score" ","
                     "row"       ":" number ","
                     "col"       ":" number ","
                     "score"     ":" number "}" ;

(* §58.8 — Unified Pattern Hierarchy *)
pattern_hierarchy ::= "{" "kind" ":" "pattern_hierarchy" ","
    "levels" ":" "[" "literal_pattern" "," "regex_pattern" "," "tree_pattern" ","
                     "graph_pattern" "," "bitfield_pattern" "," "matrix_pattern" ","
                     "topological_pattern" "]" "}" ;
(* All levels are instances of the same calculus: Scrutinee -> Pattern -> Bindings -> Attention -> Fold *)

(* §58 Inference Rules:
   2D-MATCH: Submatrix(S) iso Pattern(P) => Gamma |- S match P
     If a submatrix is structurally equivalent to the pattern (via 2D ISO), match succeeds.

   2D-ANA: Generate all (row,col) candidate windows from text matrix.
   2D-ATT: score_window(row,col) = sum(cell_match * weight) / total_cells.
   2D-CATA: argmax(score) -> canonical match at (best_row, best_col).
*)
two_d_match_rule ::= "{" "kind"       ":" "2D-MATCH" ","
                         "premise"    ":" "Submatrix(S) iso Pattern(P)" ","
                         "conclusion" ":" "Gamma |- S match P" "}" ;

(* §58 Laws:
   (1) Unification Law: 1D string matching is 2D matching with height=1.
       regex match on string = matrix_pattern[1xN] on picture[1xM]. Same abstraction.
   (2) Wildcard Law (2D): wildcard cell (*) matches any cell, binds nothing.
       Extends §56 MATCH-WILDCARD to matrix cells.
   (3) Score Law (2D): score_window = (matching_cells + 0.5*wildcard_cells) / total_cells.
       Enables approximate matching with Attention. Pure boolean = WILD-RETAIN/RESOLVE threshold.
   (4) Isomorphism Law (2D): Matrix(P) iso Submatrix(S) iff exists bijection preserving cell adjacency.
       Extends ISO-MATCH to matrix topology.
   (5) Hypercube Law: Q_n neighbor = bit-flip = local 2D window shift in the hypercube coordinate.
       Hypercube traversal IS 2D pattern search over binary matrices.
*)

(* ===================================================================
   §59 — Vectorized/SIMD Pattern Extension
   BitField 2D accelerated: ((window ^ pattern) & mask) == 0
   Generalizes over scalar -> AVX2 -> AVX-512 -> N*SIMD -> GPU.
   Date: 2026-10-06
   =================================================================== *)

(* §59.1 — BitField 2D Pattern Grammar *)
bit_row_64   ::= bitfield ;                          (* one uint64_t row = 64 cells *)
pattern_2d_bitfield ::= "{" "kind"         ":" "pattern_2d_bitfield" ","
                             "rows"        ":" number ","
                             "width"       ":" number ","
                             "bits"        ":" "[" { bit_row_64 } "]" ","
                             "mask"        ":" "[" { bit_row_64 } "]" "}" ;
(* mask bit=1 -> required; mask bit=0 -> wildcard (ignore).
   Wildcard cell encodes SC-37 at the bit level: mask=0 != Failure.            *)

(* §59.2 — SIMD Execution Surface Hierarchy *)
simd_width ::= "scalar_64" | "simd_128_sse" | "simd_256_avx2"
             | "simd_512_avx512" | "simd_n_blocks" | "gpu_warp" | "webgpu_bitplane" ;

simd_match_record ::= "{" "kind"    ":" "simd_match" ","
                          "width"   ":" simd_width ","
                          "window"  ":" bitfield ","
                          "pattern" ":" bitfield ","
                          "mask"    ":" bitfield ","
                          "result"  ":" boolean "}" ;
(* Core operation: ((window XOR pattern) AND mask) == 0 *)

(* §59.3 — SIMD Attention Layer *)
simd_wcr_score ::= "{" "kind"       ":" "simd_wcr_score" ","
                       "width"      ":" simd_width ","
                       "weights"    ":" "[" { number } "]" ","
                       "confidences" ":" "[" { number } "]" ","
                       "relevances" ":" "[" { number } "]" ","
                       "scores"     ":" "[" { number } "]" "}" ;
(* Vectorized: score[i] = W[i] * C[i] * R[i] over SIMD width simultaneously. *)

(* §59.4 — SIMD ArgMax Catamorphism *)
simd_argmax ::= "{" "kind"      ":" "simd_argmax" ","
                    "scores"    ":" "[" { number } "]" ","
                    "best_idx"  ":" number ","
                    "best_score" ":" number "}" ;
(* CATA-SELECT: best = argmax(scores). Reduces N scores to one canonical match. *)

(* §59.5 — Sliding Window (lane-crossing)
   For bit_offset not on SIMD boundary: load two adjacent registers, merge.
   extract_window256(ptr, byte_offset) = _mm256_alignr_epi8(b, a, byte_offset).
   Bit-level: combine left-shift of lo and right-shift of hi.
   Generalizes to arbitrary width in units of machine words.
*)
sliding_window ::= "{" "kind"        ":" "sliding_window" ","
                       "bit_offset"  ":" number ","
                       "byte_shift"  ":" number ","
                       "intra_shift" ":" number ","
                       "result"      ":" bitfield "}" ;

(* §59.6 — Runtime Dispatch *)
runtime_dispatch ::= "{" "kind"    ":" "runtime_dispatch" ","
                         "avx2"    ":" "match_avx2" ","
                         "scalar"  ":" "match_scalar" ","
                         "init"    ":" "cpu_has_avx2() ? match_avx2 : match_scalar" "}" ;
(* Dispatch once at startup. Hot path: function pointer g_match(text, offset). *)

(* §59.7 — SIMD FoldGraph Pipeline *)
fold_graph_simd ::= "{" "kind"         ":" "fold_graph_simd" ","
                        "simd_width"   ":" simd_width ","
                        "candidate_matrix" ":" pattern_2d_bitfield ","
                        "match_kernel"  ":" simd_match_record ","
                        "attention"    ":" simd_wcr_score ","
                        "catamorphism" ":" simd_argmax "}" ;
(* FoldGraph(B,Q) = ArgMax(ScoreSIMD(MatchSIMD(Ana(B,Q)))) *)

(* §59 Inference Rules (SIMD):
   SIMD-MATCH: TestZero((W XOR P) AND M) => Gamma |- W match P  [SIMD generalization of BIT-MATCH]
   SIMD-ATT:   score[i] = W[i]*C[i]*R[i] (vectorized ATT-SCORE over SIMD width)
   SIMD-CATA:  best = argmax(scores)      (CATA-SELECT over SIMD register)
*)
simd_match_rule ::= "{" "kind" ":" "SIMD-MATCH" ","
    "premise"    ":" "TestZero((W XOR P) AND M)" ","
    "conclusion" ":" "Gamma |- W match P" "}" ;

(* §59 Laws:
   (1) Equivalence Law: ((w^p)&m)==0  <=>  SIMDMatch(W,P,M)==TestZero((W XOR P) AND M).
       Same semantic across scalar, AVX2, AVX-512, GPU.
   (2) Width Law: scalar=64, AVX2=256, AVX-512=512, N*SIMD=N*512. Semantics unchanged.
   (3) Sliding Window Law: any bit_offset representable via byte_shift + intra_shift.
       Lane-crossing windows are computable without semantic change.
   (4) Wildcard Law (SIMD): mask bit=0 => that position is wildcard; matches anything.
       mask=0 for all bits => match all strings (universal wildcard).
   (5) Hypercube Law (SIMD): neighbor = state XOR (1ULL << bit).
       SIMD neighbor generation: _mm512_xor_si512(state_vec, dim_mask) generates many neighbors.
   (6) Dispatch Law: scalar fallback always available; SIMD is an optimization, not a semantic change.
*)


(* ===================================================================
   §60 — SNOBOL Ancestry: Pattern as First-Class Value
   Lineage: regex -> SNOBOL -> BNF/EBNF -> FoldGraph
   Date: 2026-10-06
   =================================================================== *)

(* §60.1 — Ancestry Chain
   Level 0 (Regex):    P(x) -> {match, no-match}. Pattern = syntax object.
   Level 1 (SNOBOL):   P = runtime value. Compose, store, pass, execute.
   Level 2 (BNF/EBNF): P = recursive grammar rule. Productions as values.
   Level 3 (FoldGraph): P(Q,B) -> Ana -> F_Q -> WCR -> Cata -> C_Q.
                         Pattern determines what portion of B gets unfolded.
*)
pattern_ancestry_level ::= "regex_predicate"     (* P(x) -> {match,fail} *)
                          | "snobol_value"        (* P = composable runtime object *)
                          | "bnf_production"      (* P = recursive grammar rule *)
                          | "foldgraph_constraint" ;  (* P constrains Ana expansion *)

(* §60.2 — SNOBOL Pattern Model
   Core: patterns are first-class values assignable to variables and composable.
   Concatenation: P = Q R  (both Q and R must match in sequence)
   Alternation:   P = Q | R  (first match wins — GREEDY left-to-right scan)
   Assignment:    P . VAR   (bind matched span to VAR; cursor advances)
               || P $ VAR   (bind and replace)
   ARB:           arbitrary match — equivalent to §41 wildcard_entity
   LEN(n):        match exactly n characters — equivalent to §57 BIT-MATCH with mask
   BAL:           match balanced brackets — context-free; beyond regular expressions
   Evaluation:    subject  P . binding  -> success (cursor advances) | fail (branch)
*)
snobol_operation ::= "concat" | "alt" | "assign_immediate" | "assign_deferred"
                   | "arb" | "len_n" | "bal" | "any_char" | "notany_char" ;

snobol_pattern_value ::= "{" "kind"      ":" "snobol_pattern_value" ","
                             "operation" ":" snobol_operation ","
                             "left"      ":" ( pattern_58 | snobol_pattern_value ) ","
                             "right"     ":" ( pattern_58 | snobol_pattern_value ) ","
                             "binding"   ":" identifier "}" ;

snobol_eval_record ::= "{" "kind"    ":" "snobol_eval" ","
                           "subject" ":" string ","
                           "pattern" ":" snobol_pattern_value ","
                           "cursor"  ":" number ","
                           "result"  ":" ( "match" | "fail" ) ","
                           "bindings" ":" "[" { binding } "]" "}" ;

(* §60.3 — The WCR Departure
   SNOBOL: first-match wins (committed, greedy). No ranking across alternatives.
   P = Q | R => try Q first; if Q matches, done; R never tried.

   FoldGraph: Ana generates ALL candidates from P(Q,B). WCR scores each.
   Cata selects argmax. First match is never assumed canonical.

   Relation: SNOBOL(P) ≅ FoldGraph(P, τ=1, argmax-of-first-candidate).
   SNOBOL is FoldGraph with Attention collapsed to a threshold-1 filter.
*)
snobol_vs_foldgraph ::= "{" "kind"    ":" "snobol_vs_foldgraph" ","
    "snobol_strategy" ":" "first_match_greedy" ","
    "foldgraph_strategy" ":" "best_match_wcr" ","
    "equivalence" ":" "SNOBOL ≅ FoldGraph with tau=1 and argmax-of-first" "}" ;

(* §60.4 — Pattern as Graph-Generating Constraint (FoldGraph departure)
   In SNOBOL: pattern operates ON a fixed subject string. String is given.
   In FoldGraph: pattern (= query Q) determines WHICH PART of B gets unfolded.
                 The "string" (F_Q) is generated BY the pattern's application to B.

   Key consequence: FoldGraph pattern can expand to previously unvisited regions
   of the knowledge graph depending on the query. A new query = new unfolding.
   This is beyond what any string-matching pattern language can express.
*)
fold_graph_pattern_constraint ::= "{" "kind"    ":" "pattern_constraint" ","
    "query"    ":" string ","
    "base"     ":" topology_ref ","
    "expanded" ":" candidate_field_52 ","
    "law"      ":" "P(Q,B) determines which subgraph of B enters Ana" "}" ;

(* §60.5 — AIML Unification Under Pattern Ancestry
   AIML <pattern> = SNOBOL-style recognizer (first-match, left-to-right, wildcard)
   AIML <template> = stored structural transform applied post-Cata
   AIML <wildcard> (* # ^ _) = SC-37 retained unknown = SNOBOL ARB
   FoldGraph extends AIML by replacing first-match with WCR scoring.
*)
aiml_pattern_ancestry ::= "{" "kind"     ":" "aiml_pattern_ancestry" ","
    "pattern"  ":" string ","            (* AIML pattern text; SNOBOL-style recognizer *)
    "wildcard" ":" wildcard_type_53 ","  (* SC-37 retained unknown *)
    "template" ":" string ","            (* AIML template text; post-Cata transform *)
    "wcr_ext"  ":" fold_graph_v2 "}" ;  (* FoldGraph replaces first-match *)

(* §60.6 — Formal Map: SNOBOL Concepts -> FoldGraph Roles *)
snobol_foldgraph_map ::= "{" "kind"        ":" "snobol_foldgraph_map" ","
    "snobol_pattern_value" ":" "constrains Ana expansion (governs what unfolds)" ","
    "snobol_arb"           ":" "SC-37 wildcard (unresolved, retained)" ","
    "snobol_assign"        ":" "binding (bound variable in §56 MATCH-BIND)" ","
    "snobol_concat"        ":" "sequence in FoldGraph path constraint" ","
    "snobol_alt"           ":" "Sek candidates (Ana expands all, WCR ranks)" ","
    "snobol_bal"           ":" "context-free: requires recursive Ana (BNF level)" ","
    "snobol_first_match"   ":" "Cata with tau=1 threshold (SNOBOL subset)" ","
    "snobol_execute_str"   ":" "XJSON/K'UHUL: symbol->structure->operation" "}" ;

(* §60.7 — Possibility Language Principle
   Classic regex: P describes a SET of strings (language).
   SNOBOL: P describes an EXECUTABLE object (runtime process).
   BNF/EBNF: P describes a POSSIBILITY SPACE (recursive grammar).
   FoldGraph: P describes a CONSTRAINT on graph-generating structure.

   Unified: pattern = executable description of possible structure.
   At every level, the same abstraction: Scrutinee -> Pattern -> Bindings -> Fold.
*)
possibility_language ::= "{" "kind"   ":" "possibility_language" ","
    "level"  ":" pattern_ancestry_level ","
    "domain" ":" ( "string_set" | "runtime_process" | "grammar_space" | "graph_constraint" ) ","
    "law"    ":" "a pattern is an executable description of possible structure" "}" ;

(* §60 Laws:
   (1) Ancestry Law: regex ⊂ SNOBOL ⊂ BNF ⊂ FoldGraph (each extends the prior).
       FoldGraph subsumes all predecessors as special cases.
   (2) Composability Law: SNOBOL established pattern-as-value.
       Consequence: patterns can be arguments to Ana (FoldGraph generalizes this).
   (3) WCR Law: SNOBOL=first-match=greedy. FoldGraph=best-match=WCR-scored.
       SNOBOL ≅ FoldGraph(tau=1, argmax-of-first).
   (4) Constraint Law: FoldGraph pattern constrains Ana expansion.
       The pattern determines what part of B is unfolded — not merely what is recognized.
   (5) Possibility Law: pattern = executable description of possible structure.
       At every level (regex,SNOBOL,BNF,FoldGraph): Scrutinee->Pattern->Bindings->Fold.
   (6) AIML Bridge Law: <pattern>/<template>/<wildcard> = SNOBOL+SC-37+WCR.
       AIML is FoldGraph with first-match (no WCR). Adding WCR = full FoldGraph.
   (7) Execute-as-Data Law: SNOBOL "strings as programs" = K'UHUL symbol->structure->operation.
       Both languages challenge the program/data boundary from different directions.
*)

(* ===================================================================
   §61 — Micronaut Program System
   Formal law: MicronautRuntime(B,Q) = Cata_φ(WCR(Match(Ana_ψQ(B))))
   A micronaut is a pattern-bound continuation with memory, WCR state,
   and callable edges. The micronaut program is the global FoldGraph
   orchestration grammar that discovers, ranks, composes, and evolves
   those continuations across the entire topology.
   Date: 2026-10-07
   =================================================================== *)

(* §61.1 — Edge Types (strict boundary: semantic ≠ callable)
   semantic_edge = relates_to (inference, lookup, weighting only).
   callable_edge  = invokes   (may execute, requires Xul promotion).
   A learned semantic relation does NOT automatically become callable.
   Promotion requires route contract or Xul-authorized gate (§XulGate).
*)
semantic_edge_61 ::= "{" "kind" ":" "semantic_edge" "," "from" ":" identifier ","
                         "to" ":" identifier "," "relation" ":" "relates_to" "}" ;
callable_edge_61 ::= "{" "kind" ":" "callable_edge" "," "from" ":" identifier ","
                         "to"   ":" micronaut_key_61 "," "relation" ":" "invokes" ","
                         "promoted" ":" boolean "}" ;
edge_61 ::= semantic_edge_61 | callable_edge_61 ;

(* §61.2 — Micronaut Key *)
micronaut_key_61 ::= "µ://" identifier ;

(* §61.3 — Micronaut (Pattern-Bound Continuation)
   Each micronaut = key + patterns + guards + continuations + edges + WCR state.
   Pattern layer: scrutinee matches -> bindings -> guard -> continuation fires.
   Analogy: SNOBOL pattern-value + AIML template + FoldGraph WCR state.
*)
micronaut_guard_61  ::= "{" "kind" ":" "guard" "," "expr" ":" "confidence > tau"
                             "," "tau" ":" number "}" ;
micronaut_wcr_61    ::= "{" "weight" ":" number "," "confidence" ":" number ","
                             "relevance" ":" number "}" ;
micronaut_61 ::= "{" "key"             ":" micronaut_key_61 ","
                     "patterns"        ":" "[" { pattern_58 } "]" ","
                     "guards"          ":" "[" { micronaut_guard_61 } "]" ","
                     "continuations"   ":" "[" { identifier } "]" ","
                     "callable_edges"  ":" "[" { micronaut_key_61 } "]" ","
                     "semantic_edges"  ":" "[" { identifier } "]" ","
                     "wcr"             ":" micronaut_wcr_61 "}" ;

(* §61.4 — Micronaut Program (Global Orchestration Grammar)
   The program is NOT each micronaut — it is the grammar that governs all of them.
   Separates: topology, runtime (FoldGraph), registry, learning policy, routing policy.
*)
program_topology_61  ::= "{" "type" ":" "hypercube" "," "space" ":" "QnxC6" "}" ;
program_runtime_61   ::= "{" "foldgraph" ":" "{" "anamorphism" ":" identifier ","
                                                  "attention"   ":" "WCR" ","
                                                  "catamorphism" ":" identifier "}" "}" ;
program_registry_61  ::= "{" "micronauts" ":" "[" { micronaut_key_61 } "]" "}" ;
program_learning_61  ::= "{" "promotion_threshold"  ":" number ","
                             "wildcard_retention"   ":" boolean ","
                             "fixed_point_iters"    ":" number "}" ;
program_routing_61   ::= "{" "semantic_edges"   ":" boolean ","
                             "callable_edges"   ":" boolean ","
                             "require_promotion" ":" boolean "}" ;
micronaut_program_61 ::= "{" "version"   ":" string ","
                             "topology"  ":" program_topology_61 ","
                             "runtime"   ":" program_runtime_61 ","
                             "registry"  ":" program_registry_61 ","
                             "learning"  ":" program_learning_61 ","
                             "routing"   ":" program_routing_61 "}" ;

(* §61.5 — Execution Pipeline
   MicronautRuntime(B,Q) = Cata_φ(WCR(Match(Ana_ψQ(B))))
   Six steps: query -> ana -> match -> attention/WCR -> cata -> continuation.
*)
micronaut_scrutinee_61 ::= "{" "query"    ":" string ","
                               "topology" ":" topology_substrate ","
                               "registry" ":" program_registry_61 ","
                               "memory"   ":" identifier "}" ;

micronaut_candidate_field_61 ::= "[" { micronaut_key_61 } "]" ;

micronaut_pattern_match_61 ::= "{" "scrutinee" ":" micronaut_scrutinee_61 ","
                                   "matched"   ":" "[" { micronaut_61 } "]" ","
                                   "bindings"  ":" "[" { binding } "]" "}" ;

micronaut_scored_field_61 ::= "{" "key"   ":" micronaut_key_61 ","
                                  "score" ":" number "}" ;

micronaut_execution_61 ::= "{" "kind"            ":" "micronaut_execution" ","
                               "query"           ":" string ","
                               "ana"             ":" micronaut_candidate_field_61 ","
                               "pattern_match"   ":" micronaut_pattern_match_61 ","
                               "attention"       ":" "[" { micronaut_scored_field_61 } "]" ","
                               "selected"        ":" "[" { micronaut_key_61 } "]" ","
                               "continuations"   ":" "[" { identifier } "]" ","
                               "result"          ":" identifier "}" ;

(* §61.6 — Domain Field + Promotion
   Emergent domain law: evidence -> patterns -> templates -> routes -> micronaut.
   A domain accumulates successful folds until promotion fires.
   Semantic relations become callable only after Xul-authorized promotion.
*)
domain_field_61 ::= "{" "kind"      ":" "domain_field" ","
                        "name"      ":" identifier ","
                        "patterns"  ":" "[" { pattern_58 } "]" ","
                        "templates" ":" "[" { identifier } "]" ","
                        "routes"    ":" "[" { micronaut_key_61 } "]" ","
                        "histories" ":" "[" { identifier } "]" ","
                        "weights"   ":" "[" { number } "]" "}" ;

promotion_score_61 ::= "{" "pattern_density" ":" number ","
                           "route_density"   ":" number ","
                           "confidence"      ":" number ","
                           "usage"           ":" number "}" ;

micronaut_promotion_61 ::= "{" "kind"      ":" "micronaut_promotion" ","
                               "domain"    ":" domain_field_61 ","
                               "score"     ":" promotion_score_61 ","
                               "threshold" ":" number ","
                               "result"    ":" ( "promote_to_micronaut" | "retain_domain" ) "}" ;

(* §61 Laws:
   (1) Formal Law: MicronautRuntime(B,Q) = Cata_φ(WCR(Match(Ana_ψQ(B)))).
       Ana = expose candidate micronauts. Match = bind query to patterns.
       WCR = rank candidates. Cata = select execution set. Continuation = invoke.
   (2) Edge Separation Law: semantic_edge ≠ callable_edge.
       A learned relation does not automatically become a callable tool edge.
       Promotion requires Xul-authorized gate. (SC-37 applies: unknown edge ≠ callable edge.)
   (3) Micronaut Identity Law: Micronaut = Pattern-Bound Continuation + Memory + WCR.
       Not primarily an agent. Pattern fires → continuation executes → result learned.
   (4) Program Identity Law: MicronautProgram = Global FoldGraph Hylomorphism.
       Program governs all micronauts; each micronaut retains individuality.
   (5) Emergent Domain Law: evidence → patterns → templates → routes → micronaut.
       Domain promotion fires when promotion_score > threshold (default 0.85).
   (6) Bitfield Domain Law: domain membership encodable as bitfield.
       query_mask & micronaut_mask = candidate activation. Then WCR ranks.
   (7) Learning Law: successful fold → update patterns/templates/weights.
       Repeated successful folds → domain field → potential micronaut promotion.
   (8) SNOBOL Bridge Law (from §60): Micronaut pattern = SNOBOL pattern-value.
       But FoldGraph adds WCR ranking. Micronaut continuation = AIML template.
       Full chain: SNOBOL pattern → AIML → FoldGraph micronaut.
*)

(* §61 Production Mapping (src/ -> §61 formal law)
   MicronautEntry            = micronaut_61 (id/confidence/static_weight/route_contract/relations/folds)
   RouteContract             = callable_edges (schemes/verbs/aiml_patterns/aiml_templates/tokens)
   RelationEntry.directed=T  = callable_edge_61 (requires XCFE gate)
   RelationEntry.directed=F  = semantic_edge_61 (horizontal fold, no gate)
   MicronautRegistry         = micronaut_program_61.registry + GravityField (WCR attention)
   MicronautRegistry.dispatch_blend(phase,tokens,top_k=4)  = §61 WCR attention (LBS weights)
   MicronautRegistry.relational_dispatch(id,verb)          = semantic edge traversal
   MouRouter                 = full Ana+Attention+Cata pipeline (two-tier):
     Tier 1: MoERouter dot(W_µ,F_Q)+C_µ bias->softmax->top-k  = Ana+WCR
     Tier 2: phase gate->renormalize->top_k                     = Cata
   MouRouter.route(phase,tokens,top_k) = MicronautRuntime(B,Q)=Cata_φ(WCR(Match(Ana_ψQ(B))))
   MouRouter.query_vec(tokens)         = §61 Ana step: derives 3D F_Q from tokens
   MouRouter.routing_variance()        = entropy proxy:
     high -> one µ dominates (Jyggalag: crystallized Xul commit = FIXED-POINT-µ)
     low  -> flat distribution (Sheogorath: delegate to ELIZA = perpetual Ana expansion)
   VectorMuMicronaut                   = micronaut_61 as projection operator:
     static_weight_=WCR W, confidence_=WCR C, capability_verb_=edge type,
     ExecuteProjection()=continuation execution
   decision_mu.ActionSelectionPolicy:
     AllowedUnderUnknown  = SC-37 retained_wildcard (select under uncertainty)
     BlockedOnUnknown     = blocked (opposite of SC-37)
     RequiresConfirmation = WILD-RETAIN with flag (confidence < tau, but representable)
   MicronautEntry.no_eval=true = declarative constraint: tracks are patterns/caps, not eval scripts
   MicronautEntry.governs      = domain field vocabulary (§61 domain_field_61.patterns)
*)

(* ============================================================
   §62  FOLD UNIVERSALITY AND THE ERGONOMIC GAP
   Every computation is a fold. Modern abstractions are folds
   with scaffolding that bridges the semantic-to-usable gap.
   ============================================================ *)

(* ── substrate ─────────────────────────────────────────────── *)

fold_substrate_62 ::= "{" "kind"      ":" "fold_substrate" ","
                          "carrier"   ":" type_expr ","
                          "algebra"   ":" ( "phi" | "cata" ) ","
                          "seed"      ":" value ","
                          "result"    ":" value "}" ;

(* Every computation expressible as fold_substrate_62.
   Semantic universality: reduce, map, flatMap, typecheck, parse — all folds.
   Pragmatic gap: universality does not imply usability. *)

(* ── ergonomic gap ─────────────────────────────────────────── *)

gap_kind_62 ::= "effect_boundary"     (* fold(B, f) ≠ fold_effect(B, f: A→M B) *)
              | "composition_opacity"  (* fold-of-fold unreadable past depth 2 *)
              | "ranking_absence"      (* plain fold: all N valid reductions equal *)
              | "cognitive_load" ;     (* point-free exceeds human short-term memory *)

ergonomic_gap_62 ::= "{" "kind"    ":" "ergonomic_gap" ","
                         "sources" ":" "[" gap_kind_62 { "," gap_kind_62 } "]" ","
                         "claim"   ":" string "}" ;

(* ── scaffold layers ───────────────────────────────────────── *)

scaffold_layer_kind_62 ::= "ranker"    (* answers: of N valid folds, which one? *)
                          | "effect"   (* answers: how do folds compose across IO/async/error? *)
                          | "syntax"   (* answers: how do humans read nested folds? *)
                          | "type" ;   (* answers: which folds compose without breaking? *)

fold_scaffold_layer_62 ::= "{" "kind"       ":" scaffold_layer_kind_62 ","
                               "gap_solved" ":" gap_kind_62 ","
                               "example"    ":" string ","
                               "fold_form"  ":" string "}" ;

fold_scaffold_62 ::= "{" "kind"   ":" "fold_scaffold" ","
                         "layers" ":" "[" fold_scaffold_layer_62
                                          { "," fold_scaffold_layer_62 } "]" "}" ;

(* ── concrete modern abstractions as fold + scaffold ───────── *)

modern_abstraction_62 ::= "{" "name"       ":" identifier ","
                              "layer"      ":" scaffold_layer_kind_62 ","
                              "fold_basis" ":" string ","
                              "added"      ":" string "}" ;

(* async/await   = ContinuationMonad(foldr(callStack))
                   layer=effect+syntax; fold_basis=foldr; added=deferred_execution+OS_scheduling
   Promise.then  = fmap+bind over Future functor
                   layer=effect; fold_basis=fmap; added=async_monad_composition
   TypeScript     = Cata_φ(typeGrammar); layer=type; fold_basis=Cata; added=explicit_check
   Array.map      = fold with const accumulator = pure fold (no scaffold needed)
   for await      = do-notation for IO+async monad; layer=syntax; fold_basis=foldr
   Haskell lazy   = ana (corecursion) + guarded productivity; layer=effect *)

(* ── WCR as the ranking scaffold ───────────────────────────── *)

fold_ranker_62 ::= "{" "kind"        ":" "fold_ranker" ","
                       "problem"     ":" "plain_fold_gives_no_ordering" ","
                       "solution"    ":" "wcr_score" ","
                       "formula"     ":" "S_mu(u|Q) = W * C * R(Q,K_u)" ","
                       "selects"     ":" "argmax_over_candidate_field" "}" ;

(* ── SNOBOL temporal gap law ────────────────────────────────── *)

snobol_gap_62 ::= "{" "kind"       ":" "temporal_gap" ","
                      "era_a"      ":" "1962_SNOBOL" ","
                      "era_b"      ":" "FoldGraph" ","
                      "era_a_fold" ":" "pattern_value + first_match_greedy" ","
                      "era_b_fold" ":" "pattern_value + WCR_ranked_match" ","
                      "gap_filled" ":" "ranker_layer" ","
                      "equivalence" ":" "SNOBOL ≅ FoldGraph(tau=1, argmax_of_first)" "}" ;

(* ── KHANARY full scaffold ──────────────────────────────────── *)

khanary_fold_scaffold_62 ::= "{" "kind"       ":" "khanary_fold_scaffold" ","
                                 "fold_law"   ":" "FoldGraph_Q = Cata_phi ∘ Attention_WCR ∘ Ana_psiQ" ","
                                 "ranker"     ":" "WCR — answers: of N candidates, which fold to take?" ","
                                 "effects"    ":" "C6_phase_wheel — sequences folds with side effects" ","
                                 "naming"     ":" "Micronaut — addresses and composes named folds" ","
                                 "type_sys"   ":" "EBNF_grammar — constrains which folds compose" ","
                                 "gap_solved" ":" "[" "ranking_absence" "," "effect_boundary" ","
                                                      "composition_opacity" "," "cognitive_load" "]" "}" ;

(* §62 Laws:
   (1) Universality Law: Every computation is a fold. Fold is the semantic substrate.
       reduce/map/typecheck/parse/Ana/Cata — all fold_substrate_62.
       Fold is universal the way Turing machines are universal: correct but not ergonomic.
   (2) Ergonomic Gap Law: Universality ≠ usability.
       Gap sources: effect_boundary + composition_opacity + ranking_absence + cognitive_load.
       Modern programming fills the gap — it does not replace folds.
   (3) Effect Boundary Law: fold(B, f:A→B) ≠ fold_effect(B, f:A→M(B)).
       Effects require monad transformer scaffold.
       async/await = ContinuationMonad(foldr(callStack)). New part: ergonomic+runtime layer. Old part: foldr.
   (4) Scaffold Law (four layers):
       (a) Ranker: WCR answers "of N valid reductions, which one?" Plain fold cannot.
       (b) Effect: Monad/transformer answers "how do folds compose across IO/async/error?"
       (c) Syntax: async/await = do-notation = "how do humans read nested folds?"
       (d) Type: Grammar/checker answers "which folds compose without type error?"
   (5) Async-Fold Law: async/await = ContinuationMonad(foldr(callStack)).
       Not new semantics — new ergonomic+OS layer that makes the fold operable at human scale.
   (6) TypeSystem-Fold Law: TypeChecker = Cata_φ(typeGrammar).
       TypeScript = explicit Cata over JS's implicit types. New: checkability. Old: fold.
   (7) Ranker Gap Law: SNOBOL(1962) = fold + first-match. FoldGraph = fold + WCR-ranked.
       60-year gap = adding the ranker layer (scaffold_layer_kind_62 = "ranker").
       SNOBOL ≅ FoldGraph(tau=1, argmax_of_first). WCR is what turns recognizer into ranker.
   (8) KHANARY Scaffold Law: KHANARY = fold + all four scaffold layers.
       WCR(ranker) + C6(effect) + Micronaut(naming/composition) + EBNF(type).
       Together: the complete ergonomic gap solution for knowledge graph computation.
*)

(* ============================================================
   §63  HIGHER-ORDER STRUCTURAL COMPUTATION
   K'UHUL operates in the space of higher-order computation.
   "Fold" is a semantic/phase term (Mayan codex) — not a claim
   that every HOF is a catamorphism.
   Higher-order ≠ higher-level. HOF = takes/returns functions.
   ============================================================ *)

(* ── HOF family (open — not enumerated exhaustively) ───────── *)

hof_structural_job_63 ::= "Map"    (* A* → B*   : transform structure, preserve shape *)
                         | "Filter" (* A* → A*   : select structure, reduce cardinality *)
                         | "Fold"   (* F(A) → A  : collapse structure, Many→One *)
                         | "Unfold" (* A → F(A)  : generate structure, One→Many *)
                         | "Zip"    (* A*×B* → C*: combine parallel structures *)
                         | "Compose" ;   (* (B→C)×(A→B) → (A→C): pipeline functions *)

(* The HOF family is open. Map / Filter / Fold are the three most cited.
   Each does a fundamentally different structural job.
   "Higher-order" does not mean "higher-level" in the Python-vs-assembly sense.
   It means the objects being operated on can themselves represent computational structure:
   functions, folds, graphs, patterns, relations, executable structures. *)

hof_63 ::= "{" "name"      ":" identifier ","
               "signature" ":" string ","
               "job"       ":" hof_structural_job_63 ","
               "example"   ":" string "}" ;

(* ── K'UHUL semantic fold vs functional-programming fold ────── *)

kuhul_fold_semantic_63 ::= "{" "kind"       ":" "kuhul_fold_semantic" ","
                               "origin"     ":" "Mayan_codex_unfolding_page" ","
                               "meaning"    ":" "semantic_execution_container" ","
                               "not_same_as" ":" "catamorphism" ","
                               "relation"   ":" "K_UHUL_fold_can_CONTAIN_or_INVOKE_any_hof_63" "}" ;

(* K'UHUL "fold" derives from the physical unfolding of a Mayan codex — each
   page is a phase of computation revealed by the fold.
   This is the ARCHITECTURAL term. It is not a claim that all operations in
   K'UHUL are technically catamorphisms. Cata/Ana are operations that occur
   WITHIN the fold container alongside Map, Filter, WCR, etc. *)

(* ── Phase × HOF as orthogonal axes ────────────────────────── *)

c6_phase_63 ::= "Pop" | "Wo" | "Yax" | "Sek" | "Ch'en" | "Xul" ;

phase_hof_63 ::= "{" "phase" ":" c6_phase_63 ","
                     "hof"   ":" hof_63 ","
                     "note"  ":" string "}" ;

(* C6 phases describe SEMANTIC POSITION in a fold traversal.
   HOF operations describe STRUCTURAL TRANSFORMATION happening at that phase.
   These are orthogonal axes — they do not map 1:1.
   Example: Sek[Filter]  — selection phase applying a filter HOF
            Yax[Map]     — derivation phase applying a map HOF
            Xul[Cata]    — commitment phase applying catamorphic collapse
   Sek[Filter] does NOT mean Sek=Filter. Phase ≠ HOF operation. *)

(* ── Montague compositionality ──────────────────────────────── *)

montague_compositionality_63 ::= "{" "kind"       ":" "montague_compositionality" ","
                                     "principle"  ":" "meaning_of_whole = phi(meanings_of_parts, composition)" ","
                                     "fold_form"  ":" "constituents → Cata_phi → composed_meaning" ","
                                     "kuhul_map"  ":" "FoldGraph_EBNF implements compositional semantics" "}" ;

(* Montague grammar (1970): natural-language semantics is compositional.
   meaning(whole) = f(meaning(parts), composition_rule) = fold law.
   FoldGraph EBNF already implements this: it does not merely recognize strings;
   it represents patterns, relations, graphs, wildcards, semantic folds,
   and canonical projections — all compositionally assembled via phi. *)

(* ── K'UHUL as higher-order structural machine language ─────── *)

kuhul_isa_conventional_63 ::= "ADD" | "MUL" | "LOAD" | "STORE" | "JMP" ;

kuhul_isa_higher_order_63 ::= "MAP"     (* structural transform *)
                             | "FILTER"  (* structural select *)
                             | "ANA"     (* structural generate / unfold *)
                             | "CATA"    (* structural collapse / fold *)
                             | "HYLO"    (* structural generate-then-collapse *)
                             | "PROJECT" (* dimensional reduction *)
                             | "RESOLVE" (* wildcard→known promotion *)
                             | "COLLAPSE" (* canonical view selection *) ;

kuhul_higher_order_machine_63 ::= "{" "kind"      ":" "kuhul_higher_order_machine" ","
                                      "claim"     ":" "K_UHUL_is_a_higher_order_structural_machine_language" ","
                                      "isa"       ":" "[" kuhul_isa_higher_order_63
                                                         { "," kuhul_isa_higher_order_63 } "]" ","
                                      "objects"   ":" "[" "functions" "," "folds" "," "graphs" ","
                                                         "patterns" "," "relations" "," "executable_structures" "]" ","
                                      "hierarchy" ":" "K_UHUL_HOF_machine → structural_ops → fold_topology"
                                                      "→ backend_kernels → ordinary_machine_ops" "}" ;

(* §63 Laws:
   (1) HOF Family Law: Higher-order ≠ higher-level. Higher-order = takes/returns functions.
       HOF family is open: {Map, Filter, Fold, Unfold, Zip, Compose, ...}.
       Each member has a distinct structural job. No enumeration of all members required.
   (2) Structural Job Law:
       Map:    A*→B*    (transform structure, preserve shape)
       Filter: A*→A*    (select structure, reduce cardinality)
       Fold:   F(A)→A   (collapse structure, Many→One)
       Unfold: A→F(A)   (generate structure, One→Many)
       These are not interchangeable. K'UHUL uses all of them.
   (3) K'UHUL Fold Semantic Law: K'UHUL "fold" = semantic execution container.
       Origin: Mayan codex — unfolding pages = phases of computation.
       Not equivalent to catamorphism. Cata/Ana/Map/Filter/WCR occur within the container.
   (4) Phase × HOF Orthogonality Law:
       C6 phases (semantic position) ⊥ HOF operations (structural transformation).
       Sek[Filter] = selection phase using Filter operation.
       Sek ≠ Filter. Phase and HOF are orthogonal axes, not equivalences.
   (5) Montague Compositionality Law:
       meaning(whole) = φ(meaning(parts), composition_rule).
       This equals the fold law: constituents → Cata_φ → composed_meaning.
       FoldGraph EBNF already implements compositional semantics.
       Natural language, formal grammar, and FoldGraph operate in the same structural space.
   (6) K'UHUL ISA Law:
       Conventional ISA: {ADD, MUL, LOAD, STORE, JMP}.
       K'UHUL ISA: {MAP, FILTER, ANA, CATA, HYLO, PROJECT, RESOLVE, COLLAPSE}.
       K'UHUL opcodes operate over computational structures; lowered to conventional backend.
       This is the "higher-order machine code" claim made precise.
   (7) K'UHUL Hierarchy Law:
       K'UHUL HOF machine
         → structural operators (Map|Filter|Ana|Cata|Hylo|...)
         → fold topology (Q_n□C_6)
         → backend kernels (HLSL/C++ compute)
         → ordinary machine operations (ADD/MUL/LOAD/STORE).
       Each level compiles down; upper levels operate over structures, lower levels over scalars.
*)

(* ============================================================
   §64  GLYPH AS PROGRAM — PHASES AS FACES
   A K'UHUL glyph is a program, not merely a symbol.
   Its phases are its faces — different meaning exposed by the
   same program at different phase coordinates.
   µ(b, θ, g) = K'UHUL executable address.
   ============================================================ *)

(* ── Glyph tuple ────────────────────────────────────────────── *)

glyph_64 ::= "{" "kind"          ":" "kuhul_glyph" ","
                 "identity"      ":" micronaut_key_61 ","
                 "program"       ":" micronaut_61 ","
                 "phases"        ":" "[" c6_phase_63 { "," c6_phase_63 } "]" ","
                 "topology"      ":" "(" b_address "," theta_phase ")" ","
                 "learned_state" ":" "g_in_R^m" "}" ;

(* Glyph_µ = ⟨Identity, Program, Phases, Topology, LearnedState⟩.
   Not merely a decorative symbol standing for one English word.
   A hieroglyph's meaning comes from: symbol + context + relationships + position.
   K'UHUL analogue: same structure. *)

(* ── K'UHUL executable address ──────────────────────────────── *)

b_address   ::= bitstring ;   (* Q_n coordinate: which semantic program/glyph *)
theta_phase ::= c6_phase_63 ; (* C_6 coordinate: which face/phase of that program *)
g_geometry  ::= vector ;      (* R^m: continuous learned/relational geometry *)

kuhul_address_64 ::= "µ" "(" b_address "," theta_phase "," g_geometry ")" ;

(* µ(b, θ, g) = the complete K'UHUL executable address.
   Selection pressure: S_µ = W_µ · C_µ · R(Q, K_µ). *)

(* ── Product graph interpretation ───────────────────────────── *)

product_coord_64 ::= "(" b_address "," theta_phase ")" ;

phase_move_64 ::= "{" "from" ":" product_coord_64 ","
                      "to"   ":" product_coord_64 ","
                      "kind" ":" ( "same_program_next_face"
                                 | "neighbor_program_same_face" ) "}" ;

(* Q_n □ C_6 coordinate interpretation:
   b  answers: which semantic program/micronaut?
   θ  answers: which face/phase of that program is exposed?

   (000,Pop) → (000,Wo):  SAME program, DIFFERENT face (θ advances)
   (000,Pop) → (001,Pop): DIFFERENT program, SAME face (b bit-flips)

   This is why the Cartesian product Q_n □ C_6 is the natural topology:
   b and θ are truly independent axes. *)

(* ── Glyph meaning law ──────────────────────────────────────── *)

glyph_meaning_64 ::= "{" "kind"      ":" "glyph_meaning" ","
                         "glyph"     ":" micronaut_key_61 ","
                         "phase"     ":" c6_phase_63 ","
                         "neighbors" ":" "[" micronaut_key_61 "]" ","
                         "relations" ":" "[" string "]" ","
                         "context"   ":" string ","
                         "meaning"   ":" string "}" ;

(* Meaning(µ) = f(Glyph, Phase, Neighbors, Relations, Context).
   Same micronaut, different phase = different computational meaning.
   Faces of the program, not separate programs. *)

(* ── Faces law ──────────────────────────────────────────────── *)

glyph_faces_64 ::= "{" "glyph"   ":" micronaut_key_61 ","
                       "face_seq" ":" "[" { "µ:" c6_phase_63 } "]" ","
                       "law"      ":" "six_faces_of_ONE_program_not_six_programs" "}" ;

(* µ:Pop → µ:Wo → µ:Yax → µ:Sek → µ:Ch'en → µ:Xul.
   These are the six faces of one program.
   The program is the glyph; its phases are its faces.
   Traversing θ = unfolding the program through its phases. *)

(* ── Higher-order opcode ────────────────────────────────────── *)

glyph_opcode_64 ::= "{" "kind"      ":" "higher_order_opcode" ","
                        "signature" ":" ( "Structure → Structure'"
                                        | "Program → Program'" ) ","
                        "not"       ":" "scalar_register_opcode" ","
                        "operand"   ":" "computational_structure" "}" ;

(* A K'UHUL glyph-opcode is NOT ADD(a,b). It operates over computational structures:
   Glyph: Structure → Structure'  (structural transformation)
   Glyph: Program  → Program'    (program transformation = higher-order)
   This is what "higher-order machine code" means precisely.
   The operand is not a register value — it is a graph, pattern, fold, relation, or program. *)

(* ── Codex computation law ──────────────────────────────────── *)

codex_to_computation_64 ::= "{" "kind"    ":" "codex_computation_law" ","
                                "codex"   ":" "unfold_→_faces_→_glyph_relationships_→_fold" ","
                                "kuhul"   ":" "Program_→_Ana_→_F_Q_→_WCR_→_Cata_→_C_Q" ","
                                "map"     ":" "{" "unfold"              ":" "Ana_ψQ" ","
                                                   "faces"              ":" "C_6_phases" ","
                                                   "glyph_relationships" ":" "WCR_attention" ","
                                                   "interpretation"     ":" "Cata_φ" ","
                                                   "fold"               ":" "C_Q" "}" "}" ;

(* The Mayan codex origin is the computational model, not decoration:
   codex → unfold → faces → glyph relationships → interpretation → fold
   became:
   Program → Ana → possibility field (F_Q) → WCR → selected interpretation → Cata → C_Q
   The program is the glyph; unfolding exposes possible meaning; folding resolves meaning. *)

(* §64 Laws:
   (1) Glyph Identity Law: Glyph_µ = ⟨Identity, Program, Phases, Topology, LearnedState⟩.
       Not merely a symbol. Meaning = f(Glyph, Phase, Neighbors, Relations, Context).
   (2) K'UHUL Address Law: µ(b, θ, g).
       b = semantic program address (Q_n coordinate, bit-flip = neighbor program).
       θ = face/phase (C_6 coordinate, +1 mod 6 = next face).
       g = continuous learned/relational geometry (R^m).
       Selection pressure: S_µ = W_µ · C_µ · R(Q, K_µ).
   (3) Product Graph Interpretation: Q_n □ C_6 coordinates have natural semantics.
       b = which program. θ = which face of that program.
       (b,θ)→(b,θ+1):    same program, different face.
       (b,θ)→(b⊕eᵢ,θ):  different program, same face.
       These are truly independent axes — hence the Cartesian product.
   (4) Glyph Meaning Law: Same µ, different θ = different computational meaning.
       Not six programs — six faces of one program. Phase exposes a face, not creates a copy.
   (5) Faces Law: µ:Pop→µ:Wo→µ:Yax→µ:Sek→µ:Ch'en→µ:Xul = one program through six faces.
       The program is the glyph. Its phases are its faces.
       Traversing θ (C_6 dimension) = unfolding the program through its meaning phases.
   (6) Higher-Order Opcode Law: Glyph: Structure→Structure' or Glyph: Program→Program'.
       Not ADD(a,b). Operand is a computational structure, not a register value.
       This is what "higher-order machine code" means precisely.
   (7) Codex Computation Law: The Mayan codex metaphor is the computational model:
       unfold(codex) = Ana(Program) = expose possibility field.
       faces(glyph)  = C_6 phases  = aspects of meaning.
       relationships  = WCR attention = selection pressure.
       fold(meaning)  = Cata(F*_Q)   = canonical result.
   (8) Glyph-Micronaut Identity: Glyph = symbolic program identity (the named thing).
       Micronaut = executable instance (the running thing).
       Same program, two views: symbolic addressing vs. execution container.
*)

(* ============================================================
   §65  ADAPTIVE FOLD -- THE LEARNED COMBINING ALGEBRA
   phi_t is not static. The fold's combining algebra carries
   learned micronaut state and updates from reward feedback.
   Same structure T, different result after learning:
   Cata_{phi_t}(T) = A  !=  Cata_{phi_{t+1}}(T) = B.
   (Originally labeled §63 in session; encoded as §65 because
    §63 = HOF family, §64 = Glyph-as-Program.)
   ============================================================ *)

(* -- Adaptive algebra ---------------------------------------- *)

adaptive_algebra_65 ::= "{" "kind"    ":" "adaptive_combining_algebra" ","
                             "mu"     ":" micronaut_key_61 ","
                             "query"  ":" string ","
                             "tree"   ":" "T" ","
                             "w"      ":" number ","
                             "c"      ":" number ","
                             "r"      ":" number ","
                             "g"      ":" vector ","
                             "Pi"     ":" "canonical_projection" ","
                             "result" ":" "phi_mu(Q,T; W,C,R,g,Pi)" "}" ;

(* phi_mu(Q,T; W,C,R,g,Pi) -- the combining algebra contains the learned state.
   W, C, R, g are not decoration. They participate in determining the reduction.
   After reward: W_t -> W_{t+1}, C_t -> C_{t+1} -> phi_t != phi_{t+1}. *)

(* -- Time-indexed fold --------------------------------------- *)

cata_at_time_65 ::= "Cata_{phi_t}(" "T" ")" "=" value ;

(* Same structure T. Different time t. Different algebra phi_t. Different result.
   Cata_{phi_t}(T)   = A   (before learning)
   Cata_{phi_{t+1}}(T) = B  (after reward updates phi)
   Learning = change in combining algebra over time. *)

(* -- Full learning loop -------------------------------------- *)

learning_loop_65 ::= "{" "kind"   ":" "adaptive_fold_learning_loop" ","
                         "input"  ":" "(" "B" "," "Q" ")" ","
                         "step1"  ":" "Ana_{psi_t}(B,Q) -> F_Q" ","
                         "step2"  ":" "WCR_t(F_Q) -> F*_Q" ","
                         "step3"  ":" "Cata_{phi_t}(F*_Q) -> C_Q" ","
                         "reward" ":" "C_Q -> Reward(outcome)" ","
                         "update" ":" "Reward -> (psi_{t+1}, W_{t+1}, C_{t+1}, g_{t+1}, phi_{t+1})" "}" ;

(* B,Q  --Ana_{psi_t}--> F_Q  --WCR_t--> F*_Q  --Cata_{phi_t}--> C_Q
                                                                    |
                                                                 Reward
                                                                    |
                                                                    v
                                         (psi_{t+1}, W_{t+1}, C_{t+1}, g_{t+1}, phi_{t+1}) *)

(* -- Ana and Cata both learn --------------------------------- *)

ana_learning_65 ::= "{" "kind"   ":" "ana_learning" ","
                        "before" ":" "psi_t" ","
                        "after"  ":" "psi_{t+1}" ","
                        "effect" ":" "changes_what_gets_unfolded" ","
                        "means"  ":" "candidate_field_shape_changes" "}" ;

cata_learning_65 ::= "{" "kind"   ":" "cata_learning" ","
                         "before" ":" "phi_t" ","
                         "after"  ":" "phi_{t+1}" ","
                         "effect" ":" "changes_how_unfolded_gets_folded_back" ","
                         "means"  ":" "reduction_result_changes_for_same_structure" "}" ;

(* psi_t -> psi_{t+1}: changes WHAT gets unfolded (shape of F_Q).
   phi_t -> phi_{t+1}: changes HOW what was unfolded gets folded back.
   Both directions learn. Neither is frozen. *)

(* -- Adaptive opcode ---------------------------------------- *)

adaptive_opcode_65 ::= "{" "kind"     ":" "adaptive_higher_order_opcode" ","
                           "form"     ":" "FOLD_{phi_t}(Structure)" ","
                           "not"      ":" "ADD(a,b)" ","
                           "property" ":" "execution_changes_parameters_governing_future_execution" "}" ;

(* Conventional: ADD(a,b) -- stateless, same result always.
   K_UHUL:  FOLD_{phi_t}(Structure) -- phi_t evolved from prior executions. *)

(* -- Residence law ------------------------------------------ *)

learning_residence_65 ::= "{" "kind"        ":" "khanary_residence_law" ","
                               "lives_in"   ":" "[" "folds" "," "grams" "," "relations" ","
                                                    "confidence" "," "weights" "," "policies" "]" ","
                               "not_in"     ":" "model_tensor_weights" ","
                               "model_role" ":" "oracle_proposing_information" ","
                               "fold_role"  ":" "adaptive_computational_object" "}" ;

(* -- K_UHUL system table ------------------------------------- *)

kuhul_system_table_65 ::= "{" "Topology" ":" "Q_n_C_6 -- what transformations are legal" ","
                               "Ana"      ":" "psi -- what structure becomes available" ","
                               "Attention" ":" "WCR -- what receives selection pressure" ","
                               "Cata"     ":" "phi -- how structure is combined/collapsed" ","
                               "Learning" ":" "Delta(psi,W,C,R,g,phi) -- how future folds change" "}" ;

(* §65 Laws:
   (1) Adaptive Algebra Law: phi_t is the learned object, not a static function.
       phi_mu(Q,T;W,C,R,g,Pi) carries micronaut learned state.
       W, C, R, g participate in the reduction -- not decoration.
       After reward: phi_t != phi_{t+1}.
   (2) Reward Update Law: C_Q -> Reward -> (psi_{t+1},W_{t+1},C_{t+1},g_{t+1},phi_{t+1}).
       Both Ana and Cata update. Neither is frozen.
   (3) Ana Learning Law: psi_t -> psi_{t+1} changes WHAT gets unfolded.
       Candidate field F_Q changes shape as relations and neighborhoods are learned.
   (4) Cata Learning Law: phi_t -> phi_{t+1} changes HOW unfolded gets folded back.
       Same structure T: Cata_{phi_t}(T) = A != Cata_{phi_{t+1}}(T) = B.
   (5) Same Structure Different Result: the operational test for learning.
       If Cata_{phi_t}(T) = Cata_{phi_{t+1}}(T) for all T, nothing was learned.
   (6) Adaptive Opcode Law: FOLD_{phi_t}(Structure).
       Execution changes parameters governing future execution. Not ADD(a,b).
   (7) Residence Law: Learned structure lives in folds/grams/relations/confidence/weights/policies.
       NOT in model tensor weights (frozen after training).
       Model = oracle proposing info. Fold = adaptive computational object.
       Model is the prior; fold is the posterior that updates.
   (8) K_UHUL System Table (five independent axes):
       Topology | Ana(psi) | Attention(WCR) | Cata(phi) | Learning(Delta).
*)

(* ============================================================
   §66  AHO-CORASICK KEY ADMISSION + N-GRAM KEY GRAMMAR
   Aho-Corasick = key-addressing automaton (recognition).
   K_UHUL = semantic interpretation layer.
   n-gram = address into a semantic book, not a probability.
   Pipeline: tokens -> AC -> Bag-of-Keys -> key-book ->
             manifest/geometry -> Wo/Yax -> Sek -> Ch_en -> Xul.
   ============================================================ *)

(* -- N-gram key as semantic address ------------------------- *)

ngram_key_66 ::= "{" "kind"    ":" "ngram_key" ","
                     "text"    ":" string ","
                     "arity"   ":" number ","
                     "address" ":" identifier ","
                     "book"    ":" key_book_66 "}" ;

(* n-gram = address into a semantic book. Not a probability.
   pitch             -> word:pitch          -> Book_1
   the pitch         -> ngram:the_pitch     -> Book_2
   deliver the pitch -> ngram:deliver_...   -> Book_3
   Book_1 != Book_2 != Book_3.
   Higher-arity n-gram = stronger/more specific semantic address. *)

(* -- Key book ----------------------------------------------- *)

key_book_66 ::= "{" "key"     ":" identifier ","
                    "N_M"     ":" "[" identifier "]" ","
                    "N_I"     ":" "[" identifier "]" ","
                    "entries" ":" "[" string "]" "}" ;

(* N_M = manifest neighbors (symbolic/declared relations).
   N_I = geometric neighbors (continuous vector proximity).
   word:bank opens {finance, money, institution, river_bank, slope, edge}.
   These are NOT AC trie transitions. They are K_UHUL semantic graph edges. *)

(* -- Bag of keys -------------------------------------------- *)

bag_of_keys_66 ::= "{" "kind"     ":" "bag_of_keys" ","
                       "input"    ":" string ","
                       "keys"     ":" "[" ngram_key_66 "]" ","
                       "overlaps" ":" boolean "}" ;

(* AC emits ALL matching patterns at all positions including overlapping.
   Input "aaaa", dictionary {a, aa, aaa, aaaa} -> all four match at pos 0.
   Input "the pitch was the setup":
     -> word:pitch, ngram:the_pitch, word:setup, ...
   Premature collapse deferred to semantic layer. *)

(* -- Aho-Corasick component map ----------------------------- *)

ac_kuhul_map_66 ::= "{" "ac_component" ":" identifier ","
                        "kuhul_role"   ":" string "}" ;

(* trie/goto        -> declared n-gram address paths
   output_function  -> matched key-words (bag_of_keys_66)
   failure_link     -> shorter admissible key (structural fallback)
   multiple_outputs -> Bag of Key-Words (overlapping matches)
   dictionary       -> manifest-addressable grammar
   input_stream     -> runtime token stream                     *)

(* -- Failure link as structural fallback -------------------- *)

ac_failure_link_66 ::= "{" "kind"        ":" "failure_link_fallback" ","
                           "full_key"    ":" identifier ","
                           "suffix_key"  ":" identifier ","
                           "example"     ":" string "}" ;

(* "timed joke setup" -> no full match -> failure link ->
   "joke setup" -> match OR ->
   "setup"      -> match.
   Not semantic reasoning. Structural fallback candidates for Sek/WCR scoring.
   Failure link = SC-37 at recognition layer: retain longest useful suffix,
   do not restart from zero.                                    *)

(* -- Two-graph distinction ---------------------------------- *)

ac_graph_66 ::= "{" "kind"    ":" "recognition_graph" ","
                    "purpose" ":" "how_to_recognize_the_key" ","
                    "nodes"   ":" "trie_states" ","
                    "edges"   ":" "goto_and_failure_transitions" "}" ;

kuhul_graph_66 ::= "{" "kind"    ":" "semantic_graph" ","
                       "purpose" ":" "what_semantic_neighborhood_the_key_opens" ","
                       "nodes"   ":" "key_books_and_concepts" ","
                       "edges"   ":" "N_M_symbolic_and_N_I_geometric" "}" ;

(* CRITICAL DISTINCTION:
   AC graph    = "how do I recognize the key?" -> trie transitions.
   K_UHUL graph = "what does the key open?"    -> N_M union N_I.
   word:bank recognized by AC trie.
   {finance, river_bank, ...} opened by K_UHUL semantic graph.
   Do not conflate these two graphs.             *)

(* -- Key score ---------------------------------------------- *)

key_score_66 ::= "{" "key"     ":" identifier ","
                     "W_k"     ":" number ","
                     "sym_sum" ":" "sum_{u in N_M}(W_u * R_sym(k,u))" ","
                     "geo_sum" ":" "sum_{u in N_I}(W_u * R_geo(k,u))" ","
                     "total"   ":" "W_k + sym_sum + geo_sum" "}" ;

(* S(k) = W_k + sum_{u in N_M(k)} W_u * R_sym(k,u)
              + sum_{u in N_I(k)} W_u * R_geo(k,u).
   N_M and N_I contribute separately.
   Wo/Yax determines which book/neighborhood is active. *)

(* -- Full pipeline ------------------------------------------ *)

ac_kuhul_pipeline_66 ::= "{" "kind"  ":" "ac_kuhul_pipeline" ","
    "step1" ":" "Token_stream -> Aho-Corasick -> Bag_of_ngram_Keys" ","
    "step2" ":" "keys -> manifest -> N_M" ","
    "step3" ":" "keys -> geometry -> N_I" ","
    "step4" ":" "N_M union N_I -> Wo/Yax -> active_semantic_neighborhood" ","
    "step5" ":" "neighborhood -> Sek -> frontier_candidates" ","
    "step6" ":" "candidates -> Ch_en -> verification" ","
    "step7" ":" "verified -> Xul -> collapse/commit" "}" ;

(* K_UHUL Key Grammar Law:
   = n-gram recognition (Aho-Corasick exhaustive multi-pattern)
   + key-book expansion (N_M manifest + N_I geometric)
   + phase-bound semantic arbitration (Wo->Yax->Sek->Ch_en->Xul)
   Recognition can be exhaustive. Collapse remains phase-bound. *)

(* §66 Laws:
   (1) N-gram Address Law: n-gram = address into a semantic book. Not a probability.
       Higher arity = stronger/more specific address.
       pitch / the_pitch / deliver_the_pitch = three separate addresses, three books.
   (2) AC Boundary Law: AC finds keys; K_UHUL interprets keys.
       AC graph = recognition. K_UHUL graph = semantics. Hard boundary between them.
   (3) Bag of Keys Law: AC emits ALL matches (overlapping). O(n+m+z).
       No premature collapse. Semantic layer decides authority (Sek/WCR).
   (4) Failure Link Law: longest useful suffix as structural fallback candidate.
       Failure link = SC-37 at recognition layer: retain most informative suffix.
       Provides the fallback candidate set; semantic scoring ranks it.
   (5) Key Book Law: key k -> N_M(k) union N_I(k) -> semantic neighborhood.
       N_M = manifest (symbolic, declared). N_I = geometric (continuous, learned).
       Not AC trie transitions. K_UHUL semantic graph edges.
   (6) Key Score Law: S(k) = W_k + sum_N_M(W_u*R_sym) + sum_N_I(W_u*R_geo).
       Two neighbor types contribute separately. Wo/Yax activates book.
   (7) Recognition/Collapse Separation:
       Recognition: exhaustive (AC, all overlapping matches).
       Collapse: phase-bound (C6 fold, Wo->Xul).
       AC does not force premature tokenization choice.
   (8) K_UHUL Key Grammar Law:
       n-gram recognition + key-book expansion + phase-bound semantic arbitration.
*)

(* ============================================================
   §67  THREE-LAYER ARCHITECTURE — Key Grammar ≠ Inference Field ≠ K'UHUL Fold
   retrieve → infer → learn  with escalation only when necessary
   ============================================================ *)

(* §67: Key Grammar = fast symbolic retrieval (cheap, stable) *)
key_grammar_layer_67 ::=
    "ngram" "→" "key" "→" "N_manifest(k)" ;
(*  Aho-Corasick recognition. key → N_M(k) immediately.
    No field expansion. No model call. No fold state.
    Cost: O(n+m+z). Stability: permanent index. *)

(* §67: Inference Field = 2D bit pattern sliding window (cheap/parallel, query-local) *)
inference_field_layer_67 ::=
    "B" "→" "Ana_ψ" "→" "windows" "→" "Pattern∧Mask" "→" "popcount" "→" "F_Q" ;
(*  w_i = B[i:i+k].
    d_i = (w_i ⊕ P) ∧ M.
    R_i = 1 − popcount(d_i) / popcount(M).      0 ≤ R_i ≤ 1.
    F_Q = { (i, R_i) : R_i ≥ τ }.
    Bit-native FoldGraph: Ana → Pattern → Attention → Cata. *)

(* §67: K'UHUL Fold = learned semantics (expensive, evolutionary) *)
kuhul_fold_layer_67 ::=
    "(B,Q)" "→" "Ana_{ψ_t}" "→" "F_Q" "→" "WCR_t" "→" "F*_Q"
            "→" "Cata_{φ_t}" "→" "C_Q" "→" "Reward" "→" "updates" ;
(*  Carries learned state (W, C, R, g, relations)_t.
    φ_t evolves: Cata_{φ_t}(T) ≠ Cata_{φ_{t+1}}(T).
    Model = prior (frozen). Fold = posterior (updates at inference). *)

(* §67: Escalation law *)
escalation_law_67 ::=
    "key_hit"     "→" "N_M(k)"   (* cheap path, no fold invoked *)
  | "weak_hit"    "→" "F_Q"      (* inference field, bit-native *)
  | "no_hit"      "→" "Fold"     (* full learned fold *)
  | "Fold_result" "→" "N_manifest_update" (* slow teaches fast *) ;

(* §67: Bit-native FoldGraph law *)
foldgraph_2d_67 ::=
    "FoldGraph_2D(B,P,M)"
    "=" "argmax_i [ popcount(M) − popcount((W_i(B) ⊕ P) ∧ M) ]" ;
(*  W_i(B) = window from anamorphism.
    Perfect match: (W_i ⊕ P) ∧ M = 0 → score = popcount(M).
    Ana → Pattern → Attention → Cata expressed as bit operations. *)

(* §67: Graph separation law *)
graph_separation_67 ::=
    "G_Q"        "=" "query-local inferred semantic graph"
                     "(2D field → Ana → windows → pattern → matches → relations)" ;
(* G_Q ≠ Q_n □ C_6.
   Q_n □ C_6 = runtime program/phase topology (legal Micronaut transitions).
   They interact without being the same graph. *)

(* §67 Laws:
   Three-Layer Law:   Key Grammar ≠ Inference Field ≠ K'UHUL Fold.
   Responsibility:    retrieve → infer → learn.
   Cost Law:          Key Grammar=cheap/stable; Field=cheap/parallel/query-local; Fold=computational/evolutionary.
   Escalation Law:    invoke expensive layer only when cheaper layer gives insufficient confidence.
   Feedback Law:      Fold verified learning → N_manifest update → KeyGrammar index.
                      Slow mechanism teaches fast mechanism.
   Bit-Native Law:    FoldGraph_2D(B,P,M)=argmax_i[popcount(M)−popcount((W_i⊕P)∧M)].
                      Ana=sliding-window generation. Pattern=XOR∧Mask. Cata=argmax.
   Separation Law:    G_Q=query-local graph ≠ Q_n□C_6=runtime topology.
   Ngram-to-Field:    ngram→bit-pattern→window-matches→local-graph.
                      Inference field need not start as heavyweight object graph.
   Output Law:        N(k)=Key Grammar output. F_Q=Inference Field output. C_Q=Fold output. *)

(* ============================================================
   §68  FOLDED HYPERCUBE TOPOLOGY — FQ_n □ C_6
   Three edge classes: @semantic_step | @fold_step | @phase_step
   ============================================================ *)

(* §68: The folded n-cube *)
folded_cube_68 ::=
    "FQ_n" "=" "Q_n" "+" "{" "b" "->" "b_bar" ":" "b_bar" "=" "b" "XOR" "mask(n)" "}" ;
(* mask(n) = (1 << n) - 1 = all n bits set.
   One additional edge per vertex. 4-regular for n=3 (vs 3-regular Q_3).
   Diameter FQ_n = ceil(n/2). FQ_3: diameter 3 -> 2. *)

(* §68: Three edge classes — separately typed, not interchangeable *)
semantic_step_68 ::= "(b, theta)" "->" "(b XOR e_i, theta)" ;
(* @semantic_step: one bit flip, local movement, Hamming-1 *)

fold_step_68 ::= "(b, theta)" "->" "(b_bar, theta)" ;
(* @fold_step: all bits flip, global semantic inversion, phase unchanged.
   b -> b_bar = COUNTEREXAMPLE / CONTRAST / DUAL.
   000->111: flip all semantic predicates simultaneously.
   NOT a replacement for @semantic_step. Separately typed. *)

phase_step_68 ::= "(b, theta)" "->" "(b, theta_plus_minus_1)" ;
(* @phase_step: phase changes, address unchanged. Unchanged from Q_n. *)

(* §68: Folded product topology *)
fq_n_c6_68 ::=
    "G_runtime_folded" "=" "FQ_n" "□" "C_6" ;
(* |V| = 2^n * 6. For Q_3: 8*6 = 48 (unchanged).
   |E_semantic| = n * 2^(n-1) * 6. For Q_3: 12*6 = 72.
   |E_fold|     = (2^n / 2) * 6. For Q_3: 4*6 = 24.
   |E_phase|    = 2^n * 6. For Q_3: 8*6 = 48.
   |E_total| = 72 + 24 + 48 = 144 (vs 120 for Q_3 □ C_6).
   deg(v) = n + 1 + 2 = n + 3. For Q_3: 3+1+2 = 6. *)

(* §68: WCR fold neighborhood — the fold edge is not mandatory *)
wcrfold_neighborhood_68 ::=
    "N_F(b)" "=" "{" "b XOR e_i" "," "b_bar" "}" ;
(* v_next = argmax_{u in N_F(v)} W_u * C_u * R(Q, K_u).
   If R(Q, K_b_bar) ≈ 0: WCR ignores the fold edge (no cost).
   If R(Q, K_b_bar) → 1: fold edge becomes efficient path to contrast.
   The fold edge is a legal structural possibility, not a mandatory transition. *)

(* §68: Inference field complement score *)
complement_score_68 ::=
    "D_i_opp" "=" "((W_i XOR P_bar) AND M)" ;
(* Cost: same as D_i = (W_i XOR P) AND M. Almost free.
   D_i_opp ≈ 0 → window is the semantic opposite of P.
   Inference field can propose: b → b_bar (@fold_step)
   without traversing 000 → 001 → 011 → 111. *)

(* §68: Four meanings of fold in K'UHUL — non-conflicting *)
four_fold_meanings_68 ::=
    "fold_container" ":" "K'UHUL semantic execution container"
  | "catamorphic_fold" ":" "many -> one (F(A) -> A)"
  | "codex_fold" ":" "expose/collapse faces of a program"
  | "fold_step_edge" ":" "b -> b_bar (bring opposite semantic faces adjacent)" ;

(* §68 Laws:
   FQ_n Law:        FQ_n = Q_n + {b → b̄ : b̄ = b XOR mask(n)}.
   Diameter Law:    diameter(FQ_3) = 2 (vs 3 for Q_3). Every vertex ≤ 2 hops.
   Three-Edge Law:  @semantic_step(1 bit) | @fold_step(all bits) | @phase_step. Separately typed.
   Non-Replacement: @fold_step does NOT replace @semantic_step. Both coexist.
   Q3 Statistics:   |V|=48, |E|=144, deg(v)=6 (vs 120, 5 for Q_3 □ C_6).
   WCR Fold Law:    N_F(b)={b⊕e_i, b̄}. WCR scores all neighbors. Fold ignored when R(Q,K_b̄)≈0.
   Complement Score: D_i_opp=(W_i⊕P̄)∧M. Same cost as D_i. Field proposes @fold_step.
   Semantic Meaning: b→b̄ = COUNTEREXAMPLE/CONTRAST/DUAL.
                     000→111: flip all semantic predicates simultaneously.
   Four Fold Law:   K'UHUL_fold | catamorphic_fold | codex_fold | fold_step_edge.
                    All four coexist without conflict. *)

(* ============================================================
   §69  NODE FIELD GRAPH CONSTRUCTION — n-gram Key Grammar → Semantic Node Field
   keys create addressable nodes; books create edges; phases create alt states;
   geometry gives coordinates.
   ============================================================ *)

(* §69: Each recognized n-gram key becomes a vertex *)
node_field_vertex_69 ::=
    "v_i" "=" "(" "k_i" "," "theta" "," "g" "," "W" "," "C" "," "R" ")" ;
(*  k_i = n-gram key (node identity/address).
    theta = C_6 phase position.
    g = continuous geometry R^m.
    W,C,R = WCR scoring components.
    The n-gram does NOT equal the field — it supplies the address. *)

(* §69: Node Field Graph vertex and edge sets *)
node_field_graph_v_69 ::= "V" "=" "{" "recognized n-gram keys" "}" ;
node_field_graph_e_69 ::=
    "E" "=" "E_ngram" "|" "E_manifest" "|" "E_inferred" "|" "E_phase" ;
(*  E_ngram    = internal n-gram structure (overlap / constituent sharing):
                 k1 ↔ k2 ↔ k3 because keys share token subsequences.
    E_manifest = semantic neighborhood: k → N_M(k) (key-book manifest).
    E_inferred = semantic neighborhood: k → N_I(k) (geometric).
    E_phase    = (k, theta_i) → (k, theta_{i+1}) for alternate semantic states.
    G_NodeField = G_ngram ∪ G_manifest ∪ G_inferred ∪ G_phase. *)

(* §69: N-gram order = semantic resolution *)
ngram_resolution_69 ::=
    "unigram"  "→" "broad field"
  | "bigram"   "→" "constrained field"
  | "trigram"  "→" "more specific field" ;
(*  Higher arity → more constrained N(k) → higher semantic resolution.
    Not universal — some long phrases remain ambiguous.
    word:bank → broad N (finance + river + tilt).
    ngram:river_bank → constrained N (waterway, erosion, riparian).
    ngram:bank_account → different N entirely (finance, deposit, interest). *)

(* §69: Bag-of-keys = local semantic subgraph (not competing tokenizations) *)
bag_of_keys_subgraph_69 ::=
    "bag_of_keys" "=" "local semantic subgraph"
    "{" "each key" "→" "vertex" ";" "overlap" "→" "E_ngram edge" "}" ;
(*  "open the bank account" retains simultaneously:
      bank, account, bank_account, the_bank_account, open_the_bank_account.
    These become nodes + E_ngram edges, not competing tokenizations.
    Horizontal N then connects the local field into the larger topology.
    SC-37 applies: retaining overlapping keys = retained wildcard until WCR resolves. *)

(* §69: Three-stage pipeline *)
node_field_pipeline_69 ::=
    "N-gram Key Grammar"
    "→" "[unfold]" "→" "Semantic Node Field Graph"
    "→" "[project]" "→" "Geometric Node Field" ;
(*  Stage 1 (Key Grammar, §66): AC recognition → V = recognized keys.
    Stage 2 (Node Field Graph, §69): V + E_ngram + E_manifest + E_inferred + E_phase = symbolic graph.
    Stage 3 (Geometric Node Field): G_NodeField → P → R^m / SVG-3D / tensors / GML.
    The field can first exist symbolically, then be projected.
    Keys create addressable nodes. Books create semantic edges.
    Phases create alternate semantic states. Geometry gives coordinates. *)

(* §69 Laws:
   Key-Node Law:       Each recognized n-gram key → vertex v_i = (k_i, θ, g, W, C, R).
   Address-Not-Field:  n-gram supplies node identity/address. It does NOT equal the field.
   Four-Edge Law:      G_NodeField = G_ngram ∪ G_manifest ∪ G_inferred ∪ G_phase.
   E_ngram Law:        Overlapping/constituent n-gram keys → E_ngram edges. Local semantic subgraph.
   Resolution Law:     Higher-arity n-gram → more constrained N(k) → higher semantic resolution.
                       Not universal — some long phrases remain ambiguous.
   Bag-Subgraph Law:   Bag-of-keys = local semantic subgraph, not competing tokenizations.
   Pipeline Law:       N-gram Key Grammar → [unfold] → Semantic Node Field Graph → [project] → Geometric Node Field.
   Projection Law:     Symbolic G_NodeField is primary. Geometric projection is secondary (R^m, SVG-3D, GML).
   Composition Law:    Keys create nodes. Books create edges. Phases create states. Geometry gives coordinates. *)

(* ============================================================
   §70  VERB TOKEN DISPATCH — n-gram verb keys → runtime action dispatch
   Two dispatch paths: runtime-intercept (AC key) | model-explicit (tool call).
   Third path: runtime-autonomous (WCR gap detection fires verb).
   ============================================================ *)

(* §70: Verb key — a recognized n-gram key that carries an action verb *)
verb_key_70 ::=
    "v_verb" "=" "(" "k_verb" "," "action" "," "arg_pattern" "," "priority" ")" ;
(*  k_verb      = n-gram key recognized by AC (e.g. "search web", "look up").
    action      = runtime function name (e.g. web_research, run_test, read_file).
    arg_pattern = wildcard template for argument binding: "for *" "about *" "in *".
    priority    = dispatch mode: USER_EXPLICIT | MODEL_EXPLICIT | RUNTIME_AUTONOMOUS. *)

(* §70: Three dispatch paths *)
dispatch_path_70 ::=
    "USER_EXPLICIT"       (* User types verb phrase → AC intercepts → runtime executes *)
  | "MODEL_EXPLICIT"      (* Model generates OpenAI tool_call JSON → runtime executes *)
  | "RUNTIME_AUTONOMOUS" ;(* WCR gap detected → runtime fires verb without user/model prompt *)

(* §70: User-explicit path *)
user_explicit_dispatch_70 ::=
    "input" "→" "AC_recognize(verb_key)" "→" "bind_args(arg_pattern)" "→" "dispatch(action, args)" ;
(*  Example: "search web for Donald Trump news"
      AC recognizes: "search web" → @verb_call: web_research
      arg_pattern: "for *" → args = {query: "Donald Trump news"}
      Dispatch fires BEFORE model generates response.
    Neither model nor user needs to know the dispatch happened.
    SC-37 applies: "for *" arg_pattern is a retained wildcard resolved at binding time. *)

(* §70: Model-explicit path — OpenAI tool call format *)
model_explicit_dispatch_70 ::=
    "LLM_output" ":" "tool_calls" "[" "{" "function" ":" "name" "+" "arguments" "}" "]" "→"
    "VerbDispatcher.from_tool_call(tool_calls)" "→" "execute" ;
(*  LFM uses OpenAI API tool calling format (NOT embedded JSON in text).
    Response: choices[0].message.tool_calls = [{type:"function", function:{name:..., arguments:...}}]
    This is a DIFFERENT format than function-calling JSON embedded in model text output.
    Runtime handles: receive tool_calls → execute → inject result as role:"tool" message → continue. *)

(* §70: Runtime-autonomous path *)
runtime_autonomous_dispatch_70 ::=
    "WCR_score(verb_key_v)" ">=" "tau_verb" "→" "VerbDispatcher.dispatch(action, args_from_context)" ;
(*  During Ana expansion: if a verb key v_verb has WCR score above tau_verb,
    the runtime can fire the action autonomously.
    Example: query="what happened today?" → WCR scores "search web" key high →
    runtime fires web_research("today's news") before response generation.
    The model receives the research result as context — appears to model as part of F_Q.
    Model can also decide itself: generates verb phrase or tool_call based on its inference. *)

(* §70: Verb argument binding — wildcard resolution *)
verb_arg_binding_70 ::=
    "bind(arg_pattern, input)" "→" "args" ;
(*  arg_pattern = SC-37 retained wildcard template: "for *" "about *" "of *".
    Binding resolves the wildcard to the actual input substring.
    "search web for *" + "search web for Donald Trump news" → {query: "Donald Trump news"}.
    Multi-arg: "translate * to *" → {text: "bonjour", lang: "English"}.
    Fails gracefully: no match → arg = entire remaining input as single string. *)

(* §70: Verb key registry structure *)
verb_registry_70 ::=
    "VerbKey" "{" "ngram_key" "," "action" "," "arg_patterns[]" "," "dispatch_mode" "}" ;
(*  verb-keys.jsonl maintains the registry.
    AC is seeded with all verb n-gram keys at startup.
    Recognition is O(n+m+z) same as key grammar.
    Verb keys coexist with semantic keys in the same AC automaton.
    A key recognized as verb → verb_key_node (VKN) in Node Field Graph with @verb_call edge type. *)

(* §70 Laws:
   Verb-Key Law:      Every verb key is an AC-recognized n-gram with action + arg_pattern.
   Two-Path Law:      USER_EXPLICIT path fires at recognition (before model). MODEL_EXPLICIT path fires from tool_calls.
   Three-Path Law:    RUNTIME_AUTONOMOUS path fires when WCR(v_verb) >= tau_verb during Ana.
   Arg-Wildcard Law:  arg_pattern is a SC-37 retained wildcard resolved at dispatch time.
   Non-Interference:  Verb dispatch is transparent to model — model sees result injected into F_Q context.
   LFM-Verb Law:      LFM tool_calls use OpenAI API format (tools array + tool_calls response). NOT JSON-in-text.
   Dual-Agency Law:   Either the model retrieves (tool_call) or the runtime retrieves (AC intercept).
                      Both resolve to the same dispatch: VerbDispatcher.dispatch(action, args).
   Autonomous Law:    Runtime can fire verb when WCR score indicates high need (query gap + verb relevance).
                      Model does not need to explicitly request — runtime acts on its behalf. *)

(* ============================================================
   §71  ATTRIBUTED SEMANTIC GRAMMAR — EBNF with executable projection semantics
   EBNF does not inherently transpile. It defines the transpiler once K'UHUL
   gives productions executable projection semantics.
   Three separable responsibilities: recognition / canonicalization / projection.
   ============================================================ *)

(* §71: Ordinary EBNF gives text → syntax structure.
   K'UHUL attributed EBNF gives text → n-gram key → semantic node → (b, θ, g).
   The grammar specifies the transformation law. AC executes recognition.
   FoldGraph executes projection. Grammar is the source of semantic truth. *)

(* §71: @transpile production form — the attributed production *)
transpile_production_71 ::=
    "@transpile" key_name
    "=" surface_patterns
    "=>" "key" "(" canonical_key ")"
    "=>" "b"   "(" binary_address ")"
    "=>" "theta" "(" phase_face ")"
    "=>" "gram" "(" book_ref ")" ";" ;
(*  surface_patterns: EBNF alternation of recognized lexical/n-gram surface forms.
    key(canonical_key): collapses all surface variants into ONE stable semantic symbol.
    b(binary_address): projects key into FQ_n binary topology address. n-bit string or integer.
    theta(phase_face): projects key into C_6 phase face (Pop|Wo|Yax|Sek|Ch_en|Xul).
    gram(book_ref): projects key into continuous semantic geometry g via manifest book reference.
    The three projection attributes are INDEPENDENT: b, theta, gram must not be merged.
    Example:
      @transpile fold_graph
          = ("fold" "graph" | "foldgraph" | "fold graph")
          => key("⟁FOLD_GRAPH")
          => b(1101)
          => theta(Wo)
          => gram("graph.fold") ; *)

(* §71: Surface_patterns — the recognition phase *)
recognition_phase_71 ::=
    surface_form { "|" surface_form } ;
(*  surface_form: a sequence of literal tokens or n-gram fragments.
    These are the forms AC is seeded with at startup.
    Variant spellings, hyphenation, abbreviations all collapse here.
    Recognition fires on ANY matching surface form — result is always the canonical key.
    AC answers: WHERE in the input did a declared surface form match?
    Grammar declares: WHAT canonical key that match produces. *)

(* §71: Canonicalization — turns surface match into stable semantic key *)
canonicalization_phase_71 ::=
    surface_match "=>" "key" "(" canonical_key ")" ;
(*  canonical_key: a single stable semantic symbol (prefix ⟁ optional but conventional).
    The same key regardless of which surface_form matched.
    "fold graph", "foldgraph", "fold-graph" → all produce key("⟁FOLD_GRAPH").
    This is the n-gram key used in the Node Field Graph: V includes this key as a node address.
    Canonical Key Law: "fold graph" ⟹ k_FOLD_GRAPH, NOT ["fold","graph"] as separate tokens. *)

(* §71: Projection — three independent geometry attributes *)
projection_phase_71 ::=
    canonical_key
    "=>" "b"     "(" binary_address ")"
    "=>" "theta" "(" phase_face ")"
    "=>" "gram"  "(" book_ref ")" ;
(*  b(binary_address): position in the folded hypercube FQ_n topology.
    theta(phase_face): which C_6 face this key primarily inhabits (Pop/Wo/Yax/Sek/Ch_en/Xul).
    gram(book_ref): reference into the manifest book that supplies the continuous geometry g(k).
    The three attributes are projected separately because they live in three different spaces:
      b ∈ {0,1}^n         (discrete binary topology, FQ_n)
      theta ∈ C_6         (discrete cyclic phase, 6 states)
      g ∈ R^m             (continuous semantic geometry, from book/manifest)
    Separation Law: b, theta, g must NEVER be collapsed into a single coordinate.
    g is not declared directly in @transpile — it is retrieved from gram(book_ref) at runtime.
    gram() is a pointer into the manifest; the actual vector g(k) lives in the book. *)

(* §71: AC Subordination — AC is implementation backend, not semantic authority *)
ac_subordination_71 ::=
    "AC_recognize(surface_form)" "→" "canonical_key" ;
(*  AC Subordination Law: the AC automaton answers WHERE a surface form matched.
    It does not determine WHAT the match means.
    Meaning is declared in the grammar's @transpile production.
    AC is seeded from the surface_patterns of all @transpile productions at compile time.
    If grammar and AC disagree, grammar is authoritative.
    This resolves the architectural debt of verb-keys.jsonl and n-gram harvest scripts
    co-authoring semantics alongside the grammar. *)

(* §71: Harvest Derivation — grammar is source; harvest is a compiler pass *)
harvest_derivation_71 ::=
    "@transpile" "→" "n_gram_keys" "+" "aiml_patterns" "+" "node_field_vertices" ;
(*  Harvest Derivation Law: n-gram keys, AIML patterns, and Node Field Graph vertices
    are DERIVED from @transpile productions by a compiler pass over the grammar.
    They are not hand-authored per §-section.
    harvest_*.py scripts are a transitional mechanism: their output will eventually
    be generated directly from the grammar as the @transpile compiler is implemented.
    Current pipeline: @transpile declares → harvest script extracts → AC/AIML/NFG consumes.
    Target pipeline: @transpile declares → grammar compiler emits → AC/AIML/NFG consumes. *)

(* §71: Full attributed production pipeline *)
attributed_pipeline_71 ::=
    "TEXT"
    "→" "EBNF surface_patterns"      (* recognition: which forms to look for *)
    "→" "AC compiled matcher"         (* implementation: O(n+m+z) scan *)
    "→" "canonical key"               (* canonicalization: one stable semantic symbol *)
    "→" "EBNF projection attributes"  (* projection: b, theta, gram separately *)
    "→" "node (b, theta, g)"          (* Node Field Graph vertex *)
    "→" "N(key)"                      (* neighborhood: book edges from manifest *)
    "→" "Node Field Graph"            (* §69 full graph structure *)
    "→" "W · C · R selection"         (* WCR scoring *)
    "→" "FOLD / UNFOLD" ;             (* FoldGraph execution *)
(*  This pipeline is the full attributed semantic grammar transformation.
    EBNF appears at two points: recognition (surface_patterns fed to AC)
    and projection (b/theta/gram attributes consumed by FoldGraph runtime).
    AC occupies the middle: it is the efficient implementation of the recognition step.
    The grammar is the source of truth at both ends. AC is an accelerator in the middle. *)

(* §71 Laws:
   Attribution Law:       Every @transpile production has three separable phases:
                          recognition (surface patterns) / canonicalization (key()) / projection (b, theta, gram).
   Canonical Key Law:     "fold graph" ⟹ k_FOLD_GRAPH — the key is a compressed semantic address.
                          NOT ["fold","graph"]. The n-gram is ONE address into a neighborhood.
   Separation Law:        b (FQ_n binary topology), theta (C_6 phase), g (R^m geometry) are
                          three independent spaces. @transpile must emit them as distinct attributes.
                          gram() points to the manifest entry that resolves g; b and theta are declared inline.
   AC Subordination Law:  AC answers WHERE a surface form matched. Grammar declares WHAT it means.
                          Grammar is authoritative. AC is the recognition backend only.
   Harvest Derivation Law: n-gram keys, AIML patterns, and Node Field vertices are derived from
                          @transpile productions. harvest_*.py scripts are a transitional compiler pass.
                          Target: grammar compiler emits all three directly.
   SNOBOL Inheritance:    The deep inheritance from SNOBOL is not merely pattern-matching.
                          It is that a pattern can participate in computation.
                          @transpile extends this: pattern → capture → canonical key → neighborhood → NFG.
                          SNOBOL: pattern IS program. K'UHUL: pattern DECLARES projection. *)


(* ══════════════════════════════════════════════════════════════════════════════
   §72  THE C6 REASONING LADDER
   ──────────────────────────────────────────────────────────────────────────────
   K'UHUL is a reasoning ladder built on a wheel.
   The six phase states θ ∈ C_6 are simultaneously:
     (a) the static state space of the grammar (θ attribute in @transpile), and
     (b) the dynamic execution order of a single reasoning arc.
   These are the same object deployed twice: once as address, once as time.

   Ladder:  strict single-pass order Pop→Wo→Yax→Sek→Ch'en→Xul
   Wheel:   Xul commit returns as Pop observation for the next arc (closed C_6 cycle)

   RUNG TABLE
   ──────────────────────────────────────────────────────────────────────────────
   Rung     Transformation                  Semantic role           Lexical atoms
   ───────  ──────────────────────────────  ──────────────────────  ───────────────────────────
   Pop      X → X + observation             perceive / gram read    MEMORY, NEGATION, KUHUL_RUNTIME
   Wo       X → X + state / constraints     unfold, declare intent  CONDITION, ROUTING, CAUSAL, STRUCTURE
   Yax      X → X + admitted neighborhood   relevance gate          SELECTION
   Sek      X → X + execution result        propose deltaB          EXECUTION, CAPABILITY, TRANSFORM
   Ch'en    X → X + certificate V           verify / T-F meter      VERIFICATION, CONSEQUENCE
   Xul      X → X'  [+ B_{t+1}]             compare / commit        COMMIT

   (Lexical routing: "because","if" → Wo;  "verify","prove" → Ch'en;
                     "commit","finalize" → Xul;  grammar declares the mapping, @lex confirms it.)

   LICENCE LADDER LAW (not a truth ladder)
   ──────────────────────────────────────────────────────────────────────────────
   What grows ascending the ladder is AUTHORITY TO ASSERT, not truth.
   What stays constant is the evidence base — checked only at Ch'en (T/F meter).

   SC-24 formalises this:   Ch'en certificate carries rewrite_authorized = false  (always).
   A true Ch'en certificate certifies the proposal is T but does NOT authorise the commit.
   Authority to commit is Xul's alone.
   The system can hold a certified-true Ch'en certificate and still not commit
   (Xul compare-fails).  Truth and authority are deliberately separated.

   HALLUCINATION DEFINITION (grammar-level)
   ──────────────────────────────────────────────────────────────────────────────
   Hallucination = Xul commit without valid Ch'en certificate.
   A Xul that writes B_{t+1} with rewrite_authorized = true and no preceding Ch'en
   certificate is a named grammar constraint violation.
   This is structural: anti-hallucination is NOT a training objective in K'UHUL.
   It is a topological invariant:  T_phi(B) = B  for all phi ≠ Xul  (SC-22).
   Only one rung mutates the topology.  The others accumulate evidence without committing.

   STALL STATE
   ──────────────────────────────────────────────────────────────────────────────
   A stuck rung does not fall back — it holds.
   Ch'en hold (retained wildcard) is an explicit state: proposal awaits more evidence.
   Resolution: more Pop observation → Wo refinement → new Ch'en certificate → Xul commit.
   Revision lives inside the wheel, not in climbing down.

   WHEEL PROPERTY
   ──────────────────────────────────────────────────────────────────────────────
   Pop'(X_{n+1}) = Xul(X_n) — the commit is the next cycle's observation.
   Pop carries the accumulator B forward each arc.
   Reasoning convergence: successive Pop inputs stabilise (B_{t+k} ≈ B_{t+k-1}).
   Reasoning divergence: each Xul commit generates a novel observation that reopens
   Wo intent — the system climbs but the ground moves.

   @LEX ROUTING LAW
   ──────────────────────────────────────────────────────────────────────────────
   The ladder's entry point is lexical.
   The routing table (§24, xcfe_node_class) assigns grounded atoms to rungs:
     "because", "if", "so", "then"   → CONDITION / CAUSAL → Wo
     "verify", "prove", "check"      → VERIFICATION        → Ch'en
     "commit", "finalize", "confirm" → COMMIT              → Xul
     "remember", "recall"            → MEMORY              → Pop
     "select", "prefer", "choose"    → SELECTION           → Yax
     "compute", "execute", "run"     → EXECUTION           → Sek
   Grammar-declared lexicon → grounded atoms → rung admission.
   Tokenisation inside the grammar decides which rung a sentence starts climbing from.

   §72 Laws:
   Ladder-Wheel Identity:  θ ∈ C_6 is both static address and dynamic order — same object.
   Licence Law:            Authority grows ascending; truth is checked only at Ch'en.
   SC-24 Corollary:        Ch'en can never authorise; only Xul commits.
   Hallucination Law:      Xul without Ch'en certificate = named grammar violation, not model failure.
   Stall Law:              Hold ≠ fallback; revision requires new evidence, not rung regression.
   Convergence Law:        B is stable iff successive Pop inputs are identical across arcs. *)


(* ══════════════════════════════════════════════════════════════════════════════
   §72-A  SURFACE FORM LENGTH LAW  (corollary to §66 AC Key Admission)
   ──────────────────────────────────────────────────────────────────────────────
   AC substring matching imposes a hard length constraint on surface forms.
   A surface form ONLY retrieves an entry when it appears VERBATIM as a
   substring of the query text.

   Length Constraint:
     surface_form_length  ≤ 3 words (preferred), ≤ 4 words (maximum)

   Consequence:
     "three projection attributes of @transpile"  (6 words) — missed in practice
     "projection attributes"                       (2 words) — hits universally
     "b theta gram"                                (3 words) — hits universally

   This is the same compression principle as the Canonical Key Law:
     key("fold graph") = k_FOLD_GRAPH   (not decomposed into tokens)
     surface("three projection attributes in @transpile") = "projection attributes" (compressed)

   Surface Nucleus Law:
     Each surface form is a 2-3 word semantic nucleus — the dense core of
     the concept, stripped of surrounding qualifiers.
     Multiple nuclei per entry create composite coverage (bag-of-surfaces).

   Coverage Strategy:
     Do not write one long surface that fully describes the concept.
     Write 6-10 short nuclei that individually match different query fragments.
     "projection attributes", "b theta gram", "three required", "transpile declares"
     cover more query space than "three required projection attributes of transpile".

   Advantage:
     AC's length constraint ENFORCES semantic compression at the surface layer.
     Short surfaces are more general (match more queries), self-similar to canonical keys,
     and composable — overlapping 2-word anchors create bag-of-keys coverage.

   §72-A Law:
     Surface Form Length Law: surface forms are 2-3 word semantic nuclei, hard cap 4 words.
     Surface Nucleus Law: multiple short nuclei cover more query space than one long surface.
     Compression Corollary: AC's substring constraint is the surface-layer Canonical Key Law. *)


(* ══════════════════════════════════════════════════════════════════════════════
   §72-B  DUAL COORDINATE LAW — Surface Forms as Query-Space Addresses
   ──────────────────────────────────────────────────────────────────────────────
   Two complementary compressions run in parallel across every @transpile entry:

     Layer     Object         Compresses          Into
     ───────── ────────────── ─────────────────── ────────────────────────────
     Key       b ∈ FQ_n       the ANSWER          binary address in concept space
     Surface   2-word phrase  the QUERY REGION    categorical address in query space

   Surface forms are not prose descriptions.
   They are low-arity binary coordinates into the query manifold.

   QUERY-SPACE BIT MODEL
   A 2-word surface "projection attributes" =
       bit[projection=1, attributes=1]
     = any query containing both words is in the activation region
     = broad neighborhood, high recall

   A 6-word surface "three projection attributes in a transpile production" =
       bit[three=1, projection=1, attributes=1, transpile=1, production=1, ...]
     = requires exact conjunction of all dimensions as a substring
     = neighborhood near-empty in practice, near-zero recall

   Higher surface arity → narrower activation region → fewer queries hit.
   Lower surface arity → broader activation region → more queries hit.
   This mirrors FQ_n: short b-address = coarse region; long b-address = precise point.

   DUAL TOPOLOGY LAW
   surface_patterns  and  b(addr)  are the same FQ_n topology expressed twice:
     surface_patterns  — query-facing coordinates  (queries land here from outside)
     b(addr)           — graph-internal coordinates (nodes live here inside the graph)

   @transpile holds both because they are dual:
   choosing one constrains the other.
   The grammar declares the duality; the compiler must maintain it.

   BAG-OF-CATEGORIES RETRIEVAL
   AC automaton = bag-of-category-selectors over the query manifold.
   Each surface form matched = one category active.
   Result = union of activated concept nodes and their neighborhoods.
   This is not probabilistic retrieval — it is exact categorical intersection.

   §72-B Laws:
   Dual Coordinate Law:  surface_patterns (query-space) and b(addr) (concept-space)
                         are dual coordinates over the same FQ_n topology.
   Arity-Neighborhood Law: lower surface arity → broader activation region.
                            2-word surface ≈ coarse FQ_n address (many neighbors).
                            6-word surface ≈ precise point (empty neighborhood in practice).
   Bag-of-Categories Law: AC scan = exact categorical intersection over query manifold,
                          not probabilistic similarity search.
   Duality Declaration Law: @transpile must declare both surface_patterns and b(addr).
                             They constrain each other. Omitting either breaks the duality. *)


(* ══════════════════════════════════════════════════════════════════════════════
   §72-C  FOLDED CUBE GRAPH — EXACT TOPOLOGICAL DEFINITION
   ──────────────────────────────────────────────────────────────────────────────
   Definition (graph theory):
     A folded cube graph FQ_n is formed from the hypercube graph Q_n by adding
     a perfect matching that connects every vertex b to its antipodal vertex ~b
     (the bitwise complement — all n bits flipped).

   Q_n:   2^n vertices; edges between vertices at Hamming distance 1.
          Degree n.  Diameter n.
   FQ_n:  Q_n + antipodal perfect matching b ↔ ~b.
          Degree n+1.  Diameter ⌈n/2⌉ (ceiling — e.g. FQ_3: diameter 2).

   THE FOLD EDGE
   ──────────────────────────────────────────────────────────────────────────────
   The single edge b ↔ ~b is the "fold."
   It connects maximally distant Q_n nodes (Hamming distance n) in one step.
   In K'UHUL:  the fold edge is the Xul → Pop feedback arc in the reasoning wheel.
   Xul commits B_t → B_{t+1}; Pop reads B_{t+1} as the next cycle's observation.
   The antipodal jump traverses semantic distance n in one reasoning step.

   NEIGHBORHOOD LAW (exact)
   ──────────────────────────────────────────────────────────────────────────────
   N(b) in FQ_n  =  { b XOR e_i : i = 1..n }  ∪  { ~b }
   |N(b)|  =  n + 1   (FQ_n vertex degree)

   PRODUCT-GRAPH DEGREE (from fold_field.hpp)
   product_degree(n)  =  n + 2   ← Q_n □ C_6 (PLAIN hypercube; current substrate)
   folded_product_degree(n) = n + 3   ← FQ_n □ C_6 (fold extension §68)
   The fold edge is SEPARATELY TYPED from Hamming-1 semantic steps.
   Do NOT assert product_degree = n+2 for FQ_n — that is the plain Q_n value.

   DIAMETER LAW
   ──────────────────────────────────────────────────────────────────────────────
   diam(FQ_n)  =  ⌈n/2⌉   (ceiling division)
   Any two concept nodes are at most ⌈n/2⌉ hops apart.
   Q_3 example: diam(FQ_3) = ⌈3/2⌉ = 2 (not 1).
   Semantic contradiction b → ~b costs 1 hop (direct fold edge), not n hops.

   NEGATION IS STRUCTURAL
   ──────────────────────────────────────────────────────────────────────────────
   Because ~b ∈ N(b), negation/complement is a direct neighbor, not a distant node.
   The grammar does not need a separate negation operator.
   Pop reading a NEGATION atom has ~b immediately available in N(b).
   Contradiction = 1-hop traversal.  Affirmation = stay at b.

   SURFACE-FORM / BIT-AXIS CORRESPONDENCE (§72-B refinement)
   ──────────────────────────────────────────────────────────────────────────────
   A k-word surface form selects k bit-axes of Q_n.
   The induced subgraph on those k axes is a k-dimensional sub-hypercube.
   In FQ_n it also includes fold edges crossing that sub-cube.
   2-word surface → 2-dimensional slice → broad neighborhood.
   1-word surface → 1-dimensional slice → includes fold edge if the word is
                     the antipodal anchor of the entry.

   §72-C Laws:
   Fold Edge Law:      b ↔ ~b is the antipodal edge; the fold; the Xul→Pop arc.
   Neighborhood Law:   N(b) = single-bit-flip neighbors ∪ { ~b }.  |N(b)| = n+1.
   Diameter Law:       diam(FQ_n) = ⌈n/2⌉.  Contradiction costs 1 hop.
   Negation Law:       ~b ∈ N(b).  Negation is structural, not semantic.
   Sub-Cube Law:       k-word surface selects a k-dimensional sub-hypercube of FQ_n.
                       Arity of surface = dimensionality of the activation sub-cube.
   Degree Law:         product_degree(n) = n+2 (Q_n □ C_6).
                       folded_product_degree(n) = n+3 (FQ_n □ C_6).
                       These are DISTINCT — do not conflate the plain and folded cases. *)


(* ══════════════════════════════════════════════════════════════════════════════
   §72-D  DIFFERENTIAL ACTIVATION FIELD OVER FQ_n × C_6
   ──────────────────────────────────────────────────────────────────────────────
   The surface declarations in @transpile collectively define a discrete
   differential field over the full K'UHUL topology FQ_n × C_6.

   ACTIVATION FIELD
   ──────────────────────────────────────────────────────────────────────────────
   f : FQ_n × C_6 → Z≥0
   f(b, θ) = number of surface sub-cubes (from all @transpile declarations)
             whose activation region contains (b, θ).

   Each k-word surface activates a k-dimensional sub-hypercube of FQ_n
   at phase θ declared in @transpile.
   The union of all these sub-cubes defines the field.

   GRADIENT = RETRIEVAL PRESSURE
   ──────────────────────────────────────────────────────────────────────────────
   On each edge (b, b') in FQ_n:
     δf(b, b') = f(b') − f(b)   (discrete coboundary / edge gradient)

   ∇f at b points toward the neighboring node with largest positive δf —
   toward the densest reachable region.

   WCR-Field Connection:
     C (coverage) in WCR scoring  =  f(b, θ) — the activation field density.
     Yax admission  =  selection in the direction of ∇f.
     WCR navigation is gradient ascent on the differential field.

   FOLD EDGE GRADIENT
   ──────────────────────────────────────────────────────────────────────────────
   The fold edge (b, ~b) carries:
     δf(b, ~b) = f(~b) − f(b)

   If a concept is densely covered but its negation is sparse:
     δf(b, ~b) < 0  (strong negative gradient across the fold)
   This is the semantic asymmetry between concept and complement —
   measurable in the field, not declared in the grammar.

   C_6 PHASE GRADIENT
   ──────────────────────────────────────────────────────────────────────────────
   f(b, θ_Yax) may differ from f(b, θ_Xul) for the same b.
   A concept frequently retrieved during relevance selection but rarely at commit
   has high f(b, θ_Yax) and low f(b, θ_Xul).
   The reasoning ladder traverses the C_6 gradient by construction (Pop→Wo→...→Xul).
   WCR navigates the FQ_n gradient by selection.
   They are orthogonal components of the same field gradient.

   FIELD GAPS = TOPOLOGICAL VOIDS
   ──────────────────────────────────────────────────────────────────────────────
   Nodes with f(b, θ) = 0 are unreachable by direct query.
   They exist in the grammar (have declared b addresses) but no surface covers them.
   Accessible only via:
     (a) fold edge from ~b  (negation / contradiction path)
     (b) C_6 arc from adjacent phase  (reasoning step path)
   These are concepts you can reason TO but never ASK ABOUT directly.

   LAPLACIAN = DISTORTION MEASURE
   ──────────────────────────────────────────────────────────────────────────────
   Δf(b) = Σ_{b' ∈ N(b)} (f(b') − f(b))  =  (n+1)·f(b) − Σ_{b'∈N(b)} f(b')

   Δf(b) = 0 everywhere → uniform field → no retrieval bias.
   Δf(b) ≠ 0 → differential pressure → attractor regions (sources) and voids (sinks).

   A heavily concentrated §-section (many surfaces in one semantic cluster)
   creates a high-Δf attractor. Retrieval benchmarks find voids at f(b,θ) = 0 nodes.
   Mapping benchmark misses to b-addresses locates the field voids.

   §72-D Laws:
   Activation Field Law:  f(b,θ) = count of surface sub-cubes containing (b,θ).
                          Defined over FQ_n × C_6.
   Gradient Law:          δf(b,b') = f(b')−f(b).  WCR ascends ∇f.
   WCR-Field Law:         C in WCR scoring = f(b,θ).  Yax = gradient selection.
   Fold Gradient Law:     δf(b,~b) measures semantic asymmetry of concept vs complement.
   Gap Law:               f(b,θ)=0 → unreachable by query; only fold or C_6 arc reaches it.
   Laplacian Law:         Δf ≠ 0 → differential pressure; attractor/void structure.
                          Benchmark misses map to field voids. *)


(* ══════════════════════════════════════════════════════════════════════════════
   §72-E  FOLDED CUBE GRAPH — EXTENDED STRUCTURAL PROPERTIES
   ──────────────────────────────────────────────────────────────────────────────
   This section records graph-theoretic facts about FQ_n.

   NOTATION BRIDGE
   ──────────────────────────────────────────────────────────────────────────────
   Standard graph theory uses k as the degree: a dimension-k folded cube FQ_k
   has 2^(k-1) vertices and degree k.  K'UHUL uses n as the hypercube dimension.
   Translation: k = n+1.  Equivalences:
     Wikipedia "dimension-k folded cube" = K'UHUL "FQ_n" with n = k−1.
     Vertices: 2^(k-1) = 2^n.
     Degree:   k = n+1.
     Diameter: ⌈(k-1)/2⌉ = ⌈n/2⌉.

   REGULARITY (Law)
   ──────────────────────────────────────────────────────────────────────────────
   FQ_n is (n+1)-regular: every vertex has exactly n+1 neighbors (n Hamming-1
   neighbors + 1 antipodal fold neighbor).  Total edges: (n+1)·2^n / 2.

   CHROMATIC NUMBER — PARITY LAW (Law)
   ──────────────────────────────────────────────────────────────────────────────
   n odd  (k = n+1 even):   χ(FQ_n) = 2   — FQ_n is BIPARTITE.
                             Equal bipartition: each side has 2^(n-1) vertices.
   n even (k = n+1 odd):    χ(FQ_n) = 4   — triangle-free, not 3-colorable.
                             The minimum chromatic number requires 4 colors.

   Note: Q_n (hypercube) is always bipartite (χ = 2).  Adding the antipodal fold
   edge b↔~b creates an odd cycle when k is odd (n is even), breaking bipartiteness.

   ODD GIRTH AND GENERALIZED ODD GRAPHS (Law)
   ──────────────────────────────────────────────────────────────────────────────
   When n is even (k = n+1 is odd):
     Odd girth of FQ_n = k = n+1.
     FQ_n is triangle-free for n ≥ 2 (odd girth ≥ 3; in fact ≥ k > 3 for n ≥ 4).
     Diameter = (k-1)/2 = n/2.
     FQ_n is DISTANCE-REGULAR and belongs to the class of GENERALIZED ODD GRAPHS:
       odd girth = 2·diameter + 1  (since n/2 = (n+1-1)/2 and girth = n+1).
     This places FQ_n in a well-studied family with arbitrarily large odd girth.

   BIPARTITE DOUBLE COVER (Law)
   ──────────────────────────────────────────────────────────────────────────────
   n even (k odd, FQ_n not bipartite):
     The bipartite double cover of FQ_n is Q_{n+1} (the hypercube of dimension n+1).
     Equivalently: Q_{n+1} → FQ_n is a 2-sheeted covering map.
     "Unfolding" FQ_n by lifting across this cover recovers Q_{n+1}.

   n odd (k even, FQ_n already bipartite):
     Q_{n+1} is still a double cover of FQ_n, but it is not the BIPARTITE double
     cover (FQ_n is already bipartite, so the bipartite double cover is different).

   HAMILTONIAN CYCLE (Law)
   ──────────────────────────────────────────────────────────────────────────────
   FQ_n contains a Hamiltonian cycle: a cyclic path visiting every vertex exactly
   once.  Inherited from the Q_n subgraph (hypercubes have Hamiltonian cycles) and
   preserved after adding the antipodal matching.

   DISTANCE-TRANSITIVE (Law)
   ──────────────────────────────────────────────────────────────────────────────
   FQ_n is distance-transitive: for any two pairs of vertices (u,v) and (u',v')
   with d(u,v) = d(u',v'), there exists an automorphism mapping u→u' and v→v'.
   Inherited from the covering hypercube Q_{n+1}.
   Consequence (Law): every vertex is geometrically equivalent at each distance.
   No vertex in FQ_n is geometrically privileged over another.

   COMPLETE BINARY TREE SUBGRAPH (Law)
   ──────────────────────────────────────────────────────────────────────────────
   n even (k = n+1 odd):
     FQ_n contains a complete binary tree with 2^n − 1 vertices as a subgraph.
     (Equivalently: a full binary tree of depth n-1.)
     The binary tree's 2:1 branching ratio is compatible with FQ_n's odd-k structure.

   n odd (k = n+1 even, FQ_n bipartite):
     FQ_n CANNOT contain a complete binary tree as a subgraph.
     Reason: FQ_n has an equal bipartition (2^(n-1) vertices per side), but a
     complete binary tree has a 2:1 ratio between its two bipartition classes.
     Structural incompatibility; the embedding does not exist.

   K'UHUL OBSERVATIONS (Conjecture — not proven bijections)
   ──────────────────────────────────────────────────────────────────────────────
   OBSERVATION 1 (Bipartite parity):
     When n is odd, FQ_n is bipartite.  The AC recognition pipeline produces pairs
     (surface_form, canonical_key).  Whether this pairwise structure aligns with the
     bipartite partition of FQ_n is NOT established.  Candidate for future proof.

   OBSERVATION 2 (AC failure tree ↔ CBT subgraph):
     When n is even, FQ_n contains a CBT with 2^n − 1 nodes.
     The AC automaton failure function defines a tree over the trie states — a rooted
     tree on the AC pattern set.  The number of AC patterns in the current corpus
     is of order 2^n for some n.  Whether the failure tree can be embedded as the
     CBT subgraph of FQ_n is NOT established.  A bijection would need both a mapping
     from AC trie states to FQ_n vertices and a proof that failure links = tree edges
     in the subgraph.  Candidate for future proof.

   OBSERVATION 3 (Hamiltonian traversal):
     Existence of a Hamiltonian cycle means one could enumerate every concept node
     exactly once.  Whether any practical K'UHUL operation (full field scan, batch
     Cata) uses this structure is NOT established.

   OBSERVATION 4 (Distance-transitive = uniform field geometry):
     No concept node is geometrically privileged in FQ_n.  All retrieval bias
     (attractors/voids, §72-D) arises entirely from f(b,θ) (surface coverage density)
     — not from any intrinsic topological asymmetry of FQ_n itself.
     This is a structural corroboration of the Laplacian Law: Δf = 0 means
     uniform coverage; nonzero Δf is purely a function of surface declarations.

   §72-E Laws:
   Regularity Law:         FQ_n is (n+1)-regular; (n+1)·2^n / 2 edges.
   Chromatic Parity Law:   n odd → χ = 2 (bipartite); n even → χ = 4 (triangle-free).
   Odd Girth Law:          n even → odd girth = n+1; FQ_n is a generalized odd graph.
   Bipartite Cover Law:    n even → bipartite double cover of FQ_n = Q_{n+1}.
   Hamiltonian Law:        FQ_n has a Hamiltonian cycle (full traversal exists).
   Distance-Transitive Law: FQ_n is distance-transitive; no vertex is privileged.
   Binary Tree Law:        n even → contains CBT(2^n − 1); n odd → CBT impossible.

   Notation bridge: standard dimension-k ↔ K'UHUL FQ_n with k = n+1. *)


(* ══════════════════════════════════════════════════════════════════════════════
   §72-F  COMPILATION PIPELINE LAW — KEY GRAMMAR TO EXECUTABLE ROUTE
   ──────────────────────────────────────────────────────────────────────────────
   The key grammar is the ADDRESS LAYER, not the answer itself.
   It compiles through successive representations:

   surface form
     →  token stream
     →  n-gram keys  (canonical addresses; §71)
     →  AST / bytecode nodes  (executable syntax; API boundary)
     →  binary composition tree  (local phrase structure; A → B C)
     →  semantic node-field subgraph  (neighborhood graph; §69 NodeFieldGraph)
     →  FQ_n × C_6 differential field  (routing pressure; §72-D)
     →  WCR/Yax route selection  (gradient ascent; §72-D)
     →  Sek execution  (deltaB proposal; §72)
     →  Ch'en verification  (authorization check; §72)
     →  Xul commit or hold  (state transition; §72)

   THE FIVE REPRESENTATIONS (Law)
   ──────────────────────────────────────────────────────────────────────────────
   Keys address.   — n-gram keys are addresses into concept space (b, θ, g).
   ASTs execute.   — bytecode/API nodes carry executable syntax.
   Trees compose.  — binary trees encode local pairwise composition (A → B C).
   Graphs relate.  — node-field subgraphs encode semantic neighborhood.
   Fields route.   — FQ_n × C_6 differential field encodes global routing pressure.

   BINARY TREE COMPOSITION (Law)
   ──────────────────────────────────────────────────────────────────────────────
   A binary tree encodes the same 2-to-1 folding structure as K'UHUL surfaces:
     "bank" + "account"  →  "bank_account"      (2 children → 1 parent concept)
     "bank_account" + "open"  →  "open_bank_account"

   In grammar notation: A → B C.  Each composition step is one fold.
   This is pairwise and GPU-tractable — the same 2D structure exploited by:
     attention (token×token score matrix),
     chart parsing ((i,k)+(k,j)→(i,j) CYK split),
     graph adjacency (M_ij = 1 iff i connects j).

   ML preferentially uses 2D (pairwise) structures because:
     (a) expressiveness — pairwise composition can build arbitrary trees,
     (b) tractability — O(n²) is GPU-parallelizable,
     (c) composability — pairwise steps chain into arbitrary-depth trees.

   RELATIONSHIP TO FQ_n (Observation — not proven bijection)
   ──────────────────────────────────────────────────────────────────────────────
   When n is even, FQ_n contains a CBT with 2^n − 1 nodes (§72-E Binary Tree Law).
   The binary composition tree for a concept with 2^n surface leaves CAN be embedded
   in FQ_n as a subgraph — but whether the grammar's actual composition trees match
   the FQ_n CBT embedding is NOT established.  Candidate for future proof.

   §72-F Laws:
   Compilation Pipeline:   surface → tokens → keys → AST → tree → subgraph → field → route.
   Five Representations:   address / execute / compose / relate / route.
   Pairwise Composition:   A → B C; 2-to-1 fold; GPU-tractable; 2D structure.
   Field Routing:          FQ_n × C_6 is the routing layer; Sek/Ch'en execute the route. *)


(* ══════════════════════════════════════════════════════════════════════════════
   §73  ATTRIBUTED LEXICAL GROUNDING — the cue→atom table, machine-declared
   ──────────────────────────────────────────────────────────────────────────────
   §24 (xcfe_node_class) declares the atom taxonomy and the atom→rung routing.
   §72 (@LEX ROUTING LAW) declares that the ladder's entry point is lexical.
   This section is the grounded lexical table itself: which surface cues
   ground which node class, and which morphemes derive groundable variants.

   The table lives in the grammar, not beside it. tools/semantic_grammar.py
   compiles this block TOGETHER WITH the §24/§25/§26 closed-set productions
   (read directly by the compiler — the routing is declared once, in §24)
   into data/grammar/kuhul.semantic-grammar.json. The runtime mirror is
   src/kuhul/semantic_grammar.cpp (core table); KHANARY_SEMANTIC_TEST pins
   the mirror to the emitted artifact.

   Consumers:
     - src/io/code_parser.cpp  semantic_atom_from_cue / morpheme_cues_for_token
       (grounding lane — delegates to the core mirror)
     - src/kuhul/kuhul_vm.cpp  exec_sek (SC-13 glyph admission, fail-closed)

   Authority note: a @cue grounds WHICH atom a surface form addresses. It does
   not authorize: grounded atoms enter at their rung (§24) and any proposal
   they carry is checked at Ch'en (SC-24) before Xul could commit it.
   STRUCTURE deliberately has no cue row: its operators (BOUNDARY, RELATION)
   ground by parse position, not by lexical surface.
   ================================================================ *)

@cue CONDITION    if, when, condition, unless
@cue CONSEQUENCE  then, result, consequence, therefore
@cue CAUSAL       because, cause, reason
@cue VERIFICATION verify, verification, check, confirm, validate, prove, evidence, support, supported
@cue NEGATION     not, no, never, without, absence, prefix:un, prefix:non, prefix:dis, prefix:in, prefix:im, prefix:ir, prefix:il
@cue CAPABILITY   ability, capability, suffix:able, suffix:ible
@cue SELECTION    choose, select, selection, filter, rank, relevance, candidate
@cue EXECUTION    execute, execution, run, dispatch, call
@cue COMMIT       commit, archive, persist, store, finalize
@cue ROUTING      route, routing, router, delegate
@cue MEMORY       memory, recall, history
@cue KUHUL_RUNTIME kuhul, k'uhul, fold, phase, runtime, pop, wo, yax, sek, ch'en, xul

(* Morpheme rules: surface forms ground atom-bearing pseudo-cues derived from
   token morphology. min_stem = minimum stem length after stripping the affix
   (prefixes require a stem of at least 3 chars, suffixes at least 2 — the
   historical grounding-lane guards). The emitted pseudo-cue must exist in
   the @cue table above. *)
@morpheme prefix un   NEGATION   min_stem=3
@morpheme prefix non  NEGATION   min_stem=3
@morpheme prefix dis  NEGATION   min_stem=3
@morpheme prefix in   NEGATION   min_stem=3
@morpheme prefix im   NEGATION   min_stem=3
@morpheme prefix ir   NEGATION   min_stem=3
@morpheme prefix il   NEGATION   min_stem=3
@morpheme suffix able CAPABILITY min_stem=2
@morpheme suffix ible CAPABILITY min_stem=2
