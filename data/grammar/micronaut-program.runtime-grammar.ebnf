(* KHANARY Micronaut Program Runtime Grammar *)
micronaut_program      = program_header topology_section runtime_section authority_boundary_section registry_section edge_section learning_section domain_field_section ;
program_header         = "micronaut_program" string "version" version_string ;
topology_section       = "topology" "{" "space" ":" product_space "," "semantic_coordinates" ":" "bitvector" "," "phase_wheel" ":" phase_list "}" ;
product_space          = "Qn□C6" | "QnxC6" ;
runtime_section        = "runtime" "{" runtime_law stage_list "}" ;
runtime_law            = "law" ":" "Cata_phi(WCR(Match(Ana_psiQ(B))))" ;
stage_list             = "stages" ":" "[" ana_stage "," match_stage "," wcr_stage "," cata_stage "," continue_stage "," learn_stage "]" ;
ana_stage              = "Ana" ":" "expand_candidate_micronauts" ;
match_stage            = "Match" ":" "bind_query_to_patterns" ;
wcr_stage              = "WCR" ":" "rank_candidate_micronauts" ;
cata_stage             = "Cata" ":" "select_execution_set" ;
continue_stage         = "Continue" ":" "invoke_callable_edges" ;
learn_stage            = "Learn" ":" "distill_patterns_templates_routes" ;
registry_section       = "registry" "{" { micronaut_continuation } "}" ;
micronaut_continuation = micronaut_key track_ref pattern_set guard_set continuation_set semantic_edge_set callable_edge_set wcr_block route_contract_guard ;
micronaut_key          = "µ://" identifier ;
track_ref              = "track" ":" string ;
pattern_set            = "patterns" ":" string_list ;
guard_set              = "guards" ":" string_list ;
continuation_set       = "continuations" ":" string_list ;
semantic_edge_set      = "semantic_edges" ":" string_list ;
callable_edge_set      = "callable_edges" ":" micronaut_key_list ;
wcr_block              = "wcr" "{" "weight" ":" bounded_number "," "confidence" ":" bounded_number "}" ;
route_contract_guard   = "route_contract_required" ":" true_lit ;
edge_section           = "edges" "{" { semantic_edge | callable_edge } "}" ;
semantic_edge          = "semantic" source_ref relation_ref target_ref edge_weight ;
callable_edge          = "callable" micronaut_key "invokes" micronaut_key route_contract_guard phase_ref ;
relation_ref           = "rel" ":" identifier ;
source_ref             = "from" ":" string ;
target_ref             = "to" ":" string ;
edge_weight            = "weight" ":" bounded_number ;
phase_ref              = "phase" ":" phase ;
learning_section       = "learning" "{" promotion_threshold wildcard_retention fixed_point_iterations promotion_requires_xul source_integrity law_chain "}" ;
promotion_threshold    = "promotionThreshold" ":" bounded_number ;
wildcard_retention     = "wildcardRetention" ":" true_lit ;
fixed_point_iterations = "fixedPointIterations" ":" nonnegative_number ;
promotion_requires_xul = "promotion_requires_xul" ":" true_lit ;
source_integrity       = "source_integrity" "{" "conversation_logs_must_be_saved" ":" true_lit "," "do_not_truncate_chats" ":" true_lit "}" ;
law_chain              = "law" ":" "evidence -> patterns -> templates -> routes -> micronaut" ;
domain_field_section   = "domainFields" "{" { domain_field } "}" ;
domain_field           = "domain" identifier "{" "status" ":" domain_status pattern_set template_set route_set [ promotion_candidate ] "}" ;
domain_status          = "latent" | "emerging" | "dominant" ;
template_set           = "templates" ":" string_list ;
route_set              = "routes" ":" micronaut_key_list ;
promotion_candidate    = "promotion_candidate" ":" micronaut_key ;
micronaut_key_list     = "[" [ micronaut_key { "," micronaut_key } ] "]" ;
(* Semantic relation edges never imply invocation. Callable edges require explicit route contracts and cannot bypass Ch'en verification or Xul commit. *)
