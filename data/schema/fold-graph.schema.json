{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kuhul:khanary:schema:fold-graph:v1",
  "title": "KHANARY Fold Graph and Active Fold Graph",
  "description": "Schema-backed runtime record for the persistent Fold Graph G_F(h) and the query-conditioned Active Fold Graph G_F^Q(h). Unfold reveals only represented relationships; the active graph is masked and ephemeral; neither carries semantic authority; only a verified, XCFE-authorized Xul delta persists topology (GAP-093).",
  "$ref": "#/$defs/FoldGraph",
  "$defs": {
    "Edge": {
      "type": "object",
      "required": [
        "@id",
        "@typed",
        "@from",
        "@to",
        "@relation",
        "@orientation"
      ],
      "properties": {
        "@id": {
          "type": "string",
          "minLength": 1
        },
        "@typed": {
          "type": "boolean",
          "const": true
        },
        "@from": {
          "type": "string",
          "minLength": 1
        },
        "@to": {
          "type": "string",
          "minLength": 1
        },
        "@relation": {
          "type": "string",
          "minLength": 2
        },
        "@orientation": {
          "type": "string",
          "enum": [
            "forward",
            "reverse",
            "bidirectional",
            "blocked"
          ]
        }
      },
      "additionalProperties": false
    },
    "Weight": {
      "type": "object",
      "required": [
        "@id",
        "@strength"
      ],
      "properties": {
        "@id": {
          "type": "string",
          "minLength": 1
        },
        "@strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "Incidence": {
      "type": "object",
      "required": [
        "@handle",
        "@edge",
        "@strength"
      ],
      "properties": {
        "@handle": {
          "type": "string",
          "minLength": 1
        },
        "@edge": {
          "type": "string",
          "minLength": 1
        },
        "@strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "FoldGraph": {
      "type": "object",
      "required": [
        "@type",
        "@handle",
        "@tau",
        "@nodes",
        "@edges",
        "@weights",
        "@incidence_matrix",
        "@topology_hash",
        "@semantic_authority"
      ],
      "properties": {
        "@type": {
          "type": "string",
          "const": "khanary.fold_graph.v1"
        },
        "@handle": {
          "type": "string",
          "minLength": 1
        },
        "@tau": {
          "type": "string",
          "minLength": 1
        },
        "@nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "@edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Edge"
          }
        },
        "@weights": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Weight"
          }
        },
        "@incidence_matrix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Incidence"
          }
        },
        "@topology_hash": {
          "type": "string",
          "minLength": 8
        },
        "@semantic_authority": {
          "type": "boolean",
          "const": false
        }
      },
      "additionalProperties": false
    }
  }
}
