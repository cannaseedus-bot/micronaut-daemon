{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kuhul:khanary:schema:executor-result:v1",
  "title": "KHANARY executor result envelope",
  "description": "The result half of E_theta. It always echoes the request identity and phase, names the one binding that answered (or a typed refusal status), carries the contract evidence and never asserts authority. A commit is never granted by an executor (GAP-091 laws E6-E7).",
  "$ref": "#/$defs/ExecutorResult",
  "$defs": {
    "Authority": {
      "type": "object",
      "required": ["semantic_authority", "commit_authorized", "fact_commit", "gated_by"],
      "properties": {
        "semantic_authority": { "type": "boolean", "const": false },
        "commit_authorized": { "type": "boolean", "const": false },
        "fact_commit": { "type": "string", "const": "denied" },
        "gated_by": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "Evidence": {
      "type": "object",
      "required": ["request_hash", "contract"],
      "properties": {
        "request_hash": { "type": "string", "minLength": 8 },
        "contract": {
          "type": "object",
          "properties": {
            "pre": { "type": "string" },
            "post": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "ExecutorResult": {
      "type": "object",
      "required": [
        "@kind",
        "correlation_id",
        "phase",
        "fold",
        "status",
        "binding_backend",
        "binding_entry",
        "used_fallback",
        "detail",
        "evidence",
        "authority"
      ],
      "properties": {
        "@kind": { "type": "string", "const": "khanary.executor.result.v1" },
        "correlation_id": { "type": "string", "minLength": 5 },
        "phase": {
          "type": "string",
          "enum": ["Pop", "Wo", "Yax", "Sek", "Ch'en", "Ch_en", "Xul"]
        },
        "fold": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "request_invalid",
            "no_binding",
            "MISS_capability",
            "model_cannot_verify",
            "track_does_not_realize",
            "envelope_contradiction"
          ]
        },
        "binding_backend": { "type": "string" },
        "binding_entry": { "type": "string" },
        "used_fallback": { "type": "boolean" },
        "detail": { "type": "string" },
        "evidence": { "$ref": "#/$defs/Evidence" },
        "authority": { "$ref": "#/$defs/Authority" }
      },
      "additionalProperties": true
    }
  }
}
