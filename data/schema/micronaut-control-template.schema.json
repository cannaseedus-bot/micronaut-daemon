{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kuhul:micronaut-control-template:v1",
  "title": "K'UHUL phase-gated wildcard command templates",
  "type": "object",
  "required": [
    "@kind", "@no-eval", "@version", "phase_order", "capture_contract",
    "gate_contract", "direction_store", "tracks", "templates"
  ],
  "properties": {
    "@kind": { "const": "semantic.micronaut-control-templates.v1" },
    "@no-eval": { "const": true },
    "@version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "phase_order": {
      "const": ["Pop", "Wo", "Yax", "Sek", "Ch'en", "Xul"]
    },
    "capture_contract": {
      "type": "object",
      "required": ["wildcard", "typed"],
      "properties": {
        "wildcard": {
          "type": "object",
          "required": [
            "proposes", "authorizes", "on_unresolved", "on_multiple_resolved",
            "on_no_match", "on_resolved", "binding_types", "binding_requires"
          ],
          "properties": {
            "proposes": { "const": "capture_binding" },
            "authorizes": { "const": false },
            "on_unresolved": { "const": "defer" },
            "on_multiple_resolved": { "const": "reject" },
            "on_no_match": { "const": "reject" },
            "on_resolved": { "const": "bind" },
            "binding_types": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/capture_type" },
              "uniqueItems": true
            },
            "binding_requires": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "typed": {
          "type": "object",
          "required": ["entity", "program", "question"],
          "properties": {
            "entity": { "$ref": "#/$defs/resolver" },
            "program": { "$ref": "#/$defs/resolver" },
            "question": { "$ref": "#/$defs/resolver" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "gate_contract": {
      "type": "object",
      "required": ["hard_gate", "direction_gate", "delta_learning", "laws"],
      "properties": {
        "hard_gate": { "const": "current_phase in template.phases" },
        "direction_gate": { "const": "DirectionStore.query_at_phase(capabilities,current_phase,min_score)" },
        "delta_learning": { "const": "GOOD FoldDelta.phase_position -> FoldDirection.phase_key" },
        "laws": {
          "type": "array",
          "minItems": 4,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "direction_store": {
      "type": "object",
      "required": ["mode", "min_score_default", "capability_source", "phase_keyed"],
      "properties": {
        "mode": { "const": "rank_if_verified" },
        "min_score_default": { "type": "number", "minimum": 0, "maximum": 1 },
        "capability_source": { "type": "string", "minLength": 1 },
        "phase_keyed": { "const": true },
        "note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "tracks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z0-9-]+-[µu]$" },
      "additionalProperties": { "$ref": "#/$defs/track" }
    },
    "templates": {
      "type": "array",
      "minItems": 12,
      "items": { "$ref": "#/$defs/template" }
    }
  },
  "$defs": {
    "phase": {
      "enum": ["Pop", "Wo", "Yax", "Sek", "Ch'en", "Xul"]
    },
    "capture_type": {
      "enum": ["text", "entity", "relation", "property", "question", "program"]
    },
    "effect": {
      "enum": [
        "read_only", "invoke_candidate", "file_read", "file_write", "file_patch",
        "program_dispatch", "code_compile", "registered_call", "web_retrieval"
      ]
    },
    "resolver": {
      "type": "object",
      "required": ["resolve_against", "allow_wildcard_subpath"],
      "properties": {
        "resolve_against": { "type": "string", "minLength": 1 },
        "allow_wildcard_subpath": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "direction_gate": {
      "type": "object",
      "required": ["mode", "capabilities", "min_score"],
      "properties": {
        "mode": { "const": "rank_if_verified" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "min_score": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "track": {
      "type": "object",
      "required": ["default_phase_floor", "effects"],
      "properties": {
        "default_phase_floor": { "$ref": "#/$defs/phase" },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/effect" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "capture": {
      "type": "object",
      "required": ["index", "name", "type", "on_unresolved"],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/capture_type" },
        "on_unresolved": { "const": "defer" },
        "on_resolved": { "const": "bind" }
      },
      "additionalProperties": false
    },
    "template": {
      "type": "object",
      "required": [
        "id", "intent", "verb", "patterns", "captures", "phases",
        "phase_floor", "track", "render", "admission", "effect"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^tool\\.[a-z_]+$" },
        "intent": { "type": "string", "pattern": "^intent:tool_" },
        "verb": { "enum": ["GET", "POST", "READ", "WRITE", "PATCH", "LIST", "INSPECT", "RUN", "COMPILE", "CALL", "HEALTH", "SEARCH"] },
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "captures": {
          "type": "array",
          "items": { "$ref": "#/$defs/capture" }
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/phase" },
          "uniqueItems": true
        },
        "phase_floor": { "$ref": "#/$defs/phase" },
        "track": { "type": "string", "minLength": 1 },
        "render": { "type": "string", "minLength": 1 },
        "admission": { "$ref": "#/$defs/direction_gate" },
        "effect": { "$ref": "#/$defs/effect" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
