{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cfpc-task.schema.json",
  "title": "CfpcTaskContract",
  "description": "K'UHUL declarative task contract. @kind must be khanary.task.v1. Pattern Induction Guard: promote_generated_facts MUST be false under @policy — any other value is a schema violation.",
  "type": "object",
  "required": ["@kind", "id", "intent", "@query", "@micronauts", "@policy", "@result"],
  "additionalProperties": false,
  "properties": {
    "@kind": {
      "type": "string",
      "const": "khanary.task.v1"
    },
    "id": {
      "type": "string",
      "description": "Unique task identifier used for cycle detection and result attribution.",
      "pattern": "^[A-Za-z0-9_-]+"
    },
    "intent": {
      "type": "string",
      "enum": ["define", "explain", "verify", "resolve", "generate"]
    },
    "capability": {
      "type": "string",
      "description": "Task-level capability declaration (metadata; does not override per-micronaut routing)."
    },
    "@query": {
      "type": "object",
      "required": ["pattern"],
      "additionalProperties": false,
      "properties": {
        "pattern": { "type": "string" },
        "captures": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "context": { "type": "string" }
      }
    },
    "@micronauts": {
      "type": "array",
      "minItems": 1,
      "description": "Capability entries — one invocation is dispatched per entry. Order is preserved in findings.",
      "items": {
        "type": "object",
        "required": ["selector", "capability"],
        "additionalProperties": false,
        "properties": {
          "selector": {
            "type": "string",
            "description": "Dispatch mechanism (e.g. dispatch_blend)."
          },
          "capability": {
            "type": "string",
            "description": "Required capability label used as the gap_capability_map target for all gap types."
          }
        }
      }
    },
    "@policy": {
      "type": "object",
      "required": ["max_depth", "cycle_detection", "promote_generated_facts"],
      "additionalProperties": false,
      "properties": {
        "max_depth": { "type": "integer", "minimum": 0 },
        "cycle_detection": { "type": "boolean" },
        "promote_generated_facts": {
          "const": false,
          "description": "Pattern Induction Guard — MUST be false. This is a grammar-level invariant, not a runtime policy. No parser may accept true."
        }
      }
    },
    "@result": {
      "type": "object",
      "required": ["retain_provenance", "retain_gaps", "allow_pattern_candidates"],
      "additionalProperties": false,
      "properties": {
        "retain_provenance":        { "type": "boolean" },
        "retain_gaps":              { "type": "boolean" },
        "allow_pattern_candidates": { "type": "boolean" }
      }
    }
  }
}
