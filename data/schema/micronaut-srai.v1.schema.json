{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kuhul.dev/schemas/micronaut-srai.v1.json",
  "title": "micronaut-srai.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "nodes", "containment", "data_flow", "execution_dependencies"],
  "properties": {
    "schema": { "const": "micronaut-srai.v1" },

    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "params"],
        "properties": {
          "id":   { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "kind": {
            "enum": ["SRAI", "ROUTE", "CAPABILITY", "FALLBACK", "BINDING"]
          },
          "params": { "type": "object" }
        }
      }
    },

    "containment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parent_id", "child_id", "role"],
        "properties": {
          "parent_id": { "type": "string" },
          "child_id":  { "type": "string" },
          "role": {
            "enum": ["owns", "owns_fallback", "owns_binding", "owns_route"]
          }
        }
      }
    },

    "data_flow": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "output_port", "target_id", "input_port"],
        "properties": {
          "source_id":   { "type": "string" },
          "output_port": {
            "enum": ["out", "resolved_input", "fallback_out", "binding_out"]
          },
          "target_id":   { "type": "string" },
          "input_port":  {
            "enum": ["in", "input", "fallback_in", "binding_in"]
          }
        }
      }
    },

    "execution_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["before_id", "after_id"],
        "properties": {
          "before_id": { "type": "string" },
          "after_id":  { "type": "string" }
        }
      }
    }
  }
}
