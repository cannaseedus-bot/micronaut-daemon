{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cfpc-intent-resolver.schema.json",
  "title": "CFPC Intent Resolver Contract",
  "description": "Contract for a cfpc.intent_resolver pass. Declares intent vocabulary, Q factories gated on scored intent candidates, gap expansion policy, and WCR selection scope.",
  "type": "object",
  "required": ["@kind", "id"],
  "additionalProperties": false,
  "properties": {
    "@kind": {
      "type": "string",
      "const": "cfpc.intent_resolver"
    },
    "id": {
      "type": "string"
    },
    "@candidates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "allow_multiple": { "type": "boolean" },
        "intents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "keywords"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "keywords": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              }
            }
          }
        }
      }
    },
    "@q_factory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intent_templates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["intent", "pattern"],
            "additionalProperties": false,
            "properties": {
              "intent": { "type": "string" },
              "pattern": { "type": "string" }
            }
          }
        }
      }
    },
    "@gap_expansion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_depth": { "type": "integer", "minimum": 1 },
        "require_new_information": { "type": "boolean" }
      }
    },
    "@selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string" },
        "scope": { "type": "string" }
      }
    }
  }
}
