{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asx://schema/micronaut-goal-state-v1",
  "title": "MicronautGoalState v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "@kind", "goal_ref", "predicate_ref", "initial_state_ref", "observed_state_ref", "transition_model_ref",
    "allowed_capabilities", "max_plan_steps", "context_scope_ref", "evidence_scope_ref",
    "completion_evidence_refs", "failure_conditions"
  ],
  "properties": {
    "@kind": { "const": "asx.micronaut.goal-state.v1" },
    "goal_ref": { "type": "string", "minLength": 1 },
    "predicate_ref": { "type": "string", "minLength": 1, "description": "Reference to a registered predicate evaluator; never inline code." },
    "initial_state_ref": { "type": "string", "minLength": 1 },
    "observed_state_ref": { "type": "string", "minLength": 1, "description": "Reference to the current state snapshot; refresh after each observation before evaluating or replanning." },
    "transition_model_ref": { "type": "string", "minLength": 1 },
    "allowed_capabilities": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "max_plan_steps": { "type": "integer", "minimum": 1 },
    "context_scope_ref": { "type": "string", "minLength": 1 },
    "evidence_scope_ref": { "type": "string", "minLength": 1 },
    "completion_evidence_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "failure_conditions": {
      "type": "array", "items": { "type": "string", "minLength": 1 }
    }
  }
}
