<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:xcfe="urn:kuhul:xcfe:aiml:1.0"
           elementFormDefault="unqualified">
  <xs:import namespace="urn:kuhul:xcfe:aiml:1.0" schemaLocation="xcfe-aiml.xsd"/>
  <xs:complexType name="MixedTextType" mixed="true">
    <xs:sequence><xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/></xs:sequence>
  </xs:complexType>
  <xs:complexType name="CategoryType">
    <xs:sequence>
      <xs:element name="pattern" type="MixedTextType"/>
      <xs:element name="that" type="MixedTextType" minOccurs="0"/>
      <xs:element name="topic" type="MixedTextType" minOccurs="0"/>
      <xs:element ref="xcfe:fold" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="template" type="MixedTextType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="aiml">
    <xs:complexType>
      <xs:sequence><xs:element name="category" type="CategoryType" minOccurs="1" maxOccurs="unbounded"/></xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
