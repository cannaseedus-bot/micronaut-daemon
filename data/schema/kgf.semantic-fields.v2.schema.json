{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kuhul.dev/schemas/kgf.semantic-fields.v2.schema.json",
  "title": "KGF Semantic Fields v2",
  "description": "Key-to-key field membership and optional typed relation labels. Declarations carry no execution authority.",
  "type": "object",
  "required": ["schema", "fields", "relations"],
  "properties": {
    "schema": { "const": "kgf.semantic-fields/2" },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/glyphKey" },
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/glyphKey" }
      }
    },
    "relations": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/glyphKey" },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "$ref": "#/$defs/glyphKey" },
        "additionalProperties": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "glyphKey": { "type": "string", "pattern": "^⟁[A-Z0-9_]+$" }
  }
}
