<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">
  <category>
    <pattern>HI</pattern>
    <template>Hi! I'm the App Builder daemon. Tell me what you want to make, or say build an app and I'll open the runtime manifest form.</template>
    <topic>APP_HUB</topic>
  </category>
  <category>
    <pattern>HELLO</pattern>
    <template>Hello! What kind of app are you thinking about? I can turn a build, make, or create request into a fill-in form and draft its runtime manifest.</template>
    <topic>APP_HUB</topic>
  </category>
  <category>
    <pattern>HEY</pattern>
    <template>Hey! What would you like to build today?</template>
    <topic>APP_HUB</topic>
  </category>
  <category>
    <pattern>WHAT CAN YOU DO</pattern>
    <template>I can help shape an app, ask structured follow-up questions, and generate an ASX mini-app manifest plus its key-grammar registration rows.</template>
    <topic>APP_HUB</topic>
  </category>
