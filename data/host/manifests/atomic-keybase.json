{
  "@kind": "asx.atomic.keybase.v1",
  "@version": "1.0.0",
  "@authority": "manifest",
  "description": "Callable key database for Atomics.js and host runtime dispatch.",
  "sources": {
    "key_grammar": "data/grammar/asx-mini-app.key-grammar.jsonl",
    "aiml": "data/manifest/aiml.manifest.json",
    "aiml_roots": ["data/alice", "data/host/apps", "data/host/bots"],
    "aiml_fold_deltas": "data/host/storage/aiml-fold-deltas.json",
    "apps": "data/host/apps",
    "micronaut_manifests": "drivers/micronauts/manifests",
    "micronaut_registry": "drivers/micronauts/registry.json",
    "learning_provenance": "data/host/manifests/learning-provenance.json",
    "asxg_lanes": "data/host/manifests/asxg-lanes.json",
    "asxg_lane_schema": "data/host/asxg/extensions/asxg-lane-descriptors.v1.schema.json",
    "asxg_lane_fixtures": "data/host/asxg/lane-descriptor-fixtures.json",
    "templates": "data/templates/registry.json",
    "tables": "data/host/manifests/tables.json",
    "ngram_tables": "data/host/manifests/tables.json#ngram_records",
    "cdata_store": "data/host/storage/cdata-db.json"
  },
  "keys": {
    "key-grammar.parse": { "kind": "grammar", "route": "key-grammar.parse", "executor": "mx.run", "authority": "observation_only" },
    "aiml.index": { "kind": "aiml.registry", "route": "/api/atomic/call", "executor": "inproc.app_host", "authority": "observation_only" },
    "aiml.match": { "kind": "aiml.pattern", "route": "/api/atomic/call", "executor": "inproc.app_host", "authority": "observation_only" },
    "aiml.template": { "kind": "aiml.template", "route": "/api/atomic/call", "executor": "inproc.app_host", "authority": "observation_only" },
    "aiml.fold.record": { "kind": "aiml.fold_delta", "route": "/api/atomic/call", "executor": "inproc.app_host", "operation": "record", "authority": "proposed_learning_only" },
    "aiml.fold.list": { "kind": "aiml.fold_delta", "route": "/api/atomic/call", "executor": "inproc.app_host", "operation": "list", "authority": "observation_only" },
    "app.call": { "kind": "app", "route": "/api/atomic/call", "executor": "inproc.app_host", "authority": "app_host_manifest" },
    "app.cdata-db": { "kind": "app", "app": "cdata-db", "app_key": "⟁APP:CDATA_DB", "route": "/api/atomic/call", "executor": "inproc.app_host", "authority": "app_host_manifest" },
    "cdata.init": { "kind": "database", "app": "cdata-db", "program": "cdata.init", "route": "/api/atomic/call", "executor": "inproc.app_host", "operation": "INIT_STORE", "authority": "app_host_store" },
    "cdata.put": { "kind": "database", "app": "cdata-db", "program": "cdata.put", "route": "/api/atomic/call", "executor": "inproc.app_host", "operation": "PUT", "authority": "app_host_store" },
    "cdata.get_all": { "kind": "database", "app": "cdata-db", "program": "cdata.get_all", "route": "/api/atomic/call", "executor": "inproc.app_host", "operation": "GET_ALL", "authority": "app_host_store" },
    "pipeline.run": { "kind": "pipeline", "route": "micronaut.program", "executor": "mx.run", "authority": "observation_only" },
    "kuhul.execute": { "kind": "kuhul", "route": "kuhul.execute", "executor": "mx.run", "authority": "observation_only" },
    "native.execute": { "kind": "driver", "route": "native.execute", "executor": "inproc.native", "bridge": { "type": "inproc", "binding": "native-exec" }, "authority": "observation_only" },
    "wasm.execute": { "kind": "driver", "route": "wasm.execute", "executor": "inproc.wasm", "bridge": { "type": "inproc", "binding": "wasm-exec" }, "authority": "observation_only" },
    "self.execute": { "kind": "xjson.self_executing", "route": "kuhul.execute", "executor": "mx.run", "program": "data/host/manifests/self-executing-program.json", "authority": "observation_only" },
    "improve.all_systems_recursively": { "kind": "improvement_orchestrator", "route": "kuhul.execute", "executor": "mx.run", "program": "data/host/manifests/improvement-orchestrator.json", "authority": "observation_only" },
    "omnibrain.triple_recursion": { "kind": "omnibrain.compiler", "route": "kuhul.execute", "executor": "mx.run", "program": "data/host/manifests/triple-recursion.json", "authority": "observation_only" },
    "function.optimize": { "kind": "xjson.optimized_function", "route": "kuhul.execute", "executor": "mx.run", "program": "data/host/manifests/recursive-compilation-cycle-0.json", "authority": "observation_only" },
    "omega.execute": { "kind": "execution_law", "route": "kuhul.execute", "executor": "mx.run", "program": "data/host/manifests/omega-execution-law.json", "authority": "governance" },
    "atomic.exec": { "kind": "glyph_lane", "route": "kuhul.execute", "executor": "atomic_exec", "program": "data/host/manifests/atomic-exec-glyph-lane.json", "authority": "frozen" },
    "semantic.admit": { "kind": "semantic_admission", "route": "semantic.admit", "executor": "inproc.app_host", "bridge": { "type": "inproc", "binding": "app-host" }, "program": "data/host/manifests/semantic-admission.json", "authority": "server_validated" },
    "semantic.authorize": { "kind": "semantic_authorization", "route": "semantic.authorize", "executor": "inproc.app_host", "bridge": { "type": "inproc", "binding": "app-host" }, "program": "data/host/manifests/semantic-admission.json", "authority": "local_operator_token" },
    "semantic.dispatch": { "kind": "semantic_dispatch", "route": "semantic.dispatch", "executor": "inproc.app_host", "bridge": { "type": "inproc", "binding": "app-host" }, "program": "data/host/manifests/semantic-admission.json", "authority": "explicit_permission_required", "supported_capabilities": ["khanary.json.inline", "khanary.micronaut.dispatch"] }
  },
  "aliases": {
    "grammar": "key-grammar.parse",
    "aiml": "aiml.match",
    "aiml-index": "aiml.index",
    "app": "app.call",
    "cdata": "app.cdata-db",
    "pipeline": "pipeline.run",
    "kuhul": "kuhul.execute",
    "native": "native.execute",
    "wasm": "wasm.execute"
  }
}
