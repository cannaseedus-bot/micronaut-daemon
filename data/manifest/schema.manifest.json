    "data/schema/episode.contract.json",
    "id:episode.v1",
    "kind:episode_journal_contract",
    "formal:E_t=<O_t,F_Q,Candidates,WCR,Geometry,Admission,Executors,Verdict,Evidence>",
    "selection:M_cooccurrence — co-occurrence mass M_{Y,X}; NOT W_Y (runtime selection weight)",
    "selection:W — static_weight ∈ [0,1]; multiplicative prior",
    "selection:C — epistemic confidence ∈ [0,1]; C←f(Evidence) not f(Usage)",
    "selection:R — relevance ∈ [0,1]; provider-dependent",
    "selection:G — geometry bias; lerp(1,relation_weight*fold_weight*phase_weight,relation_mix)",
    "selection:T — optional tensor-slot bias; tensor_enabled? tensor_mass*tensor_alignment*tensor_health : 1",
    "selection:score — S=W*C*R*G*lerp(1,T,tensor_mix)",
    "selection:legal — capable AND policy_ok AND xcfe_ok",
    "selection:admitted — legal AND score>=0.35",
    "law:generated-episode-not-training-episode",
    "law:multiplicative-score-no-false-relevance — R=0 ⟹ S=0",
    "law:legality-gate-is-not-score — W=C=R=1 ⟹̸ Admit",
    "law:confidence-from-evidence — C←f(Evidence) not f(Usage)",
    "law:cooccurrence-mass-not-selection-weight — M_{Y,X}≠W_Y",
    "law:journal-is-direction-library — GOOD episodes contribute ΔF_i; monotonic; re-project not re-collect",
    "law:fold-delta-not-vec-delta — ΔF≠vec(ΔF); structured delta authoritative; exactly as Fold≠Vector",
    "law:apply-field-not-commit-topology — F_Q+α*ΔF reversible; B+ΔF→B' requires Ch'en/XCFE/Xul",
    "fold_delta:composition — ΔF=⟨ΔM,ΔRelations,ΔW,ΔC⟩; four projections of one displacement",
    "fold_direction:formal — FoldDirection_i=⟨ΔF_i,K_i,W_i,C_i,Evidence_i,Provenance_i⟩",
    "fold_direction:principal_direction — PCA(vec)/Consensus(graph)/BitConsensus(SDR); provider-agnostic",
    "fold_direction:retrieval — S_i=W_i*C_i*R_i; R_i=Similarity(Q,K_i)",
    "direction_library:layers — Journal=evidence; ΔF=transition; DirectionLibrary=knowledge; Projection=retrieval",
    "verdict:GOOD/BAD/UNKNOWN",
    "dataset_projections:cooccurrence/relation/retrieval/WCR/Advisor/LFM/Micronaut/response",
    "reconstruction_law:representations-rebuildable-from-journal-without-recollecting",
    "purpose:episode-journal-contract-training-data-and-direction-library-specification",
