  "schema:fold_runtime": [
    "data/schema/fold.runtime.json",
    "id:fold.runtime.v1",
    "kind:fold_runtime_config",
    "section:fold_adt — default ADT state: phase=Pop, confidence=1.0, static_weight=1.0, health=1.0, active=true",
    "section:phase_algebra — P^6=I; C6 transition matrix; for all phi!=Xul: T_phi(B)=B",
    "section:operator_contracts — Pop=observe, Wo=state_and_constraints, Yax=admit_neighborhood, Sek=compute_over_admitted_structure, Ch'en=assert_and_verify_candidate, Xul=compare_and_commit",
    "section:phase_driver_lock — audit/enforce modes; per-phase driver artifacts (pop.json…xul.json); entry_symbol:khanary_phase_driver_entry_v1",
    "section:phase_driver_contract_profiles — default + unigram profiles; data/drivers/phases/",
    "section:projection_contract — lossless:{GraphML,B_matrix,SCXQ2}; lossy:{SDR,SVG_3D,JSON_Book_view}; rule:projection_is_not_object",
    "section:chen_verification_contract — rewrite_authorized_by_chen:false; MISS=Acquire/Unfold; required_assertion_classes:{STRUCTURAL,SEMANTIC,STATE,AUTHORITY}",
    "section:miss_deficit_contract — MISS(Q)=RequiredContext(Q)-ResolvedContext(F_Q); rho_research=D*R*U; miss_kind_enum includes relation",
    "section:runtime_attention_contract — A(v)=R*U*D*P; admission_threshold:0.35; tie_break:score_desc,D_desc,R_desc,node_id_asc",
    "section:semantic_attention_shader_contract — S=W*C*R; G=lerp(1,relation*fold*phase,relation_mix); T=optional Micronaut tensor-slot modifier; H=optional STBGeodesicRecord sidecar modifier; score=S*G*lerp(1,T,tensor_mix)*lerp(1,H,geodesic_mix); backend:data/shaders/attention.hlsl; embedded:src/gpu/gram_gpu_scorer.cpp; legal_gate:capable&&policy_ok&&xcfe_ok; tensor_slot_and_geodesic_sidecar_are_projection_not_truth; not:transformer-QKV",
    "section:xul_commit_contract — requires:Verified+Authorized+Fresh+certificate_hash_match+topology_hash_match; on_fail:reject_delta_keep_topology",
    "section:semantic_hypernym_fold — SHF(h,tau)=<h,B_tau[h,*],N_tau(h),W_tau,State(h)>; axiom:Fold-is-structure-Phase-is-operation",
    "section:yax_wsd_contract — WSD via admission gate; resolution_states:VERIFIED/AMBIGUOUS/MISS/INSUFFICIENT_CONTEXT/CONTRADICTED/INVALID; rho_research=M*I*U",
    "section:relation_isa_contract — 7 families; 37 canonical relations; fallback_rule:@related_to-does-not-upgrade-typed-miss",
    "section:multi_track_fold_unfold — Omega=(phi,T,s); 3-axes:phase-wheel x fold-unfold x track; max_alternation_depth:6; movement:horizontal/vertical/diagonal",
    "section:isa_extension_contract — base_compiler:L_A, base_isa:GraphPlan; AIML may only emit declared ops",
    "section:semantic_code_parser_graph — grammar-driven fold-native code graph; pipeline:Surface->Grammar->AST->Atoms+RelISA->FoldGraph->KUHUL->Exec",
    "sha256:3313c79c6407b0f8a3d2df1da11e5d75efb35875b246c199611d6f650d1ae0e0",
    "binding:validated-at-load-by-chen-xul-pipeline",
    "schema_stack_links:cycle-hash.spec.json+kuhul.fold-runtime.json+kuhul.xsd+resolver.primitives.json+math-isa.json",
    "law:fold-not-xul — fold/unfold are s-coordinate moves; only Xul mutates B",
    "law:projection-is-not-object — lossless/lossy projections are views, not authoritative copies",
    "law:chen-verifies-not-authorizes — rewrite_authorized_by_chen=false",
    "law:miss-is-not-wrong — MISS = epistemic deficit; resolution_transition:MISS→Acquire/Unfold",
    "law:admission-threshold-0.35 — A(v)>=0.35 required for Yax admission",
    "purpose:runtime-configuration-and-contract-specification-for-fold-pipeline",
