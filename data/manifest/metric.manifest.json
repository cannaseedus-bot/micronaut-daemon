{
  "METRIC:": [
    "@metric",
    "METRIC-µ",
    "metric:graph:v1",
    "metric:track_compartment:v1",
    "metric:registry:metric_graph.xml",
    "metric:gml:data/metric_graph.gml",
    "metric:mml:data/grammar/metric_graph.mml",
    "intent:metric_relevance_geometry",
    "phase:Yax",
    "semantic_authority:false",
    "topology_authority:false",
    "metric:micronaut-attraction",
    "metric:stb-tensor-brains"
  ],
  "@metric": [
    "@node:METRIC-µ",
    "LearnMetric(Track_tau,J,DeltaF)->M_tau",
    "Track_tau=<G_tau,N_tau,R_tau>",
    "MetricCost(A,r,B|F,theta,J,DeltaF)->L_e",
    "Relevance(Q,K|tau,r,F,theta,provider)->R_tau",
    "Bridge_alpha_beta required for R_alpha_beta",
    "PrincipalDirection(D_Q|M_Q)",
    "S=W*C*R",
    "DeltaMetric!=DeltaTopology",
    "MicronautAttraction(mu,Q)->Phi_mu",
    "CaptureGate(Q,mu)",
    "STBTensorBrainRegistry->MicronautAttraction"
  ],
  "METRIC-µ": [
    "metric_geometry_learner",
    "relevance_measurement_layer",
    "provider_independent",
    "semantic_authority:false",
    "topology_authority:false",
    "learns_from:Ch'en",
    "track_compartment_first",
    "no_global_metric_space",
    "cross_track_bridge_required",
    "consumed_by:WCR/Yax",
    "phase:Yax"
  ],
  "metric:contract": [
    "M2XLM=semantic_structure_authority",
    "METRIC-µ=derived_relevance_geometry",
    "VECTOR-µ=coordinate_provider",
    "SDR-µ=overlap_provider",
    "GRAPH-µ=typed_path_provider",
    "SCX=key_book_provider",
    "Ch'en=verification_authority",
    "Xul=topology_commit_gate",
    "DeltaL!=DeltaB",
    "R_conditioned_by_relation_phase_context_provider",
    "MicronautAttraction=derived_capture_relevance",
    "CaptureGate!=Ch_en_verification",
    "STBTensorBrainRegistry binds projection evidence only"
  ],
  "metric:contrastive-loss": [
    "MetricScore(Q,K|tau,r,F,theta,provider)",
    "L_contrast=-log(exp(score_pos)/(exp(score_pos)+sum_exp(score_neg)))",
    "Pos_tau=GOOD_FoldDelta|admitted_RelationISA_edge|declared_key_book_neighborhood",
    "Neg_tau=same_track_hard_negatives|admitted_bridge_negatives",
    "no_global_all_grams_negative_pool",
    "semantic_authority:false",
    "topology_authority:false"
  ],
  "metric:bridge-loss": [
    "Bridge_alpha_beta_required",
    "d_alpha_beta(Q,K)=d_alpha(Q,m)+L_m+d_beta(m,K)",
    "L_bridge=-log(exp(-d_alpha_beta/T_bridge))",
    "mesh_node_permits_discovery_not_execution"
  ],
  "metric:differential-risk-loss": [
    "L_diff=||Projection(DeltaG)-DeltaF||^2",
    "DeltaG=differential_comparison_graph",
    "DeltaF=verified_FoldDelta",
    "L_risk=max(0,Risk(theta,delta)-risk_bound)^2",
    "L_total=alpha*L_contrast+beta*L_bridge+gamma*L_diff+eta*L_risk",
    "Ch'en=verdict_source",
    "DeltaMetric!=DeltaTopology"
  ],
  "metric:track-compartment": [
    "Track_tau=<G_tau,N_tau,R_tau>",
    "G_tau=track_owned_grams",
    "N_tau=track_local_neighborhoods",
    "R_tau=track_local_relation_structure",
    "M_tau=METRIC_mu(Track_tau)",
    "local_metric_search_only",
    "no_global_union_metric"
  ],
  "metric:cross-track-bridge": [
    "Bridge_alpha_beta",
    "explicit_admission_required",
    "R_alpha_beta defined only with bridge",
    "no_bridge=>not_comparable",
    "cross_track_relation_must_be_declared_or_verified"
  ],
  "metric:heterogeneous-graph": [
    "G=(V_gram union V_track union V_fold union V_mu union V_mesh,E)",
    "node_roles_not_interchangeable",
    "GramNode=track_owned_ngram",
    "TrackNode=compartment_boundary",
    "FoldNode=phase_addressable_semantic_structure",
    "MicronautNode=capability_execution_specialist",
    "MeshNode=controlled_transition_between_compartments",
    "mesh_connectivity_permits_discovery_not_execution"
  ],
  "metric:graph:v1": [
    "B=authoritative_FoldGraph_topology",
    "M_tau=derived_metric_geometry_inside_Track_tau",
    "L_e=edge_traversal_cost",
    "R=relevance_score",
    "theta=Pop/Wo/Yax/Sek/Ch'en/Xul",
    "r=RelationISA_relation_type",
    "provider=metric_graph|vector|sdr|graph|scx"
  ],
  "metric:providers": [
    "metric_graph_provider",
    "vector_provider",
    "sdr_provider",
    "graph_provider",
    "scx_keybook_provider"
  ],
  "metric:cannot": [
    "change_relation_type",
    "verify_GOOD_BAD",
    "authorize_XCFE",
    "commit_topology",
    "perform_Xul",
    "mutate_B"
  ],
  "metric:can": [
    "learn_edge_costs",
    "rank_candidate_relevance",
    "supply_provider_indexes",
    "condition_by_relation",
    "condition_by_phase",
    "estimate_typed_path_distance",
    "derive_principal_direction_geometry"
  ],
  "metric:vector-provider": [
    "VECTOR-µ",
    "coordinates",
    "cosine_provider",
    "local_chart_provider",
    "semantic_manifold_provider",
    "not_top_level_authority"
  ],
  "metric:principal-direction": [
    "compatible_FoldDelta_only",
    "metric_aware",
    "provider_independent",
    "PCA_is_vector_provider_only",
    "consensus_paths_are_graph_provider",
    "bit_consensus_is_SDR_provider"
  ],
  "metric:training-gradient": [
    "L_total=alpha*L_contrast+beta*L_bridge+gamma*L_diff+eta*L_risk",
    "TrainingGradient:g_phi=grad_phi L_total",
    "provider_parameter_update_only",
    "METRIC-µ supplies loss geometry; VECTOR/GRAPH/SDR/SCX providers may learn parameters",
    "TrainingGradient!=FoldDelta",
    "ParameterUpdate!=XulCommit",
    "semantic_authority:false"
  ],
  "metric:entropy-gating": [
    "local_entropy:uncertainty_metric",
    "entropy_spike:structural_shift_gate",
    "entropy_bound:admission_ceiling",
    "ENTROPY_BOUND_EXCEEDED",
    "FreeEnergyFlow conditions provider relevance geometry",
    "not_semantic_truth"
  ],
  "metric:micronaut-attraction": [
    "Phi_mu(Q)=Mass_mu*cos(Q,K_mu)*(W_mu*C_mu*R_mu)",
    "Mass_mu derived from M_YX and declared Micronaut basin evidence",
    "K_mu from vector_meta/coordinate anchor",
    "WCRPrior gates candidate capture",
    "EntropyDiffusion competes with attraction",
    "policy_ok AND capable AND xcfe_ok required",
    "candidate_admission_only",
    "semantic_authority:false"
  ],
  "metric:stb-tensor-brains": [
    "registry:data/world/stb_tensor_brains.json",
    "checker:tools/check_stb_tensor_brains.py",
    "canonical_geometry_brain:brain4",
    "METRIC-µ binding_kind:metric_provider_brain",
    "Phi_mu uses shared STB geometry plus WCR/capture context",
    "semantic_authority:false"
  ]
}
