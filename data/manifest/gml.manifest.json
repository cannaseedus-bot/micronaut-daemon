    "data/grammar/gml.khanary.ebnf",
    "parser:src/world/gml_parser.cpp"
  ],
  "gml:topology_contract": [
    "role:explicit-graph-topology-contract",
    "between:key-books-and-vector-projection",
    "preserves:nodes",
    "preserves:typed_edges",
    "preserves:relation_phase",
    "preserves:fold_direction",
    "preserves:graph_family",
    "law:GML!=VECTOR",
    "law:GML!=STB",
    "law:topology-before-coordinates",
    "consumer:vectors.xml",
    "consumer:VECTOR-µ"
  ],
  "gml:vector_boundary": [
    "GML=graph-shape-authority",
    "VECTOR-µ=derived-representation-learner",
    "STB/mesh/HLSL/KLSL=projection-or-execution-provider",
    "similarity_subset_relatedness",
    "projection_cannot_redefine_semantics"
  ],
  "gml:mesh_projection_bridge": [
    "vectors.xml",
    "provider:birdsong-stb",
