    "law:ParsedGraph≠VerifiedGraph≠B",
    "law:Representation→Relevance→Candidate→Verification",
    "law:VerifiedGraph→Proposal→Ch'en→XCFE→XulGate→B'"
  ],
  "gml:fold_graph_law_bridge": [
    "data/grammar/fold_graph.xml:fold-graph-lawbook",
    "data/grammar/fold.cd.xml:openmath-content-dictionary",
    "cd:urn:kuhul:fold-graph:v1",
    "symbols:FoldPair/FoldPairLower/Axis/supp/setbuilder",
    "topology-symbol:B",
    "cycle:Pop Wo Yax Sek Ch'en Xul",
    "law:topology-before-coordinates",
    "data/grammar/vectors.mml:mathml-foldpair-contract",
    "FoldPair(S)=<M[Y,X],C[Y,X]^T>",
    "M_YX!=W_Y",
    "B=authoritative_discrete_topology",
    "M_mu=VECTOR-µ_learned_geometry_over_B",
    "N(k)->T_k(M_mu)",
    "g(F,theta,r)=local_metric_projection",
    "d_M(A,B)=typed_graph_geodesic_projection",
    "law:Delta(M_mu)!=Delta(B)",
    "Risk(theta,delta)=E[Loss(theta,delta(x))]",
    "PriorDistribution:Lambda(theta)",
    "MinimaxRule:INADMISSIBLE_VECTOR_RULE",
    "DeltaF_diff=<DeltaM[Y,X],DeltaRelations,R_minimax>",
    "dual_twin:dual_comparison_edge_pair",
    "mutation:insert/delete/modify/unchanged",
    "law:Risk constrains projection not topology truth"
  ],
  "gml:semantic_manifold_projection_boundary": [
    "B remains GML/FoldGraph topology authority",
    "VECTOR-µ may learn M_mu over B",
    "local charts and metrics are projection-only",
    "geodesic estimates rank/retrieve but do not verify relations",
    "semantic_authority:false for learned geometry"
