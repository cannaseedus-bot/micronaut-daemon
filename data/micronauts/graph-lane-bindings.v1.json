{
  "schema": "kuhul.micronaut.graph-lane-bindings.v1",
  "version": "1.0.0",
  "authority": "DATA_ONLY",
  "status": "declarative_proposal",
  "contract_refs": [
    "data/micronauts/Micronaut.SRAI.AIML.ebnf",
    "data/micronauts/srai_route.ebnf",
    "data/grammar/gml.khanary.ebnf",
    "data/grammar/runtime-graph.contracts.json",
    "data/grammar/mml/v1/WildcardFieldResolution.mml",
    "data/grammar/mml/v1/XaimlMicronautDispatch.mml"
  ],
  "execution_boundary": {
    "graph_read": "in_process_read_only_after_XCFE_admission",
    "relation_truth": "requires_source_evidence_and_Ch_en_verification",
    "vector_role": "rank_or_retrieve_only",
    "topology_mutation": "proposal_then_Ch_en_then_XCFE_then_Xul",
    "tool_dispatch": "registered_local_executor; XCFE_admission_required_per_invocation",
    "direct_dispatch": false,
    "persistent_write": false
  },
  "lanes": {
    "topology": "GML typed nodes and edges; graph shape only",
    "field": "domain/intent membership candidates with provenance",
    "vector": "read-only representation and ranking over graph nodes",
    "phase_edge": "Pop-Wo-Yax-Sek-Ch'en-Xul transitions",
    "tool": "route proposal from existing AIML patterns; host admits separately"
  },
  "graphs": [
    {
      "id": "hypercube_q3",
      "path": "data/hypercube_Q3.gml",
      "kind": "topology",
      "use": [
        "3-bit neighbor traversal",
        "small topology features"
      ],
      "authority": "DATA_ONLY"
    },
    {
      "id": "hypercube_q4",
      "path": "data/hypercube_Q4.gml",
      "kind": "topology",
      "use": [
        "4-bit neighbor traversal",
        "higher-order topology features"
      ],
      "authority": "DATA_ONLY"
    },
    {
      "id": "khanary_topology",
      "path": "data/khanary_topology.gml",
      "kind": "micronaut_track_topology",
      "use": [
        "track adjacency",
        "delta-map proposals"
      ],
      "authority": "DATA_ONLY",
      "note": "Contains the core Q3 tracks plus MORPHISM/FIXED-POINT overlays; read actual file counts rather than stale manifest counts."
    },
    {
      "id": "unfold_graph",
      "path": "data/unfold-graph.gml",
      "kind": "product_topology",
      "use": [
        "Q3 x C6 fold address traversal",
        "phase-aware neighbor proposals"
      ],
      "authority": "DATA_ONLY"
    },
    {
      "id": "micronaut_fieldgraph",
      "path": "data/micronaut_fieldgraph.gml",
      "kind": "phase_edge",
      "use": [
        "fold phase transition visualization",
        "resident selector hints"
      ],
      "authority": "projection_only",
      "note": "Descriptive phase edges; Sek dispatch role does not authorize dispatch."
    },
    {
      "id": "code_wildcard",
      "path": "data/code-wildcard.gml",
      "kind": "tool_route_structure",
      "use": [
        "wildcard capture structure",
        "tool-route candidate formation"
      ],
      "authority": "DATA_ONLY",
      "dispatch": "XCFE_required"
    },
    {
      "id": "intent_graph",
      "path": "data/intent-graph.gml",
      "kind": "field",
      "use": [
        "explicit field_member supervision",
        "intent candidate lookup"
      ],
      "authority": "DATA_ONLY"
    },
    {
      "id": "cfpc_questions",
      "path": "data/cfpc-questions.gml",
      "kind": "question_field",
      "use": [
        "question candidate routing",
        "gap-family references"
      ],
      "authority": "DATA_ONLY"
    },
    {
      "id": "cfpc_wildcards",
      "path": "data/cfpc-wildcards.gml",
      "kind": "wildcard_field",
      "use": [
        "typed wildcard capture candidates"
      ],
      "authority": "DATA_ONLY"
    },
    {
      "id": "metric_graph",
      "path": "data/metric_graph.gml",
      "kind": "metric_topology",
      "use": [
        "declared path-cost/risk comparisons"
      ],
      "authority": "DATA_ONLY",
      "note": "Metric values are source data, not calibrated model confidence."
    },
    {
      "id": "vectors",
      "path": "data/vectors.gml",
      "kind": "vector_projection",
      "use": [
        "read-only semantic ranking candidates"
      ],
      "authority": "projection_only",
      "semantic_authority": false
    },
    {
      "id": "kuhul_pi",
      "path": "data/kuhul-pi.gml",
