  "policy_cases": [
    {
      "id": "bind_loopback_without_token",
      "kind": "bind",
      "host": "127.0.0.1",
      "token": "",
      "expect": "ALLOW"
    },
    {
      "id": "bind_localhost_without_token",
      "kind": "bind",
      "host": "localhost",
      "token": "",
      "expect": "ALLOW"
    },
    {
      "id": "bind_ipv6_loopback_without_token",
      "kind": "bind",
      "host": "::1",
      "token": "",
      "expect": "ALLOW"
    },
    {
      "id": "bind_any_without_token",
      "kind": "bind",
      "host": "0.0.0.0",
      "token": "",
      "expect": "REFUSE",
      "error": "non_loopback_bind_requires_token"
    },
    {
      "id": "bind_any_with_token",
      "kind": "bind",
      "host": "0.0.0.0",
      "token": "secret",
      "expect": "ALLOW",
