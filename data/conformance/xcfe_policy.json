      "id": "valid_default_policy_authorizes",
      "expect": "PASS",
      "policy": {
        "@ref": "xcfe://autonomy/default@1.0.0",
        "@evidence": {
          "@inputs": [
            "observations",
            "support",
            "exceptions",
            "validated",
            "failures"
          ]
        },
        "@weights": {
          "@alpha": 0.5,
          "@beta": 0.5,
          "@gamma": 0.0,
          "@delta": 0.0,
          "@epsilon": 0.000001
        },
        "@thresholds": {
          "@autonomy": 0.75,
          "@fallback": 0.45,
          "@failure_limit": 2,
          "@hysteresis": 0.02
        },
        "@routes": {
          "@autonomous": "local",
          "@validated": "local-test",
          "@default": "fallback"
        }
      },
      "eval": {
        "state": "validated",
        "event": "authorize",
        "evidence": {
          "observations": 10,
          "support": 8,
          "exceptions": 2,
          "validated": 5,
          "failures": 1
        },
        "expect": {
          "state": "autonomous",
          "route": "local",
          "confidence": 0.8166665561111307
        }
      }
