  "clifford": {
    "description": "Cl(2,0) — 2D Euclidean Geometric Algebra. Basis {1, e1, e2, e12} with e1²=+1, e2²=+1, e12²=-1. Multivector format: {s, x(e1), y(e2), b(e12)}. Basis products checked with exact integer arithmetic.",
    "basis_products": [
      {
        "id": "cl20-basis-e1e1",
        "description": "e1*e1 = 1. e1²=+1 is the signature.",
        "a": {"s": 0, "x": 1, "y": 0, "b": 0},
        "b": {"s": 0, "x": 1, "y": 0, "b": 0},
        "expect": {"s": 1, "x": 0, "y": 0, "b": 0}
      },
      {
        "id": "cl20-basis-e2e2",
        "description": "e2*e2 = 1. e2²=+1 is the signature.",
        "a": {"s": 0, "x": 0, "y": 1, "b": 0},
        "b": {"s": 0, "x": 0, "y": 1, "b": 0},
        "expect": {"s": 1, "x": 0, "y": 0, "b": 0}
      },
      {
        "id": "cl20-basis-e12e12",
        "description": "e12*e12 = -1. The pseudoscalar squares to -1.",
        "a": {"s": 0, "x": 0, "y": 0, "b": 1},
        "b": {"s": 0, "x": 0, "y": 0, "b": 1},
        "expect": {"s": -1, "x": 0, "y": 0, "b": 0}
      },
      {
        "id": "cl20-basis-e1e2",
        "description": "e1*e2 = e12.",
        "a": {"s": 0, "x": 1, "y": 0, "b": 0},
        "b": {"s": 0, "x": 0, "y": 1, "b": 0},
        "expect": {"s": 0, "x": 0, "y": 0, "b": 1}
      },
      {
        "id": "cl20-basis-e2e1",
        "description": "e2*e1 = -e12. Non-commutativity witness: e1*e2 != e2*e1.",
        "a": {"s": 0, "x": 0, "y": 1, "b": 0},
        "b": {"s": 0, "x": 1, "y": 0, "b": 0},
        "expect": {"s": 0, "x": 0, "y": 0, "b": -1}
      },
      {
        "id": "cl20-unitality",
        "description": "1_A * e1 = e1 (left identity check).",
        "a": {"s": 1, "x": 0, "y": 0, "b": 0},
        "b": {"s": 0, "x": 1, "y": 0, "b": 0},
        "expect": {"s": 0, "x": 1, "y": 0, "b": 0}
      },
      {
        "id": "cl20-associativity",
        "description": "(e1*e2)*e1 == e1*(e2*e1): both paths give (0,0,-1,0).",
        "op": "associativity_check",
        "a": {"s": 0, "x": 1, "y": 0, "b": 0},
        "b": {"s": 0, "x": 0, "y": 1, "b": 0},
        "c": {"s": 0, "x": 1, "y": 0, "b": 0},
        "expect_ab_c": {"s": 0, "x": 0, "y": -1, "b": 0},
        "expect_a_bc": {"s": 0, "x": 0, "y": -1, "b": 0}
      }
    ],
    "phase_products": [
      {
        "id": "cl20-phase-pop-to-wo",
        "description": "Phase product Pop(0)→Wo(1): Δθ=π/3. scalar=cos(π/3)=0.5 == arc_weight. This is the FULL-ANGLE product — not a rotation rotor.",
        "from_phase": 0,
        "to_phase": 1,
        "expect_scalar": 0.5,
