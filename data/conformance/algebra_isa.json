        "from_phase": 0,
        "to_phase": 3,
        "expect_scalar": -1.0,
        "expect_bivector": 0.0
      }
    ],
    "phase_rotors": [
      {
        "id": "cl20-rotor-pop-to-wo",
        "description": "Half-angle rotor Pop(0)→Wo(1): Δθ/2=π/6. Sandwich rotor*e0*reverse(rotor) rotates e0=(0,1,0,0) to e1=(0,0.5,0.866,0).",
        "from_phase": 0,
        "to_phase": 1,
        "input_vector": {"s": 0, "x": 1, "y": 0, "b": 0},
