  "negative": [
    {
      "id": "srai-neg-001",
      "description": "TRAIN without commit_requires — propose_delta must have commit_requires",
      "frame": {
        "operator": "TRAIN",
        "executor": "learning",
        "phase": "Xul",
        "input_roles": ["ranked_candidates"],
        "output_role": "weight_delta",
        "effects": ["propose_delta"],
        "commit_requires": null
      },
      "expect": "invalid",
      "violation": "effects contains propose_delta but commit_requires is null"
    },
    {
      "id": "srai-neg-002",
      "description": "TRAIN without verified_outcome in input_roles — missing Ch'en gate input",
      "frame": {
        "operator": "TRAIN",
        "executor": "learning",
        "phase": "Xul",
        "input_roles": ["ranked_candidates"],
        "output_role": "weight_delta",
        "effects": ["propose_delta"],
        "commit_requires": ["Ch_en_verification", "Xul_authorization"]
      },
      "expect": "invalid",
      "violation": "TRAIN input_roles must include verified_feedback (derived from verified_outcome)"
    },
    {
      "id": "srai-neg-003",
      "description": "SCORE with propose_delta effect — SCORE may not propose topology changes",
      "frame": {
        "operator": "SCORE",
        "executor": "metric",
        "phase": "Sek",
        "input_roles": ["candidate_set", "query_vector"],
        "output_role": "scored_candidates",
        "effects": ["read", "measure", "propose_delta"]
      },
      "expect": "invalid",
      "violation": "SCORE declared propose_delta but commit_requires is absent"
    },
    {
      "id": "srai-neg-004",
      "description": "COLLAPSE claiming to commit topology",
      "frame": {
        "operator": "COLLAPSE",
        "executor": "jyggalag",
        "phase": "Ch_en",
        "input_roles": ["ranked_candidates", "critic_reports"],
        "output_role": "topology_delta",
        "effects": ["read", "collapse", "propose_delta"],
        "commit_requires": null
      },
      "expect": "invalid",
      "violation": "COLLAPSE output_role must be collapsed_candidate (Greymarch record), not topology_delta; and propose_delta requires commit_requires"
    },
    {
      "id": "srai-neg-005",
      "description": "Unknown effect value",
      "frame": {
        "operator": "RECALL",
        "executor": "gram_store",
        "phase": "Pop",
        "input_roles": ["query"],
        "output_role": "gram_evidence",
        "effects": ["read", "mutate_topology"]
      },
      "expect": "invalid",
      "violation": "mutate_topology is not in the permitted effects set {read,measure,order,analyze,gate,project,emit,collapse,propose_delta}"
    },
    {
      "id": "srai-neg-006",
      "description": "Pipeline shortcut — RANK output claimed to authorize TRAIN without VERIFY",
      "pipeline_sequence": ["SCORE", "RANK", "TRAIN"],
      "expect": "invalid",
      "violation": "TRAIN without VERIFY in sequence; COLLAPSE and VERIFY must precede TRAIN"
    },
    {
      "id": "srai-neg-007",
      "description": "VERIFY committing topology directly",
      "frame": {
        "operator": "VERIFY",
        "executor": "ch_en_gate",
        "phase": "Ch_en",
        "input_roles": ["candidate", "evidence_refs"],
        "output_role": "topology_commit",
        "effects": ["read", "gate"]
      },
      "expect": "invalid",
      "violation": "VERIFY output_role must be verified_outcome (a gate token), not topology_commit; only Xul may commit topology"
    }
  ]
}
