      "error": "UNEXPECTED_TOKEN"
    },
    {
      "id": "wcf-e06",
      "description": "Trailing tokens after the continuation are not part of the production.",
      "pattern": "* IF * OR * THEN * AND * extra",
      "error": "UNEXPECTED_TOKEN"
    }
  ],

