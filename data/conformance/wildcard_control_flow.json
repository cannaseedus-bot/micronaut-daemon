{
  "description": "Conformance fixtures for the Q-Prime wildcard control-flow family. Each case gives a pattern, the expected parse, and the gap the analysis must route. Contract authority: data/grammar/wildcard-control-flow.contracts.json and data/grammar/wildcard-control-flow.ebnf.",

  "parse_ok": [
    {
      "id": "wcf-001",
      "description": "THEN: consequence with a conjunctive continuation.",
      "pattern": "* IF * OR * THEN * AND *",
      "marker": "THEN",
      "condition_op": "OR",
      "continuation_op": "AND",
      "captures": 5,
      "has_srai": false,
      "gap": "NONE"
    },
    {
      "id": "wcf-002",
      "description": "ELSE with no known THEN is a question, not a branch: QUERY_GAP.",
      "pattern": "* IF * OR * ELSE * AND *",
      "marker": "ELSE",
      "condition_op": "OR",
      "continuation_op": "AND",
      "captures": 5,
      "has_srai": false,
      "then_branch_known": false,
      "gap": "QUERY_GAP"
    },
    {
      "id": "wcf-003",
      "description": "ELSE with a known THEN is an alternative branch: no gap.",
      "pattern": "* IF * OR * ELSE * AND *",
      "marker": "ELSE",
      "condition_op": "OR",
      "continuation_op": "AND",
      "captures": 5,
      "has_srai": false,
      "then_branch_known": true,
      "gap": "NONE"
    },
    {
      "id": "wcf-004",
      "description": "BUT is a contrast, not an alias for ELSE: INTENT_GAP until resolved.",
      "pattern": "* IF * OR * BUT * AND *",
      "marker": "BUT",
      "condition_op": "OR",
      "continuation_op": "AND",
      "captures": 5,
      "has_srai": false,
      "gap": "INTENT_GAP"
    },
    {
      "id": "wcf-005",
      "description": "<srai> inside the condition is its own AST node with a target.",
      "pattern": "* IF * OR <srai>candidate B</srai> THEN * AND *",
      "marker": "THEN",
      "condition_op": "OR",
      "continuation_op": "AND",
      "captures": 4,
      "has_srai": true,
      "srai_target": "candidate B",
      "gap": "NONE"
    },
    {
      "id": "wcf-006",
      "description": "A self-closing <srai/> has no target: KNOWLEDGE_GAP.",
      "pattern": "* IF * OR <srai/> THEN * AND *",
      "marker": "THEN",
      "condition_op": "OR",
      "continuation_op": "AND",
      "captures": 4,
      "has_srai": true,
      "srai_target": "",
      "gap": "KNOWLEDGE_GAP"
    },
    {
      "id": "wcf-007",
      "description": "Underscore wildcards count the same as asterisks.",
      "pattern": "_ IF _ OR _ THEN _ AND _",
      "marker": "THEN",
      "condition_op": "OR",
      "continuation_op": "AND",
      "captures": 5,
      "has_srai": false,
      "gap": "NONE"
    },
    {
      "id": "wcf-008",
      "description": "A conjunctive condition is recorded as AND, not normalised to OR.",
      "pattern": "* IF * AND * THEN * AND *",
      "marker": "THEN",
      "condition_op": "AND",
      "continuation_op": "AND",
      "captures": 5,
      "has_srai": false,
      "gap": "NONE"
    }
  ],

  "parse_errors": [
    {
      "id": "wcf-e01",
      "description": "No IF: the pattern is not a control-flow production.",
      "pattern": "* THEN *",
      "error": "MISSING_IF"
    },
    {
      "id": "wcf-e02",
      "description": "The condition operator is missing between the operands.",
      "pattern": "* IF * * THEN * AND *",
      "error": "MISSING_OPERATOR"
    },
    {
      "id": "wcf-e03",
      "description": "No THEN/ELSE/BUT marker.",
      "pattern": "* IF * OR * * AND *",
      "error": "MISSING_MARKER"
    },
    {
      "id": "wcf-e04",
      "description": "An unterminated <srai> element.",
      "pattern": "* IF <srai>broken OR * THEN * AND *",
