  "glyph_lane_contract": "programs/glyph.tokens.json",
  "lane_order": ["TOOL", "CODE", "AST", "THINK", "REASON", "CHATML", "MEMORY"],
  "micronauts": {
    "CHATML": "µ-chat",
    "REASON": "µ-reason",
    "CODE": "µ-code",
    "AST": "µ-ast",
    "TOOL": "µ-tool",
    "MEMORY": "µ-memory",
    "THINK": "µ-think"
  },
  "classification": {
    "priority": "tool > code_or_ast > reason > chat",
    "tool_patterns": ["TOOL_CALL", "tool_call", "tool_use", "<tool", "npm ", "git ", "python ", "powershell", "apply_patch"],
    "ast_patterns": ["<AST>", "KSON", "KAST", "parser tree", "AST", "XCFE", "XJSON", "KUHUL"],
    "code_patterns": ["```", "def ", "class ", "function ", "import ", "#include", "<script", "public static", "SELECT "],
    "reason_patterns": ["chain of thought", "step by step", "reasoning", "proof", "compare", "why", "because"]
  },
  "record_contract": {
    "lane": "CHATML|REASON|CODE|AST|TOOL|MEMORY|THINK",
    "micronaut": "µ-chat|µ-reason|µ-code|µ-ast|µ-tool|µ-memory|µ-think",
    "fold": "Pop|Wo|Yax|Sek|Chen|Xul",
    "input": "string",
    "output": "string",
    "source": "string",
    "source_record": "integer",
    "split": "train|validation|test"
  },
  "outputs": {
    "directory": "artifacts/response-lanes",
    "files": ["chatml.jsonl", "reason.jsonl", "code.jsonl", "ast.jsonl", "tool.jsonl", "memory.jsonl", "think.jsonl", "manifest.json"],
    "deduplicate": true,
    "max_chars": 131072
  }
}
