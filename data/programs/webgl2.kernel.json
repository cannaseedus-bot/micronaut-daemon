{
  "@program": "webgl2.kernel",
  "@schema": "kuhul.webgl2.kernel.v1",
  "@version": "1.0.0",
  "@description": "WebGL2 semantic tensor and ARC visualization registry using GLSL ES 3.00.",
  "opcode_table": "programs/opcode.table.json",
  "backend": {
    "name": "webgl2",
    "language": "GLSL ES 3.00",
    "context": "WebGL2RenderingContext",
    "shader_stages": ["vertex", "fragment"],
    "compute_model": "render-target and transform-feedback passes",
    "host_binding": "trainer/dashboard/webgl2-trainer-dashboard.ps1",
    "forbidden": ["WGSL", "WebGPU compute", "compute shaders", "SSBO-only OpenGL 4.3 syntax"]
  },
  "phase_hooks": {
    "Pop": "create_webgl2_context_and_targets",
    "Wo": "bind_attributes_uniforms_textures",
    "Yax": "select_shader_program",
    "Sek": "draw_or_transform_feedback",
    "Chen": "read_pixels_or_feedback_and_verify",
    "Xul": "commit_texture_or_buffer_state"
  },
  "fold_targets": {
    "Pop": { "semantic": "webgl2.context.allocate", "host_ops": ["getContext", "createBuffer", "createTexture", "createFramebuffer"] },
    "Wo": { "semantic": "webgl2.tensor.bind", "host_ops": ["bindBuffer", "bindTexture", "uniform*", "vertexAttribPointer"] },
    "Yax": { "semantic": "webgl2.program.select", "host_ops": ["createShader", "compileShader", "linkProgram", "useProgram"] },
    "Sek": { "semantic": "webgl2.pass.dispatch", "host_ops": ["drawArrays", "drawElements", "beginTransformFeedback", "endTransformFeedback"] },
    "Chen": { "semantic": "webgl2.result.collect", "host_ops": ["readPixels", "getBufferSubData"] },
    "Xul": { "semantic": "webgl2.state.commit", "host_ops": ["swapTargets", "flush"] }
  },
  "glyph_opcodes": {
    "0x30": { "glyph": "G_LOAD_BIN_TENSOR", "arity": 0, "semantic": "tensor.load", "pass": "texture_upload", "status": "host_only" },
    "0x40": { "glyph": "G_TENSOR_MATMUL", "arity": 2, "semantic": "tensor.matmul", "pass": "fragment_multiply", "vertex": "drivers/webgl2/fullscreen.vert", "fragment": "drivers/webgl2/matmul.frag", "status": "implemented" },
    "0x41": { "glyph": "G_TENSOR_ADD", "arity": 2, "semantic": "elementwise.add", "pass": "fragment_add", "vertex": "drivers/webgl2/fullscreen.vert", "fragment": "drivers/webgl2/add.frag", "status": "implemented" },
    "0x42": { "glyph": "G_TENSOR_CONV2D", "arity": 2, "semantic": "tensor.conv2d", "pass": "fragment_convolution", "vertex": "drivers/webgl2/fullscreen.vert", "fragment": "drivers/webgl2/conv2d.frag", "status": "implemented" },
    "0x50": { "glyph": "G_RELU", "arity": 1, "semantic": "activation.relu", "pass": "fragment_activation", "vertex": "drivers/webgl2/fullscreen.vert", "fragment": "drivers/webgl2/relu.frag", "status": "implemented" },
    "0x51": { "glyph": "G_GELU", "arity": 1, "semantic": "activation.gelu", "pass": "fragment_activation", "vertex": "drivers/webgl2/fullscreen.vert", "fragment": "drivers/webgl2/gelu.frag", "status": "implemented" },
    "0x52": { "glyph": "G_SOFTMAX", "arity": 1, "semantic": "activation.softmax", "pass": "fragment_reduction", "vertex": "drivers/webgl2/fullscreen.vert", "fragment": "drivers/webgl2/softmax.frag", "status": "implemented" },
    "0x60": { "glyph": "G_QKV_PROJECTION", "arity": 3, "semantic": "attention.qkv", "pass": "fragment_multiply", "vertex": "drivers/webgl2/fullscreen.vert", "fragment": "drivers/webgl2/qkv_projection.frag", "status": "implemented" },
    "0x61": { "glyph": "G_SCALED_DOT_PRODUCT", "arity": 3, "semantic": "attention.scaled_dot", "pass": "fragment_reduction", "vertex": "drivers/webgl2/fullscreen.vert", "fragment": "drivers/webgl2/scaled_dot.frag", "status": "implemented" },
    "0x70": { "glyph": "G_FORWARD_PASS", "arity": 1, "semantic": "training.forward", "pass": "fragment_identity", "vertex": "drivers/webgl2/fullscreen.vert", "fragment": "drivers/webgl2/forward.frag", "status": "implemented" },
    "0x71": { "glyph": "G_BACKWARD_PASS", "arity": 1, "semantic": "training.backward", "pass": "fragment_gradient", "vertex": "drivers/webgl2/fullscreen.vert", "fragment": "drivers/webgl2/backward.frag", "status": "implemented" },
    "0x80": { "glyph": "G_MATRIX5X4_MUL", "arity": 2, "semantic": "buffer.matrix5x4.mul", "pass": "fragment_matrix5x4", "vertex": "drivers/webgl2/fullscreen.vert", "fragment": "drivers/webgl2/matrix5x4_mul.frag", "status": "implemented", "shape": [5, 4] },
    "0x81": { "glyph": "G_MATRIX5X4_MATMUL", "arity": 2, "semantic": "buffer.matrix5x4.matmul", "pass": "fragment_matrix5x4", "vertex": "drivers/webgl2/fullscreen.vert", "fragment": "drivers/webgl2/matrix5x4_matmul.frag", "status": "implemented", "shape": [5, 4], "rhs_shape": [4, 5] },
    "0x82": { "glyph": "G_MATRIX5X4_ADD", "arity": 2, "semantic": "buffer.matrix5x4.add", "pass": "fragment_matrix5x4", "vertex": "drivers/webgl2/fullscreen.vert", "fragment": "drivers/webgl2/matrix5x4_add.frag", "status": "implemented", "shape": [5, 4] },
    "0x83": { "glyph": "G_MATRIX5X4_SWIGLU", "arity": 2, "semantic": "buffer.matrix5x4.swiglu", "pass": "fragment_matrix5x4", "vertex": "drivers/webgl2/fullscreen.vert", "fragment": "drivers/webgl2/matrix5x4_swiglu.frag", "status": "implemented", "shape": [5, 4] },
    "0x100": { "glyph": "G_SOBEL_X", "arity": 1, "glyph_symbol": "∇x", "semantic": "convolution.sobel_x", "pass": "fragment_convolution", "vertex": "drivers/webgl2/fullscreen.vert", "fragment": "drivers/webgl2/sobel_x.frag", "status": "implemented" },
    "0x101": { "glyph": "G_SOBEL_Y", "arity": 1, "glyph_symbol": "∇y", "semantic": "convolution.sobel_y", "pass": "fragment_convolution", "vertex": "drivers/webgl2/fullscreen.vert", "fragment": "drivers/webgl2/sobel_y.frag", "status": "implemented" },
    "0x102": { "glyph": "G_SOBEL_MAGNITUDE", "arity": 2, "glyph_symbol": "∇", "semantic": "convolution.gradient", "pass": "fragment_reduction", "vertex": "drivers/webgl2/fullscreen.vert", "fragment": "drivers/webgl2/sobel_magnitude.frag", "status": "implemented" },
    "0x103": { "glyph": "G_ELEMENTWISE_MUL", "arity": 2, "glyph_symbol": "⊗", "semantic": "elementwise.mul", "pass": "fragment_elementwise", "vertex": "drivers/webgl2/fullscreen.vert", "fragment": "drivers/webgl2/elementwise_mul.frag", "status": "implemented" },
    "0x104": { "glyph": "G_REDUCE_PAIR_SUM", "arity": 2, "glyph_symbol": "∑", "semantic": "reduce.pair_sum", "pass": "fragment_elementwise", "vertex": "drivers/webgl2/fullscreen.vert", "fragment": "drivers/webgl2/reduce_pair_sum.frag", "status": "implemented" },
    "0x105": { "glyph": "G_SOBEL_THRESHOLD", "arity": 1, "glyph_symbol": "T", "semantic": "convolution.threshold", "pass": "fragment_activation", "vertex": "drivers/webgl2/fullscreen.vert", "fragment": "drivers/webgl2/sobel_threshold.frag", "status": "implemented" },
    "0x110": { "glyph": "G_SWIGLU", "arity": 3, "semantic": "activation.swiglu", "status": "host_only" },
    "0x111": { "glyph": "G_SILU", "arity": 1, "semantic": "activation.silu", "status": "host_only" },
    "0x112": { "glyph": "G_SOFTMAX_BACK", "arity": 1, "semantic": "activation.softmax_back", "status": "host_only" },
    "0x113": { "glyph": "G_RMS_NORM_BACK", "arity": 2, "semantic": "normalization.rms_back", "status": "host_only" },
    "0x114": { "glyph": "G_SILU_BACK", "arity": 2, "semantic": "activation.silu_back", "status": "host_only" },
    "0x115": { "glyph": "G_GELU_BACK", "arity": 2, "semantic": "activation.gelu_back", "status": "host_only" },
    "0x116": { "glyph": "G_ADAMW", "arity": 4, "semantic": "optimizer.adamw", "status": "host_only" },
    "0x117": { "glyph": "G_SGD", "arity": 2, "semantic": "optimizer.sgd", "status": "host_only" },
    "0x118": { "glyph": "G_RMS_NORM", "arity": 1, "semantic": "normalization.rms", "status": "host_only" },
    "0x119": { "glyph": "G_CROSS_ENTROPY_BACK", "arity": 2, "semantic": "loss.cross_entropy_back", "status": "host_only" },
    "0x200": { "glyph": "G_HF_LOAD", "arity": 0, "semantic": "hf.tensor.load", "pass": "texture_upload", "status": "host_only", "host": "trainer/dashboard/webgl2-hf-loader.mjs" },
    "0x201": { "glyph": "G_HF_MATMUL", "arity": 2, "semantic": "hf.tensor.matmul", "pass": "fragment_multiply", "vertex": "drivers/webgl2/fullscreen.vert", "fragment": "drivers/webgl2/matmul.frag", "status": "implemented" },
    "0x202": { "glyph": "G_HF_ATTENTION", "arity": 4, "semantic": "hf.attention", "pass": "multi_pass_attention", "status": "contracted" },
    "0x203": { "glyph": "G_HF_SWIGLU", "arity": 3, "semantic": "hf.swiglu", "pass": "multi_pass_swiglu", "status": "contracted" },
    "0x204": { "glyph": "G_HF_RMS_NORM", "arity": 1, "semantic": "hf.rms_norm", "pass": "multi_pass_rms_norm", "status": "contracted" },
    "0x205": { "glyph": "G_GRAVITY_CORRECTIVE", "arity": 2, "semantic": "training.gravity_corrective", "pass": "fragment_gradient_corrective", "vertex": "drivers/webgl2/fullscreen.vert", "fragment": "drivers/webgl2/gravity_corrective.frag", "host": "drivers/webgl2/gravity_corrective.mjs", "status": "implemented" }
  },
  "tensor_contract": {
    "storage": "WebGL2 buffer, texture, or transform-feedback target",
    "dtype": "f32",
    "shape": "host metadata; not encoded by GLSL ES array declarations",
    "lanes": "vertex attributes, texture channels, or feedback varyings",
    "storage_authority": "tools/stb.py"
  },
  "constraints": {
    "browser_api": "WebGL2 only",
    "shader_version": "#version 300 es",
    "no_compute_dispatch": true,
    "semantic_state": "logical tensor state is preserved across ping-pong targets"
  }
}
