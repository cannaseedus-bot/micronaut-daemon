(* Phase-driven frame generation. Every loop iteration is one complete frame. *)
[Pop neon_fallout_boy]
  [Wo 1920] -> [Ch'en width]
  [Wo 1080] -> [Ch'en height]
  [Wo 90] -> [Ch'en frame_count]
  [Wo 30] -> [Ch'en fps]
  [Wo "#00ffff"] -> [Ch'en neon_color]
  [Wo "#ff00ff"] -> [Ch'en accent_color]
  [Wo 0.85] -> [Ch'en glow_intensity]
  [Wo "fallout_boy.png"] -> [Ch'en sprite_source]
  [Wo "build/neon-fallout-boy/frames"] -> [Ch'en output_dir]

  [K'ayab' frame_loop]
    [Pop load_sprite sprite_source] -> [Ch'en base_sprite]
    [Wo apply_neon_glow base_sprite neon_color glow_intensity frame_index] -> [Ch'en glow_layer]
    [Yax apply_scanlines_and_chromatic_aberration glow_layer frame_index] -> [Ch'en aberrated_layer]
    [Sek composite_frame base_sprite glow_layer aberrated_layer frame_index] -> [Ch'en composited_frame]
    [Ch'en encode_and_verify composited_frame frame_index] -> [Ch'en encoded_frame]
    [Xul emit_frame encoded_frame output_dir frame_index]
  [Kumk'u frame_loop]

  [Ch'en verify_all_frames output_dir frame_count] -> [Ch'en all_valid]
  [Xul write_render_manifest output_dir frame_count fps all_valid]
[Xul]
