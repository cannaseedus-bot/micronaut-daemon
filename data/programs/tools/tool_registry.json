{
  "@kind": "kuhul.tool-registry.v1",
  "@version": "1.0.0",
  "@description": "Small explicit allowlist. Add commands here before a model can request them.",
  "tools": [
    {
      "id": "micronaut.v4.confidence",
      "verb": "confidence.update",
      "target": "http://127.0.0.1:17889/confidence",
      "route": "micronaut://v4/confidence",
      "lane": "MEMORY",
      "phase": "Sek",
      "effect": "write",
      "input_schema": {
        "type": "object",
        "required": [
          "target",
          "value"
        ],
        "properties": {
          "target": {
            "type": "string",
            "description": "Semantic variable to update (e.g., \"attention_confidence\")"
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Confidence value in [0,1]"
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      },
      "replay": true,
      "requires": []
    },
