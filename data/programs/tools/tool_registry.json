    {
      "id": "jrom.record",
      "verb": "jrom.record",
      "target": "jrom://replay",
      "route": "jrom://replay",
      "lane": "MEMORY",
      "phase": "Chen",
      "effect": "write",
      "input_schema": {
        "type": "object",
        "required": [
          "tool_id",
          "verb",
          "target",
          "args",
          "phase",
          "lane",
          "status"
        ],
        "properties": {
          "replay_id": {
            "type": "string",
            "description": "Optional explicit replay id; auto-generated if omitted"
          },
          "tool_id": {
            "type": "string",
            "description": "Tool or model identity that emitted this event"
          },
          "verb": {
            "type": "string",
            "description": "Action verb"
          },
          "target": {
            "type": "string",
            "description": "Target route/endpoint/executable"
          },
          "args": {
            "type": "object",
            "description": "Arguments or payload"
          },
          "phase": {
            "type": "string",
            "enum": [
              "Pop",
              "Wo",
              "Yax",
              "Sek",
              "Chen",
              "Xul"
            ],
            "description": "Fold phase"
          },
          "lane": {
            "type": "string",
            "enum": [
              "TOOL",
              "VERB",
              "CODE",
              "AST",
              "KSON",
              "REASON",
              "MEMORY",
              "CHATML"
            ],
            "description": "Glyph lane"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error",
              "pending",
              "refused"
            ],
            "description": "Event status"
          },
          "result": {
            "type": "object",
            "description": "Tool/model result payload"
          },
          "error": {
            "type": "string",
            "description": "Error message if status=error"
          },
          "model": {
            "type": "string",
            "description": "Model or micronaut name that produced the output"
          },
          "micronaut": {
            "type": "string",
            "description": "Resolved micronaut glyph"
          },
          "jrom_program": {
            "type": "string",
            "description": "JROM program tag"
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "events": {
            "type": "integer"
          },
          "last_hash": {
            "type": "string"
          },
          "event": {
            "type": "object"
          }
        }
      },
      "replay": true,
      "requires": [
        "Chen_validation"
      ]
    },
