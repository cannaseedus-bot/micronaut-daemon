(* Ashen Vale tabletop RPG. One player action advances one full turn cycle. *)
[Pop tabletop_rpg]
  [Wo "The Ashen Vale"] -> [Ch'en campaign_name]
  [Wo 20] -> [Ch'en max_turns]
  [Wo "d20"] -> [Ch'en dice_system]
  [Yax "Aria the Rogue"] -> [Sek create_character]
    [Wo 10] -> [Ch'en hp_max]
    [Wo 14] -> [Ch'en armor_class]
    [Wo 16] -> [Ch'en dexterity]
    [Wo 12] -> [Ch'en strength]
  [Yax "dungeon corridor"] -> [Sek init_world]
    [Wo "goblin_guard"] -> [Ch'en enemy]
    [Wo 5] -> [Ch'en enemy_hp]
    [Wo 13] -> [Ch'en enemy_ac]

  [K'ayab' turn_loop]
    [Pop load_state player world turn] -> [Ch'en game_state]
    [Wo bind_player_intent game_state] -> [Ch'en intent]
    [Yax resolve_action intent d20 modifiers armor_class] -> [Ch'en resolution]
    [Sek apply_effects resolution player world] -> [Ch'en updated_state]
    [Ch'en verify_state updated_state max_turns] -> [Ch'en verification]
    [Xul commit_turn verification updated_state narration] -> [Ch'en committed]
    [Yax verification]
      [Sek if game_over] -> [Sek break turn_loop]
      [Sek else] -> [Sek advance turn]
  [Kumk'u turn_loop]
[Xul]
