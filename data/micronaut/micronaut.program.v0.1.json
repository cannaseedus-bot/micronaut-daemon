{
  "$schema": "urn:khanary:schema:micronaut-program:0.1",
  "@type": "khanary.micronaut_program.v0.1",
  "@no-eval": true,
  "version": "0.1",
  "name": "KHANARY Micronaut Program",
  "purpose": "Query-directed orchestration grammar for selecting, composing, executing, and learning Micronaut continuations without granting semantic authority.",
  "topology": {
    "type": "product_graph",
    "space": "Qn□C6",
    "semantic_coordinates": "bitvector",
    "phase_wheel": [
      "Pop",
      "Wo",
      "Yax",
      "Sek",
      "Ch'en",
      "Xul"
    ],
    "semantic_step": "d_H(b,b')=1 && theta'=theta",
    "phase_step": "b'=b && d_C6(theta,theta')=1"
  },
  "runtime": {
    "law": "MicronautRuntime(B,Q)=Cata_phi(WCR(Match(Ana_psiQ(B))))",
    "stages": [
      {
        "name": "Ana",
        "verb": "expand_candidate_micronauts",
        "phase": "Yax"
      },
      {
        "name": "Match",
        "verb": "bind_query_to_patterns",
        "phase": "Wo"
      },
      {
        "name": "WCR",
        "verb": "rank_candidate_micronauts",
        "phase": "Sek"
      },
      {
        "name": "Cata",
        "verb": "select_execution_set",
        "phase": "Ch'en"
      },
      {
        "name": "Continue",
        "verb": "invoke_callable_edges",
        "phase": "Sek"
      },
      {
        "name": "Learn",
        "verb": "distill_patterns_templates_routes",
        "phase": "Xul"
      }
    ]
  },
  "authority_boundary": {
    "semantic_authority": false,
    "topology_authority": false,
    "verification_authority": false,
    "commit_authority": false,
    "semantic_edges_do_not_invoke": true,
    "callable_edges_require_route_contract": true,
    "xul_required_for_promotion": true
  },
  "memory_field_assets": {
    "schema": "memory.field.v1",
    "memory_field": "memory/memory.field.v1.json",
    "vectors": "memory/memory.field.vectors.v1.json",
    "bytecode_keys": "memory/memory.field.bytecode-keys.v1.json",
    "loader": "micronaut.program.inspect",
    "execution": "read_only_resolution"
  },
